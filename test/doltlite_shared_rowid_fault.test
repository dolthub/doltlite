set testdir [file dirname $argv0]
source $testdir/tester.tcl

reset_db
execsql {
  CREATE TABLE t(id INTEGER PRIMARY KEY, v TEXT);
  SELECT dolt_commit('-Am','base');
  SELECT dolt_branch('other');
}
faultsim_save_and_close
do_faultsim_test shared-rowid-insert-oom -faults oom-transient -prep {
  faultsim_restore_and_reopen
  db eval {SELECT * FROM t}
} -body {
  db eval {INSERT INTO t VALUES(50,'main')}
} -test {
  faultsim_test_result {0 {}}
  set expectedRows [expr {$testrc==0 ? 1 : 0}]
  set actualRows [db one {SELECT count(*) FROM t}]
  if {$actualRows != $expectedRows} {
    error "expected $expectedRows rows after INSERT, got $actualRows"
  }
  set expected [expr {$testrc==0 ? 51 : 1}]
  db eval {SELECT dolt_checkout('other'); INSERT INTO t(v) VALUES('other')}
  set actual [db one {SELECT id FROM t}]
  if {$actual != $expected} {error "expected rowid $expected, got $actual"}
}

reset_db
execsql {
  CREATE TABLE t(id INTEGER PRIMARY KEY, v TEXT);
  INSERT INTO t VALUES(50,'base');
  DELETE FROM t;
}
faultsim_save_and_close
do_faultsim_test shared-rowid-rename-oom -faults oom-transient -prep {
  faultsim_restore_and_reopen
  db eval {SELECT * FROM t}
} -body {
  db eval {ALTER TABLE t RENAME TO renamed}
} -test {
  faultsim_test_result {0 {}} \
      {1 {unable to open a temporary database file for storing temporary tables}}
  set table [expr {$testrc==0 ? "renamed" : "t"}]
  db eval "INSERT INTO ${table}(v) VALUES('after rename')"
  set actual [db one "SELECT id FROM $table"]
  if {$actual != 51} {error "expected rowid 51, got $actual"}
}

finish_test
