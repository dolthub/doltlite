# sqlite3_deserialize() of a stock SQLite page image reopens the schema on the
# original B-tree engine, whatever engine the schema held before. The image
# decides; the connection's current format does not.

set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix doltlite_deserialize_stock_image

db close
forcedelete stockimg.db stockmain.db
sqlite3 dbs file:stockimg.db?doltlite_engine=sqlite -uri 1
dbs eval {
  CREATE TABLE t(a INT); INSERT INTO t VALUES(1),(2),(3);
  CREATE TABLE pk(k1 INT, k2 INT, v, PRIMARY KEY(k1,k2));
  INSERT INTO pk VALUES(1,10,'a'),(2,20,'b');
}
set img [dbs serialize]
dbs close

sqlite3 hashdb stockimg.db
foreach mode {autocommit transaction} {
  if {$mode eq "transaction"} {hashdb eval BEGIN}
  foreach {name sql} {
    head {dolt_hashof('HEAD')}
    branch {dolt_hashof('main')}
    db {dolt_hashof_db()}
    table {dolt_hashof_table('t')}
    index {dolt_hashof_index('sqlite_autoindex_pk_1')}
    catalog {dolt_hashof_catalog()}
    db-head {dolt_hashof_db('HEAD')}
    db-working {dolt_hashof_db('WORKING')}
    db-staged {dolt_hashof_db('STAGED')}
    db-empty {dolt_hashof_db('')}
    table-head {dolt_hashof_table('t','HEAD')}
    table-working {dolt_hashof_table('t','WORKING')}
    table-staged {dolt_hashof_table('t','STAGED')}
    index-head {dolt_hashof_index('sqlite_autoindex_pk_1','HEAD')}
    index-working {dolt_hashof_index('sqlite_autoindex_pk_1','WORKING')}
    catalog-head {dolt_hashof_catalog('HEAD')}
    catalog-working {dolt_hashof_catalog('WORKING')}
  } {
    do_test hashof.$mode.$name {
      list [catch {hashdb eval "SELECT $sql"} msg] $msg
    } {1 {dolt version-control features are not available on stock SQLite databases}}
  }
  do_test hashof.$mode.null {
    hashdb eval {
      SELECT typeof(dolt_hashof(NULL)), typeof(dolt_hashof_db(NULL)),
             typeof(dolt_hashof_table(NULL)), typeof(dolt_hashof_table('t',NULL)),
             typeof(dolt_hashof_index(NULL)), typeof(dolt_hashof_index('i',NULL)),
             typeof(dolt_hashof_catalog(NULL));
    }
  } {null null null null null null null}
  do_test hashof.$mode.readable {hashdb eval {SELECT sum(a) FROM t}} {6}
  if {$mode eq "transaction"} {hashdb eval ROLLBACK}
}
do_test hashof.integrity {hashdb eval {PRAGMA integrity_check}} {ok}
hashdb close

# 1: into a DoltLite-format :memory: main
sqlite3 db :memory:
do_test 1.1 {
  db eval { CREATE TABLE d(x INT PRIMARY KEY); SELECT count(*) FROM dolt_log }
} {1}
do_test 1.2 {
  db deserialize $img
  db eval { SELECT count(*), sum(a) FROM t }
} {3 6}
do_test 1.3 {
  db eval { INSERT INTO t VALUES(4); SELECT sum(a) FROM t }
} {10}
do_test 1.4 {
  string range [db serialize] 0 14
} {SQLite format 3}
# A composite PRIMARY KEY stays in stock rowid form: rows come from the table
# b-tree, not from the autoindex.
do_test 1.5 {
  db eval { SELECT rowid, k1, k2, v FROM pk ORDER BY rowid }
} {1 1 10 a 2 2 20 b}
do_test 1.6 {
  db eval { SELECT v FROM pk WHERE k1=2 AND k2=20 }
} {b}
do_test 1.7 {
  db eval { INSERT INTO pk VALUES(3,30,'c'); SELECT count(*) FROM pk; PRAGMA integrity_check }
} {3 ok}
db close

# 2: into a connection whose main is a stock file
sqlite3 dbm file:stockmain.db?doltlite_engine=sqlite -uri 1
dbm eval { CREATE TABLE z(q) }
do_test 2.1 {
  dbm eval { SELECT name FROM sqlite_master }
} {z}
do_test 2.2 {
  dbm deserialize $img
  dbm eval { SELECT count(*), sum(a) FROM t }
} {3 6}
dbm close

# 3: a DoltLite image still takes the DoltLite path
sqlite3 dbd :memory:
dbd eval { CREATE TABLE k(id INT PRIMARY KEY, v); INSERT INTO k VALUES(1,'a'); SELECT dolt_commit('-Am','init') }
set dimg [dbd serialize]
dbd close
sqlite3 dbd :memory:
do_test 3.1 {
  dbd deserialize $dimg
  dbd eval { SELECT v FROM k; SELECT count(*) FROM dolt_log }
} {a 2}
dbd close

sqlite3 db test.db
finish_test
