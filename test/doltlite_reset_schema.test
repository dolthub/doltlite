set testdir [file dirname $argv0]
source $testdir/tester.tcl

foreach kind {view trigger} {
  foreach stage {unstaged staged tracked target} {
    foreach unrelated {0 1} {
      foreach txn {autocommit explicit} {
        reset_db
        execsql {
          CREATE TABLE t(id INTEGER PRIMARY KEY, a INT);
          CREATE TABLE audit(id INTEGER PRIMARY KEY);
          INSERT INTO t VALUES(1,1);
        }
        if {$stage in {tracked target}} {
          execsql {CREATE VIEW old_v AS SELECT a FROM t}
        }
        execsql {SELECT dolt_commit('-Am','base')}
        if {$stage eq "target"} {
          execsql {
            DROP VIEW old_v;
            SELECT dolt_commit('-Am','drop');
          }
        }
        if {$kind eq "view"} {
          execsql {CREATE VIEW vv AS SELECT a FROM t}
        } else {
          execsql {
            CREATE TRIGGER tr AFTER INSERT ON t BEGIN
              INSERT INTO audit VALUES(NEW.id);
            END;
          }
        }
        if {$stage eq "staged"} {
          execsql {SELECT dolt_add('dolt_schemas')}
        }
        if {$stage eq "tracked"} {
          execsql {DROP VIEW old_v}
        }
        if {$unrelated} {
          execsql {
            CREATE TABLE u(id INTEGER PRIMARY KEY, v TEXT UNIQUE);
            INSERT INTO u VALUES(1,'untracked');
          }
        }
        execsql {UPDATE t SET a=99}
        if {$txn eq "explicit"} {execsql {BEGIN}}
        set prefix reset-schema-$kind-$stage-$unrelated-$txn
        set keep [expr {$stage eq "unstaged"}]
        set tracked [expr {$stage in {tracked target}}]
        if {$stage eq "target"} {
          do_execsql_test $prefix-reset {
            SELECT dolt_reset('--hard','HEAD~1');
          } {0}
        } else {
          do_execsql_test $prefix-reset {SELECT dolt_reset('--hard')} {0}
        }
        set query {
          SELECT count(*) FROM sqlite_master WHERE name IN ('vv','tr');
          SELECT count(*) FROM sqlite_master WHERE name='old_v';
          SELECT a FROM t;
          SELECT count(*) FROM dolt_status WHERE staged=1;
          SELECT count(*) FROM dolt_status WHERE table_name='dolt_schemas';
          SELECT count(*) FROM sqlite_master WHERE name='u';
          PRAGMA integrity_check;
        }
        set expected [list $keep $tracked 1 0 $keep $unrelated ok]
        do_execsql_test $prefix-live $query $expected
        if {$txn eq "explicit"} {execsql {COMMIT}}
        db close
        sqlite3 db test.db
        do_execsql_test $prefix-reopen $query $expected
        if {$unrelated} {
          do_execsql_test $prefix-untracked-index {
            SELECT id FROM u WHERE v='untracked';
          } {1}
        }
        if {$keep && $kind eq "view"} {
          do_execsql_test $prefix-view {SELECT a FROM vv} {1}
        }
        if {$keep && $kind eq "trigger"} {
          do_execsql_test $prefix-trigger {
            INSERT INTO t VALUES(2,2);
            SELECT id FROM audit;
          } {2}
        }
        if {$tracked} {
          do_execsql_test $prefix-restored-view {SELECT a FROM old_v} {1}
        }
      }
    }
  }
}

# An untracked view or trigger whose name the reset restores to another
# object gives the name back; unrelated untracked views are kept.
foreach {name target} {head {} ref c1} {
  reset_db
  execsql {
    CREATE TABLE t(id INTEGER PRIMARY KEY, a INT);
    INSERT INTO t VALUES(1,1);
  }
  if {$name eq "head"} {
    execsql {
      CREATE TABLE x(id INTEGER PRIMARY KEY, a INT);
      CREATE INDEX xa ON x(a);
      INSERT INTO x VALUES(7,7);
      SELECT dolt_commit('-Am','c0');
      DROP TABLE x;
    }
  } else {
    execsql {
      SELECT dolt_commit('-Am','c0');
      CREATE TABLE x(id INTEGER PRIMARY KEY, a INT);
      CREATE INDEX xa ON x(a);
      INSERT INTO x VALUES(7,7);
      SELECT dolt_commit('-Am','c1');
      SELECT dolt_tag('c1');
      SELECT dolt_reset('--hard','HEAD~1');
    }
  }
  execsql {
    CREATE VIEW x AS SELECT a FROM t;
    CREATE TRIGGER xi INSTEAD OF INSERT ON x BEGIN
      INSERT INTO t VALUES(NEW.a, NEW.a);
    END;
    CREATE VIEW xa AS SELECT id FROM t;
    CREATE VIEW keep AS SELECT id FROM t;
  }
  set prefix reset-hard-name-collision-$name
  do_test $prefix-reset {
    if {$target eq ""} {
      catchsql {SELECT dolt_reset('--hard')}
    } else {
      catchsql {SELECT dolt_reset('--hard','c1')}
    }
  } {0 0}
  set query {
    SELECT type, name FROM sqlite_master ORDER BY name;
    SELECT id FROM x WHERE a=7;
    SELECT id FROM keep;
    PRAGMA integrity_check;
  }
  set expected {view keep table t table x index xa 7 1 ok}
  do_execsql_test $prefix-usable $query $expected
  db close
  sqlite3 db test.db
  do_execsql_test $prefix-reopen $query $expected
  do_execsql_test $prefix-reset-again {SELECT dolt_reset('--hard')} {0}
}

# A virtual table is a master row with no catalog entry. An untracked one
# survives a hard reset together with its shadow tables, as untracked
# ordinary tables do; a tracked one is restored from the target.
foreach {name create insert more probe expect} {
  fts5 {CREATE VIRTUAL TABLE ft USING fts5(body)}
       {INSERT INTO ft VALUES('hello world'),('goodbye moon')}
       {INSERT INTO ft VALUES('third row')}
       {SELECT body FROM ft WHERE ft MATCH 'moon'} {{goodbye moon}}
  rtree {CREATE VIRTUAL TABLE ft USING rtree(id, x0, x1)}
       {INSERT INTO ft VALUES(1,0,10),(2,20,30)}
       {INSERT INTO ft VALUES(3,40,50)}
       {SELECT id FROM ft WHERE x0>=15} 2
} {
  foreach target {head ref} {
    reset_db
    execsql {
      CREATE TABLE base(id INTEGER PRIMARY KEY, v);
      INSERT INTO base VALUES(1,'a');
      SELECT dolt_commit('-Am','c0');
      INSERT INTO base VALUES(2,'b');
      SELECT dolt_commit('-Am','c1');
    }
    execsql $create
    execsql $insert
    execsql {
      CREATE TABLE plain(id INTEGER PRIMARY KEY);
      UPDATE base SET v='dirty';
    }
    set prefix reset-hard-untracked-vtab-$name-$target
    do_test $prefix.reset {
      if {$target eq "head"} {
        catchsql {SELECT dolt_reset('--hard')}
      } else {
        catchsql {SELECT dolt_reset('--hard','HEAD~1')}
      }
    } {0 0}
    set rows [expr {$target eq "head" ? "a b" : "a"}]
    foreach stage {after reopened} {
      if {$stage eq "reopened"} {
        db close
        sqlite3 db test.db
      }
      do_execsql_test $prefix.$stage.vtab $probe $expect
      do_execsql_test $prefix.$stage.rest {
        SELECT group_concat(v, ' ') FROM (SELECT v FROM base ORDER BY id);
        SELECT count(*) FROM sqlite_schema WHERE name IN ('ft','plain');
        PRAGMA integrity_check;
      } [list $rows 2 ok]
    }
    do_test $prefix.writable {
      execsql $more
      execsql {SELECT count(*) FROM ft}
    } 3
    do_execsql_test $prefix.tracked {
      SELECT dolt_commit('-Am','track') IS NOT NULL;
      DROP TABLE ft;
      SELECT dolt_reset('--hard');
      SELECT count(*) FROM ft;
    } {1 0 3}
  }
}

finish_test
