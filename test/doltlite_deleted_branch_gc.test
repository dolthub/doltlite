set testdir [file dirname $argv0]
source $testdir/tester.tcl

set executable [file normalize [info nameofexecutable]]
while {[file type $executable] eq "link"} {
  set executable [file normalize [file join [file dirname $executable] \
      [file readlink $executable]]]
}
set engine [file join [file dirname $executable] doltlite]
if {$tcl_platform(platform) eq "windows"} {append engine .exe}

foreach key {INTEGER INT} {
  foreach dirty {0 1} {
    foreach boundary {autocommit begin savepoint nested} {
      foreach target {main recreated} {
        set prefix deleted-branch-direct-$key.$dirty.$boundary.$target
        reset_db
        db eval "CREATE TABLE t(id $key PRIMARY KEY,v TEXT)"
        db eval {
          CREATE INDEX tv ON t(v);
          INSERT INTO t VALUES(1,'main');
          SELECT dolt_commit('-Am','main');
          SELECT dolt_checkout('-b','feat');
          CREATE TABLE feat_only(id INTEGER PRIMARY KEY);
          INSERT INTO t VALUES(2,'feat');
          SELECT dolt_commit('-Am','feat');
        }
        if {$dirty} {db eval {INSERT INTO t VALUES(3,'dirty')}}
        switch $boundary {
          begin {db eval BEGIN}
          savepoint {db eval {SAVEPOINT caller}}
          nested {db eval {BEGIN; SAVEPOINT caller}}
        }
        exec $engine -bail [file normalize test.db] {
          SELECT dolt_branch('-D','feat'); SELECT dolt_gc();
        }
        db eval {PRAGMA shrink_memory}
        set sql {SELECT dolt_checkout('main')}
        if {$target eq "recreated"} {
          set sql {SELECT dolt_checkout('-b','feat','main')}
        }
        do_test $prefix.checkout {catchsql $sql} {0 0}
        do_execsql_test $prefix.target {
          SELECT id FROM t INDEXED BY tv ORDER BY id;
          SELECT count(*) FROM sqlite_schema WHERE name='feat_only';
          SELECT count(*) FROM dolt_status;
          PRAGMA integrity_check;
        } {1 0 0 ok}
        do_execsql_test $prefix.branch {
          SELECT active_branch();
          SELECT count(*) FROM dolt_branches WHERE name='feat';
        } [expr {$target eq "main" ? "main 0" : "feat 1"}]
        do_execsql_test $prefix.write {
          INSERT INTO t VALUES(4,'recovered');
          SELECT length(dolt_commit('-am','recovered'));
        } 40
        if {![sqlite3_get_autocommit db]} {
          do_test $prefix.commit {catchsql COMMIT} {0 {}}
        }
        do_test $prefix.reopen {
          db close
          sqlite3 db test.db
          db eval {
            SELECT id FROM dolt_at_t('main') ORDER BY id;
            SELECT count(*) FROM dolt_branches WHERE name='feat';
            PRAGMA integrity_check;
          }
        } [expr {$target eq "main" ? "1 4 0 ok" : "1 1 ok"}]
      }
    }
  }
}

foreach key {INTEGER INT} {
  foreach {mode sql} {
    scan {SELECT * FROM t}
    reverse {SELECT * FROM t ORDER BY id DESC}
    seek {SELECT * FROM t WHERE id=2}
    count {SELECT count(*) FROM t}
    index {SELECT * FROM t INDEXED BY tv WHERE v='feat'}
    insert {INSERT INTO t VALUES(3,'rejected')}
  } {
    reset_db
    db eval "CREATE TABLE t(id $key PRIMARY KEY,v TEXT)"
    db eval {
      CREATE INDEX tv ON t(v);
      INSERT INTO t VALUES(1,'main');
      SELECT dolt_commit('-Am','main');
      SELECT dolt_checkout('-b','feat');
      CREATE TABLE feat_only(id INTEGER PRIMARY KEY);
      INSERT INTO t VALUES(2,'feat');
      SELECT dolt_commit('-Am','feat');
    }
    exec $engine -bail [file normalize test.db] {
      SELECT dolt_branch('-D','feat'); SELECT dolt_gc();
    }
    db eval {PRAGMA shrink_memory; BEGIN}
    do_test deleted-branch-read-$key.$mode.refused {
      list [catch {db eval $sql} message] [expr {[db errorcode]&255}]
    } {1 5}
    do_catchsql_test deleted-branch-read-$key.$mode.checkout {
      SELECT dolt_checkout('main');
    } {0 0}
    do_execsql_test deleted-branch-read-$key.$mode.target {
      INSERT INTO t VALUES(4,'recovered');
      SELECT length(dolt_commit('-am','recovered'));
      SELECT id FROM t ORDER BY id;
      SELECT count(*) FROM dolt_branches WHERE name='feat';
      PRAGMA integrity_check;
    } {40 1 4 0 ok}
    if {![sqlite3_get_autocommit db]} {db eval COMMIT}
  }
}

set deletedReadArmed 0
proc deleted_read_error {method filename args} {
  if {$::deletedReadArmed && [file tail $filename] eq "test.db"} {
    incr ::deletedReadHits
    return SQLITE_IOERR
  }
  return SQLITE_OK
}
testvfs deletedio
deletedio filter {xRead}
deletedio script deleted_read_error

foreach error {corrupt ioerr} {
  reset_db
  db close
  sqlite3 db test.db -vfs deletedio
  db eval {
    CREATE TABLE t(id INTEGER PRIMARY KEY);
    INSERT INTO t VALUES(1);
    SELECT dolt_commit('-Am','main');
    SELECT dolt_checkout('-b','feat');
    CREATE TABLE feat_only(id INTEGER PRIMARY KEY);
    SELECT dolt_commit('-Am','feat');
    BEGIN;
  }
  exec $engine -bail [file normalize test.db] {
    SELECT dolt_branch('-D','feat'); SELECT dolt_gc();
  }
  db eval {PRAGMA shrink_memory}
  if {$error eq "corrupt"} {
    do_catchsql_test deleted-branch-prior-corrupt {
      SELECT test_error('prior corruption',11);
    } {1 {prior corruption}}
    set expected 11
  } else {
    set deletedReadHits 0
    set deletedReadArmed 1
    set expected 10
  }
  do_test deleted-branch-$error.refused {
    list [catch {db eval {SELECT dolt_checkout('main')}} message] \
      [expr {[db errorcode]&255}]
  } [list 1 $expected]
  set deletedReadArmed 0
  if {$error eq "ioerr"} {
    do_test deleted-branch-ioerr.injected {expr {$deletedReadHits>0}} 1
  }
  if {![sqlite3_get_autocommit db]} {db eval ROLLBACK}
  do_execsql_test deleted-branch-$error.rollback {
    SELECT dolt_checkout('main');
    SELECT id FROM t;
    SELECT count(*) FROM dolt_branches WHERE name='feat';
    PRAGMA integrity_check;
  } {0 1 0 ok}
}
db close
deletedio delete
sqlite3 db test.db

foreach gc {0 1} {
  foreach dirty {0 1} {
    foreach boundary {autocommit begin savepoint nested} {
      set prefix deleted-branch-$gc.$dirty.$boundary
      reset_db
      db eval {
        CREATE TABLE t(id INTEGER PRIMARY KEY,v TEXT);
        CREATE INDEX tv ON t(v);
        INSERT INTO t VALUES(1,'main');
        SELECT dolt_commit('-Am','main commit');
        SELECT dolt_checkout('-b','feat');
        CREATE TABLE feat_only(id INTEGER PRIMARY KEY);
        INSERT INTO t VALUES(2,'feat');
        SELECT dolt_commit('-am','feat commit');
      }
      if {$dirty} {db eval {INSERT INTO t VALUES(3,'dirty')}}
      set head [db one {SELECT dolt_hashof('HEAD')}]
      switch $boundary {
        begin {db eval BEGIN}
        savepoint {db eval {SAVEPOINT caller}}
        nested {db eval {BEGIN; SAVEPOINT caller}}
      }
      if {$boundary ne "autocommit"} {db eval {SELECT * FROM t}}
      set peerSql {SELECT dolt_branch('-D','feat');}
      if {$gc} {append peerSql {SELECT dolt_gc();}}
      do_test $prefix.peer {
        set output [exec $engine -bail [file normalize test.db] $peerSql]
        expr {$gc ? [regexp {^0\n[1-9][0-9]* chunks removed, [0-9]+ chunks kept$} $output]
                  : $output eq "0"}
      } 1
      db eval {PRAGMA shrink_memory}
      do_test $prefix.status {
        set caught [catch {db eval {SELECT count(*) FROM dolt_status}} message]
        expr {!$caught || ([db errorcode]&255)==5}
      } 1
      foreach {name op} {
        commit {SELECT dolt_commit('-a','--allow-empty','-m','rejected')}
        amend-all {SELECT dolt_commit('-A','--amend','-m','rejected')}
        amend {SELECT dolt_commit('--amend','-m','rejected')}
        hard-reset {SELECT dolt_reset('--hard')}
        soft-reset {SELECT dolt_reset('--soft','HEAD')}
      } {
        do_test $prefix.$name {
          list [catch {db eval $op} message] [expr {[db errorcode]&255}]
        } {1 5}
      }
      do_test $prefix.invalid-checkout {
        list [catch {db eval {SELECT dolt_checkout('nosuch')}} message] \
          [db one {SELECT dolt_hashof('HEAD')}]
      } [list 1 $head]
      db eval {PRAGMA shrink_memory}
      do_test $prefix.checkout {
        set caught [catch {db eval {SELECT dolt_checkout('main')}} message]
        if {$caught && ([db errorcode]&255)==5 && ![sqlite3_get_autocommit db]} {
          db eval ROLLBACK
          set caught [catch {db eval {SELECT dolt_checkout('main')}} message]
        }
        list $caught $message
      } {0 0}
      if {![sqlite3_get_autocommit db]} {db eval COMMIT}
      do_execsql_test $prefix.target {
        SELECT dolt_checkout('main');
        SELECT id FROM t INDEXED BY tv ORDER BY id;
        SELECT count(*) FROM dolt_branches WHERE name='feat';
        SELECT count(*) FROM dolt_status;
      } {0 1 0 0}
      do_execsql_test $prefix.write {
        INSERT INTO t VALUES(4,'recovered');
        SELECT length(dolt_commit('-am','recovered'));
      } 40
      do_test $prefix.reopen {
        db close
        sqlite3 db test.db
        db eval {
          SELECT id FROM dolt_at_t('main') ORDER BY id;
          SELECT count(*) FROM dolt_branches WHERE name='feat';
          PRAGMA integrity_check;
        }
      } {1 4 0 ok}
    }
  }
}

foreach gc {0 1} {
  foreach flag {-b -B} {
    set prefix deleted-branch-recreate-$gc.$flag
    reset_db
    db eval {
      CREATE TABLE t(id INTEGER PRIMARY KEY);
      INSERT INTO t VALUES(1);
      SELECT dolt_commit('-Am','main');
      SELECT dolt_checkout('-b','feat');
      CREATE TABLE feat_only(id INTEGER PRIMARY KEY);
      SELECT dolt_commit('-Am','feat');
    }
    set peerSql {SELECT dolt_branch('-D','feat');}
    if {$gc} {append peerSql {SELECT dolt_gc();}}
    exec $engine -bail [file normalize test.db] $peerSql
    db eval {PRAGMA shrink_memory}
    do_test $prefix.checkout {db eval "SELECT dolt_checkout('$flag','feat','main')"} 0
    do_execsql_test $prefix.rows {
      SELECT id FROM t;
      SELECT count(*) FROM sqlite_schema WHERE name='feat_only';
      SELECT count(*) FROM dolt_branches WHERE name='feat';
    } {1 0 1}
    do_execsql_test $prefix.write {
      INSERT INTO t VALUES(2);
      SELECT length(dolt_commit('-am','recreated'));
      PRAGMA integrity_check;
    } {40 ok}
  }
}

foreach gc {none before after} {
  foreach boundary {autocommit begin savepoint} {
    foreach {mode checkout} {
      table {SELECT dolt_checkout('t')}
      head {SELECT dolt_checkout('HEAD','t')}
      dot {SELECT dolt_checkout('.')}
    } {
      reset_db
      execsql {
        CREATE TABLE t(id INT PRIMARY KEY,v TEXT);
        INSERT INTO t VALUES(1,'main');
        SELECT dolt_commit('-Am','main');
        SELECT dolt_checkout('-b','feat');
        INSERT INTO t VALUES(2,'feat');
        SELECT dolt_commit('-am','feat');
        CREATE TABLE d(id INTEGER PRIMARY KEY,v TEXT);
        INSERT INTO d VALUES(1,'uncommitted');
      }
      set peerSql {}
      if {$gc eq "before"} {
        append peerSql {
          SELECT dolt_checkout('feat');
          DROP TABLE d;
          SELECT dolt_checkout('main');
          SELECT dolt_gc();
        }
      }
      append peerSql {SELECT dolt_branch('-D','feat');}
      if {$gc eq "after"} {append peerSql {SELECT dolt_gc();}}
      exec $engine -bail [file normalize test.db] $peerSql
      switch $boundary {
        begin {db eval BEGIN}
        savepoint {db eval {SAVEPOINT caller}}
      }
      set prefix deleted-branch-table-$gc-$boundary-$mode
      do_test $prefix.table-refused {
        list [catch {db eval $checkout} message] [expr {[db errorcode]&255}]
      } {1 5}
      if {![sqlite3_get_autocommit db]} {db eval ROLLBACK}
      do_test $prefix.table-durable {
        exec $engine -bail [file normalize test.db] {
          SELECT count(*) FROM dolt_branches WHERE name='feat';
          SELECT id,v FROM t;
          PRAGMA integrity_check;
        }
      } {0
1|main
ok}
      do_execsql_test $prefix.recover {
        SELECT dolt_checkout('main');
        INSERT INTO t VALUES(3,'recovered');
        SELECT id,v FROM t ORDER BY id;
        PRAGMA integrity_check;
      } {0 1 main 3 recovered ok}
    }
  }
}
foreach boundary {autocommit begin} {
  set prefix deleted-branch-read-message-$boundary
  reset_db
  db eval {
    CREATE TABLE t(a INTEGER PRIMARY KEY, b TEXT);
    SELECT dolt_commit('-Am','init');
    SELECT dolt_checkout('-b','feat');
    WITH RECURSIVE r(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM r WHERE i<20000)
      INSERT INTO t SELECT i, hex(randomblob(40)) FROM r;
    SELECT dolt_commit('-am','rows on feat');
  }
  db eval {SELECT b FROM t WHERE a=1}
  exec $engine -bail [file normalize test.db] {
    SELECT dolt_branch('-D','feat'); SELECT dolt_gc();
  }
  db eval {PRAGMA shrink_memory}
  if {$boundary eq "begin"} {db eval BEGIN}
  for {set i 1} {$i<=2} {incr i} {
    do_test $prefix.scan.$i {
      list [catch {db eval {SELECT count(*), max(length(b)) FROM t}} msg] \
        $msg [expr {[db errorcode]&255}]
    } {1 {cannot read: branch 'feat' no longer exists} 5}
  }
  if {![sqlite3_get_autocommit db]} {db eval ROLLBACK}
  do_execsql_test $prefix.checkout {
    SELECT dolt_checkout('main');
    SELECT count(*) FROM t;
  } {0 0}
}

finish_test
