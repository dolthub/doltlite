set testdir [file dirname $argv0]
source $testdir/tester.tcl

proc vc_interrupt_snapshot {handle} {
  $handle eval {
    SELECT dolt_hashof('HEAD');
    SELECT active_branch();
    SELECT name,hash FROM dolt_branches ORDER BY name;
    SELECT table_name,staged,status FROM dolt_status ORDER BY table_name,staged;
    SELECT id,v FROM t ORDER BY id;
  }
}

foreach op {commit checkout} {
  set interrupted 0
  for {set tick 1} {$tick<=1000} {incr tick} {
    reset_db
    db eval {
      CREATE TABLE t(id INTEGER PRIMARY KEY,v);
      INSERT INTO t VALUES(1,1);
      SELECT dolt_commit('-Am','init');
      SELECT dolt_branch('f');
      INSERT INTO t VALUES(2,2);
    }
    set before [vc_interrupt_snapshot db]
    set ::vc_interrupt_ticks 0
    db progress 1 {expr {[incr ::vc_interrupt_ticks]==$tick}}
    if {$op eq "commit"} {
      set failed [catch {db eval {SELECT dolt_commit('-Am','c2')}}]
    } else {
      set failed [catch {db eval {SELECT dolt_checkout('f')}}]
    }
    set code [sqlite3_errcode db]
    db progress 0 {}
    set prefix vc-interrupt-$op-$tick
    if {$failed} {
      incr interrupted
      do_test $prefix.code {set code} SQLITE_INTERRUPT
      do_test $prefix.live {vc_interrupt_snapshot db} $before
      sqlite3 observer test.db
      do_test $prefix.durable {vc_interrupt_snapshot observer} $before
      observer close
      db eval {INSERT INTO t VALUES(3,3)}
      do_test $prefix.no-staging {
        db one {SELECT count(*) FROM dolt_status WHERE staged}
      } 0
    } else {
      do_test $prefix.success {
        list [db one {SELECT active_branch()}] \
             [db one {SELECT count(*) FROM t}] \
             [db one {SELECT count(*) FROM dolt_status}]
      } [expr {$op eq "commit" ? [list main 2 0] : [list f 1 0]}]
    }
    if {$::vc_interrupt_ticks<$tick} break
  }
  do_test vc-interrupt-$op.cancellable {expr {$interrupted>0}} 1
  do_test vc-interrupt-$op.terminates {expr {$tick<=1000}} 1
}

reset_db
db eval {CREATE TABLE t(id INTEGER PRIMARY KEY); INSERT INTO t VALUES(1)}
set stmt [sqlite3_prepare_v2 db {SELECT dolt_add('-A')} -1 tail]
do_test vc-interrupt.reuse-first {sqlite3_step $stmt} SQLITE_ROW
db interrupt
do_test vc-interrupt.reuse-finish {sqlite3_step $stmt} SQLITE_DONE
sqlite3_reset $stmt
set ::vc_interrupt_ticks 0
db progress 1 {expr {[incr ::vc_interrupt_ticks]==1}}
do_test vc-interrupt.reuse-cancel {sqlite3_step $stmt} SQLITE_INTERRUPT
db progress 0 {}
sqlite3_finalize $stmt

set stmt [sqlite3_prepare_v2 db {
  WITH RECURSIVE r(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM r WHERE x<100)
  SELECT dolt_add('-A') FROM r
} -1 tail]
do_test vc-interrupt.rows-first {sqlite3_step $stmt} SQLITE_ROW
set ::vc_interrupt_ticks 0
db progress 1 {expr {[incr ::vc_interrupt_ticks]==1}}
do_test vc-interrupt.rows-cancel {sqlite3_step $stmt} SQLITE_INTERRUPT
db progress 0 {}
sqlite3_finalize $stmt

proc clean_interrupt_snapshot {} {
  db eval {
    SELECT dolt_hashof('HEAD');
    SELECT name,type,tbl_name,sql FROM main.sqlite_schema ORDER BY name;
    SELECT table_name,staged,status FROM dolt_status ORDER BY table_name,staged;
    SELECT id,v FROM t ORDER BY id;
    SELECT id,v FROM u1 INDEXED BY u1v ORDER BY id;
    SELECT * FROM u2;
    SELECT * FROM u3;
    SELECT seq FROM sqlite_sequence WHERE name='u1';
    SELECT * FROM local_view ORDER BY id;
    PRAGMA foreign_keys;
  }
}

proc clean_interrupt_progress {api tick} {
  incr ::cleanTicks
  if {$::cleanTicks==$tick} {
    set ::cleanFired 1
    if {$api eq "interrupt"} {
      db interrupt
      return 0
    }
    return 1
  }
  return 0
}

foreach boundary {autocommit begin savepoint nested} {
  foreach api {progress interrupt} {
    set interrupted 0
    for {set tick 1} {$tick<=1500} {incr tick} {
      reset_db
      db eval {
        PRAGMA foreign_keys=ON;
        CREATE TABLE t(id INTEGER PRIMARY KEY,v TEXT);
        INSERT INTO t VALUES(1,'base');
        SELECT dolt_commit('-Am','base');
        INSERT INTO t VALUES(2,'staged');
        SELECT dolt_add('t');
        INSERT INTO t VALUES(3,'working');
        CREATE TABLE u1(id INTEGER PRIMARY KEY AUTOINCREMENT,v TEXT);
        CREATE INDEX u1v ON u1(v);
        INSERT INTO u1(v) VALUES('one');
        CREATE TABLE u2(id INT PRIMARY KEY,v TEXT);
        INSERT INTO u2 VALUES(2,'two');
        CREATE TABLE u3(id INT PRIMARY KEY,v TEXT);
        INSERT INTO u3 VALUES(3,'three');
        CREATE VIEW local_view AS SELECT * FROM t;
        CREATE TRIGGER local_trigger AFTER INSERT ON u3 BEGIN SELECT 1; END;
      }
      switch $boundary {
        begin {db eval BEGIN}
        savepoint {db eval {SAVEPOINT caller}}
        nested {db eval {BEGIN; SAVEPOINT caller}}
      }
      if {$boundary ne "autocommit"} {
        db eval {INSERT INTO t VALUES(4,'caller'); UPDATE u3 SET v='caller'}
      }
      set before [clean_interrupt_snapshot]
      set beforeAuto [sqlite3_get_autocommit db]
      set ::cleanTicks 0
      set ::cleanFired 0
      db progress 1 [list clean_interrupt_progress $api $tick]
      set failed [catch {db eval {SELECT dolt_clean()}} message]
      set code [sqlite3_errcode db]
      db progress 0 {}
      set prefix clean-interrupt-$boundary-$api-$tick
      if {$failed} {
        incr interrupted
        do_test $prefix.code {set code} SQLITE_INTERRUPT
        do_test $prefix.transaction {sqlite3_get_autocommit db} $beforeAuto
        do_test $prefix.live {clean_interrupt_snapshot} $before
        if {$boundary eq "autocommit"} {
          sqlite3 peer test.db
          do_test $prefix.peer-write {peer eval {INSERT INTO t VALUES(50,'peer')}} {}
          peer close
          do_execsql_test $prefix.next-write {INSERT INTO t VALUES(51,'next')} {}
        } elseif {$boundary eq "begin"} {
          do_execsql_test $prefix.commit {COMMIT} {}
        } else {
          do_execsql_test $prefix.caller-savepoint {
            ROLLBACK TO caller;
            RELEASE caller;
            SELECT count(*) FROM t WHERE id=4;
          } {0}
          if {$boundary eq "nested"} {db eval COMMIT}
        }
        do_test $prefix.durable {
          db close
          sqlite3 db test.db
          db eval {
            SELECT count(*) FROM main.sqlite_schema WHERE name IN ('u1','u2','u3');
            SELECT v FROM u1 INDEXED BY u1v;
            SELECT * FROM u2;
            SELECT v FROM u3;
            SELECT seq FROM sqlite_sequence WHERE name='u1';
            SELECT count(*) FROM main.sqlite_schema
              WHERE name IN ('local_view','local_trigger');
            SELECT count(*) FROM dolt_status WHERE table_name='t' AND staged=1;
            SELECT count(*) FROM t WHERE id=4;
            SELECT count(*) FROM t WHERE id IN (50,51);
            PRAGMA integrity_check;
          }
        } [list 3 one 2 two [expr {$boundary eq "begin" ? "caller" : "three"}] \
             1 2 1 [expr {$boundary eq "begin" ? 1 : 0}] \
             [expr {$boundary eq "autocommit" ? 2 : 0}] ok]
      } else {
        do_execsql_test $prefix.success {
          SELECT count(*) FROM main.sqlite_schema
            WHERE name IN ('u1','u2','u3','local_view','local_trigger');
          SELECT count(*) FROM t;
          SELECT count(*) FROM dolt_status WHERE table_name='t' AND staged=1;
          PRAGMA foreign_keys;
        } [list 0 [expr {$boundary eq "autocommit" ? 3 : 4}] 1 1]
        if {![sqlite3_get_autocommit db]} {db eval COMMIT}
      }
      if {!$::cleanFired} break
    }
    do_test clean-interrupt-$boundary-$api.cancellable {expr {$interrupted>0}} 1
    do_test clean-interrupt-$boundary-$api.terminates {expr {$tick<=1500}} 1
  }
}

proc resolve_interrupt_snapshot {} {
  db eval {
    SELECT dolt_hashof('HEAD');
    SELECT id,v FROM t ORDER BY id;
    SELECT id,v FROM u ORDER BY id;
    SELECT id,v FROM caller_rows ORDER BY id;
    SELECT "table",num_conflicts FROM dolt_conflicts ORDER BY "table";
    SELECT base_v,our_v,their_v FROM dolt_conflicts_t ORDER BY our_id;
    SELECT base_v,our_v,their_v FROM dolt_conflicts_u ORDER BY our_id;
    SELECT table_name,staged,status FROM dolt_status ORDER BY table_name,staged;
  }
}

foreach boundary {begin nested collision} {
  foreach mode {ours theirs} {
    foreach tables {'t' 't','u'} {
      foreach api {progress interrupt} {
        set interrupted 0
        for {set tick 1} {$tick<=200} {incr tick} {
          reset_db
          db eval {
            CREATE TABLE t(id INTEGER PRIMARY KEY,v TEXT);
            CREATE TABLE u(id INTEGER PRIMARY KEY,v TEXT);
            CREATE TABLE caller_rows(id INTEGER PRIMARY KEY,v TEXT);
            WITH RECURSIVE s(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<20)
              INSERT INTO t SELECT i,'base' FROM s;
            INSERT INTO u SELECT * FROM t;
            SELECT dolt_commit('-Am','base');
            SELECT dolt_branch('feat');
            UPDATE t SET v='main'; UPDATE u SET v='main';
            SELECT dolt_commit('-am','main');
            SELECT dolt_checkout('feat');
            UPDATE t SET v='feat'; UPDATE u SET v='feat';
            SELECT dolt_commit('-am','feat');
            SELECT dolt_checkout('main');
            BEGIN;
          }
          catch {db eval {SELECT dolt_merge('feat')}}
          if {$boundary ne "begin"} {
            if {$boundary eq "collision"} {
              db eval {SAVEPOINT doltlite_conflicts_resolve}
            } else {
              db eval {SAVEPOINT caller}
            }
          }
          db eval {INSERT INTO caller_rows VALUES(1,'caller')}
          set before [resolve_interrupt_snapshot]
          set ::cleanTicks 0
          set ::cleanFired 0
          db progress 1 [list clean_interrupt_progress $api $tick]
          set failed [catch {db eval "SELECT dolt_conflicts_resolve('--$mode',$tables)"} message]
          set code [sqlite3_errcode db]
          db progress 0 {}
          set prefix resolve-interrupt-$boundary-$mode-$tables-$api-$tick
          if {$failed} {
            incr interrupted
            do_test $prefix.code {set code} SQLITE_INTERRUPT
            do_test $prefix.message {string match *interrupt* $message} 1
            do_test $prefix.transaction {sqlite3_get_autocommit db} 0
            do_test $prefix.live {resolve_interrupt_snapshot} $before
          } else {
            do_execsql_test $prefix.success {
              SELECT count(*) FROM t WHERE v='main';
              SELECT count(*) FROM u WHERE v='main';
              SELECT count(*) FROM dolt_conflicts;
              SELECT count(*) FROM caller_rows;
            } [list [expr {$mode eq "ours" ? 20 : 0}] \
                    [expr {$tables eq "'t'" || $mode eq "ours" ? 20 : 0}] \
                    [expr {$tables eq "'t'" ? 1 : 0}] 1]
          }
          if {$boundary eq "collision"} {
            do_execsql_test $prefix.caller-savepoint {
              ROLLBACK TO doltlite_conflicts_resolve;
              RELEASE doltlite_conflicts_resolve;
              SELECT count(*) FROM caller_rows;
              SELECT count(*) FROM dolt_conflicts;
            } {0 2}
          } elseif {$boundary ne "begin"} {
            do_execsql_test $prefix.caller-savepoint {
              ROLLBACK TO caller;
              RELEASE caller;
              SELECT count(*) FROM caller_rows;
            } {0}
          }
          do_test $prefix.no-internal-savepoint {
            catchsql {RELEASE doltlite_conflicts_resolve}
          } {1 {no such savepoint: doltlite_conflicts_resolve}}
          if {![sqlite3_get_autocommit db]} {db eval ROLLBACK}
          if {!$::cleanFired} break
        }
        do_test resolve-interrupt-$boundary-$mode-$tables-$api.cancellable {expr {$interrupted>0}} 1
        do_test resolve-interrupt-$boundary-$mode-$tables-$api.terminates {expr {$tick<=200}} 1
      }
    }
  }
}

proc add_interrupt_snapshot {handle} {
  $handle eval {
    SELECT dolt_hashof('HEAD'),dolt_hashof_db('WORKING'),dolt_hashof_db('STAGED');
    SELECT table_name,staged,status FROM dolt_status ORDER BY table_name,staged;
    SELECT id,v FROM t ORDER BY id;
    SELECT * FROM u;
  }
}

foreach arg {. t -A} {
  foreach api {progress interrupt} {
    set interrupted 0
    for {set tick 1} {$tick<=400} {incr tick} {
      reset_db
      db eval {
        CREATE TABLE t(id INTEGER PRIMARY KEY,v TEXT);
        INSERT INTO t VALUES(1,'base');
        SELECT dolt_commit('-Am','base');
        INSERT INTO t VALUES(2,'staged');
        SELECT dolt_add('t');
        INSERT INTO t VALUES(3,'working');
        CREATE TABLE u(id INTEGER PRIMARY KEY);
        INSERT INTO u VALUES(99);
      }
      set before [add_interrupt_snapshot db]
      set ::cleanTicks 0
      set ::cleanFired 0
      db progress 1 [list clean_interrupt_progress $api $tick]
      set failed [catch {db eval "SELECT dolt_add('$arg')"} message]
      set code [sqlite3_errcode db]
      db progress 0 {}
      set prefix add-interrupt-$arg-$api-$tick
      do_test $prefix.autocommit {sqlite3_get_autocommit db} 1
      if {$failed} {
        incr interrupted
        do_test $prefix.code {set code} SQLITE_INTERRUPT
        do_test $prefix.live {add_interrupt_snapshot db} $before
        sqlite3 observer test.db
        do_test $prefix.durable {add_interrupt_snapshot observer} $before
        observer close
        do_execsql_test $prefix.write {
          INSERT INTO t VALUES(4,'recovered');
        } {}
      } else {
        do_test $prefix.staged {
          db one {SELECT count(*) FROM dolt_diff_t('HEAD','STAGED')}
        } 2
      }
      if {!$::cleanFired} break
    }
    do_test add-interrupt-$arg-$api.cancellable {expr {$interrupted>0}} 1
    do_test add-interrupt-$arg-$api.terminates {expr {$tick<=400}} 1
  }
}


# An interrupt anywhere in a command inside BEGIN must not leave the
# command's own savepoint open; the session would then act as if the user
# held a SAVEPOINT, and a later conflicting merge would drop its conflicts.
foreach op {merge commit checkout} {
  set interrupted 0
  for {set tick 1} {$tick<=3000} {incr tick} {
    reset_db
    db eval {
      CREATE TABLE t(id INTEGER PRIMARY KEY, v);
      INSERT INTO t VALUES(1,'a');
      SELECT dolt_commit('-Am','init');
      SELECT dolt_checkout('-b','b3');
      UPDATE t SET v='b3';
      SELECT dolt_commit('-am','b3');
      SELECT dolt_checkout('main');
      UPDATE t SET v='m';
      SELECT dolt_commit('-am','m');
      BEGIN;
    }
    if {$op eq "commit"} {db eval {INSERT INTO t VALUES(2,'x')}}
    set sql [dict get {
      merge {SELECT dolt_merge('b3')}
      commit {SELECT dolt_commit('-Am','c2')}
      checkout {SELECT dolt_checkout('b3')}
    } $op]
    set ::vc_interrupt_ticks 0
    db progress 1 {expr {[incr ::vc_interrupt_ticks]==$tick}}
    catch {db eval $sql}
    set code [sqlite3_errcode db]
    db progress 0 {}
    if {$code eq "SQLITE_INTERRUPT"} {incr interrupted}
    do_catchsql_test vc-interrupt-begin-$op-$tick.savepoint {
      RELEASE doltlite_command
    } {1 {no such savepoint: doltlite_command}}
    catch {db eval ROLLBACK}
    if {$::vc_interrupt_ticks<$tick} break
  }
  do_test vc-interrupt-begin-$op.cancellable {expr {$interrupted>0}} 1
  do_test vc-interrupt-begin-$op.terminates {expr {$tick<=3000}} 1
}

finish_test
