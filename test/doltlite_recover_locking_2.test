  BEGIN;
    CREATE TABLE t7(a, b);
    INSERT INTO t7 VALUES(1, 2);
    SAVEPOINT one;
      INSERT INTO t7 VALUES(3, 4);
    ROLLBACK TO one;
    SELECT * FROM t7;
} {1 2}
do_execsql_test doltlite_recover_locking_2-16.2 {
