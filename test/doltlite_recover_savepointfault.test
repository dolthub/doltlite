set testdir [file dirname $argv0]
source $testdir/tester.tcl
source $testdir/malloc_common.tcl

set testprefix doltlite_recover_savepointfault


do_malloc_test 1 -sqlprep {
  CREATE TABLE t1(a, b, c);
  INSERT INTO t1 VALUES(1, 2, 3);
} -sqlbody {
  SAVEPOINT one;
    INSERT INTO t1 VALUES(4, 5, 6);
    SAVEPOINT two;
      DELETE FROM t1;
    ROLLBACK TO two;
  RELEASE one;
}

do_malloc_test 2 -sqlprep {
  PRAGMA cache_size = 10;
  CREATE TABLE t1(a, b, c);
  INSERT INTO t1 VALUES(randstr(400,400), randstr(400,400), randstr(400,400));
  INSERT INTO t1 SELECT
    randstr(400,400), randstr(400,400), randstr(400,400) FROM t1;
  INSERT INTO t1
    SELECT randstr(400,400), randstr(400,400), randstr(400,400) FROM t1;
  INSERT INTO t1
    SELECT randstr(400,400), randstr(400,400), randstr(400,400) FROM t1;
  INSERT INTO t1
    SELECT randstr(400,400), randstr(400,400), randstr(400,400) FROM t1;
  INSERT INTO t1
    SELECT randstr(400,400), randstr(400,400), randstr(400,400) FROM t1;
  INSERT INTO t1
    SELECT randstr(400,400), randstr(400,400), randstr(400,400) FROM t1;
  INSERT INTO t1
    SELECT randstr(400,400), randstr(400,400), randstr(400,400) FROM t1;
  INSERT INTO t1
    SELECT randstr(400,400), randstr(400,400), randstr(400,400) FROM t1;
} -sqlbody {
  PRAGMA cache_size = 10;
  SAVEPOINT one;
    DELETE FROM t1 WHERE rowid < 5;
    SAVEPOINT two;
      DELETE FROM t1 WHERE rowid > 10;
    ROLLBACK TO two;
  ROLLBACK TO one;
  RELEASE one;
}

do_ioerr_test 3 -sqlprep {
  CREATE TABLE t1(a, b, c);
  INSERT INTO t1 VALUES(1, randstr(1000,1000), randstr(1000,1000));
  INSERT INTO t1 VALUES(2, randstr(1000,1000), randstr(1000,1000));
} -sqlbody {
  BEGIN;
    UPDATE t1 SET a = 3 WHERE a = 1;
    SAVEPOINT one;
      UPDATE t1 SET a = 4 WHERE a = 2;
  COMMIT;
} -cleanup {
  db eval {
    SAVEPOINT one;
    RELEASE one;
  }
}

reset_db
do_execsql_test 4.0 {
  CREATE TABLE t1(a INTEGER PRIMARY KEY, b BLOB);
}
faultsim_save_and_close

do_faultsim_test 4.1 -faults oom-transient -prep {
  faultsim_restore_and_reopen
  db eval {
    BEGIN;
    INSERT INTO t1 VALUES(1, replace(hex(zeroblob(250)), '00', 'ab'));
    INSERT INTO t1 VALUES(2, zeroblob(500));
    SAVEPOINT sp1;
      DELETE FROM t1 WHERE a IN (1, 2);
      SAVEPOINT sp2;
        INSERT INTO t1 VALUES(1, X'01'), (2, X'02');
      ROLLBACK TO sp2;
      RELEASE sp2;
  }
  set ::rb_stmt [sqlite3_prepare_v2 db "ROLLBACK TO sp1" -1]
} -body {
  set rc [sqlite3_step $::rb_stmt]
  if {$rc ne "SQLITE_DONE"} {
    error "ROLLBACK TO sp1 failed: $rc ([sqlite3_errmsg db])"
  }
} -test {
  sqlite3_finalize $::rb_stmt
  faultsim_test_result {0 {}}
  set res [db eval {
    SELECT a, length(b), substr(b, 1, 4) FROM t1 WHERE a = 1
    UNION ALL
    SELECT a, length(b), hex(substr(b, 1, 2)) FROM t1 WHERE a = 2
    ORDER BY a
  }]
  if {$res ne {1 500 abab 2 500 0000}} {
    error "unexpected rows after ROLLBACK TO sp1: $res"
  }
  db eval {
    RELEASE sp1;
    COMMIT;
  }
  faultsim_integrity_check
}

do_faultsim_test 4.2 -faults oom-transient -prep {
  faultsim_restore_and_reopen
  db eval {
    BEGIN;
    INSERT INTO t1 VALUES(1, X'01'), (2, X'02'), (3, X'03');
    SAVEPOINT sp1;
      INSERT INTO t1 VALUES(4, X'04'), (5, X'05');
  }
  set ::rb_stmt [sqlite3_prepare_v2 db "ROLLBACK TO sp1" -1]
} -body {
  set rc [sqlite3_step $::rb_stmt]
  if {$rc ne "SQLITE_DONE"} {
    error "ROLLBACK TO sp1 failed: $rc ([sqlite3_errmsg db])"
  }
} -test {
  sqlite3_finalize $::rb_stmt
  faultsim_test_result {0 {}}
  set res [db eval { SELECT a, hex(b) FROM t1 ORDER BY a }]
  if {$res ne {1 01 2 02 3 03}} {
    error "unexpected rows after append-sorted ROLLBACK TO sp1: $res"
  }
  db eval {
    RELEASE sp1;
    COMMIT;
  }
  faultsim_integrity_check
}

do_faultsim_test 4.3 -faults oom-transient -prep {
  faultsim_restore_and_reopen
  db eval {
    BEGIN;
    INSERT INTO t1 VALUES(1, X'01'), (2, X'02');
    SAVEPOINT sp1;
      CREATE TABLE t_sp(id INTEGER PRIMARY KEY, v TEXT);
      INSERT INTO t_sp VALUES(1, 'a'), (2, 'b');
      INSERT INTO t1 VALUES(3, X'03'), (4, X'04');
  }
  set ::scan_stmt [sqlite3_prepare_v2 db "SELECT a, hex(b) FROM t1 ORDER BY a" -1]
  if {[sqlite3_step $::scan_stmt] ne "SQLITE_ROW"} {
    error "failed to position scan cursor"
  }
  set ::rb_stmt [sqlite3_prepare_v2 db "ROLLBACK TO sp1" -1]
} -body {
  set rc [sqlite3_step $::rb_stmt]
  if {$rc ne "SQLITE_DONE"} {
    error "ROLLBACK TO sp1 failed: $rc ([sqlite3_errmsg db])"
  }
} -test {
  sqlite3_finalize $::rb_stmt
  catch { sqlite3_step $::scan_stmt }
  sqlite3_finalize $::scan_stmt
  faultsim_test_result {0 {}} {1 {ROLLBACK TO sp1 failed: SQLITE_NOMEM (out of memory)}}
  catchsql ROLLBACK
  faultsim_integrity_check
}

finish_test
