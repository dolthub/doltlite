set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix checkout-txn

proc checkout_txn_reset {{storage file}} {
  reset_db
  if {$storage eq "memory"} {db close; sqlite3 db :memory:}
  db eval {
    CREATE TABLE t(id INT PRIMARY KEY,v TEXT);
    SELECT dolt_commit('-Am','base');
    SELECT dolt_branch('f');
  }
}

foreach storage {file memory} {
  foreach begin {BEGIN {BEGIN IMMEDIATE}} {
    foreach roundtrip {0 1} {
      checkout_txn_reset $storage
      set prefix $storage-$begin-$roundtrip
      set commits 0
      db commit_hook {incr ::commits; expr 0}
      db eval "$begin; INSERT INTO t VALUES(1,'main');"
      db eval {SELECT dolt_checkout('f'); INSERT INTO t VALUES(2,'f');}
      if {$roundtrip} {db eval {SELECT dolt_checkout('main')}}
      do_test $prefix.kept {
        list [sqlite3_get_autocommit db] $commits [db eval {SELECT id FROM t}]
      } [list 0 0 [expr {$roundtrip ? 1 : 2}]]
      if {$storage eq "file"} {
        foreach branch {main f} {
          sqlite3 peer test.db/$branch -readonly 1
          do_test $prefix.$branch.private {peer one {SELECT count(*) FROM t}} 0
          peer close
        }
      }
      do_execsql_test $prefix.rollback {
        ROLLBACK;
        SELECT count(*) FROM t;
        PRAGMA integrity_check;
      } {0 ok}
      db commit_hook {}
      do_execsql_test $prefix.branches {
        SELECT dolt_checkout('main'); SELECT count(*) FROM t;
        SELECT dolt_checkout('f'); SELECT count(*) FROM t;
      } {0 0 0 0}
      if {$storage eq "file"} {
        db close
        sqlite3 db test.db
        do_execsql_test $prefix.reopen {SELECT count(*) FROM t} 0
      }
    }
  }
}

checkout_txn_reset
do_execsql_test savepoint.before {
  BEGIN;
  INSERT INTO t VALUES(1,'before');
  SAVEPOINT s;
  INSERT INTO t VALUES(2,'after');
  SELECT dolt_checkout('f');
  INSERT INTO t VALUES(3,'target');
  ROLLBACK TO s;
  SELECT active_branch();
  SELECT id FROM t ORDER BY id;
  SELECT dolt_checkout('main');
  SELECT id FROM t ORDER BY id;
  ROLLBACK;
  SELECT count(*) FROM t;
  SELECT dolt_checkout('f');
  SELECT count(*) FROM t;
} {0 f 0 1 0 0 0}

# ROLLBACK TO puts every branch's working set back to the savepoint and
# leaves the session on its current branch; COMMIT then persists that.
proc checkout_txn_rows {branch} {
  sqlite3 observer [file normalize test.db]/$branch -readonly 1
  set r [observer eval {
    SELECT group_concat(id) FROM (SELECT id FROM t ORDER BY id);
    SELECT count(*) FROM dolt_status;
    PRAGMA integrity_check;
  }]
  observer close
  return $r
}
foreach {name setup sql main f} {
  savepoint-on-target {INSERT INTO t VALUES(10,'dirty')} {
    BEGIN;
    SELECT dolt_checkout('f');
    SAVEPOINT s;
    SELECT dolt_checkout('main');
    ROLLBACK TO s;
    COMMIT;
  } {10 1 ok} {{} 0 ok}
  savepoint-on-source {} {
    BEGIN;
    INSERT INTO t VALUES(1,'before');
    SAVEPOINT s;
    INSERT INTO t VALUES(2,'after');
    SELECT dolt_checkout('f');
    INSERT INTO t VALUES(3,'target');
    ROLLBACK TO s;
    COMMIT;
  } {1 1 ok} {{} 0 ok}
  round-trip {} {
    BEGIN;
    INSERT INTO t VALUES(1,'before');
    SAVEPOINT s;
    SELECT dolt_checkout('f');
    INSERT INTO t VALUES(2,'target');
    SELECT dolt_checkout('main');
    INSERT INTO t VALUES(3,'after');
    ROLLBACK TO s;
    COMMIT;
  } {1 1 ok} {{} 0 ok}
  nested {} {
    BEGIN;
    INSERT INTO t VALUES(1,'before');
    SAVEPOINT a;
    SELECT dolt_checkout('f');
    INSERT INTO t VALUES(2,'target');
    SAVEPOINT b;
    INSERT INTO t VALUES(3,'target');
    SELECT dolt_checkout('main');
    INSERT INTO t VALUES(4,'after');
    ROLLBACK TO b;
    RELEASE a;
    COMMIT;
  } {1 1 ok} {2 1 ok}
  rollback-twice {} {
    BEGIN;
    SAVEPOINT s;
    INSERT INTO t VALUES(1,'source');
    SELECT dolt_checkout('f');
    INSERT INTO t VALUES(2,'target');
    ROLLBACK TO s;
    INSERT INTO t VALUES(3,'target');
    SELECT dolt_checkout('main');
    INSERT INTO t VALUES(4,'source');
    ROLLBACK TO s;
    INSERT INTO t VALUES(5,'source');
    COMMIT;
  } {5 1 ok} {{} 0 ok}
} {
  checkout_txn_reset
  db eval $setup
  do_test savepoint.commit.$name.run {
    catchsql $sql
    sqlite3_get_autocommit db
  } 1
  db close
  do_test savepoint.commit.$name.main {checkout_txn_rows main} $main
  do_test savepoint.commit.$name.f {checkout_txn_rows f} $f
  sqlite3 db test.db
}

checkout_txn_reset
do_execsql_test savepoint.after {
  BEGIN;
  INSERT INTO t VALUES(1,'source');
  SELECT dolt_checkout('f');
  INSERT INTO t VALUES(2,'target');
  SAVEPOINT s;
  INSERT INTO t VALUES(3,'after');
  ROLLBACK TO s;
  SELECT id FROM t;
  RELEASE s;
  ROLLBACK;
  SELECT count(*) FROM t;
  SELECT dolt_checkout('main');
  SELECT count(*) FROM t;
} {0 2 0 0 0}

checkout_txn_reset
do_execsql_test dirty.setup {
  INSERT INTO t VALUES(10,'staged');
  SELECT dolt_add('t');
  INSERT INTO t VALUES(11,'working');
  SELECT dolt_checkout('f');
  INSERT INTO t VALUES(20,'staged');
  SELECT dolt_add('t');
  INSERT INTO t VALUES(21,'working');
  SELECT dolt_checkout('main');
} {0 0 0 0}
do_execsql_test dirty.rollback {
  BEGIN;
  INSERT INTO t VALUES(12,'transaction');
  SELECT dolt_checkout('f');
  INSERT INTO t VALUES(22,'transaction');
  SELECT dolt_checkout('main');
  INSERT INTO t VALUES(13,'transaction');
  ROLLBACK;
  SELECT id FROM t ORDER BY id;
  SELECT to_id FROM dolt_diff_t('HEAD','STAGED');
  SELECT dolt_checkout('f');
  SELECT id FROM t ORDER BY id;
  SELECT to_id FROM dolt_diff_t('HEAD','STAGED');
} {0 0 10 11 10 0 20 21 20}

checkout_txn_reset
do_execsql_test schema.rollback {
  BEGIN;
  CREATE TABLE transient(id INT PRIMARY KEY);
  CREATE INDEX t_v ON t(v);
  INSERT INTO t VALUES(1,'source');
  SELECT dolt_checkout('f');
  INSERT INTO t VALUES(2,'target');
  SELECT dolt_checkout('main');
  ROLLBACK;
  SELECT count(*) FROM t;
  SELECT count(*) FROM sqlite_schema WHERE name IN ('transient','t_v');
  INSERT INTO t VALUES(3,'after');
  PRAGMA integrity_check;
} {0 0 0 0 ok}
do_test schema.reopen {
  db close
  sqlite3 db test.db
  db eval {
    SELECT id,v FROM t;
    SELECT count(*) FROM sqlite_schema WHERE name IN ('transient','t_v');
    PRAGMA integrity_check;
  }
} {3 after 0 ok}

checkout_txn_reset
do_execsql_test commit.source {
  BEGIN;
  INSERT INTO t VALUES(1,'source');
  SELECT dolt_checkout('f');
  COMMIT;
  SELECT count(*) FROM t;
  SELECT dolt_checkout('main');
  SELECT id FROM t;
} {0 0 0 1}
do_execsql_test commit.next-rollback {
  BEGIN; INSERT INTO t VALUES(2,'next'); ROLLBACK;
  SELECT id FROM t;
} 1

checkout_txn_reset
do_execsql_test failure.setup {
  BEGIN; INSERT INTO t VALUES(1,'source');
  SELECT dolt_checkout('f');
  INSERT INTO t VALUES(2,'target');
} 0
do_catchsql_test failure.missing {SELECT dolt_checkout('missing')} \
  {1 {no such branch or table: missing}}
do_execsql_test failure.rollback {
  ROLLBACK;
  SELECT active_branch(),count(*) FROM t;
  SELECT dolt_checkout('main');
  SELECT count(*) FROM t;
} {f 0 0 0}

checkout_txn_reset
do_execsql_test create.seals {
  BEGIN;
  INSERT INTO t VALUES(1,'source');
  SELECT dolt_checkout('-b','new');
  INSERT INTO t VALUES(2,'target');
  ROLLBACK;
  SELECT active_branch(),count(*) FROM t;
  SELECT dolt_checkout('main');
  SELECT id FROM t;
} {0 new 0 0 1}

checkout_txn_reset
sqlite3 peer test.db/f
do_execsql_test lock.setup {
  BEGIN;
  INSERT INTO t VALUES(1,'source');
  SELECT dolt_checkout('f');
} 0
do_test lock.held {
  list [catch {peer eval {INSERT INTO t VALUES(2,'peer')}} msg] $msg
} {1 {database is locked}}
do_execsql_test lock.rollback {ROLLBACK; SELECT count(*) FROM t} 0
do_test lock.released {
  peer eval {INSERT INTO t VALUES(2,'peer'); SELECT id FROM t}
} 2
peer close

# A command that publishes refs without ending the transaction must not
# carry the working set of a branch the transaction checked out of. The
# command's own change is durable either way; the rows follow the
# transaction.
proc checkout_txn_branch {branch sql} {
  sqlite3 observer [file normalize test.db]/$branch -readonly 1
  set r [observer eval $sql]
  observer close
  return $r
}
foreach {name pre cmd probe durable} {
  tag {} {SELECT dolt_tag('tg')}
    {SELECT count(*) FROM dolt_tags WHERE tag_name='tg'} 1
  tag-delete {SELECT dolt_tag('tg')} {SELECT dolt_tag('-d','tg')}
    {SELECT count(*) FROM dolt_tags WHERE tag_name='tg'} 0
  remote {} {SELECT dolt_remote('add','origin','file:///nonexistent/remote')}
    {SELECT count(*) FROM dolt_remotes WHERE name='origin'} 1
} {
  foreach roundtrip {0 1} {
    foreach end {ROLLBACK COMMIT} {
      checkout_txn_reset
      db eval $pre
      set prefix ref-writer.$name.$roundtrip.$end
      do_test $prefix.run {
        db eval {
          BEGIN;
          INSERT INTO t VALUES(1,'main');
          SELECT dolt_checkout('f');
          INSERT INTO t VALUES(2,'f');
        }
        if {$roundtrip} {db eval {SELECT dolt_checkout('main')}}
        db eval $cmd
        db eval $end
        sqlite3_get_autocommit db
      } 1
      db close
      set rows {
        SELECT group_concat(id) FROM (SELECT id FROM t ORDER BY id);
        SELECT count(*) FROM dolt_status;
        PRAGMA integrity_check;
      }
      if {$end eq "ROLLBACK"} {
        do_test $prefix.main {checkout_txn_branch main $rows} {{} 0 ok}
        do_test $prefix.f {checkout_txn_branch f $rows} {{} 0 ok}
      } else {
        do_test $prefix.main {checkout_txn_branch main $rows} {1 1 ok}
        do_test $prefix.f {checkout_txn_branch f $rows} {2 1 ok}
      }
      do_test $prefix.durable {checkout_txn_branch main $probe} $durable
      sqlite3 db test.db
    }
  }
}

finish_test
