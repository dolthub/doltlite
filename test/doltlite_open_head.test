set testdir [file dirname $argv0]
source $testdir/tester.tcl

proc open_head_setup {} {
  reset_db
  execsql {
    CREATE TABLE t(id INTEGER PRIMARY KEY,v TEXT);
    INSERT INTO t VALUES(1,'base');
    SELECT dolt_commit('-Am','base');
    SELECT dolt_checkout('-b','feature/x');
    INSERT INTO t VALUES(3,'feature');
    SELECT dolt_commit('-am','feature');
    SELECT dolt_checkout('main');
    INSERT INTO t VALUES(2,'main');
    SELECT dolt_commit('-am','main');
  }
}

proc open_head_state {connection} {
  $connection eval {
    SELECT active_branch(),dolt_hashof('HEAD'),
           dolt_hashof_db('WORKING'),dolt_hashof_db('STAGED');
    SELECT id,v FROM t ORDER BY id;
    SELECT table_name,staged,status FROM dolt_status ORDER BY table_name,staged;
    SELECT name FROM dolt_branches ORDER BY name;
  }
}

foreach default {main feature/x} {
  foreach separator {/ @} {
    foreach revision {HEAD head} {
      foreach readonly {0 1} {
        open_head_setup
        set other [expr {$default eq "main" ? "feature/x" : "main"}]
        execsql "SELECT dolt_default_branch('$default'); SELECT dolt_checkout('$other')"
        set otherBefore [open_head_state db]
        execsql "SELECT dolt_checkout('$default')"
        execsql {
          INSERT INTO t VALUES(10,'staged');
          SELECT dolt_add('t');
          INSERT INTO t VALUES(20,'working');
        }
        set before [open_head_state db]
        set head [db one {SELECT dolt_hashof('HEAD')}]
        set path "[file normalize test.db]$separator$revision"
        set prefix open-head-$default-$separator-$revision-$readonly
        db close
        sqlite3 alias $path -readonly $readonly
        do_test $prefix-state {
          expr {$before eq [open_head_state alias]}
        } {1}
        if {$readonly} {
          do_test $prefix-readonly {
            list [catch {alias eval {CREATE TABLE z(id INTEGER PRIMARY KEY)}} message] $message
          } {1 {attempt to write a readonly database}}
          do_test $prefix-readonly-kept {
            expr {$before eq [open_head_state alias]}
          } {1}
        } else {
          do_test $prefix-write {
            alias eval {
              CREATE TABLE z(id INTEGER PRIMARY KEY);
              INSERT INTO z VALUES(1);
            }
            set commit [alias one {SELECT dolt_commit('-Am','alias commit')}]
            regexp {^[0-9a-f]{40}$} $commit
          } {1}
          do_test $prefix-parent {
            expr {$head eq [alias one {SELECT dolt_hashof('HEAD~1')}]}
          } {1}
        }
        alias close
        sqlite3 db test.db
        do_execsql_test $prefix-branch {
          SELECT active_branch();
          SELECT name FROM dolt_branches ORDER BY name;
          SELECT count(*) FROM dolt_branches WHERE name IN ('HEAD','head');
        } [list $default feature/x main 0]
        if {$readonly} {
          do_test $prefix-reopen {
            expr {$before eq [open_head_state db]}
          } {1}
        } else {
          do_execsql_test $prefix-reopen {
            SELECT count(*) FROM t;
            SELECT id FROM z;
            SELECT count(*) FROM dolt_status;
            SELECT message FROM dolt_log LIMIT 1;
          } {4 1 0 {alias commit}}
        }
        execsql "SELECT dolt_checkout('$other')"
        do_test $prefix-other-kept {
          expr {$otherBefore eq [open_head_state db]}
        } {1}
        do_execsql_test $prefix-integrity {PRAGMA integrity_check} {ok}
      }
    }
  }
}

open_head_setup
set mainBefore [open_head_state db]
db close
sqlite3 db "[file normalize test.db]/HEAD"
sqlite3 peer "[file normalize test.db]/feature/x"
peer eval {
  SELECT dolt_default_branch('feature/x');
  INSERT INTO t VALUES(30,'peer working');
}
do_test open-head-default-change-keeps-session {
  expr {$mainBefore eq [open_head_state db]}
} {1}
sqlite3 fresh "[file normalize test.db]@head"
do_test open-head-default-change-new-session {
  list [fresh one {SELECT active_branch()}] \
       [fresh eval {SELECT id FROM t ORDER BY id}]
} {feature/x {1 3 30}}
do_execsql_test open-head-peer-view-kept {
  INSERT INTO t VALUES(40,'main working');
  SELECT active_branch();
  SELECT id FROM t ORDER BY id;
} {main 1 2 40}
do_test open-head-peer-kept {
  peer eval {SELECT id FROM t ORDER BY id}
} {1 3 30}
fresh close
peer close

open_head_setup
db close
foreach separator {/ @} {
  foreach revision {HEAD head} {
    foreach {suffix expected} {~0 {1 2} ~1 1} {
      set path "[file normalize test.db]$separator$revision$suffix"
      sqlite3 db $path
      set prefix open-head-parent-$separator-$revision-$suffix
      do_execsql_test $prefix-state {
        SELECT active_branch() IS NULL;
        SELECT id FROM t ORDER BY id;
      } [concat 1 $expected]
      do_catchsql_test $prefix-readonly {
        INSERT INTO t VALUES(99,'blocked');
      } {1 {attempt to write a readonly database}}
      do_execsql_test $prefix-integrity {PRAGMA integrity_check} {ok}
      db close
    }
  }
}
sqlite3 db test.db
do_execsql_test open-head-mixed-case-branch {
  SELECT dolt_checkout('-b','HeAd');
  INSERT INTO t VALUES(50,'named branch');
  SELECT dolt_commit('-am','mixed case') IS NOT NULL;
} {0 1}
db close
sqlite3 db "[file normalize test.db]/HeAd"
do_execsql_test open-head-mixed-case-open {
  SELECT active_branch();
  SELECT id FROM t ORDER BY id;
} {HeAd 1 2 50}
finish_test
