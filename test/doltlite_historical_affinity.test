set testdir [file dirname $argv0]
source $testdir/tester.tcl

do_execsql_test doltlite_historical_affinity-setup {
  CREATE TABLE t(
    id INTEGER PRIMARY KEY, n INT, r REAL, q DECIMAL(10,2), s TEXT,
    g INT AS (n+1) STORED, v TEXT COLLATE NOCASE,
    padded TEXT COLLATE RTRIM, raw BLOB, untyped
  );
  INSERT INTO t(id,n,r,q,s,v,padded,raw,untyped) VALUES
    (1,42,1.5,7.25,42,'abc','tail  ',42,42),
    (2,7,2,5,7,'B','tail','42','42'),
    (3,42,3,7.25,42,'ABC','other',x'3432',x'3432'),
    (4,99,4,8,99,'Z','other ',NULL,NULL);
  SELECT length(dolt_commit('-Am','base'));
  SELECT dolt_tag('base');
  SELECT count(*) FROM t WHERE n='42';
  SELECT count(*) FROM t WHERE v='ABC';
} {40 0 2 2}

set queries {
  integer {SELECT id FROM @ WHERE n='42' ORDER BY id}
  real {SELECT id FROM @ WHERE r='2.0' ORDER BY id}
  numeric {SELECT id FROM @ WHERE q='7.25' ORDER BY id}
  text {SELECT id FROM @ WHERE s=42 ORDER BY id}
  nocase {SELECT id FROM @ WHERE v='ABC' ORDER BY id}
  rtrim {SELECT id FROM @ WHERE padded='tail' ORDER BY id}
  blob {SELECT id FROM @ WHERE raw='42' ORDER BY id}
  untyped {SELECT id FROM @ WHERE untyped=42 ORDER BY id}
  null {SELECT id FROM @ WHERE raw IS NULL ORDER BY id}
  types {SELECT typeof(n),typeof(r),typeof(q),typeof(s),typeof(raw)
           FROM @ ORDER BY id}
  range {SELECT id FROM @ WHERE n BETWEEN '40' AND '50' ORDER BY id}
  in {SELECT id FROM @ WHERE n IN ('42','7') ORDER BY id}
  join {WITH rhs(a,b) AS (VALUES('42','ABC'))
        SELECT h.id FROM @ h JOIN rhs ON h.n=rhs.a AND h.v=rhs.b
         ORDER BY h.id}
  sort {SELECT id FROM @ ORDER BY v,id}
  group {SELECT min(id),count(*) FROM @ GROUP BY v ORDER BY min(id)}
  distinct {SELECT count(DISTINCT v),count(DISTINCT padded) FROM @}
  explicit_collation {SELECT id FROM @ WHERE v COLLATE BINARY='ABC'}
}
foreach {name sql} $queries {
  set expected($name) [db eval [string map [list @ t] $sql]]
}
foreach phase {live reopen dropped} {
  if {$phase ne "live"} {
    if {$phase eq "dropped"} {
      db eval {DROP TABLE t; SELECT dolt_commit('-Am','drop')}
    }
    db close
    sqlite3 db test.db
  }
  foreach {surface source} {
    snapshot dolt_at_t('base')
    history dolt_history_t('base')
  } {
    foreach {name sql} $queries {
      do_execsql_test doltlite_historical_affinity-$phase-$surface-$name \
          [string map [list @ $source] $sql] $expected($name)
    }
  }
}

reset_db
do_execsql_test doltlite_historical_affinity-strict-setup {
  CREATE TABLE t(id INTEGER PRIMARY KEY, a ANY) STRICT;
  INSERT INTO t VALUES(1,'42'),(2,42);
  SELECT length(dolt_commit('-Am','strict'));
} {40}
foreach source {t dolt_at_t('HEAD') dolt_history_t} {
  do_execsql_test doltlite_historical_affinity-strict-$source "
    SELECT id,typeof(a) FROM $source WHERE a='42' ORDER BY id;
    SELECT id,typeof(a) FROM $source WHERE a=42 ORDER BY id;
  " {1 text 2 integer}
}

reset_db
do_execsql_test doltlite_historical_affinity-collision-setup {
  CREATE TABLE t(id INT PRIMARY KEY, commit_hash TEXT COLLATE NOCASE);
  INSERT INTO t VALUES(1,'abc');
  SELECT length(dolt_commit('-Am','collision'));
} {40}
do_execsql_test doltlite_historical_affinity-collision {
  SELECT id FROM dolt_history_t WHERE commit_hash_1='ABC';
} {1}

reset_db
proc historical_nocase {a b} { string compare -nocase $a $b }
db collate {fold"case} historical_nocase
do_execsql_test doltlite_historical_affinity-custom-setup {
  CREATE TABLE t(id INTEGER PRIMARY KEY, v TEXT COLLATE "fold""case");
  INSERT INTO t VALUES(1,'abc');
  SELECT length(dolt_commit('-Am','custom collation'));
} {40}
foreach source {t dolt_at_t('HEAD') dolt_history_t} {
  do_execsql_test doltlite_historical_affinity-custom-$source \
      "SELECT id FROM $source WHERE v='ABC'" {1}
}

do_execsql_test doltlite_historical_affinity-custom-drop {
  SELECT dolt_tag('custom');
  DROP TABLE t;
  SELECT length(dolt_commit('-Am','drop custom collation table'));
} {0 40}
db close
sqlite3 db test.db
foreach source {dolt_at_t('custom') dolt_history_t('custom')} {
  do_test doltlite_historical_affinity-custom-missing-$source {
    lindex [catchsql "SELECT id FROM $source WHERE v='ABC'"] 0
  } {1}
}
db collate {fold"case} historical_nocase
foreach source {dolt_at_t('custom') dolt_history_t('custom')} {
  do_execsql_test doltlite_historical_affinity-custom-dropped-$source \
      "SELECT id FROM $source WHERE v='ABC'" {1}
}

reset_db
set historical_collation_deletes 0
sqlite3_create_collation_v2 db owned historical_nocase \
    {incr ::historical_collation_deletes}
do_execsql_test doltlite_historical_affinity-owned-setup {
  CREATE TABLE t(id INTEGER PRIMARY KEY, v TEXT COLLATE owned);
  INSERT INTO t VALUES(1,'abc');
  SELECT length(dolt_commit('-Am','owned collation'));
  SELECT dolt_tag('owned');
  ALTER TABLE t ADD COLUMN n INT;
  SELECT id FROM dolt_at_t('owned') WHERE v='ABC';
} {40 0 1}
do_test doltlite_historical_affinity-owned-borrowed {
  set historical_collation_deletes
} {0}
db close
do_test doltlite_historical_affinity-owned-close {
  set historical_collation_deletes
} {1}
sqlite3 db test.db

reset_db
foreach {name definition value predicates} {
  int {k INT PRIMARY KEY} {42} {
    text {k='42'} real {k=42.0} exponent {k='4.2e1'}
    invalid {k='42x'} blob {k=x'3432'} null {k=NULL}
  }
  text {k TEXT PRIMARY KEY} {'42'} {
    integer {k=42} text {k='42'} real {k=42.0}
    invalid {k='42x'} blob {k=x'3432'} null {k=NULL}
  }
  real {k REAL PRIMARY KEY} {42.5} {
    text {k='42.5'} real {k=42.5} exponent {k='4.25e1'}
    invalid {k='42.5x'} blob {k=x'34322e35'} null {k=NULL}
  }
  numeric {k NUMERIC PRIMARY KEY} {42.5} {
    text {k='42.5'} real {k=42.5} exponent {k='4.25e1'}
    invalid {k='42.5x'} blob {k=x'34322e35'} null {k=NULL}
  }
  blob {k BLOB PRIMARY KEY} {42} {
    text {k='42'} integer {k=42} real {k=42.0}
    invalid {k='42x'} blob {k=x'3432'} null {k=NULL}
  }
  composite {a INT, b TEXT, k REAL, PRIMARY KEY(b DESC,a,k)} {42,'7',1.5} {
    mixed {a='42' AND b=7 AND k='1.5'}
    exponent {a='4.2e1' AND b=7 AND k='15e-1'}
    exact {a=42 AND b='7' AND k=1.5}
    invalid {a='42x' AND b=7 AND k='1.5'}
    blob {a=x'3432' AND b=7 AND k='1.5'}
    null {a=NULL AND b=7 AND k='1.5'}
  }
} {
  reset_db
  do_execsql_test doltlite_historical_affinity-pk-$name-setup "
    CREATE TABLE t($definition);
    INSERT INTO t VALUES($value);
    SELECT length(dolt_commit('-Am','pk affinity'));
    SELECT dolt_tag('pk');
  " {40 0}
  foreach {predicate where} $predicates {
    set expected($predicate) [db onecolumn "SELECT count(*) FROM t WHERE $where"]
  }
  foreach phase {live reopen dropped} {
    if {$phase ne "live"} {
      if {$phase eq "dropped"} {
        db eval {DROP TABLE t; SELECT dolt_commit('-Am','drop pk table')}
      }
      db close
      sqlite3 db test.db
    }
    foreach {surface source} {
      snapshot dolt_at_t('pk')
      history dolt_history_t('pk')
    } {
      foreach {predicate where} $predicates {
        do_execsql_test doltlite_historical_affinity-pk-$name-$phase-$surface-$predicate "
          SELECT count(*) FROM $source WHERE $where;
          SELECT count(*) FROM (SELECT * FROM $source LIMIT -1) WHERE $where;
        " [list $expected($predicate) $expected($predicate)]
      }
      if {$name eq "composite"} {
        set sql "SELECT count(*),typeof(?1),typeof(?2),typeof(?3)
                   FROM $source WHERE a=?1 AND b=?2 AND k=?3"
        set types {text int text}
        set values {42 7 1.5}
        set result {1 text integer text}
      } else {
        set sql "SELECT count(*),typeof(?1) FROM $source WHERE k=?1"
        set types [expr {$name eq "text" ? "int" : "text"}]
        set values [expr {$name in {real numeric} ? "42.5" : "42"}]
        set result [list [expr {$name eq "blob" ? 0 : 1}] \
                        [expr {$name eq "text" ? "integer" : "text"}]]
      }
      do_test doltlite_historical_affinity-pk-$name-$phase-$surface-bound {
        set stmt [sqlite3_prepare_v2 db $sql -1 tail]
        set i 0
        foreach type $types val $values {
          incr i
          if {$type eq "int"} {
            sqlite3_bind_int $stmt $i $val
          } else {
            sqlite3_bind_text $stmt $i $val -1
          }
        }
        set step [sqlite3_step $stmt]
        set row {}
        for {set i 0} {$i < [sqlite3_column_count $stmt]} {incr i} {
          lappend row [sqlite3_column_text $stmt $i]
        }
        sqlite3_finalize $stmt
        list $step $row
      } [list SQLITE_ROW $result]
    }
  }
}

finish_test
