set testdir [file dirname $argv0]
source $testdir/tester.tcl

foreach {layout key} {rowid {INTEGER PRIMARY KEY} clustered {INT PRIMARY KEY}} {
  foreach conflict {add drop} {
    foreach indexes {unchanged dropped redefined added unique partial expression} {
      foreach direction {forward reverse} {
        reset_db
        execsql "CREATE TABLE t(id $key,a INT,b INT)"
        if {$indexes eq "unique"} {
          execsql {CREATE UNIQUE INDEX ia ON t(a)}
        } else {
          execsql {CREATE INDEX ia ON t(a)}
        }
        execsql {
          CREATE TABLE u(id INTEGER PRIMARY KEY);
          INSERT INTO t VALUES(1,11,101),(2,22,202),(3,33,303);
          SELECT dolt_commit('-Am','base');
          SELECT dolt_branch('feature');
        }
        if {$conflict eq "add"} {
          execsql {ALTER TABLE t ADD COLUMN w TEXT DEFAULT 'ours'}
        } else {
          execsql {ALTER TABLE t RENAME COLUMN b TO c}
        }
        execsql {
          UPDATE t SET a=44 WHERE id=3;
          SELECT dolt_commit('-Am','ours');
          SELECT dolt_checkout('feature');
          UPDATE t SET a=83 WHERE id=2;
          DELETE FROM t WHERE id=3;
          INSERT INTO t VALUES(4,55,404);
          INSERT INTO u VALUES(1);
        }
        if {$conflict eq "add"} {
          execsql {ALTER TABLE t ADD COLUMN w INT DEFAULT 0}
        } else {
          execsql {ALTER TABLE t DROP COLUMN b}
        }
        switch $indexes {
          dropped {execsql {DROP INDEX ia}}
          redefined {execsql {DROP INDEX ia; CREATE INDEX ia ON t(a DESC)}}
          added {execsql {CREATE INDEX ix ON t(a,id)}}
          partial {execsql {CREATE INDEX ix ON t(a) WHERE a>20}}
          expression {execsql {CREATE INDEX ix ON t(a+1)}}
        }
        execsql {SELECT dolt_commit('-Am','theirs')}
        set target feature
        if {$direction eq "forward"} {
          execsql {SELECT dolt_checkout('main')}
        } else {
          set target main
        }
        set state {
          SELECT * FROM t ORDER BY id;
          SELECT id,a FROM t INDEXED BY ia ORDER BY a,id;
          SELECT type,name,tbl_name,sql FROM sqlite_schema WHERE tbl_name='t'
            ORDER BY type,name;
          PRAGMA integrity_check;
        }
        if {$direction eq "reverse" && $indexes eq "dropped"} {
          set state [string map {{INDEXED BY ia} {NOT INDEXED}} $state]
        }
        set branch [execsql {SELECT active_branch()}]
        set before [execsql $state]
        set head [execsql {SELECT dolt_hashof('HEAD')}]
        set prefix schema-index-$layout-$conflict-$indexes-$direction
        execsql BEGIN
        do_test $prefix-conflict {
          set result [catchsql "SELECT dolt_merge('$target')"]
          list [lindex $result 0] [string match {*conflict*} [lindex $result 1]]
        } {1 1}
        do_execsql_test $prefix-recorded {
          SELECT table_name FROM dolt_schema_conflicts;
          SELECT is_merging FROM dolt_merge_status;
        } {t 1}
        do_test $prefix-consistent {execsql $state} $before
        do_execsql_test $prefix-other-table {SELECT id FROM u} {1}
        do_test $prefix-write {
          catchsql {
            SAVEPOINT edit;
            UPDATE t SET a=a+100 WHERE id=1;
            INSERT INTO t(id,a) VALUES(5,66);
            DELETE FROM t WHERE id=2;
          }
        } {0 {}}
        do_execsql_test $prefix-write-integrity {PRAGMA integrity_check} {ok}
        execsql {ROLLBACK TO edit; RELEASE edit}
        if {$direction eq "forward"} {
          do_execsql_test $prefix-abort-merge {SELECT dolt_merge('--abort')} {0}
          execsql ROLLBACK
        } else {
          do_test $prefix-commit-refused {lindex [catchsql COMMIT] 0} 1
          catchsql ROLLBACK
        }
        do_test $prefix-abort {execsql $state} $before
        do_test $prefix-head {execsql {SELECT dolt_hashof('HEAD')}} $head
        db close
        sqlite3 db test.db/$branch
        do_test $prefix-reopen {execsql $state} $before
        do_execsql_test $prefix-cleared {
          SELECT count(*) FROM dolt_schema_conflicts;
          SELECT is_merging FROM dolt_merge_status;
        } {0 0}
      }
    }
  }
}
foreach {layout key} {rowid {INTEGER PRIMARY KEY} clustered {INT PRIMARY KEY}} {
  reset_db
  execsql "CREATE TABLE t(id $key,a INT,b INT,c TEXT)"
  execsql {
    CREATE INDEX ia ON t(a);
    INSERT INTO t VALUES(1,11,101,'original');
    SELECT dolt_commit('-Am','base');
    SELECT dolt_branch('feature');
    DROP INDEX ia;
    CREATE INDEX ia ON t(a DESC);
    UPDATE t SET c='ours';
    SELECT dolt_commit('-Am','ours');
    SELECT dolt_checkout('feature');
    ALTER TABLE t DROP COLUMN b;
    DROP INDEX ia;
    CREATE INDEX ia ON t(c);
    UPDATE t SET c='theirs';
    SELECT dolt_commit('-Am','theirs');
    SELECT dolt_checkout('main');
    BEGIN;
  }
  set prefix index-schema-layout-$layout
  do_test $prefix-conflict {
    set result [catchsql {SELECT dolt_merge('feature')}]
    list [lindex $result 0] [string match {*conflict*} [lindex $result 1]]
  } {1 1}
  do_execsql_test $prefix-schema {
    SELECT name FROM pragma_table_info('t') ORDER BY cid;
    SELECT sql FROM sqlite_schema WHERE name='ia';
  } {id a b c {CREATE INDEX ia ON t(a DESC)}}
  do_execsql_test $prefix-rows {
    SELECT * FROM t;
    SELECT id,a,b,c FROM t INDEXED BY ia WHERE a>0;
    PRAGMA integrity_check;
  } {1 11 101 ours 1 11 101 ours ok}
  do_execsql_test $prefix-write {
    UPDATE t SET a=12,c='resolved' WHERE id=1;
    SELECT * FROM t;
    PRAGMA integrity_check;
  } {1 12 101 resolved ok}
  execsql {SELECT dolt_merge('--abort'); ROLLBACK}
  do_execsql_test $prefix-abort {
    SELECT * FROM t;
    PRAGMA integrity_check;
  } {1 11 101 ours ok}
}
foreach {layout key} {rowid {INTEGER PRIMARY KEY} clustered {INT PRIMARY KEY}} {
  foreach direction {forward reverse} {
    foreach unique {{} UNIQUE} {
      foreach {pair ours theirs conflict} {
        suffix {b,a} {a} 0
        prefix {a,b} {a} 0
        shared {b,a} {id,b} 0
        shared_pk {b,id} {a,id} 0
        reversed {b,a} {a,b} 0
        disjoint {a} {b} 0
        quoted {"B",[a]} {`a`} 0
        partial {b,a) WHERE c>0} {a) WHERE c>0} 0
        expression {a+b,c} {c} 0
        identical {b,a} {b,a} 1
        identical_single {a} {a} 1
        identical_quoted {"B",[a]} {b,a} 1
        identical_sorted {b DESC,a ASC} {b,a} 1
        identical_partial {a) WHERE b>0} {a) WHERE c>0} 1
      } {
        reset_db
        execsql "CREATE TABLE t(id $key,a INT,b INT,c INT)"
        execsql {
          INSERT INTO t VALUES(1,11,101,1001);
          SELECT dolt_commit('-Am','base');
          SELECT dolt_branch('side');
        }
        foreach side {main side} terms [list $ours $theirs] index {ixa ixb} id {2 3} {
          execsql "SELECT dolt_checkout('$side')"
          set sql "CREATE $unique INDEX $index ON t($terms"
          if {![string match {* WHERE *} $terms]} {append sql ")"}
          execsql $sql
          execsql "INSERT INTO t VALUES($id,$id*11,$id*101,$id*1001)"
          execsql "SELECT dolt_commit('-Am','$side')"
        }
        set branch main
        set target side
        if {$direction eq "reverse"} {set branch side; set target main}
        execsql "SELECT dolt_checkout('$branch')"
        set name dual-index-$layout-$direction-$unique-$pair
        if {$conflict} {
          set before [execsql {SELECT id,a,b,c FROM t ORDER BY id}]
          execsql BEGIN
          do_test $name-conflict {
            set result [catchsql "SELECT dolt_merge('$target')"]
            list [lindex $result 0] [string match {*conflict*} [lindex $result 1]]
          } {1 1}
          do_execsql_test $name-recorded {
            SELECT table_name FROM dolt_schema_conflicts;
            PRAGMA integrity_check;
          } {t ok}
          execsql ROLLBACK
          do_test $name-rollback {execsql {SELECT id,a,b,c FROM t ORDER BY id}} $before
          continue
        }
        do_test $name-merge {string length [execsql "SELECT dolt_merge('$target')"]} 40
        set indexes {ixa ixb}
        if {$layout eq "clustered"} {lappend indexes sqlite_autoindex_t_1}
        do_execsql_test $name-schema {
          SELECT name FROM sqlite_schema WHERE type='index' ORDER BY name;
          SELECT count(*) FROM dolt_schema_conflicts;
          SELECT count(*) FROM dolt_status;
        } [concat $indexes {0 0}]
        foreach state {merged reopened written} {
          if {$state eq "reopened"} {
            db close
            sqlite3 db test.db/$branch
          }
          set expected {1 2 3}
          if {$state eq "written"} {
            execsql {
              INSERT INTO t VALUES(4,44,404,4004);
              DELETE FROM t WHERE id=2;
              UPDATE t SET a=55,b=505,c=5005 WHERE id=3;
              SELECT dolt_commit('-am','edit merged indexes');
            }
            set expected {1 3 4}
          }
          foreach index {ixa ixb} {
            do_execsql_test $name-$state-$index "
              SELECT id FROM t INDEXED BY $index WHERE c>0 AND b>0 ORDER BY id;
            " $expected
          }
          do_execsql_test $name-$state-integrity {PRAGMA integrity_check} {ok}
        }
      }
    }
  }
}

foreach {layout key} {rowid {INTEGER PRIMARY KEY} clustered {INT PRIMARY KEY}} {
  foreach direction {forward reverse} {
    reset_db
    execsql "CREATE TABLE t(id $key,a INT,b INT)"
    execsql {
      SELECT dolt_commit('-Am','base');
      SELECT dolt_branch('side');
      CREATE UNIQUE INDEX ixa ON t(b,a);
      INSERT INTO t VALUES(1,7,10);
      SELECT dolt_commit('-Am','main unique index');
      SELECT dolt_checkout('side');
      CREATE UNIQUE INDEX ixb ON t(a);
      INSERT INTO t VALUES(2,7,20);
      SELECT dolt_commit('-Am','side unique index');
    }
    set branch main
    set target side
    if {$direction eq "reverse"} {set branch side; set target main}
    execsql "SELECT dolt_checkout('$branch'); BEGIN"
    set name dual-index-violation-$layout-$direction
    do_catchsql_test $name-merge "SELECT dolt_merge('$target')" \
      {1 {Merge resulted in constraint violations. Resolve the rows in dolt_constraint_violations and then commit with dolt_commit.}}
    do_execsql_test $name-recorded {
      SELECT count(*) FROM dolt_schema_conflicts;
      SELECT violation_type,id,a,b FROM dolt_constraint_violations_t ORDER BY id;
      SELECT id FROM t INDEXED BY ixa WHERE a=7 ORDER BY id;
      SELECT id FROM t INDEXED BY ixb WHERE a=7 ORDER BY id;
    } {0 {unique index} 1 7 10 {unique index} 2 7 20 1 2 1 2}
    do_test $name-resolve {
      execsql {
        DELETE FROM t WHERE id=2;
        DELETE FROM dolt_constraint_violations_t;
      }
      string length [execsql {SELECT dolt_commit('-Am','resolve unique violation')}]
    } 40
    db close
    sqlite3 db test.db/$branch
    do_execsql_test $name-reopen {
      SELECT id,a,b FROM t INDEXED BY ixa;
      SELECT id,a,b FROM t INDEXED BY ixb;
      SELECT count(*) FROM dolt_constraint_violations;
      PRAGMA integrity_check;
    } {1 7 10 1 7 10 0 ok}
  }
}

finish_test
