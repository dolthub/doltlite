set testdir [file dirname $argv0]
source $testdir/tester.tcl

foreach layout {table column multiple duplicate several} {
  foreach predicate {{v > 5} {v > -5}} {
    foreach direction {forward reverse} {
      foreach txn {autocommit explicit} {
        reset_db
        switch $layout {
          table {
            set ancestor {id INTEGER PRIMARY KEY, v INT, CHECK(v > 0)}
            set edited "id INTEGER PRIMARY KEY, v INT, CHECK($predicate)"
          }
          column {
            set ancestor {id INTEGER PRIMARY KEY, v INT CHECK(v > 0)}
            set edited "id INTEGER PRIMARY KEY, v INT CHECK($predicate)"
          }
          multiple {
            set ancestor {id INTEGER PRIMARY KEY, v INT, CHECK(v > 0),
                          CHECK(id > 0), CONSTRAINT kept CHECK(id < 100)}
            set edited "id INTEGER PRIMARY KEY, v INT, CHECK(id > 0),
                        CHECK($predicate), CONSTRAINT kept CHECK(id < 100)"
          }
          duplicate {
            set ancestor {id INTEGER PRIMARY KEY, v INT,
                          CONSTRAINT kept CHECK(v > 0), CHECK(v > 0)}
            set edited "id INTEGER PRIMARY KEY, v INT,
                        CONSTRAINT kept CHECK(v > 0), CHECK($predicate)"
          }
          several {
            set ancestor {id INTEGER PRIMARY KEY, v INT,
                          CHECK(v > 0), CHECK(id > 0),
                          CONSTRAINT kept CHECK(id < 100)}
            set edited "id INTEGER PRIMARY KEY, v INT,
                        CHECK($predicate), CHECK(id >= 0),
                        CONSTRAINT kept CHECK(id < 100)"
          }
        }
        execsql "CREATE TABLE t($ancestor)"
        execsql {
          INSERT INTO t VALUES(1,10);
          SELECT dolt_commit('-Am','base');
          SELECT dolt_branch('side');
          SELECT dolt_checkout('side');
          DROP TABLE t;
        }
        execsql "CREATE TABLE t($edited)"
        execsql {
          INSERT INTO t VALUES(1,11);
          SELECT dolt_commit('-Am','edit check');
          SELECT dolt_checkout('main');
          ALTER TABLE t ADD COLUMN extra INT DEFAULT 3;
          SELECT dolt_commit('-Am','add column');
        }
        if {$direction eq "forward"} {
          set target side
          set connection test.db
        } else {
          execsql {SELECT dolt_checkout('side')}
          set target main
          set connection test.db/side
        }
        if {$predicate eq "v > 5"} {
          set change tighten
        } else {
          set change loosen
        }
        set name unnamed-check-$layout-$change-$direction-$txn
        if {$txn eq "explicit"} {execsql {BEGIN}}
        do_test $name-merge {
          set result [catchsql "SELECT dolt_merge('$target')"]
          if {[lindex $result 0] == 0} {set result {0 merged}}
          set result
        } {0 merged}
        do_execsql_test $name-conflicts {
          SELECT count(*) FROM dolt_schema_conflicts;
          SELECT count(*) FROM dolt_conflicts;
        } {0 0}
        do_execsql_test $name-rows {
          SELECT id,v,extra FROM t;
        } {1 11 3}
        if {$layout eq "duplicate"} {
          do_execsql_test $name-named {
            SELECT count(*) FROM sqlite_master
             WHERE name='t' AND sql LIKE '%CONSTRAINT kept CHECK(v > 0)%';
          } {1}
        } else {
          do_execsql_test $name-old {
            SELECT count(*) FROM sqlite_master
             WHERE name='t' AND sql LIKE '%v > 0%';
          } {0}
        }
        do_test $name-edited {
          execsql "SELECT count(*) FROM sqlite_master
                    WHERE name='t' AND sql LIKE '%$predicate%'"
        } {1}
        if {$layout eq "multiple"} {
          do_execsql_test $name-retained {
            SELECT count(*) FROM sqlite_master
             WHERE name='t' AND sql LIKE '%CHECK(id > 0)%'
               AND sql LIKE '%kept CHECK(id < 100)%';
          } {1}
        }
        if {$layout eq "several"} {
          do_execsql_test $name-retained {
            SELECT count(*) FROM sqlite_master
             WHERE name='t' AND sql LIKE '%CHECK(id >= 0)%'
               AND sql LIKE '%kept CHECK(id < 100)%';
          } {1}
        }
        if {$predicate eq "v > 5"} {
          set valid 6
          set invalid 5
        } else {
          set valid -1
          set invalid -6
          if {$layout eq "duplicate"} {
            set valid 1
            set invalid -1
          }
        }
        do_test $name-enforcement {
          set result [catchsql "INSERT INTO t(id,v) VALUES(2,$invalid)"]
          list [lindex $result 0] \
               [string match {*CHECK constraint failed*} [lindex $result 1]]
        } {1 1}
        do_execsql_test $name-valid "INSERT INTO t(id,v) VALUES(2,$valid)" {}
        execsql {SELECT dolt_commit('-Am','merged rows')}
        db close
        sqlite3 db $connection
        if {$direction eq "forward"} {
          set branch main
        } else {
          set branch side
        }
        do_execsql_test $name-reopen-branch {SELECT active_branch()} $branch
        do_test $name-reopen-schema {
          execsql "SELECT count(*) FROM sqlite_master
                    WHERE name='t' AND sql LIKE '%$predicate%'"
        } {1}
        do_test $name-reopen-enforcement {
          set result [catchsql "INSERT INTO t(id,v) VALUES(3,$invalid)"]
          list [lindex $result 0] \
               [string match {*CHECK constraint failed*} [lindex $result 1]]
        } {1 1}
        do_execsql_test $name-reopen "SELECT v,extra FROM t WHERE id=2" [list $valid 3]
        execsql "SELECT dolt_checkout('$target')"
        if {$direction eq "forward"} {
          execsql {SELECT dolt_checkout('main')}
        } else {
          execsql {SELECT dolt_checkout('side')}
        }
        do_execsql_test $name-checkout "SELECT v,extra FROM t WHERE id=2" [list $valid 3]
        do_test $name-checkout-enforcement {
          set result [catchsql "INSERT INTO t(id,v) VALUES(3,$invalid)"]
          list [lindex $result 0] \
               [string match {*CHECK constraint failed*} [lindex $result 1]]
        } {1 1}
        do_execsql_test $name-integrity {PRAGMA integrity_check} {ok}
      }
    }
  }
}

# Dropping a column-level CHECK when another column follows, or dropping a
# table-level CHECK that is followed by another constraint, must leave valid
# comma separation in CREATE TABLE.
foreach {case_name anc_ddl drop_ddl other_sql check_sql expected_rows} {
  col-mid-add-col
    {CREATE TABLE t(id INTEGER PRIMARY KEY, v INT CHECK(v > 0), w INT)}
    {CREATE TABLE t(id INTEGER PRIMARY KEY, v INT, w INT)}
    {ALTER TABLE t ADD COLUMN extra INT DEFAULT 9}
    {SELECT id, v, w, extra FROM t ORDER BY id}
    {1 10 20 9}
  col-mid-row-edit
    {CREATE TABLE t(id INTEGER PRIMARY KEY, v INT CHECK(v > 0), w INT)}
    {CREATE TABLE t(id INTEGER PRIMARY KEY, v INT, w INT)}
    {UPDATE t SET w = 25 WHERE id = 1}
    {SELECT id, v, w FROM t ORDER BY id}
    {1 10 25}
  tbl-first-check
    {CREATE TABLE t(id INTEGER PRIMARY KEY, v INT, w INT, CHECK(v > 0), CHECK(w > 0))}
    {CREATE TABLE t(id INTEGER PRIMARY KEY, v INT, w INT, CHECK(w > 0))}
    {ALTER TABLE t ADD COLUMN extra INT DEFAULT 9}
    {SELECT id, v, w, extra FROM t ORDER BY id}
    {1 10 20 9}
} {
  foreach direction {forward reverse} {
    reset_db
    execsql $anc_ddl
    execsql {
      INSERT INTO t VALUES(1, 10, 20);
      SELECT dolt_commit('-Am', 'base');
      SELECT dolt_branch('side');
      SELECT dolt_checkout('side');
      DROP TABLE t;
    }
    execsql $drop_ddl
    execsql {
      INSERT INTO t VALUES(1, 10, 20);
      SELECT dolt_commit('-Am', 'drop check');
      SELECT dolt_checkout('main');
    }
    execsql $other_sql
    execsql {SELECT dolt_commit('-Am', 'main change')}
    if {$direction eq "forward"} {
      set target side
      set connection test.db
    } else {
      execsql {SELECT dolt_checkout('side')}
      set target main
      set connection test.db/side
    }
    set tag cut-check-$case_name-$direction
    do_test $tag-merge {
      set result [catchsql "SELECT dolt_merge('$target')"]
      if {[lindex $result 0] == 0} {set result {0 merged}}
      set result
    } {0 merged}
    do_execsql_test $tag-conflicts {
      SELECT count(*) FROM dolt_schema_conflicts;
      SELECT count(*) FROM dolt_conflicts;
    } {0 0}
    do_execsql_test $tag-rows $check_sql $expected_rows
    do_execsql_test $tag-dropped-check {
      SELECT count(*) FROM sqlite_master
       WHERE name='t' AND sql LIKE '%v > 0%';
    } {0}
    do_execsql_test $tag-allow-neg {
      INSERT INTO t(id, v, w) VALUES(2, -1, 30);
    } {}
    execsql {SELECT dolt_commit('-Am', 'after merge')}
    db close
    sqlite3 db $connection
    do_execsql_test $tag-reopen {
      SELECT count(*) FROM t WHERE id = 2 AND v = -1;
      PRAGMA integrity_check;
    } {1 ok}
  }
}

# Replacing a named column-level CHECK when another column or another column
# constraint follows must preserve the separating comma and sibling constraints.
foreach {case_name anc_ddl edit_ddl check_not_null} {
  named-col-mid
    {CREATE TABLE t(id INTEGER PRIMARY KEY, x INT CONSTRAINT ck1 CHECK(x > 0), y INT)}
    {CREATE TABLE t(id INTEGER PRIMARY KEY, x INT CONSTRAINT ck1 CHECK(x > 10), y INT)}
    0
  named-col-not-null
    {CREATE TABLE t(id INTEGER PRIMARY KEY, x INT CONSTRAINT ck1 CHECK(x > 0) NOT NULL, y INT)}
    {CREATE TABLE t(id INTEGER PRIMARY KEY, x INT CONSTRAINT ck1 CHECK(x > 10) NOT NULL, y INT)}
    1
} {
  foreach direction {forward reverse} {
    reset_db
    execsql $anc_ddl
    execsql {
      INSERT INTO t VALUES(1, 20, 30);
      SELECT dolt_commit('-Am', 'base');
      SELECT dolt_branch('side');
      SELECT dolt_checkout('side');
      DROP TABLE t;
    }
    execsql $edit_ddl
    execsql {
      INSERT INTO t VALUES(1, 20, 30);
      SELECT dolt_commit('-Am', 'tighten check');
      SELECT dolt_checkout('main');
      ALTER TABLE t ADD COLUMN z INT DEFAULT 5;
      SELECT dolt_commit('-Am', 'add z');
    }
    if {$direction eq "forward"} {
      set target side
      set connection test.db
    } else {
      execsql {SELECT dolt_checkout('side')}
      set target main
      set connection test.db/side
    }
    set tag cut-raw-$case_name-$direction
    do_test $tag-merge {
      set result [catchsql "SELECT dolt_merge('$target')"]
      if {[lindex $result 0] == 0} {set result {0 merged}}
      set result
    } {0 merged}
    do_execsql_test $tag-conflicts {
      SELECT count(*) FROM dolt_schema_conflicts;
      SELECT count(*) FROM dolt_conflicts;
    } {0 0}
    do_execsql_test $tag-columns {
      SELECT name FROM pragma_table_info('t') ORDER BY cid;
    } {id x y z}
    do_execsql_test $tag-schema {
      SELECT count(*) FROM sqlite_master
       WHERE name='t' AND sql LIKE '%x > 10%';
      SELECT count(*) FROM sqlite_master
       WHERE name='t' AND sql LIKE '%x > 0%';
    } {1 0}
    do_test $tag-reject-old {
      set result [catchsql {INSERT INTO t(id, x, y) VALUES(2, 5, 1)}]
      list [lindex $result 0] \
           [string match {*CHECK constraint failed*} [lindex $result 1]]
    } {1 1}
    if {$check_not_null} {
      do_test $tag-reject-null {
        set result [catchsql {INSERT INTO t(id, x, y) VALUES(2, NULL, 1)}]
        list [lindex $result 0] \
             [string match {*NOT NULL constraint failed*} [lindex $result 1]]
      } {1 1}
    }
    do_execsql_test $tag-accept-valid {
      INSERT INTO t(id, x, y) VALUES(2, 15, 40);
      SELECT id, x, y, z FROM t ORDER BY id;
    } {1 20 30 5 2 15 40 5}
    execsql {SELECT dolt_commit('-Am', 'after merge')}
    db close
    sqlite3 db $connection
    do_execsql_test $tag-reopen {
      SELECT id, x, y, z FROM t ORDER BY id;
      PRAGMA integrity_check;
    } {1 20 30 5 2 15 40 5 ok}
  }
}

finish_test
