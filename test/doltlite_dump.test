set testdir [file dirname $argv0]
source $testdir/tester.tcl

foreach layout {"INTEGER PRIMARY KEY" "INT PRIMARY KEY" "INT PRIMARY KEY) WITHOUT ROWID; --"} {
  reset_db
  forcedelete dump-out.sql dump-out.sqlite
  if {[string match {*WITHOUT*} $layout]} {
    db eval {CREATE TABLE t(id INT PRIMARY KEY,v BLOB) WITHOUT ROWID}
  } else {
    db eval "CREATE TABLE t(id $layout,v BLOB)"
  }
  db eval {
    CREATE INDEX tv ON t(v);
    CREATE VIEW v AS SELECT * FROM t;
    INSERT INTO t VALUES(1,'committed');
    SELECT dolt_commit('-Am','base');
    SELECT dolt_tag('base');
    UPDATE t SET v='staged';
    SELECT dolt_add('t');
    UPDATE t SET v='working';
  }
  set before [db eval {SELECT dolt_hashof('HEAD'),active_branch(); SELECT * FROM dolt_status}]
  foreach ref {WORKING STAGED base} value {working staged committed} {
    forcedelete dump-out.sqlite
    do_test dump-$layout.$ref.result {
      db one {SELECT dolt_dump('--file-name','dump-out.sqlite','--result-format','sqlite','--ref',$ref)}
    } 0
    sqlite3 out file:dump-out.sqlite?doltlite_engine=sqlite -uri 1
    do_test dump-$layout.$ref.rows {out eval {SELECT * FROM v}} [list 1 $value]
    do_test dump-$layout.$ref.format {out one {SELECT doltlite_engine()}} orig
    do_test dump-$layout.$ref.integrity {out one {PRAGMA integrity_check}} ok
    out close
    do_test dump-$layout.$ref.source {
      db eval {SELECT dolt_hashof('HEAD'),active_branch(); SELECT * FROM dolt_status}
    } $before
    do_test dump-$layout.$ref.overwrite {
      lindex [catchsql {SELECT dolt_dump('--file-name','dump-out.sqlite','--result-format','sqlite')}] 0
    } 1
  }
  do_test dump-$layout.sql {
    db one {SELECT dolt_dump('--file-name','dump-out.sql')}
  } 0
  set sql {}
  if {[file exists dump-out.sql]} {
    set fd [open dump-out.sql rb]
    set sql [read $fd]
    close $fd
  }
  sqlite3 out file::memory:?doltlite_engine=sqlite -uri 1
  do_test dump-$layout.sql-replay {out eval $sql; out eval {SELECT * FROM v}} {1 working}
  out close
  do_test dump-$layout.no-temp {glob -nocomplain *-dump-*} {}
}

reset_db
forcedelete dump-out.sqlite
set before [db one {SELECT dolt_hashof('HEAD')}]
foreach sql {
  {SELECT dolt_dump()}
  {SELECT dolt_dump('--file-name')}
  {SELECT dolt_dump('--file-name','dump-out.sqlite','--result-format','csv')}
  {SELECT dolt_dump('--file-name','dump-out.sqlite','--ref','missing')}
  {SELECT dolt_dump('--file-name','dump-out.sqlite','extra')}
} {
  do_test dump-invalid-$sql {lindex [catchsql $sql] 0} 1
}
do_test dump-invalid.no-output {file exists dump-out.sqlite} 0
do_test dump-invalid.head {db one {SELECT dolt_hashof('HEAD')}} $before

foreach transaction {auto begin savepoint} {
  reset_db
  forcedelete dump-out.sqlite dump-out.sql
  db eval {
    PRAGMA user_version=17; PRAGMA application_id=1234;
    CREATE TABLE audit(id INTEGER PRIMARY KEY,v TEXT);
    CREATE TABLE t(id INTEGER PRIMARY KEY AUTOINCREMENT,v BLOB,
      g TEXT GENERATED ALWAYS AS (hex(v)) STORED,
      h TEXT GENERATED ALWAYS AS (typeof(v)) VIRTUAL);
    CREATE TRIGGER tr AFTER INSERT ON t BEGIN
      INSERT INTO audit VALUES(new.id,'trigger');
    END;
    CREATE VIEW v AS SELECT id,v,g,h FROM t;
    INSERT INTO t(id,v) VALUES(1,NULL),(2,X''),(3,X'0027FF'),
      (4,CAST(X'610062' AS TEXT)),(5,'a''b'),(6,char(13,10)),
      (7,'Unicode: 🐬'),(8,1.2345678901234567),(9,9e999),
      (10,-9223372036854775808),(11,9223372036854775807);
    INSERT INTO t(id,v) VALUES(100,'deleted');
    DELETE FROM t WHERE id=100;
    SELECT dolt_commit('-Am','base'); SELECT dolt_tag('old');
  }
  if {$transaction eq "begin"} {db eval BEGIN}
  if {$transaction eq "savepoint"} {db eval {SAVEPOINT caller}}
  db eval {UPDATE t SET v=CAST(X'8000FF' AS TEXT) WHERE id=4}
  set expect [db eval {SELECT id,typeof(v),hex(v),g,h FROM v ORDER BY id}]
  set audit [db eval {SELECT * FROM audit ORDER BY id}]
  set state [list [sqlite3_get_autocommit db] [db one {SELECT dolt_hashof('HEAD')}]     [db eval {SELECT * FROM dolt_status}]]
  foreach format {sql sqlite} {
    set path dump-out.$format
    forcedelete $path
    do_test dump-types-$transaction.$format.result {
      db one {SELECT dolt_dump('--file-name',$path,'--result-format',$format)}
    } 0
    if {$format eq "sql"} {
      set fd [open $path r]
      fconfigure $fd -encoding utf-8 -translation lf
      set sql [read $fd]
      close $fd
      sqlite3 out file::memory:?doltlite_engine=sqlite -uri 1
      out eval $sql
    } else {sqlite3 out file:dump-out.sqlite?doltlite_engine=sqlite -uri 1}
    do_test dump-types-$transaction.$format.rows {
      out eval {SELECT id,typeof(v),hex(v),g,h FROM v ORDER BY id}
    } $expect
    do_test dump-types-$transaction.$format.triggers-not-fired {
      out eval {SELECT * FROM audit ORDER BY id}
    } $audit
    do_test dump-types-$transaction.$format.meta {
      out eval {PRAGMA user_version; PRAGMA application_id}
    } {17 1234}
    do_test dump-types-$transaction.$format.sequence {
      out eval {INSERT INTO t(v) VALUES('next'); SELECT max(id) FROM t}
    } 101
    do_test dump-types-$transaction.$format.source {
      list [sqlite3_get_autocommit db] [db one {SELECT dolt_hashof('HEAD')}]         [db eval {SELECT * FROM dolt_status}]
    } $state
    out close
  }
  if {![sqlite3_get_autocommit db]} {db eval ROLLBACK}
}

reset_db
forcedelete dump-out.sqlite
db eval {
  CREATE TABLE old(id INT PRIMARY KEY,v TEXT);
  INSERT INTO old VALUES(1,'old');
  PRAGMA user_version=3; SELECT dolt_commit('-Am','old'); SELECT dolt_tag('old');
  DROP TABLE old; CREATE TABLE new(id INT PRIMARY KEY);
  INSERT INTO new VALUES(9); PRAGMA user_version=7;
  SELECT dolt_commit('-Am','new');
}
do_test dump-historical-schema.result {
  db one {SELECT dolt_dump('--file-name','dump-out.sqlite','-r','sqlite','--ref','old')}
} 0
sqlite3 out file:dump-out.sqlite?doltlite_engine=sqlite -uri 1
do_test dump-historical-schema.rows {out eval {SELECT * FROM old}} {1 old}
do_test dump-historical-schema.meta {out one {PRAGMA user_version}} 3
do_test dump-historical-schema.absent {out one {SELECT count(*) FROM sqlite_schema WHERE name='new'}} 0
out close

proc dump_race {action arg1 arg2 arg3 arg4} {
  if {$action eq "SQLITE_READ" && $arg1 eq "t" && ![file exists dump-race.sql]} {
    set fd [open dump-race.sql wb]; puts -nonewline $fd sentinel; close $fd
  }
  return SQLITE_OK
}
reset_db
forcedelete dump-race.sql
db eval {CREATE TABLE t(id INT PRIMARY KEY); INSERT INTO t VALUES(1)}
db authorizer dump_race
do_test dump-publication-race.result {
  catchsql {SELECT dolt_dump('--file-name','dump-race.sql')}
} {1 {dolt_dump: destination already exists: dump-race.sql}}
db authorizer {}
do_test dump-publication-race.kept {
  set fd [open dump-race.sql rb]; set value [read $fd]; close $fd; set value
} sentinel
do_test dump-publication-race.no-temp {glob -nocomplain *-dump-*} {}

ifcapable fts5 {
  reset_db
  db eval {
    CREATE VIRTUAL TABLE f USING fts5(body);
    INSERT INTO f(rowid,body) VALUES(1,'hello export'),(2,'another record');
    SELECT dolt_commit('-Am','fts'); SELECT dolt_tag('fts');
  }
  foreach ref {WORKING fts} {
    foreach format {sql sqlite} {
      set path dump-fts.$format; forcedelete $path
      do_test dump-fts-$ref.$format.result {
        db one {SELECT dolt_dump('--file-name',$path,'--result-format',$format,'--ref',$ref)}
      } 0
      if {$format eq "sql"} {
        set fd [open $path rb]; set sql [read $fd]; close $fd
        sqlite3 out file::memory:?doltlite_engine=sqlite -uri 1; out eval $sql
      } else {sqlite3 out file:dump-fts.sqlite?doltlite_engine=sqlite -uri 1}
      do_test dump-fts-$ref.$format.query {out eval {SELECT rowid,body FROM f WHERE f MATCH 'export'}} {1 {hello export}}
      do_test dump-fts-$ref.$format.integrity {out eval {INSERT INTO f(f) VALUES('integrity-check')}} {}
      out close
    }
  }
}
reset_db
forcedelete dump-rowid.sqlite dump-rowid.sql
db eval {
  CREATE TABLE rows(v TEXT);
  INSERT INTO rows(rowid,v) VALUES(10,'ten'),(20,'twenty');
  SELECT dolt_commit('-Am','rowids'); SELECT dolt_tag('rows');
}
foreach ref {WORKING rows} {
  foreach format {sql sqlite} {
    set path dump-rowid.$format; forcedelete $path
    do_test dump-rowid-$ref.$format.result {
      db one {SELECT dolt_dump('--file-name',$path,'--result-format',$format,'--ref',$ref)}
    } 0
    if {$format eq "sql"} {
      set fd [open $path rb]; set sql [read $fd]; close $fd
      sqlite3 out file::memory:?doltlite_engine=sqlite -uri 1; out eval $sql
    } else {sqlite3 out file:dump-rowid.sqlite?doltlite_engine=sqlite -uri 1}
    do_test dump-rowid-$ref.$format.values {out eval {SELECT rowid,v FROM rows ORDER BY rowid}} {10 ten 20 twenty}
    out close
  }
}

foreach format {sql sqlite} {
  reset_db
  set path dump-stage.$format; forcedelete $path
  db eval {
    CREATE TABLE t(id INTEGER PRIMARY KEY AUTOINCREMENT,old TEXT);
    INSERT INTO t VALUES(1,'staged'),(100,'deleted'); DELETE FROM t WHERE id=100;
    SELECT dolt_commit('-Am','base');
    ALTER TABLE t ADD COLUMN staged TEXT DEFAULT 'stage'; SELECT dolt_add('.');
    ALTER TABLE t DROP COLUMN old; UPDATE t SET staged='working';
  }
  do_test dump-stage-$format.result {
    db one {SELECT dolt_dump('--file-name',$path,'-r',$format,'--ref','STAGED')}
  } 0
  if {[file exists $path]} {
    if {$format eq "sql"} {
      set fd [open $path rb]; set sql [read $fd]; close $fd
      sqlite3 out file::memory:?doltlite_engine=sqlite -uri 1; out eval $sql
    } else {sqlite3 out file:dump-stage.sqlite?doltlite_engine=sqlite -uri 1}
    do_test dump-stage-$format.rows {out eval {SELECT * FROM t}} {1 staged stage}
    do_test dump-stage-$format.sequence {
      out eval {INSERT INTO t(old) VALUES('next'); SELECT max(id) FROM t}
    } 101
    out close
  }
}

foreach definition {
  {CREATE VIEW dependent AS SELECT dolt_version()}
  {CREATE TRIGGER dependent AFTER INSERT ON t BEGIN SELECT dolt_version(); END}
} {
  reset_db
  db eval {CREATE TABLE t(id INT PRIMARY KEY); INSERT INTO t VALUES(1)}
  db eval $definition
  foreach format {sql sqlite} {
    set path dump-dependent.$format; forcedelete $path
    do_test dump-dependent-$definition.$format.error {
      lindex [catchsql {SELECT dolt_dump('--file-name',$path,'-r',$format)}] 0
    } 1
    do_test dump-dependent-$definition.$format.absent {file exists $path} 0
  }
}
reset_db
db eval {
  CREATE TABLE t(id INT PRIMARY KEY); INSERT INTO t VALUES(1);
  SELECT dolt_commit('-Am','base'); SELECT dolt_checkout('-b','other');
  DROP TABLE t;
  INSERT INTO dolt_nonlocal_tables VALUES('t','main',NULL,'immediate');
  SELECT dolt_commit('-Am','binding'); SELECT dolt_tag('binding');
}
foreach ref {WORKING binding} {
  foreach format {sql sqlite} {
    set path dump-binding.$format; forcedelete $path
    do_test dump-binding-$ref.$format.error {
      set result [catchsql {SELECT dolt_dump('--file-name',$path,'-r',$format,'--ref',$ref)}]
      list [lindex $result 0] [string match {*nonlocal table bindings*} [lindex $result 1]]
    } {1 1}
    do_test dump-binding-$ref.$format.absent {file exists $path} 0
  }
}
reset_db
db eval {CREATE TABLE t(id INT PRIMARY KEY); INSERT INTO t VALUES(1)}
foreach format {sql sqlite} {
  set path dump-empty-existing.$format; forcedelete $path
  close [open $path wb]
  do_test dump-empty-existing-$format.refused {
    set result [catchsql {SELECT dolt_dump('--file-name',$path,'-r',$format)}]
    list [lindex $result 0] [lindex $result 1]
  } [list 1 "dolt_dump: destination already exists: $path"]
  do_test dump-empty-existing-$format.kept {file size $path} 0
  set path "dump unicode # ? ' 🐬.$format"; forcedelete $path
  set utf8 [encoding convertto utf-8 $path]
  do_test dump-path-$format.result {
    db one {SELECT dolt_dump('--file-name',CAST($utf8 AS TEXT),'-r',$format)}
  } 0
  do_test dump-path-$format.exists {file exists $path} 1
}
if {$tcl_platform(platform) eq "unix"} {
  forcedelete dump-link.sql dump-link-target
  close [open dump-link-target wb]
  file link -symbolic dump-link.sql dump-link-target
  forcedelete dump-link-target
  do_test dump-dangling-link.refused {
    lindex [catchsql {SELECT dolt_dump('--file-name','dump-link.sql')}] 0
  } 1
  do_test dump-dangling-link.kept {file type dump-link.sql} link
  do_test dump-dangling-link.no-target {file exists dump-link-target} 0
}
do_test dump-final.no-temp {glob -nocomplain *-dump-*} {}
foreach format {sql sqlite} {
  reset_db
  db eval {
    CREATE TABLE gone(id INTEGER PRIMARY KEY AUTOINCREMENT);
    INSERT INTO gone VALUES(100); DROP TABLE gone;
    CREATE TABLE doltlite_export_sequence_0(id INTEGER PRIMARY KEY);
    SELECT dolt_commit('-Am','empty sequence');
  }
  set path dump-sequence-only.$format; forcedelete $path
  do_test dump-sequence-only-$format.result {
    db one {SELECT dolt_dump('--file-name',$path,'-r',$format,'--ref','HEAD')}
  } 0
  if {$format eq "sql"} {
    set fd [open $path rb]; set sql [read $fd]; close $fd
    sqlite3 out file::memory:?doltlite_engine=sqlite -uri 1; out eval $sql
  } else {sqlite3 out file:dump-sequence-only.sqlite?doltlite_engine=sqlite -uri 1}
  do_test dump-sequence-only-$format.empty {out one {SELECT count(*) FROM sqlite_sequence}} 0
  do_test dump-sequence-only-$format.schema {out one {SELECT count(*) FROM sqlite_schema WHERE type='table'}} 2
  out close
}
foreach layout {rowid integer clustered without-rowid} {
  reset_db
  if {$layout eq "rowid"} {db eval {CREATE TABLE ""(a, v)}}
  if {$layout eq "integer"} {db eval {CREATE TABLE ""(a INTEGER PRIMARY KEY, v)}}
  if {$layout eq "clustered"} {db eval {CREATE TABLE ""(a INT PRIMARY KEY, v)}}
  if {$layout eq "without-rowid"} {db eval {CREATE TABLE ""(a INT PRIMARY KEY, v) WITHOUT ROWID}}
  db eval {
    INSERT INTO "" VALUES(1,'committed');
    SELECT dolt_commit('-Am','empty name');
    SELECT dolt_tag('empty-name');
    SELECT dolt_branch('empty-branch');
    DELETE FROM ""; INSERT INTO "" VALUES(1,'staged');
    SELECT dolt_add('.');
    DELETE FROM ""; INSERT INTO "" VALUES(1,'working');
  }
  set hash [db one {SELECT dolt_hashof('HEAD')}]
  set before [db eval {SELECT dolt_hashof('HEAD'),active_branch(); SELECT * FROM dolt_status}]
  foreach ref [list WORKING STAGED HEAD empty-name empty-branch $hash] \
      value {working staged committed committed committed committed} {
    foreach format {sql sqlite} {
      set path dump-empty-name.$format
      forcedelete $path
      do_test dump-empty-name-$layout-$ref-$format.result {
        db one {SELECT dolt_dump('--file-name',$path,'-r',$format,'--ref',$ref)}
      } 0
      do_test dump-empty-name-$layout-$ref-$format.rows {
        if {$format eq "sql"} {
          sqlite3 out file::memory:?doltlite_engine=sqlite -uri 1
          set fd [open $path rb]; set text [read $fd]; close $fd
          out eval $text
        } else {sqlite3 out file:dump-empty-name.sqlite?doltlite_engine=sqlite -uri 1}
        out eval {SELECT a,v FROM ""; PRAGMA integrity_check}
      } [list 1 $value ok]
      catch {out close}
      do_test dump-empty-name-$layout-$ref-$format.source {
        db eval {SELECT dolt_hashof('HEAD'),active_branch(); SELECT * FROM dolt_status}
      } $before
    }
  }
}

reset_db
db eval {
  CREATE TABLE ""(a TEXT);
  INSERT INTO "" VALUES('01');
  SELECT dolt_commit('-Am','text'); SELECT dolt_tag('empty-text');
  DROP TABLE "";
  CREATE TABLE ""(a NUMERIC, b TEXT);
  INSERT INTO "" VALUES(2,'new');
  SELECT dolt_commit('-Am','numeric'); SELECT dolt_tag('empty-numeric');
  DROP TABLE "";
}
set turn 0
foreach ref {empty-text empty-numeric empty-text} expected {{01} {2 new} {01}} {
  incr turn
  foreach format {sql sqlite} {
    set path dump-empty-declaration.$format
    forcedelete $path
    do_test dump-empty-declaration-$turn-$ref-$format.result {
      db one {SELECT dolt_dump('--file-name',$path,'-r',$format,'--ref',$ref)}
    } 0
    do_test dump-empty-declaration-$turn-$ref-$format.rows {
      if {$format eq "sql"} {
        sqlite3 out file::memory:?doltlite_engine=sqlite -uri 1
        set fd [open $path rb]; set text [read $fd]; close $fd
        out eval $text
      } else {sqlite3 out file:dump-empty-declaration.sqlite?doltlite_engine=sqlite -uri 1}
      out eval {SELECT * FROM ""}
    } $expected
    catch {out close}
  }
}
do_test dump-empty-name.no-temp {glob -nocomplain *-dump-*} {}
# Views and triggers that read DoltLite system vtables must be refused: the
# exported database has no dolt_* vtabs, so the reference would be silently
# unusable in stock SQLite (views over dropped tables stay allowed).
reset_db
forcedelete dump-out.sqlite
db eval {
  CREATE TABLE t(a);
  CREATE VIEW vb AS SELECT name FROM dolt_branches;
}
do_test dump-system-vtable-view {
  catchsql {SELECT dolt_dump('--file-name','dump-out.sqlite','-r','sqlite')}
} {1 {dolt_dump: vb: access to dolt_branches.name is prohibited}}
do_test dump-system-vtable-view.no-file {
  file exists dump-out.sqlite
} 0
forcedelete dump-out.sqlite
db eval {DROP VIEW vb}
db eval {
  CREATE TRIGGER tg AFTER INSERT ON t BEGIN
    INSERT INTO t SELECT name FROM dolt_branches;
  END;
}
do_test dump-system-vtable-trigger {
  catchsql {SELECT dolt_dump('--file-name','dump-out.sqlite','-r','sqlite')}
} {1 {dolt_dump: t: access to dolt_branches.name is prohibited}}
do_test dump-system-vtable-trigger.no-file {
  file exists dump-out.sqlite
} 0
forcedelete dump-out.sqlite
db eval {DROP TRIGGER tg}
do_test dump-normal-view-still-dumps {
  db eval {CREATE VIEW vgood AS SELECT * FROM t; SELECT dolt_commit('-Am','x')}
  db one {SELECT dolt_dump('--file-name','dump-out.sqlite','-r','sqlite')}
} 0
do_test dump-normal-view-still-dumps.rows {
  sqlite3 out file:dump-out.sqlite?doltlite_engine=sqlite -uri 1
  out eval {SELECT * FROM vgood}
} {}
do_test dump-normal-view-still-dumps.no-temp {glob -nocomplain *-dump-*} {}
out close

# A keyless table can already occupy every result column. Rowid has to be
# copied by a follow-up update so the export stays within that limit.
reset_db
forcedelete dump-wide-rowid.sql dump-wide-rowid.sqlite
set lim [sqlite3_limit db SQLITE_LIMIT_COLUMN -1]
set cols [list]
for {set i 0} {$i < $lim} {incr i} { lappend cols "c$i" }
set last [expr {$lim-1}]
set pk [list {id INTEGER PRIMARY KEY}]
for {set i 1} {$i < $lim} {incr i} { lappend pk "p$i" }
set shadow [list {"rowid"}]
for {set i 1} {$i < $lim} {incr i} { lappend shadow "s$i" }
db eval "CREATE TABLE w([join $cols ,])"
db eval "INSERT INTO w(rowid,c0,c$last) VALUES(42,1,2),(7,3,4)"
db eval "CREATE TABLE pk([join $pk ,])"
db eval "INSERT INTO pk(id,p$last) VALUES(9,8)"
db eval "CREATE TABLE shadow([join $shadow ,])"
db eval "INSERT INTO shadow(\"_rowid_\",\"rowid\",s$last) VALUES(15,'mine',6)"
db eval {CREATE TABLE narrow(v TEXT); INSERT INTO narrow(rowid,v) VALUES(10,'ten')}
db eval {SELECT dolt_commit('-Am','wide')}
foreach format {sql sqlite} {
  set path dump-wide-rowid.$format
  forcedelete $path
  do_test dump-wide-rowid-$format {
    db eval {SELECT dolt_dump('--file-name',$path,'-r',$format,'--ref','WORKING')}
    if {$format eq "sql"} {
      set fd [open $path rb]; set text [read $fd]; close $fd
      sqlite3 out file::memory:?doltlite_engine=sqlite -uri 1
      out eval $text
      set updates [regexp -all {last_insert_rowid} $text]
    } else {
      sqlite3 out file:dump-wide-rowid.sqlite?doltlite_engine=sqlite -uri 1
      set updates 3
    }
    list $updates \
         [out eval "SELECT rowid, c0, c$last FROM w ORDER BY rowid"] \
         [out eval "SELECT id, p$last FROM pk"] \
         [out eval "SELECT _rowid_, \"rowid\", s$last FROM shadow"] \
         [out eval {SELECT rowid, v FROM narrow}]
  } {3 {7 3 4 42 1 2} {9 8} {15 mine 6} {10 ten}}
  catch {out close}
}

# dolt_at names its hidden ref argument commit_ref, so a historical export
# has to copy declared columns by position. That includes a later tip that
# adds a column, a stored generated column, and a sibling already named
# commit_ref_1.
reset_db
forcedelete dump-commit-ref.sql dump-commit-ref.sqlite
db eval {
  CREATE TABLE c(commit_ref TEXT, x INT);
  INSERT INTO c VALUES('mine',1);
  CREATE TABLE s(commit_ref INTEGER PRIMARY KEY, x INT) STRICT;
  INSERT INTO s VALUES(7,2);
  CREATE TABLE mixed("Commit_Ref" TEXT, commit_ref_1 TEXT, x INT);
  INSERT INTO mixed VALUES('Keep','suffix',3);
  CREATE TABLE gen(
    commit_ref TEXT,
    g TEXT GENERATED ALWAYS AS (commit_ref || '!') STORED,
    x INT
  );
  INSERT INTO gen(commit_ref, x) VALUES('mine',4);
  CREATE TABLE mid(a INT, commit_ref TEXT, b INT);
  INSERT INTO mid VALUES(8,'mine',9);
  CREATE TABLE bare(commit_ref TEXT, x INT);
  INSERT INTO bare VALUES('row',5);
  SELECT dolt_commit('-Am','base');
  SELECT dolt_tag('base');
}
set baseHash [db one {SELECT dolt_hashof('base')}]
db eval {
  UPDATE c SET commit_ref='staged';
  UPDATE s SET x=20 WHERE commit_ref=7;
  UPDATE mixed SET "Commit_Ref"='Staged';
  UPDATE gen SET commit_ref='staged';
  UPDATE mid SET commit_ref='staged';
  UPDATE bare SET commit_ref='staged';
  SELECT dolt_add('.');
  UPDATE c SET commit_ref='working';
  UPDATE bare SET x=50;
}
set before [db eval {SELECT dolt_hashof('HEAD'),active_branch(); SELECT * FROM dolt_status}]
foreach ref {WORKING STAGED base} {
  foreach format {sql sqlite} {
    set path dump-commit-ref.$format
    forcedelete $path
    set prefix dump-commit-ref-$ref-$format
    do_test $prefix.values {
      db eval {SELECT dolt_dump('--file-name',$path,'-r',$format,'--ref',$ref)}
      if {$format eq "sql"} {
        sqlite3 out file::memory:?doltlite_engine=sqlite -uri 1
        set fd [open $path rb]; set text [read $fd]; close $fd
        out eval $text
      } else {
        sqlite3 out file:dump-commit-ref.sqlite?doltlite_engine=sqlite -uri 1
      }
      list [out eval {SELECT commit_ref, x FROM c}] \
           [out eval {SELECT commit_ref, x FROM s}] \
           [out eval {SELECT "Commit_Ref", commit_ref_1, x FROM mixed}] \
           [out eval {SELECT commit_ref, g, x FROM gen}] \
           [out eval {SELECT a, commit_ref, b FROM mid}] \
           [out eval {SELECT rowid, commit_ref, x FROM bare}] \
           [out eval "SELECT commit_ref='$baseHash' FROM c"]
    } [list \
        [dict get {WORKING {working 1} STAGED {staged 1} base {mine 1}} $ref] \
        [dict get {WORKING {7 20} STAGED {7 20} base {7 2}} $ref] \
        [dict get {WORKING {Staged suffix 3} STAGED {Staged suffix 3} base {Keep suffix 3}} $ref] \
        [dict get {WORKING {staged staged! 4} STAGED {staged staged! 4} base {mine mine! 4}} $ref] \
        [dict get {WORKING {8 staged 9} STAGED {8 staged 9} base {8 mine 9}} $ref] \
        [dict get {WORKING {1 staged 50} STAGED {1 staged 5} base {1 row 5}} $ref] \
        0]
    catch {out close}
    do_test $prefix.source {
      db eval {SELECT dolt_hashof('HEAD'),active_branch(); SELECT * FROM dolt_status}
    } $before
  }
}
db eval {
  ALTER TABLE c ADD COLUMN y INT DEFAULT 0;
  UPDATE c SET y=11;
  SELECT dolt_commit('-Am','added');
}
foreach format {sql sqlite} {
  set path dump-commit-ref-old.$format
  forcedelete $path
  do_test dump-commit-ref-old-$format {
    db eval {SELECT dolt_dump('--file-name',$path,'-r',$format,'--ref','base')}
    if {$format eq "sql"} {
      sqlite3 out file::memory:?doltlite_engine=sqlite -uri 1
      set fd [open $path rb]; set text [read $fd]; close $fd
      out eval $text
    } else {
      sqlite3 out file:dump-commit-ref-old.sqlite?doltlite_engine=sqlite -uri 1
    }
    list [out eval {SELECT commit_ref, x FROM c}] \
         [catch {out eval {SELECT y FROM c}}] \
         [out eval "SELECT commit_ref='$baseHash' FROM c"]
  } {{mine 1} 1 0}
  catch {out close}
}
do_test dump-commit-ref-head {
  forcedelete dump-commit-ref-head.sqlite
  db eval {SELECT dolt_dump('--file-name','dump-commit-ref-head.sqlite','-r','sqlite','--ref','HEAD')}
  sqlite3 out file:dump-commit-ref-head.sqlite?doltlite_engine=sqlite -uri 1
  out eval {SELECT commit_ref, x, y FROM c}
} {working 1 11}
out close

# The integer key has to be read through an alias that is not a user column.
# src.rowid is that column when the table declares one.
reset_db
forcedelete dump-shadow-rowid.sql dump-shadow-rowid.sqlite
db eval {
  CREATE TABLE "shadowed rowid"(rowid, v);
  INSERT INTO "shadowed rowid"(_rowid_,rowid,v)
    VALUES(7,'visible','first'),(19,'visible',char(97,0,98));
  SELECT dolt_commit('-Am','shadow');
}
foreach ref {WORKING HEAD} {
  foreach format {sql sqlite} {
    set path dump-shadow-rowid.$format
    forcedelete $path
    do_test dump-shadow-rowid-$ref-$format {
      db eval {SELECT dolt_dump('--file-name',$path,'-r',$format,'--ref',$ref)}
      if {$format eq "sql"} {
        sqlite3 out file::memory:?doltlite_engine=sqlite -uri 1
        set fd [open $path rb]; set text [read $fd]; close $fd
        out eval $text
      } else {
        sqlite3 out file:dump-shadow-rowid.sqlite?doltlite_engine=sqlite -uri 1
      }
      out eval {SELECT _rowid_, rowid, hex(v) FROM "shadowed rowid" ORDER BY _rowid_}
    } {7 visible 6669727374 19 visible 610062}
    catch {out close}
  }
}

# SQL text has to stay encoding-independent. A hex cast stores UTF-8 bytes
# unchanged, which a UTF-16 database then reads as its own code units.
reset_db
forcedelete dump-encoding.sql
db eval {
  CREATE TABLE t(s TEXT, b BLOB);
  INSERT INTO t VALUES(char(104,233,108,108,111), NULL);
  INSERT INTO t VALUES('a'||char(10)||'b', NULL);
  INSERT INTO t VALUES(char(0), NULL);
  INSERT INTO t VALUES('it''s', X'6100');
  INSERT INTO t VALUES(char(97,0,98), NULL);
  INSERT INTO t VALUES(char(39)||char(10)||char(39), NULL);
  INSERT INTO t VALUES('', NULL);
}
do_test dump-encoding.sql {
  db eval {SELECT dolt_dump('--file-name','dump-encoding.sql','-r','sql')}
  set fd [open dump-encoding.sql r]
  fconfigure $fd -encoding utf-8 -translation lf
  set sql [read $fd]
  close $fd
  sqlite3 out file::memory:?doltlite_engine=sqlite -uri 1
  out eval {PRAGMA encoding='UTF-16le'}
  out eval $sql
  list [expr {[string first "CAST(X'" $sql]<0}] \
       [expr {[string first "\u00e9" $sql]>=0}] \
       [expr {[string first "char(10)" $sql]>=0}] \
       [expr {[string first "char(0)" $sql]>=0}] \
       [expr {[string first "X'6100'" $sql]>=0}] \
       [out one {SELECT encoding FROM pragma_encoding}] \
       [out eval {SELECT hex(s), length(s) FROM t LIMIT 1 OFFSET 0}] \
       [out eval {SELECT hex(s), length(s) FROM t LIMIT 1 OFFSET 1}] \
       [out eval {SELECT hex(s) FROM t LIMIT 1 OFFSET 2}] \
       [out eval {SELECT hex(s), hex(b) FROM t LIMIT 1 OFFSET 3}] \
       [out eval {SELECT hex(s) FROM t LIMIT 1 OFFSET 4}] \
       [out eval {SELECT hex(s), length(s) FROM t LIMIT 1 OFFSET 5}] \
       [out eval {SELECT s='', length(s) FROM t LIMIT 1 OFFSET 6}] \
       [out one {PRAGMA integrity_check}]
} [list 1 1 1 1 1 UTF-16le {6800E9006C006C006F00 5} {61000A006200 3} 0000 \
   {6900740027007300 6100} 610000006200 {27000A002700 3} {1 0} ok]
catch {out close}
finish_test
