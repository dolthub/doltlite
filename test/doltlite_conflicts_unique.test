set testdir [file dirname $argv0]
source $testdir/tester.tcl

foreach {layout key suffix} {
  rowid {id INTEGER PRIMARY KEY} {}
  clustered {id INT PRIMARY KEY} {}
  text {id TEXT PRIMARY KEY} {}
  composite {id INT, PRIMARY KEY(id,z)} {}
  without_rowid {id INT PRIMARY KEY} {WITHOUT ROWID}
} {
  foreach {kind column terms predicate} {
    nullable {v INT} {v} {v=30}
    notnull {v INT NOT NULL} {v} {v=30}
    compound {v INT NOT NULL} {v,z} {v=30 AND z=1}
    expression {v INT} {v+0} {v+0=30}
    partial {v INT} {v} {v=30 AND z=1}
    collated {v TEXT NOT NULL} {v COLLATE NOCASE} {v='30' COLLATE NOCASE}
  } {
    reset_db
    set pk {}
    if {$layout eq "composite"} {
      set key {id INT}
      set pk {,PRIMARY KEY(id,z)}
    }
    execsql "CREATE TABLE t($key,$column,z INT NOT NULL$pk) $suffix"
    set where {}
    if {$kind eq "partial"} {set where {WHERE z=1}}
    execsql "CREATE UNIQUE INDEX u ON t($terms) $where"
    execsql {
      INSERT INTO t VALUES(1,10,1),(2,20,1);
      SELECT dolt_commit('-Am','base');
      SELECT dolt_checkout('-b','side');
      UPDATE t SET v=30 WHERE id=1;
      SELECT dolt_commit('-am','theirs');
      SELECT dolt_checkout('main');
      UPDATE t SET v=40 WHERE id=1;
      UPDATE t SET v=30 WHERE id=2;
      SELECT dolt_commit('-am','ours');
      SELECT id FROM t WHERE v=30 ORDER BY id;
      BEGIN;
    }
    set name conflicts-unique-$layout-$kind
    do_catchsql_test $name-merge {
      SELECT dolt_merge('side');
    } {1 {Merge has 1 conflict(s). Resolve and then commit with dolt_commit.}}
    do_execsql_test $name-resolve {
      SELECT dolt_conflicts_resolve('--theirs','t');
      SELECT count(*) FROM dolt_conflicts;
    } {0 0}
    foreach state {transaction committed reopened checkout} {
      switch $state {
        committed {execsql {SELECT dolt_commit('-Am','resolved')}}
        reopened {
          db close
          sqlite3 db test.db
        }
        checkout {
          execsql {SELECT dolt_checkout('side'); SELECT dolt_checkout('main')}
        }
      }
      do_execsql_test $name-$state-lookup {
        SELECT id FROM t WHERE v=30 ORDER BY id;
      } {1 2}
      do_test $name-$state-forced {
        execsql "SELECT id FROM t INDEXED BY u WHERE $predicate ORDER BY id"
      } {1 2}
      do_execsql_test $name-$state-scan {
        SELECT id FROM t NOT INDEXED WHERE v=30 ORDER BY id;
      } {1 2}
      do_execsql_test $name-$state-count {
        SELECT count(*) FROM t WHERE v=30;
        SELECT count(*) FROM t WHERE v IN (30,40);
        SELECT count(*) FROM t WHERE v IN (SELECT v FROM t);
      } {2 2 2}
      do_execsql_test $name-$state-distinct {
        SELECT DISTINCT v FROM t WHERE v=30;
        SELECT DISTINCT v,z FROM t;
      } {30 30 1}
      do_execsql_test $name-$state-join {
        SELECT a.id,b.id FROM t a JOIN t b ON a.v=b.v ORDER BY a.id,b.id;
        SELECT id FROM t WHERE v=30 ORDER BY id DESC LIMIT 2;
        SELECT a.id FROM t a LEFT JOIN t b ON a.v=b.v AND a.z=b.z
          ORDER BY a.id;
      } {1 1 1 2 2 1 2 2 2 1 1 1 2 2}
      do_catchsql_test $name-$state-enforce {
        INSERT INTO t VALUES(4,30,1);
      } [list 1 [expr {$kind eq "expression" ? "UNIQUE constraint failed: index 'u'" : ($kind eq "compound" ? "UNIQUE constraint failed: t.v, t.z" : "UNIQUE constraint failed: t.v")}]]
    }
    do_execsql_test $name-delete {
      SAVEPOINT before_delete;
      DELETE FROM t WHERE id=2;
      SELECT id FROM t WHERE v=30;
      PRAGMA integrity_check;
      ROLLBACK TO before_delete;
      RELEASE before_delete;
    } {1 ok}
    do_execsql_test $name-update {
      UPDATE t SET v=50 WHERE id=2;
      SELECT id FROM t WHERE v=30;
      SELECT id FROM t WHERE v=50;
      PRAGMA integrity_check;
    } {1 2 ok}
  }
}

foreach populated {0 1} {
  foreach key {INTEGER INT} {
    foreach direction {forward reverse} {
      foreach {kind declaration expected explicit} {
        integer {INT NOT NULL DEFAULT 7} 7 9
        negative {INT DEFAULT (-7)} -7 NULL
        text {TEXT DEFAULT 'seven'} 'seven' NULL
        affinity {TEXT DEFAULT 7} '7' NULL
        real {REAL DEFAULT 7.25} 7.25 NULL
        blob {BLOB DEFAULT X'0708'} X'0708' NULL
        nullable {INT DEFAULT NULL} NULL NULL
      } {
        reset_db
        execsql "CREATE TABLE t(a $key PRIMARY KEY,cb INT,cd INT)"
        execsql {
          SELECT dolt_commit('-Am','base');
          SELECT dolt_branch('side');
          INSERT INTO t VALUES(8,1,6);
          SELECT dolt_commit('-Am','main row');
          SELECT dolt_checkout('side');
          CREATE UNIQUE INDEX ix1 ON t(cb);
        }
        execsql "ALTER TABLE t ADD COLUMN n3 $declaration"
        if {$populated} {execsql "INSERT INTO t VALUES(2,2,5,$explicit)"}
        execsql {
          SELECT dolt_commit('-Am','add default and unique index');
          SELECT dolt_checkout('main');
          ALTER TABLE t RENAME COLUMN cd TO r2;
          INSERT INTO t VALUES(0,1,4);
        }
        if {$populated} {execsql {INSERT INTO t VALUES(3,2,9)}}
        execsql {
          SELECT dolt_commit('-Am','rename column and insert');
        }
        set target side
        set branch main
        if {$direction eq "reverse"} {
          execsql {SELECT dolt_checkout('side')}
          set target main
          set branch side
        }
        execsql {BEGIN}
        set name violations-default-$populated-$key-$direction-$kind
        set rows {0 1 4 8 1 6 2}
        set defaults [list $expected $expected]
        if {$populated} {
          set rows {0 1 4 2 2 5 3 2 9 8 1 6 4}
          lappend defaults $expected
        }
        do_catchsql_test $name-merge "SELECT dolt_merge('$target')" \
          {1 {Merge resulted in constraint violations. Resolve the rows in dolt_constraint_violations and then commit with dolt_commit.}}
        foreach state {transaction committed reopened} {
          if {$state eq "committed"} {execsql {COMMIT}}
          if {$state eq "reopened"} {
            db close
            sqlite3 db test.db/$branch
          }
          do_execsql_test $name-$state-rows {
            SELECT a,cb,r2 FROM t ORDER BY a;
            SELECT count(*) FROM dolt_constraint_violations_t
              WHERE violation_type='unique index';
          } $rows
          do_execsql_test $name-$state-default {
            SELECT quote(n3) FROM dolt_constraint_violations_t
              WHERE a IN (0,3,8) ORDER BY a;
          } $defaults
          if {$populated} {
            do_execsql_test $name-$state-explicit {
              SELECT quote(n3) FROM dolt_constraint_violations_t WHERE a=2;
            } [list $explicit]
          }
          do_execsql_test $name-$state-matches {
            SELECT count(*) FROM (
              SELECT a,cb,r2,n3 FROM t
              EXCEPT SELECT a,cb,r2,n3 FROM dolt_constraint_violations_t
            );
            SELECT count(*) FROM (
              SELECT a,cb,r2,n3 FROM dolt_constraint_violations_t
              EXCEPT SELECT a,cb,r2,n3 FROM t
            );
          } {0 0}
        }
        do_execsql_test $name-snapshot {
          UPDATE t SET n3=8 WHERE a=0;
          SELECT quote(n3) FROM dolt_constraint_violations_t WHERE a=0;
        } [list $expected]
      }
    }
  }
}

finish_test
