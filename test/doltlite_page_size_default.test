set testdir [file dirname $argv0]
source $testdir/tester.tcl

set testprefix doltlite-page-size-default

do_execsql_test 1.0 {
  PRAGMA page_size;
} {1024}

do_execsql_test 1.1 {
  CREATE VIRTUAL TABLE t1 USING fts4(x);
  INSERT INTO t1 VALUES('a b c');
  PRAGMA page_size;
} {1024}

finish_test
