set testdir [file dirname $argv0]
source $testdir/tester.tcl

proc merge_txn_setup {diverged} {
  reset_db
  execsql {
    CREATE TABLE t(id INTEGER PRIMARY KEY);
    SELECT dolt_commit('-Am','base');
    SELECT dolt_branch('feature');
    SELECT dolt_checkout('feature');
    INSERT INTO t VALUES(1);
    SELECT dolt_commit('-Am','feature');
    SELECT dolt_checkout('main');
  }
  if {$diverged} {
    execsql {INSERT INTO t VALUES(2); SELECT dolt_commit('-Am','main')}
  }
}

proc merge_txn_state {connection} {
  $connection eval {
    SELECT count(*) FROM t;
    SELECT dolt_hashof('HEAD');
    SELECT count(*) FROM dolt_status;
    SELECT is_merging FROM dolt_merge_status;
  }
}

foreach {name diverged flags} {
  ff 0 {}
  ff-no-commit 0 {'--no-commit',}
  no-ff 0 {'--no-ff',}
  three-way 1 {}
} {
  merge_txn_setup $diverged
  do_test merge-txn-$name-commits {
    execsql "BEGIN; SELECT dolt_merge(${flags}'feature')"
    list [sqlite3_get_autocommit db] [catch {execsql ROLLBACK}] \
         [execsql {SELECT count(*) FROM t}]
  } [list 1 1 [expr {$diverged+1}]]
}

foreach {name diverged flags merging} {
  no-ff-no-commit 0 {'--no-ff','--no-commit',} 1
  ff-squash 0 {'--squash',} 0
  three-way-no-commit 1 {'--no-commit',} 1
  three-way-squash-no-commit 1 {'--squash','--no-commit',} 0
} {
  foreach boundary {begin nested savepoint} {
    foreach finish {rollback commit close} {
      merge_txn_setup $diverged
      set before [merge_txn_state db]
      set namebase merge-txn-$name-$boundary-$finish
      if {$boundary ne "savepoint"} {execsql BEGIN}
      if {$boundary ne "begin"} {execsql {SAVEPOINT before_merge}}
      do_test $namebase-open {
        execsql "SELECT dolt_merge(${flags}'feature')"
        list [sqlite3_get_autocommit db] [execsql {SELECT count(*) FROM t}] \
             [execsql {SELECT is_merging FROM dolt_merge_status}]
      } [list 0 [expr {$diverged+1}] $merging]
      do_test $namebase-private {
        sqlite3 peer test.db
        set state [merge_txn_state peer]
        peer close
        set state
      } $before
      if {$finish eq "rollback"} {
        if {$boundary ne "begin"} {
          do_test $namebase-rollback-to {
            execsql {ROLLBACK TO before_merge}
            merge_txn_state db
          } $before
        }
        do_test $namebase-rollback {execsql ROLLBACK} {}
      } elseif {$finish eq "commit"} {
        do_test $namebase-commit {execsql COMMIT} {}
      }
      db close
      sqlite3 db test.db
      if {$finish eq "commit"} {
        do_test $namebase-reopen {
          merge_txn_state db
        } [list [expr {$diverged+1}] [lindex $before 1] 1 $merging]
        do_test $namebase-finish {
          execsql {SELECT dolt_commit('-m','finish')}
          execsql {SELECT count(*) FROM dolt_status; SELECT is_merging FROM dolt_merge_status}
        } {0 0}
      } else {
        do_test $namebase-reopen {merge_txn_state db} $before
      }
    }
  }
}

foreach squash {0 1} {
  foreach artifacts {conflicts violations both} {
    reset_db
    set conflicts [expr {$artifacts ne "violations"}]
    set violations [expr {$artifacts ne "conflicts"}]
    set flags [expr {$squash ? "'--squash'," : ""}]
    set name merge-txn-artifacts-$artifacts-squash-$squash
    execsql {
      CREATE TABLE t(id INTEGER PRIMARY KEY, a INT);
      CREATE TABLE u(id INTEGER PRIMARY KEY, a INT UNIQUE);
      INSERT INTO t VALUES(1,1),(2,2);
      SELECT dolt_commit('-Am','base');
      SELECT dolt_branch('feature');
      SELECT dolt_checkout('feature');
      INSERT INTO t VALUES(3,3);
    }
    if {$conflicts} {execsql {UPDATE t SET a=10 WHERE id=1}}
    if {$violations} {execsql {INSERT INTO u VALUES(1,10)}}
    execsql {
      SELECT dolt_commit('-am','feature');
      SELECT dolt_checkout('main');
      UPDATE t SET a=20 WHERE id=2;
    }
    if {$conflicts} {execsql {UPDATE t SET a=11 WHERE id=1}}
    if {$violations} {execsql {INSERT INTO u VALUES(2,10)}}
    execsql {SELECT dolt_commit('-am','main'); BEGIN}
    do_test $name-merge {
      list [catch {execsql "SELECT dolt_merge(${flags}'feature')"}] \
           [execsql {
             SELECT is_merging FROM dolt_merge_status;
             SELECT count(*) FROM dolt_conflicts;
             SELECT count(*) FROM dolt_constraint_violations;
           }]
    } [list 1 [list [expr {!$squash}] $conflicts $violations]]
    do_test $name-commit-blocked {
      lindex [catchsql {SELECT dolt_commit('-am','unresolved')}] 0
    } 1
    if {$conflicts} {
      execsql {SELECT dolt_conflicts_resolve('--theirs','t')}
    }
    if {$violations} {
      do_execsql_test $name-repair {
        DELETE FROM u WHERE id=1;
        DELETE FROM dolt_constraint_violations_u;
        SELECT dolt_verify_constraints('--all');
      } 0
    }
    do_execsql_test $name-resolved {
      SELECT count(*) FROM dolt_conflicts;
      SELECT count(*) FROM dolt_constraint_violations;
      SELECT is_merging FROM dolt_merge_status;
      SELECT id,a FROM t ORDER BY id;
    } [list 0 0 [expr {!$squash}] 1 [expr {$conflicts ? 10 : 1}] 2 20 3 3]
    do_test $name-commit {
      execsql {SELECT length(dolt_commit('-am','resolved'))}
    } 40
    db close
    sqlite3 db test.db
    do_execsql_test $name-reopen {
      SELECT count(*) FROM dolt_commit_ancestors
        WHERE commit_hash=dolt_hashof('HEAD');
      SELECT count(*) FROM dolt_log;
      SELECT is_merging FROM dolt_merge_status;
      SELECT count(*) FROM dolt_status;
      PRAGMA integrity_check;
    } [list [expr {2-$squash}] [expr {5-$squash}] 0 0 ok]
  }
}

foreach violations {0 1} {
  reset_db
  execsql {
    CREATE TABLE t(id INTEGER PRIMARY KEY);
    CREATE TABLE u(id INTEGER PRIMARY KEY, a INT UNIQUE);
    SELECT dolt_commit('-Am','base');
    SELECT dolt_branch('feature');
    SELECT dolt_checkout('feature');
    ALTER TABLE t ADD COLUMN a INT;
  }
  if {$violations} {execsql {INSERT INTO u VALUES(1,10)}}
  execsql {
    SELECT dolt_commit('-am','feature');
    SELECT dolt_checkout('main');
    ALTER TABLE t ADD COLUMN a TEXT;
  }
  if {$violations} {execsql {INSERT INTO u VALUES(2,10)}}
  execsql {SELECT dolt_commit('-am','main'); BEGIN}
  do_test merge-txn-squash-schema-$violations {
    list [catch {execsql {SELECT dolt_merge('--squash','feature')}}] \
         [execsql {
           SELECT is_merging FROM dolt_merge_status;
           SELECT table_name FROM dolt_schema_conflicts;
           SELECT count(*) FROM dolt_constraint_violations;
         }]
  } [list 1 [list 1 t $violations]]
  do_execsql_test merge-txn-squash-schema-$violations-abort {
    SELECT dolt_merge('--abort');
    SELECT is_merging FROM dolt_merge_status;
    SELECT count(*) FROM dolt_schema_conflicts;
  } {0 0 0}
}

finish_test
