set testdir [file dirname $argv0]
source $testdir/tester.tcl

set testprefix doltlite-integrity-deep-history

do_test 1.0 {
  db eval {
    CREATE TABLE t(id INTEGER PRIMARY KEY, v TEXT);
    INSERT INTO t VALUES(1,'kept');
  }
  for {set i 0} {$i<40000} {incr i} {
    db eval {SELECT dolt_commit('-Am','history','--allow-empty')}
  }
  db one {SELECT count(*) FROM dolt_log}
} {40001}

do_execsql_test 1.1 {
  PRAGMA integrity_check;
  PRAGMA quick_check;
  SELECT * FROM t;
} {ok ok 1 kept}

db close
sqlite3 db test.db

do_execsql_test 1.2 {
  PRAGMA integrity_check(1);
  SELECT count(*) FROM dolt_log;
} {ok 40001}

do_execsql_test 1.3 {
  VACUUM;
  PRAGMA integrity_check;
  SELECT count(*) FROM dolt_log;
  SELECT * FROM t;
} {ok 40001 1 kept}

db close
forcedelete test.db
sqlite3 db test.db

do_test 2.0 {
  db eval {
    CREATE TABLE t(id INTEGER PRIMARY KEY, v TEXT);
    INSERT INTO t VALUES(1,'kept');
  }
  for {set i 0} {$i<80} {incr i} {
    db eval {SELECT dolt_commit('-Am','history','--allow-empty')}
    set branch "tip$i"
    db eval {SELECT dolt_branch($branch)}
  }
  db eval {PRAGMA integrity_check}
} {ok}

source $testdir/malloc_common.tcl
faultsim_save_and_close
do_faultsim_test 2.1 -faults oom-* -prep {
  faultsim_restore_and_reopen
  if {[db eval {PRAGMA integrity_check}] ne "ok"} {error "invalid fixture"}
} -body {
  db eval {PRAGMA integrity_check}
} -test {
  faultsim_test_result {0 ok} {1 {out of memory}}
  if {[db eval {SELECT * FROM t}] ne {1 kept}} {error "changed rows"}
  if {[db one {SELECT count(*) FROM dolt_log}] != 81} {error "changed history"}
  if {[db one {SELECT count(*) FROM dolt_branches}] != 81} {error "changed branches"}
  faultsim_integrity_check
}

finish_test
