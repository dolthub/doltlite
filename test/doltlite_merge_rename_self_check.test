set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix doltlite-merge-rename-self-check

# RENAME COLUMN rewrites the column's own CHECK and every other definition
# that names it. A merge must still see a rename, not a drop and an add.
foreach {name body ours cols rows} {
  generated
    {id INTEGER PRIMARY KEY, a INT DEFAULT 3 CHECK(a>=0), b INT,
     total INT GENERATED ALWAYS AS (a*b) STORED}
    {CREATE TABLE u(x)}
    {id,a2,b,total}
    {1 10 20 200 2 20 30 600}
  other-check
    {id INTEGER PRIMARY KEY, a INT CHECK(a>0), b INT CHECK(b>a)}
    {CREATE TABLE u(x)}
    {id,a2,b}
    {1 10 20 2 20 30}
  row-edit
    {id INTEGER PRIMARY KEY, a INT CHECK(a>0), b INT CHECK(b>a)}
    {UPDATE t SET b=99 WHERE id=1}
    {id,a2,b}
    {1 10 99 2 20 30}
  add-column
    {id INTEGER PRIMARY KEY, a INT CHECK(a>0), b INT}
    {ALTER TABLE t ADD COLUMN d}
    {id,a2,b,d}
    {1 10 20 {} 2 20 30 {}}
  add-column-unique
    {id INTEGER PRIMARY KEY, a INT CHECK(a>0), b INT, UNIQUE(a,b)}
    {ALTER TABLE t ADD COLUMN d}
    {id,a2,b,d}
    {1 10 20 {} 2 20 30 {}}
} {
  foreach {op cmd} {
    merge       {dolt_merge('br')}
    cherry-pick {dolt_cherry_pick('br')}
  } {
    reset_db
    do_test $name-$op-setup {
      db eval "CREATE TABLE t($body)"
      db eval {
        INSERT INTO t(id,a,b) VALUES (1,10,20),(2,20,30);
        SELECT dolt_commit('-Am','base');
        SELECT dolt_branch('br');
      }
      db eval $ours
      db eval {
        SELECT dolt_commit('-Am','ours');
        SELECT dolt_checkout('br');
        ALTER TABLE t RENAME COLUMN a TO a2;
        SELECT dolt_commit('-Am','theirs');
        SELECT dolt_checkout('main');
      }
      db eval "SELECT $cmd IS NOT NULL"
    } {1}
    do_test $name-$op-rows {
      db eval "SELECT $cols FROM t ORDER BY id"
    } $rows
    do_execsql_test $name-$op-integrity {
      PRAGMA integrity_check;
    } {ok}
  }
}

finish_test
