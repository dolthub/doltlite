set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix doltlite_delete_all

do_execsql_test 1.0 {
  CREATE TABLE t(id TEXT PRIMARY KEY, v INTEGER);
  CREATE INDEX t_v ON t(v);
  INSERT INTO t VALUES('a',1),('b',2),('c',3);
} {}

proc uses_clear {sql} {
  expr {[lsearch -exact [db eval "EXPLAIN $sql"] Clear]>=0}
}

foreach {name predicate} {
  one 1 nonzero 42 negative -7 positive +3 true TRUE parens ((1))
} {
  do_test 1.$name.plan {
    uses_clear "DELETE FROM t WHERE $predicate"
  } {1}
  do_test 1.$name.result {
    db eval "BEGIN; DELETE FROM t WHERE $predicate;"
    set result [db eval {
      SELECT changes(),count(*) FROM t;
      SELECT count(*) FROM t INDEXED BY t_v WHERE v>=0;
    }]
    db eval ROLLBACK
    set result
  } {3 0 0}
}

foreach {name predicate} {
  zero 0 false FALSE null NULL column v filter {v=2} parameter {$flag}
} {
  do_test 2.$name.plan {
    uses_clear "DELETE FROM t WHERE $predicate"
  } {0}
}

do_execsql_test 2.1 {
  DELETE FROM t WHERE 0;
  DELETE FROM t WHERE NULL;
  DELETE FROM t WHERE FALSE;
  SELECT count(*) FROM t;
  CREATE TABLE shadow(id INTEGER PRIMARY KEY, true INTEGER);
  INSERT INTO shadow VALUES(1,0),(2,1),(3,NULL);
  DELETE FROM shadow WHERE true;
  SELECT id FROM shadow ORDER BY id;
} {3 1 3}

do_test 2.2 {
  set flag 0
  db eval {DELETE FROM t WHERE $flag; SELECT count(*) FROM t;}
} {3}
do_test 2.3 {
  db eval BEGIN
  set flag 1
  set result [db eval {DELETE FROM t WHERE $flag; SELECT count(*) FROM t;}]
  db eval ROLLBACK
  set result
} {0}
do_test 2.4 {
  set flag 0
  db eval {DELETE FROM t WHERE $flag; SELECT count(*) FROM t;}
} {3}

do_execsql_test 3.1 {
  BEGIN;
  INSERT INTO t VALUES('d',4);
  SAVEPOINT s;
  DELETE FROM t WHERE 1;
  SELECT changes(),count(*) FROM t;
  INSERT INTO t VALUES('e',5);
  ROLLBACK TO s;
  SELECT id FROM t ORDER BY id;
  SELECT id FROM t INDEXED BY t_v WHERE v>=0 ORDER BY v;
  RELEASE s;
  ROLLBACK;
  SELECT id FROM t ORDER BY id;
} {4 0 a b c d a b c d a b c}

do_execsql_test 4.0 {
  CREATE TABLE audit(id TEXT);
  CREATE TRIGGER t_del AFTER DELETE ON t BEGIN
    INSERT INTO audit VALUES(old.id);
  END;
} {}
do_test 4.1 { uses_clear {DELETE FROM t WHERE 1} } {0}
do_execsql_test 4.2 {
  BEGIN;
  DELETE FROM t WHERE 1;
  SELECT changes(),count(*) FROM t;
  SELECT id FROM audit ORDER BY id;
  ROLLBACK;
  DROP TRIGGER t_del;
} {3 0 a b c}

do_test 5.1 { uses_clear {DELETE FROM t WHERE 1 RETURNING id} } {0}
do_test 5.2 {
  db eval BEGIN
  set result [lsort [db eval {DELETE FROM t WHERE 1 RETURNING id}]]
  db eval ROLLBACK
  set result
} {a b c}

do_execsql_test 6.0 {
  PRAGMA foreign_keys=ON;
  CREATE TABLE parent(id INTEGER PRIMARY KEY);
  CREATE TABLE child(id INTEGER PRIMARY KEY, p INTEGER REFERENCES parent(id));
  INSERT INTO parent VALUES(1),(2);
  INSERT INTO child VALUES(1,1);
} {}
do_test 6.1 { uses_clear {DELETE FROM parent WHERE 1} } {0}
do_catchsql_test 6.2 { DELETE FROM parent WHERE 1; }   {1 {FOREIGN KEY constraint failed}}
do_execsql_test 6.3 { SELECT id FROM parent ORDER BY id; } {1 2}

proc delete_auth {action args} {
  if {$action eq "SQLITE_DELETE"} { return SQLITE_IGNORE }
  return SQLITE_OK
}
do_test 7.1 {
  db authorizer delete_auth
  uses_clear {DELETE FROM t WHERE 1}
} {0}
do_execsql_test 7.2 {
  BEGIN;
  DELETE FROM t WHERE 1;
  SELECT changes(),count(*) FROM t;
  ROLLBACK;
} {3 0}
db authorizer {}

do_execsql_test 8.1 {
  CREATE TABLE ints(id INTEGER PRIMARY KEY, v TEXT);
  INSERT INTO ints VALUES(1,'a'),(2,'b');
  PRAGMA count_changes=ON;
  DELETE FROM ints WHERE 1;
  SELECT changes(),count(*) FROM ints;
  PRAGMA count_changes=OFF;
} {2 2 0}

ifcapable preupdate {
  proc delete_preupdate {args} { incr ::preupdates }
  do_test 9.1 {
    set ::preupdates 0
    db preupdate hook delete_preupdate
    uses_clear {DELETE FROM t WHERE 1}
  } {0}
  do_test 9.2 {
    db eval {BEGIN; DELETE FROM t WHERE 1; ROLLBACK;}
    set ::preupdates
  } {3}
  db preupdate hook {}
}

finish_test
