set testdir [file dirname $argv0]
source $testdir/tester.tcl

# Text that converts to the REAL nearest -2**63 stays REAL in an INTEGER,
# INT or NUMERIC column, as in SQLite; a REAL with that value becomes an
# integer. Rebuilding the record must not convert the text case a second
# time, on the table row or on an index key.
do_execsql_test record-affinity-1.1 {
  CREATE TABLE t(a INTEGER PRIMARY KEY, c INTEGER);
  CREATE INDEX ti ON t(c);
  INSERT INTO t VALUES(1,'-9223372036854775809'),(2,'-9.2233720368547758e18'),
                      (3,-9223372036854775808.0),(4,'5');
  SELECT a, typeof(c) FROM t ORDER BY a;
} {1 real 2 real 3 integer 4 integer}

do_execsql_test record-affinity-1.2 {
  UPDATE t SET c='-9223372036854775809' WHERE a=4;
  SELECT typeof(c) FROM t WHERE a=4;
  SELECT count(*) FROM t INDEXED BY ti WHERE c < -9.2e18;
  PRAGMA integrity_check;
} {real 4 ok}

do_execsql_test record-affinity-1.3 {
  CREATE TABLE u(k TEXT PRIMARY KEY, n NUMERIC, i INT, r REAL);
  CREATE INDEX un ON u(n);
  INSERT INTO u VALUES('x','-9223372036854775809','-9223372036854775809',3.0);
  INSERT INTO u VALUES('y','12','13','4');
  SELECT k, typeof(n), typeof(i), typeof(r), quote(r) FROM u ORDER BY k;
  PRAGMA integrity_check;
} {x real real real 3.0 y integer integer real 4.0 ok}

finish_test
