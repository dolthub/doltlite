set testdir [file dirname $argv0]
source $testdir/tester.tcl

# Text that converts to the REAL nearest -2**63 stays REAL in an INTEGER,
# INT or NUMERIC column, as in SQLite; a REAL with that value becomes an
# integer. Rebuilding the record must not convert the text case a second
# time, on the table row or on an index key.
do_execsql_test record-affinity-1.1 {
  CREATE TABLE t(a INTEGER PRIMARY KEY, c INTEGER);
  CREATE INDEX ti ON t(c);
  INSERT INTO t VALUES(1,'-9223372036854775809'),(2,'-9.2233720368547758e18'),
                      (3,-9223372036854775808.0),(4,'5');
  SELECT a, typeof(c) FROM t ORDER BY a;
} {1 real 2 real 3 integer 4 integer}

do_execsql_test record-affinity-1.2 {
  UPDATE t SET c='-9223372036854775809' WHERE a=4;
  SELECT typeof(c) FROM t WHERE a=4;
  SELECT count(*) FROM t INDEXED BY ti WHERE c < -9.2e18;
  PRAGMA integrity_check;
} {real 4 ok}

do_execsql_test record-affinity-1.3 {
  CREATE TABLE u(k TEXT PRIMARY KEY, n NUMERIC, i INT, r REAL);
  CREATE INDEX un ON u(n);
  INSERT INTO u VALUES('x','-9223372036854775809','-9223372036854775809',3.0);
  INSERT INTO u VALUES('y','12','13','4');
  SELECT k, typeof(n), typeof(i), typeof(r), quote(r) FROM u ORDER BY k;
  PRAGMA integrity_check;
} {x real real real 3.0 y integer integer real 4.0 ok}

foreach {layout id suffix} {
  rowid {INTEGER PRIMARY KEY} {}
  clustered {TEXT PRIMARY KEY} {}
  keyless TEXT {}
  without-rowid {TEXT PRIMARY KEY} {WITHOUT ROWID}
} {
  foreach guard {none progress check foreign generated short} {
    foreach {default expected} {
      {1} integer
      {'-9223372036854775809'} real
    } {
      set prefix "record-affinity-add-$layout-$guard-$expected"
      set hashes {}
      foreach path {direct alter} {
        reset_db
        set constraint {}
        set constraintId {}
        if {$guard eq "check"} {set constraint {CHECK(c IS NOT NULL)}}
        if {$guard eq "foreign"} {
          execsql {CREATE TABLE parent(id TEXT PRIMARY KEY); INSERT INTO parent VALUES('1')}
          set constraintId { REFERENCES parent(id)}
        }
        set column {}
        if {$path eq "direct"} {set column ", x NUMERIC DEFAULT $default"}
        execsql "CREATE TABLE t(id $id $constraintId, c INT $constraint, r REAL $column) $suffix"
        execsql {
          CREATE INDEX i ON t(CAST(c AS TEXT));
          CREATE INDEX ci ON t(c);
          INSERT INTO t(id,c,r) VALUES('1','-9223372036854775809',3);
        }
        if {$guard eq "generated"} {
          execsql {ALTER TABLE t ADD COLUMN g TEXT AS (CAST(c AS TEXT))}
        }
        if {$guard eq "short"} {execsql {ALTER TABLE t ADD COLUMN padding TEXT}}
        if {$path eq "alter"} {
          if {$guard eq "progress"} {db progress 1 {expr 0}}
          execsql "ALTER TABLE t ADD COLUMN x NUMERIC DEFAULT $default"
          db progress 0 {}
        }
        foreach phase {pending committed reopened} {
          if {$phase eq "committed"} {execsql {SELECT dolt_commit('-Am','add default')}}
          if {$phase eq "reopened"} {db close; sqlite3 db test.db}
          do_execsql_test $prefix-$path-$phase {
            SELECT typeof(c), typeof(r), typeof(x) FROM t;
            SELECT count(*) FROM t INDEXED BY i WHERE CAST(c AS TEXT)='-9.2233720368547758e+18';
            SELECT count(*) FROM t INDEXED BY ci WHERE c<-9.2e18;
            PRAGMA integrity_check;
          } [list real real $expected 1 1 ok]
        }
        lappend hashes [db one {SELECT dolt_hashof_table('t')}]
        do_execsql_test $prefix-$path-affinity-restored {
          UPDATE t SET c='12';
          SELECT typeof(c) FROM t;
          PRAGMA integrity_check;
        } {integer ok}
      }
      if {$guard ni {short generated}} {
        do_test $prefix-hash {expr {[lindex $hashes 0] eq [lindex $hashes 1]}} {1}
      }
    }
  }
}

finish_test
