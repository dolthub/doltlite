set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix doltlite-rebase-io

execsql {
  CREATE TABLE t(id INTEGER PRIMARY KEY,v TEXT);
  WITH RECURSIVE c(x) AS(SELECT 1 UNION ALL SELECT x+1 FROM c WHERE x<300)
    INSERT INTO t SELECT x,printf('v%05d-%s',x,hex(zeroblob(40))) FROM c;
  CREATE TABLE u(k TEXT PRIMARY KEY,n INT);
  INSERT INTO u VALUES('a',1),('b',2);
  SELECT dolt_commit('-Am','init');
  SELECT dolt_checkout('-b','feat');
  INSERT INTO t VALUES(1001,'f1');
  UPDATE u SET n=20 WHERE k='b';
  SELECT dolt_commit('-am','feat1');
  SELECT dolt_checkout('main');
  UPDATE t SET v='m' WHERE id=5;
  SELECT dolt_commit('-am','main2');
  SELECT dolt_checkout('feat');
  INSERT INTO t VALUES(1003,'f3');
  SELECT dolt_commit('-am','feat2');
  SELECT dolt_checkout('main');
}
db close
file copy -force test.db rebase-io-base.db

proc rebase_io {method filename args} {
  if {$::armed && $method eq "xWrite"} {
    incr ::written [lindex $args 2]
    if {$::written>$::limit} {
      if {$::persistent} {
        rebaseio full 1 1
      } else {
        set ::armed 0
        return SQLITE_IOERR
      }
    }
  }
  return SQLITE_OK
}
testvfs rebaseio
rebaseio filter xWrite
rebaseio script rebase_io
set armed 0

# A rebase publishes once, when it finishes. A disk that fills before then
# leaves nothing behind: no working branch, no half-applied history, and no
# rebase to abort, so the same rebase succeeds once space is back.
foreach {reopen limit} {0 2048 1 2048 0 4096 1 4096} {
  forcedelete test.db
  file copy -force rebase-io-base.db test.db
  sqlite3 db test.db -vfs rebaseio
  execsql {SELECT dolt_checkout('feat')}
  set head [db one {SELECT dolt_hashof('HEAD')}]
  set written 0
  set persistent 1
  set armed 1
  do_test full.$limit.$reopen.error {
    set caught [catch {db eval {SELECT dolt_rebase('main')}} message]
    list $caught [sqlite3_errcode db] \
         [string match {*cleanup failed*} $message]
  } {1 SQLITE_FULL 0}
  set armed 0
  rebaseio full
  if {$reopen} {
    db close
    sqlite3 db test.db -vfs rebaseio
    execsql {SELECT dolt_checkout('feat')}
  }
  do_test full.$limit.$reopen.unchanged {
    list [expr {[db one {SELECT dolt_hashof('HEAD')}] eq $head}] \
         [db eval {SELECT id,v FROM t WHERE id>300 ORDER BY id}] \
         [db one {SELECT count(*) FROM dolt_branches WHERE name='dolt_rebase_feat'}] \
         [db one {SELECT active_branch()}]
  } {1 {1001 f1 1003 f3} 0 feat}
  do_test full.$limit.$reopen.nothing-to-abort {
    catchsql {SELECT dolt_rebase('--abort')}
  } {1 {no rebase in progress}}
  do_test full.$limit.$reopen.retry {
    db eval {SELECT dolt_rebase('main')}
    db eval {
      SELECT v FROM t WHERE id=5;
      SELECT n FROM u WHERE k='b';
      SELECT count(*) FROM dolt_status;
      SELECT count(*) FROM dolt_branches WHERE name='dolt_rebase_feat';
      PRAGMA integrity_check;
    }
  } {m 20 0 0 ok}
  db close
}

foreach reopen {0 1} {
  set limit 2048
  forcedelete test.db
  file copy -force rebase-io-base.db test.db
  sqlite3 db test.db -vfs rebaseio
  execsql {SELECT dolt_checkout('feat')}
  set head [db one {SELECT dolt_hashof('HEAD')}]
  set written 0
  set persistent 0
  set armed 1
  do_test ioerr.$reopen.error {
    set caught [catch {db eval {SELECT dolt_rebase('main')}} message]
    list $caught [sqlite3_errcode db] [string match {*cleanup failed*} $message]
  } {1 SQLITE_IOERR 0}
  set armed 0
  if {$reopen} {
    db close
    sqlite3 db test.db -vfs rebaseio
    execsql {SELECT dolt_checkout('feat')}
  }
  do_test ioerr.$reopen.cleaned {
    list [expr {[db one {SELECT dolt_hashof('HEAD')}] eq $head}] \
         [db one {SELECT count(*) FROM dolt_branches WHERE name='dolt_rebase_feat'}] \
         [db one {SELECT active_branch()}] \
         [db one {SELECT count(*) FROM dolt_status}]
  } {1 0 feat 0}
  do_test ioerr.$reopen.retry {
    db eval {SELECT dolt_rebase('main')}
    db eval {SELECT v FROM t WHERE id=5; PRAGMA integrity_check}
  } {m ok}
  db close
}

forcedelete test.db
file copy -force rebase-io-base.db test.db
sqlite3 db test.db -vfs rebaseio
execsql {SELECT dolt_checkout('feat'); SELECT dolt_branch('dolt_rebase_feat')}
set branches [db eval {SELECT name,hash FROM dolt_branches ORDER BY name}]
do_test existing.refuse {
  set caught [catch {db eval {SELECT dolt_rebase('main')}} message]
  list $caught [sqlite3_errcode db] \
       [string match {*working branch already exists*} $message] \
       [string match {*branch restored*} $message] \
       [expr {[db eval {SELECT name,hash FROM dolt_branches ORDER BY name}] eq $branches}]
} {1 SQLITE_BUSY 1 0 1}
do_catchsql_test existing.abort {SELECT dolt_rebase('--abort')} {1 {no rebase in progress}}
do_test existing.kept {
  expr {[db eval {SELECT name,hash FROM dolt_branches ORDER BY name}] eq $branches}
} 1
db close

foreach length {63 64} {
  forcedelete test.db
  file copy -force rebase-io-base.db test.db
  sqlite3 db test.db -vfs rebaseio
  set branch [string repeat f $length]
  execsql {SELECT dolt_branch('-m','feat',$branch); SELECT dolt_checkout($branch)}
  if {$length==63} {
    do_test name.$length.rebase {
      db eval {SELECT dolt_rebase('main')}
      db one {SELECT v FROM t WHERE id=5}
    } m
  } else {
    do_catchsql_test name.$length.refuse {
      SELECT dolt_rebase('main');
    } {1 {cannot start rebase: current branch name exceeds the 63-byte persisted-state limit}}
    do_execsql_test name.$length.atomic {
      SELECT count(*) FROM dolt_branches;
      SELECT v FROM t WHERE id=1003;
      SELECT count(*) FROM dolt_status;
    } {2 f3 0}
  }
  db close
}

# Interactive rebase paused on conflict: commit error in --continue must
# preserve customized plan actions and messages in dolt_rebase.
forcedelete test.db
sqlite3 db test.db -vfs rebaseio
execsql {
  CREATE TABLE t(id INTEGER PRIMARY KEY, v INT);
  INSERT INTO t VALUES(1, 1);
  SELECT dolt_commit('-Am', 'base');
  SELECT dolt_checkout('-b', 'feat');
  UPDATE t SET v = 2 WHERE id = 1;
  SELECT dolt_commit('-am', 'f1');
  INSERT INTO t VALUES(2, 20);
  SELECT dolt_commit('-am', 'f2');
  INSERT INTO t VALUES(3, 30);
  SELECT dolt_commit('-am', 'f3');
  INSERT INTO t VALUES(4, 40);
  SELECT dolt_commit('-am', 'f4');
  INSERT INTO t VALUES(5, 50);
  SELECT dolt_commit('-am', 'f5');
  SELECT dolt_checkout('main');
  UPDATE t SET v = 9 WHERE id = 1;
  SELECT dolt_commit('-am', 'main diverge');
  SELECT dolt_checkout('feat');
  SELECT dolt_rebase('-i', 'main');
  UPDATE dolt_rebase SET action = 'reword', commit_message = 'f2 custom' WHERE commit_message = 'f2';
  UPDATE dolt_rebase SET action = 'squash' WHERE commit_message = 'f3';
  UPDATE dolt_rebase SET action = 'fixup' WHERE commit_message = 'f4';
  UPDATE dolt_rebase SET action = 'drop' WHERE commit_message = 'f5';
  BEGIN;
}
do_test paused.commit_err.pause {
  set res [catchsql {SELECT dolt_rebase('--continue')}]
  list [lindex $res 0] [db one {SELECT count(*) FROM dolt_conflicts}]
} {1 1}
set expected_plan [db eval {
  SELECT rebase_order, action, commit_hash, commit_message
  FROM dolt_rebase ORDER BY rebase_order
}]
execsql {
  SELECT dolt_conflicts_resolve('--theirs', 't');
  SELECT dolt_add('.');
}
set written 0
set limit 0
set persistent 0
set armed 1
do_test paused.commit_err.fail {
  set caught [catch {db eval {SELECT dolt_rebase('--continue')}} message]
  list $caught [sqlite3_errcode db]
} {1 SQLITE_IOERR}
set armed 0
do_test paused.commit_err.plan_preserved {
  set actual_plan [db eval {
    SELECT rebase_order, action, commit_hash, commit_message
    FROM dolt_rebase ORDER BY rebase_order
  }]
  list [expr {$actual_plan eq $expected_plan}] \
       [db eval {SELECT action, commit_message FROM dolt_rebase ORDER BY rebase_order}]
} {1 {pick f1 reword {f2 custom} squash f3 fixup f4 drop f5}}
do_test paused.commit_err.retry {
  db eval {
    ROLLBACK;
    BEGIN;
    UPDATE t SET v = 2 WHERE id = 1;
    SELECT dolt_add('t');
  }
  set res [catchsql {SELECT dolt_rebase('--continue')}]
  db eval {COMMIT}
  list [lindex $res 0] \
       [string match {*Successfully rebased*} [lindex $res 1]] \
       [db one {SELECT active_branch()}] \
       [db eval {SELECT id, v FROM t ORDER BY id}] \
       [db eval {SELECT message FROM dolt_log WHERE message NOT LIKE 'Initialize%'}] \
       [db one {PRAGMA integrity_check}]
} [list 0 1 feat {1 2 2 20 3 30 4 40} [list "f2 custom\n\nf3" f1 {main diverge} base] ok]
db close

# Paused rebase: error in rebaseFinishPaused must keep dolt_rebase intact
# so a subsequent --continue succeeds once the error clears.
forcedelete test.db
sqlite3 db test.db -vfs rebaseio
execsql {
  CREATE TABLE t(id INTEGER PRIMARY KEY, v INT);
  INSERT INTO t VALUES(1, 1);
  SELECT dolt_commit('-Am', 'base');
  SELECT dolt_checkout('-b', 'feat');
  UPDATE t SET v = 2 WHERE id = 1;
  SELECT dolt_commit('-am', 'f1');
  SELECT dolt_checkout('main');
  UPDATE t SET v = 9 WHERE id = 1;
  SELECT dolt_commit('-am', 'main diverge');
  SELECT dolt_checkout('feat');
  BEGIN;
}
do_test paused.finish_err.pause {
  set res [catchsql {SELECT dolt_rebase('main')}]
  list [lindex $res 0] [db one {SELECT count(*) FROM dolt_conflicts}]
} {1 1}
execsql {
  SELECT dolt_conflicts_resolve('--ours', 't');
  SELECT dolt_add('.');
}
set written 0
set limit 0
set persistent 0
set armed 1
do_test paused.finish_err.fail {
  set caught [catch {db eval {SELECT dolt_rebase('--continue')}} message]
  list $caught [sqlite3_errcode db]
} {1 SQLITE_IOERR}
set armed 0
do_test paused.finish_err.plan_present {
  list [db one {SELECT active_branch()}] \
       [db one {SELECT count(*) FROM sqlite_schema WHERE name='dolt_rebase'}] \
       [db one {SELECT count(*) FROM dolt_rebase}]
} {dolt_rebase_feat 1 0}
do_test paused.finish_err.retry {
  set res [catchsql {SELECT dolt_rebase('--continue')}]
  db eval {COMMIT}
  list [lindex $res 0] \
       [string match {*Successfully rebased*} [lindex $res 1]] \
       [db one {SELECT active_branch()}] \
       [db one {SELECT count(*) FROM dolt_branches WHERE name='dolt_rebase_feat'}] \
       [db one {SELECT count(*) FROM sqlite_schema WHERE name='dolt_rebase'}] \
       [db eval {SELECT id, v FROM t ORDER BY id}] \
       [db one {PRAGMA integrity_check}]
} {0 1 feat 0 0 {1 9} ok}
db close

# Paused rebase: CAS failure (SQLITE_BUSY) in rebaseFinishPaused when peer
# advances original branch must keep dolt_rebase intact for retry or --abort.
forcedelete test.db
sqlite3 db test.db -vfs rebaseio
execsql {
  CREATE TABLE t(id INTEGER PRIMARY KEY, v INT);
  INSERT INTO t VALUES(1, 1);
  SELECT dolt_commit('-Am', 'base');
  SELECT dolt_checkout('-b', 'feat');
  UPDATE t SET v = 2 WHERE id = 1;
  SELECT dolt_commit('-am', 'f1');
  SELECT dolt_checkout('main');
  UPDATE t SET v = 9 WHERE id = 1;
  SELECT dolt_commit('-am', 'main diverge');
  SELECT dolt_checkout('feat');
  SELECT dolt_rebase('-i', 'main');
}
sqlite3 peer "[file normalize test.db]/feat"
peer eval {
  INSERT INTO t VALUES(99, 99);
  SELECT dolt_commit('-am', 'peer commit');
}
peer close
execsql {BEGIN}
do_test paused.finish_cas.pause {
  set res [catchsql {SELECT dolt_rebase('--continue')}]
  list [lindex $res 0] [db one {SELECT count(*) FROM dolt_conflicts}]
} {1 1}
execsql {
  SELECT dolt_conflicts_resolve('--theirs', 't');
  SELECT dolt_add('.');
}
do_test paused.finish_cas.busy {
  set caught [catch {db eval {SELECT dolt_rebase('--continue')}} message]
  list $caught [sqlite3_errcode db] \
       [db one {SELECT count(*) FROM sqlite_schema WHERE name='dolt_rebase'}] \
       [db one {SELECT count(*) FROM dolt_rebase}]
} {1 SQLITE_BUSY 1 0}
do_test paused.finish_cas.retry_still_busy {
  set caught [catch {db eval {SELECT dolt_rebase('--continue')}} message]
  list $caught [sqlite3_errcode db] \
       [db one {SELECT count(*) FROM sqlite_schema WHERE name='dolt_rebase'}]
} {1 SQLITE_BUSY 1}
do_test paused.finish_cas.abort {
  set res [catchsql {SELECT dolt_rebase('--abort')}]
  db eval {COMMIT}
  list [lindex $res 0] \
       [string match {*aborted*} [lindex $res 1]] \
       [db one {SELECT active_branch()}] \
       [db one {SELECT count(*) FROM dolt_branches WHERE name='dolt_rebase_feat'}] \
       [db eval {SELECT id, v FROM t ORDER BY id}] \
       [db one {PRAGMA integrity_check}]
} {0 1 feat 0 {1 2 99 99} ok}
db close

rebaseio delete
forcedelete rebase-io-base.db
finish_test
