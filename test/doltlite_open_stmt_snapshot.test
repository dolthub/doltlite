set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix doltlite_open_stmt_snapshot

# capi2-6.x under stock WAL semantics: a statement left open pins the
# connection's snapshot, so a peer's later write makes this connection's
# writes stale until the statement finishes.
do_execsql_test 1.0 {
  CREATE TABLE t1(a PRIMARY KEY, b, c);
  INSERT INTO t1 VALUES(1,2,3);
  CREATE TABLE t3(x);
  INSERT INTO t3 VALUES(1),(2),(3),(4);
} {}

do_test 1.1 {
  set VM1 [sqlite3_prepare_v2 db {SELECT x FROM t3} -1 TAIL]
  sqlite3_step $VM1
} {SQLITE_ROW}

do_test 1.2 {
  sqlite3 db2 test.db
  catchsql {INSERT INTO t3 VALUES(10)} db2
} {0 {}}

do_execsql_test 1.3 {SELECT count(*) FROM t3} {4}

do_test 1.4 {
  set rc [catch {db eval {UPDATE t1 SET b=b+1}} msg]
  list $rc $msg [sqlite3_extended_errcode db]
} {1 {database is locked} SQLITE_BUSY_SNAPSHOT}

do_test 1.5 {
  sqlite3_step $VM1
} {SQLITE_ROW}

do_test 1.6 {
  sqlite3_finalize $VM1
} {SQLITE_OK}

do_execsql_test 1.7 {SELECT count(*) FROM t3} {5}
do_execsql_test 1.8 {
  UPDATE t1 SET b=b+1;
  SELECT b FROM t1;
} {3}

db2 close
finish_test
