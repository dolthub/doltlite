set testdir [file dirname $argv0]
source $testdir/tester.tcl

foreach {layout key} {rowid {INTEGER PRIMARY KEY} clustered {INT PRIMARY KEY}} {
  foreach {index ddl} {
    ordinary {CREATE INDEX it ON t(n)}
    unique {CREATE UNIQUE INDEX it ON t(n)}
    partial {CREATE INDEX it ON t(n) WHERE n IS NOT NULL}
    expression {CREATE INDEX it ON t(n+1)}
  } {
    foreach operation {rebase interactive cherry-pick revert} {
      foreach txn {autocommit begin savepoint nested} {
        reset_db
        db eval "CREATE TABLE t(id $key,n INT)"
        db eval $ddl
        db eval {
          INSERT INTO t VALUES(1,10);
          SELECT dolt_commit('-Am','base');
          SELECT dolt_checkout('-b','feature');
          ALTER TABLE t RENAME TO s;
          SELECT dolt_commit('-Am','rename table');
          SELECT dolt_checkout('main');
          ALTER TABLE t ADD COLUMN x TEXT;
          SELECT dolt_commit('-Am','add column');
        }
        set branch feature
        switch $operation {
          rebase {set sql {SELECT dolt_rebase('main')}}
          interactive {
            set sql {
              SELECT dolt_rebase('-i','main');
              SELECT dolt_rebase('--continue');
            }
          }
          cherry-pick {
            set branch main
            set sql {SELECT dolt_cherry_pick('feature')}
          }
          revert {
            db eval {
              SELECT dolt_checkout('feature');
              ALTER TABLE s ADD COLUMN x TEXT;
              SELECT dolt_commit('-Am','add column after rename');
            }
            set sql {SELECT dolt_revert('HEAD~1')}
          }
        }
        db eval "SELECT dolt_checkout('$branch')"
        set table [expr {$branch eq "feature" ? "s" : "t"}]
        set state "SELECT * FROM $table ORDER BY id;\n"
        append state "SELECT id FROM $table INDEXED BY it WHERE n+1=11;\n"
        append state {
          SELECT active_branch();
          SELECT name,tbl_name,sql FROM sqlite_schema ORDER BY type,name;
          SELECT dolt_hashof('HEAD');
          SELECT dolt_hashof_catalog('STAGED');
          SELECT table_name,staged,status FROM dolt_status ORDER BY table_name,staged;
          SELECT count(*) FROM dolt_conflicts;
          PRAGMA integrity_check;
        }
        set expected [db eval $state]
        set head [db eval {SELECT name,hash FROM dolt_branches ORDER BY name}]
        switch $txn {
          begin {db eval BEGIN}
          savepoint {db eval {SAVEPOINT caller}}
          nested {db eval {BEGIN; SAVEPOINT caller}}
        }
        set prefix replay-schema-$layout.$index.$operation.$txn
        set error {cannot apply: schema conflicts detected}
        if {$operation eq "interactive"} {
          set error "rebase failed — $error — branch restored to pre-rebase state"
        }
        do_test $prefix.refused {catchsql $sql} [list 1 $error]
        do_test $prefix.state {catchsql $state} [list 0 $expected]
        do_execsql_test $prefix.refs {
          SELECT name,hash FROM dolt_branches ORDER BY name;
        } $head
        catch {db eval ROLLBACK}
        do_test $prefix.rollback {catchsql $state} [list 0 $expected]
        db close
        sqlite3 db test.db/$branch
        do_test $prefix.reopen {catchsql $state} [list 0 $expected]
      }
    }
  }
}

foreach key {INTEGER INT} {
  foreach {kind type default first second value} {
    zero INT 0 9 7 0
    five INT 5 9 7 5
    text TEXT 'none' 'high' 'medium' none
  } {
    foreach stored {0 1} {
      reset_db
      execsql "CREATE TABLE t(id $key PRIMARY KEY,name TEXT)"
      execsql {
        INSERT INTO t VALUES(1,'a'),(2,'b');
        SELECT dolt_commit('-Am','base');
        SELECT dolt_branch('feature');
      }
      execsql "ALTER TABLE t ADD COLUMN priority $type NOT NULL DEFAULT $default"
      if {$stored} {execsql "UPDATE t SET priority=$default"}
      execsql {
        SELECT dolt_commit('-Am','add priority');
      }
      execsql "UPDATE t SET priority=$first WHERE id=1; INSERT INTO t VALUES(3,'c',$second)"
      execsql {
        SELECT dolt_commit('-Am','set priority');
        SELECT dolt_checkout('feature');
      }
      execsql "ALTER TABLE t ADD COLUMN score $type NOT NULL DEFAULT $default"
      if {$stored} {execsql "UPDATE t SET score=$default"}
      execsql {SELECT dolt_commit('-Am','add score')}
      set head [execsql {SELECT dolt_hashof('HEAD')}]
      set name independent-columns-$key-$kind-$stored
      do_test $name-refused {
        set result [catchsql {SELECT dolt_cherry_pick('main')}]
        list [lindex $result 0] [string match {*ambiguous ancestry*} [lindex $result 1]]
      } {1 1}
      do_execsql_test $name-rows {SELECT id,name,score FROM t ORDER BY id} [list 1 a $value 2 b $value]
      do_execsql_test $name-schema {SELECT name FROM pragma_table_info('t')} {id name score}
      do_execsql_test $name-head {SELECT dolt_hashof('HEAD')} $head
      db close
      sqlite3 db test.db/feature
      do_execsql_test $name-reopen {
        SELECT id,name,score FROM t ORDER BY id;
        PRAGMA integrity_check;
      } [list 1 a $value 2 b $value ok]
    }
  }
}
foreach key {INTEGER INT} {
  foreach direction {forward reverse} {
    reset_db
    execsql "CREATE TABLE t(id $key PRIMARY KEY,cd INT)"
    execsql {
      SELECT dolt_commit('-Am','base');
      SELECT dolt_branch('side');
      ALTER TABLE t ADD COLUMN n1 INT;
      ALTER TABLE t DROP COLUMN cd;
      SELECT dolt_commit('-Am','replace column');
      SELECT dolt_checkout('side');
      INSERT INTO t VALUES(1,7);
      SELECT dolt_commit('-Am','insert');
    }
    set target side
    set branch main
    if {$direction eq "reverse"} {set target main; set branch side}
    execsql "SELECT dolt_checkout('$branch')"
    set before [execsql {SELECT * FROM t; SELECT dolt_hashof('HEAD')}]
    set name empty-column-replacement-$key-$direction
    do_test $name-refused {
      set result [catchsql "SELECT dolt_merge('$target')"]
      list [lindex $result 0] [string match {*ambiguous ancestry*} [lindex $result 1]]
    } {1 1}
    do_test $name-unchanged {execsql {SELECT * FROM t; SELECT dolt_hashof('HEAD')}} $before
    do_execsql_test $name-integrity {PRAGMA integrity_check} {ok}
  }
}

foreach key {INTEGER INT} {
  foreach empty {0 1} {
    reset_db
    execsql "CREATE TABLE t(id $key PRIMARY KEY,cd INT)"
    if {!$empty} {execsql {INSERT INTO t VALUES(1,NULL)}}
    execsql {
      SELECT dolt_commit('-Am','base');
      ALTER TABLE t ADD COLUMN n1 INT;
      ALTER TABLE t DROP COLUMN cd;
    }
    set change [execsql {SELECT dolt_commit('-Am','replace column')}]
    if {$empty} {
      execsql {INSERT INTO t VALUES(1,7)}
    } else {
      execsql {UPDATE t SET n1=7}
    }
    execsql {SELECT dolt_commit('-Am','set new value')}
    set head [execsql {SELECT dolt_hashof('HEAD')}]
    set name revert-column-replacement-$key-$empty
    do_test $name-refused {
      set result [catchsql "SELECT dolt_revert('$change')"]
      list [lindex $result 0] [string match {*ambiguous ancestry*} [lindex $result 1]]
    } {1 1}
    do_execsql_test $name-rows {SELECT id,n1 FROM t} {1 7}
    do_execsql_test $name-head {SELECT dolt_hashof('HEAD')} $head
    do_execsql_test $name-schema {SELECT name FROM pragma_table_info('t')} {id n1}
  }
}

finish_test
