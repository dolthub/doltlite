set testdir [file dirname $argv0]
source $testdir/tester.tcl

foreach keymode {integer clustered text without-rowid composite keyless} {
  set key {id INTEGER PRIMARY KEY}
  set extra {}
  set constraint {}
  set suffix {}
  if {$keymode eq "clustered"} {set key {id INT PRIMARY KEY}}
  if {$keymode in {text without-rowid}} {set key {id TEXT PRIMARY KEY}}
  if {$keymode eq "without-rowid"} {set suffix {WITHOUT ROWID}}
  if {$keymode eq "composite"} {
    set key {id INT}
    set extra {tenant TEXT DEFAULT 'x',}
    set constraint {,PRIMARY KEY(tenant,id)}
    set suffix {WITHOUT ROWID}
  }
  if {$keymode eq "keyless"} {set key {id INT}}
  set query {SELECT * FROM t ORDER BY 1}
  if {$keymode eq "keyless"} {set query {SELECT rowid,* FROM t ORDER BY rowid}}

  foreach kind {rename-add swap reuse pk-rename pk-rename-add rename-drop rename-default drop add} {
    reset_db
    set columns {a INT,b INT}
    if {$kind eq "reuse"} {set columns {a INT}}
    execsql "CREATE TABLE t($key,$extra$columns$constraint) $suffix"
    if {$kind eq "reuse"} {
      execsql {INSERT INTO t(id,a) VALUES(1,10),(2,20),(3,30)}
    } else {
      execsql {INSERT INTO t(id,a,b) VALUES(1,10,100),(2,20,200),(3,30,300)}
    }
    execsql {
      CREATE INDEX ia ON t(a);
      SELECT dolt_commit('-Am','base');
    }
    set base [execsql $query]
    set baseSchema [execsql {
      SELECT type,name,sql FROM sqlite_schema WHERE tbl_name='t' ORDER BY type,name;
    }]
    switch $kind {
      rename-add {
        execsql {
          ALTER TABLE t RENAME COLUMN b TO bb;
          ALTER TABLE t ADD COLUMN c INT;
          UPDATE t SET c=1 WHERE id=1;
        }
      }
      swap {
        execsql {
          ALTER TABLE t RENAME COLUMN a TO tmp;
          ALTER TABLE t RENAME COLUMN b TO a;
          ALTER TABLE t RENAME COLUMN tmp TO b;
        }
      }
      reuse {
        execsql {
          ALTER TABLE t RENAME COLUMN a TO b;
          ALTER TABLE t ADD COLUMN a INT;
        }
      }
      pk-rename - pk-rename-add {
        execsql {
          ALTER TABLE t RENAME COLUMN id TO pk;
          UPDATE t SET a=21 WHERE pk=2;
          DELETE FROM t WHERE pk=1;
          INSERT INTO t(pk,a,b) VALUES(4,40,400);
        }
        if {$kind eq "pk-rename-add"} {
          execsql {ALTER TABLE t ADD COLUMN c INT}
        }
      }
      rename-drop {
        execsql {
          ALTER TABLE t RENAME COLUMN a TO aa;
          ALTER TABLE t DROP COLUMN b;
          UPDATE t SET aa=21 WHERE id=2;
        }
      }
      rename-default {
        execsql {
          ALTER TABLE t RENAME COLUMN b TO bb;
          ALTER TABLE t ADD COLUMN c INT NOT NULL DEFAULT 7;
          UPDATE t SET c=1 WHERE id=1;
        }
      }
      drop {
        execsql {
          ALTER TABLE t DROP COLUMN b;
          UPDATE t SET a=21 WHERE id=2;
          DELETE FROM t WHERE id=1;
          INSERT INTO t(id,a) VALUES(4,40);
        }
      }
      add {
        execsql {
          ALTER TABLE t ADD COLUMN c INT DEFAULT 7;
          UPDATE t SET c=1 WHERE id=1;
          DELETE FROM t WHERE id=2;
          INSERT INTO t(id,a,b,c) VALUES(4,40,400,4);
        }
      }
    }
    execsql {SELECT dolt_commit('-Am','target')}
    set target [execsql $query]
    set targetSchema [execsql {
      SELECT type,name,sql FROM sqlite_schema WHERE tbl_name='t' ORDER BY type,name;
    }]
    set forward [execsql {
      SELECT statement FROM dolt_patch('HEAD~1','HEAD') ORDER BY statement_order;
    }]
    set reverse [execsql {
      SELECT statement FROM dolt_patch('HEAD','HEAD~1') ORDER BY statement_order;
    }]
    execsql {SELECT dolt_reset('--hard','HEAD~1')}
    foreach direction {forward reverse} expected [list $target $base] \
        schema [list $targetSchema $baseSchema] {
      set name patch-column-$keymode-$kind-$direction
      do_test $name-apply {
        foreach statement [set $direction] {execsql $statement}
        execsql $query
      } $expected
      do_execsql_test $name-schema {
        SELECT type,name,sql FROM sqlite_schema WHERE tbl_name='t' ORDER BY type,name;
      } $schema
      do_execsql_test $name-integrity {PRAGMA integrity_check} {ok}
      do_test $name-reopen {
        db close
        sqlite3 db test.db
        execsql $query
      } $expected
    }
  }
}

finish_test
