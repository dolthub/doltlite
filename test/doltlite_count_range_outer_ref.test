set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix doltlite-count-range-outer-ref

# The range-count shortcut applies to a BETWEEN over the counted table's
# own column. The same table under an outer alias is constant per outer
# row: the count is every inner row or none.
do_execsql_test 1.0 {
  CREATE TABLE t(id INTEGER PRIMARY KEY, a INT, n INT);
  CREATE INDEX ta ON t(a);
  INSERT INTO t VALUES(1,10,1),(2,20,NULL),(3,30,3),(4,40,NULL),(5,50,5),(6,60,6);
}

do_execsql_test 1.1 {
  SELECT (SELECT count(*) FROM t AS i WHERE o.id BETWEEN 1 AND 3)
    FROM t AS o ORDER BY o.id;
} {6 6 6 0 0 0}

do_execsql_test 1.2 {
  SELECT (SELECT count(*) FROM t AS i WHERE o.a BETWEEN 10 AND 40)
    FROM t AS o ORDER BY o.id;
} {6 6 6 6 0 0}

# An aggregate over an outer column belongs to the outer query.
do_execsql_test 1.3 {
  SELECT (SELECT count(o.n) FROM t AS i WHERE i.id BETWEEN 1 AND 3)
    FROM t AS o ORDER BY o.id;
} {4}

do_execsql_test 1.4 {
  SELECT (SELECT count(o.n) FROM t AS i WHERE i.a BETWEEN 10 AND 40)
    FROM t AS o ORDER BY o.id;
} {4}

do_execsql_test 1.5 {
  SELECT o.id FROM t AS o
   WHERE (SELECT count(*) FROM t AS i WHERE o.a BETWEEN 10 AND 40)>0
   ORDER BY o.id;
} {1 2 3 4}

do_execsql_test 2.0 {
  SELECT (SELECT count(*) FROM t AS i WHERE i.id BETWEEN 1 AND 3)
    FROM t AS o ORDER BY o.id;
  SELECT (SELECT count(*) FROM t AS i WHERE i.a BETWEEN 10 AND 40)
    FROM t AS o LIMIT 1;
  SELECT count(*) FROM t WHERE id BETWEEN 2 AND 5;
  SELECT count(*) FROM t WHERE a BETWEEN 20 AND 50;
  SELECT count(i.n) FROM t AS i WHERE i.id BETWEEN 1 AND 4;
} {3 3 3 3 3 3 4 4 4 2}

do_test 2.1 {
  set ops [db eval {EXPLAIN SELECT count(*) FROM t WHERE a BETWEEN 20 AND 50}]
  expr {[lsearch $ops CountIndexRange]>=0}
} {1}

proc rev_coll {a b} {
  return [expr {-[string compare $a $b]}]
}
db collate rev rev_coll

do_execsql_test 3.0 {
  CREATE TABLE t_bin(a TEXT);
  CREATE INDEX t_bin_a ON t_bin(a);
  INSERT INTO t_bin VALUES('a'),('b'),('c'),('d');
  CREATE TEMP TABLE t_temp_rev(a TEXT COLLATE rev);
  CREATE INDEX t_temp_rev_a ON t_temp_rev(a);
  INSERT INTO t_temp_rev VALUES('a'),('b'),('c'),('d');
}

do_execsql_test 3.1 {
  SELECT count(*) FROM t_bin WHERE a COLLATE rev BETWEEN 'c' AND 'a';
  SELECT count(*) FROM t_bin WHERE a COLLATE rev < 'b';
  SELECT count(*) FROM t_bin WHERE a COLLATE rev <= 'b';
  SELECT count(*) FROM t_bin WHERE a COLLATE rev > 'b';
  SELECT count(*) FROM t_bin WHERE a COLLATE rev >= 'b';
} {3 2 3 1 2}

do_execsql_test 3.2 {
  SELECT count(*) FROM t_temp_rev WHERE a BETWEEN 'c' AND 'a';
  SELECT count(*) FROM t_temp_rev WHERE a < 'b';
  SELECT count(*) FROM t_temp_rev WHERE a <= 'b';
  SELECT count(*) FROM t_temp_rev WHERE a > 'b';
  SELECT count(*) FROM t_temp_rev WHERE a >= 'b';
} {3 2 3 1 2}

do_execsql_test 4.0 {
  CREATE TABLE t_nc(a TEXT COLLATE NOCASE);
  CREATE INDEX t_nc_a ON t_nc(a);
  INSERT INTO t_nc VALUES('a'),('b'),('c');
}

do_test 4.1 {
  set ops [db eval {
    EXPLAIN SELECT count(*) FROM t_nc
     WHERE a BETWEEN 'a'||char(0)||'b' AND 'a'||char(0)||'z'
  }]
  expr {[lsearch $ops CountIndexRange]>=0}
} {1}

do_execsql_test 4.2 {
  SELECT count(*) FROM t_nc
   WHERE a BETWEEN 'a'||char(0)||'b' AND 'a'||char(0)||'z';
  SELECT count(*) FROM t_nc NOT INDEXED
   WHERE a BETWEEN 'a'||char(0)||'b' AND 'a'||char(0)||'z';
  SELECT count(*) FROM t_nc WHERE a = 'a'||char(0)||'b';
  SELECT count(*) FROM t_nc NOT INDEXED WHERE a = 'a'||char(0)||'b';
} {0 0 0 0}

do_execsql_test 4.3 {
  INSERT INTO t_nc VALUES('a'||char(0)||'a'),('A'||char(0)||'c');
  SELECT count(*) FROM t_nc
   WHERE a BETWEEN 'a'||char(0)||'b' AND 'a'||char(0)||'z';
  SELECT count(*) FROM t_nc NOT INDEXED
   WHERE a BETWEEN 'a'||char(0)||'b' AND 'a'||char(0)||'z';
  SELECT count(*) FROM t_nc
   WHERE a BETWEEN 'a'||char(0)||'z' AND 'a'||char(0)||'b';
  SELECT count(*) FROM t_nc WHERE a = 'a'||char(0)||'b';
  SELECT count(*) FROM t_nc NOT INDEXED WHERE a = 'a'||char(0)||'b';
} {2 2 2 2 2}

finish_test
