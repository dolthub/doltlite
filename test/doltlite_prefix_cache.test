set testdir [file dirname $argv0]
source $testdir/tester.tcl
source $testdir/malloc_common.tcl
set testprefix doltlite-prefix-cache

foreach {payload rows cache} {16384 128 256 256 1024 128 1024 1024 128} {
  set next [expr {$rows+1}]
  foreach key {{INTEGER PRIMARY KEY} {TEXT PRIMARY KEY} {TEXT PRIMARY KEY COLLATE NOCASE} {TEXT PRIMARY KEY COLLATE RTRIM}} {
    reset_db
    forcedelete prefix-oracle.db
    sqlite3 oracle {file:prefix-oracle.db?doltlite_engine=sqlite} -uri 1
    foreach conn {db oracle} {
      $conn eval "CREATE TABLE t(id $key,v INTEGER,b BLOB,tail TEXT)"
      $conn eval "PRAGMA cache_size=-$cache"
      $conn eval {
        WITH RECURSIVE c(i) AS (VALUES(1) UNION ALL SELECT i+1 FROM c WHERE i<$rows)
        INSERT INTO t SELECT i,i,CAST(printf('%0*d',$payload,i) AS BLOB),
                             printf('tail-%d',i) FROM c;
        CREATE INDEX tv ON t(v);
      }
    }
    foreach state {stored pending rollback committed} {
      foreach conn {db oracle} {
        switch $state {
          pending {$conn eval {
            BEGIN;
            UPDATE t SET b=X'012345',tail='changed' WHERE v=4;
            DELETE FROM t WHERE v=5;
            INSERT INTO t VALUES($next,$next,zeroblob(32768),'new');
          }}
          rollback {$conn eval {ROLLBACK}}
          committed {$conn eval {
            UPDATE t SET tail=tail||'-changed' WHERE v=20;
            DELETE FROM t WHERE v=21;
          }}
        }
        $conn eval {SELECT sum(v),sum(length(b)) FROM t NOT INDEXED}
      }
      foreach {name query} {
        metadata {SELECT sum(v),sum(length(b)),sum(octet_length(b)),min(typeof(b)) FROM t NOT INDEXED}
        contents {SELECT id,hex(b),tail,v FROM t ORDER BY id}
        reverse {SELECT id,tail,length(b),hex(substr(b,-12)) FROM t ORDER BY id DESC}
        point {SELECT a.id,b.tail,hex(substr(b.b,-12)),a.v FROM t a JOIN t b ON a.id=b.id ORDER BY a.id}
        range {SELECT id,length(b),tail FROM t WHERE id BETWEEN 10 AND 90 ORDER BY id}
        indexed {SELECT id,tail,hex(substr(b,-12)) FROM t INDEXED BY tv WHERE v BETWEEN 30 AND 90 ORDER BY v}
        materialized {WITH c AS MATERIALIZED (SELECT * FROM t) SELECT id,tail,hex(substr(b,-12)) FROM c ORDER BY id}
      } {
        do_test $payload-$key-$state-$name [list db eval $query] [oracle eval $query]
      }
    }
    oracle close
  }
}

reset_db
db eval {
  PRAGMA cache_size=-128;
  CREATE TABLE t(id INTEGER PRIMARY KEY,b BLOB,tail TEXT);
  WITH RECURSIVE c(i) AS (VALUES(1) UNION ALL SELECT i+1 FROM c WHERE i<64)
  INSERT INTO t SELECT i,CAST(printf('%016384d',i) AS BLOB),'tail' FROM c;
  SELECT sum(length(b)) FROM t;
}
do_test blob-read-write {
  set fd [db incrblob t b 32]
  fconfigure $fd -translation binary
  seek $fd 16380
  set before [read $fd 4]
  seek $fd 1000
  puts -nonewline $fd abcd
  close $fd
  list $before [db one {SELECT hex(substr(b,1001,4)) FROM t WHERE id=32}]
} {0032 61626364}

db eval {CREATE TABLE headers(id INTEGER PRIMARY KEY)}
for {set i 0} {$i<140} {incr i} {
  db eval "ALTER TABLE headers ADD COLUMN c$i"
}
db eval {
  INSERT INTO headers(id,c0,c139) SELECT id,b,tail FROM t;
  SELECT sum(id),sum(length(c0)) FROM headers;
}
do_execsql_test long-header {
  SELECT count(*),sum(length(c0)),min(c139),max(c139) FROM headers;
} {64 1048576 tail tail}

reset_db
db eval {
  CREATE TABLE t(id INTEGER PRIMARY KEY,b BLOB);
  WITH RECURSIVE c(i) AS (VALUES(1) UNION ALL SELECT i+1 FROM c WHERE i<16)
  INSERT INTO t SELECT i,CAST(printf('%016384d',i) AS BLOB) FROM c;
}
faultsim_save_and_close
faultsim_restore_and_reopen
do_execsql_test mixed-full-and-prefix {
  PRAGMA cache_size=-32;
  SELECT id FROM t LIMIT 1;
  SELECT sum(id),sum(b=CAST(printf('%016384d',id) AS BLOB)) FROM t;
} {1 136 16}
foreach warm {0 1} {
  do_faultsim_test oom-$warm -faults oom-* -prep {
    faultsim_restore_and_reopen
    db eval {PRAGMA cache_size=-32}
    if {$::warm} {db eval {SELECT sum(id),sum(length(b)) FROM t}}
  } -body {
    db eval {SELECT sum(id),sum(b=CAST(printf('%016384d',id) AS BLOB)) FROM t}
  } -test {
    faultsim_test_result {0 {136 16}} {1 {out of memory}}
    set actual [db eval {SELECT sum(id),sum(b=CAST(printf('%016384d',id) AS BLOB)) FROM t}]
    if {$actual ne {136 16}} {
      error "wide values changed after allocation failure: $actual"
    }
  }
}

finish_test
