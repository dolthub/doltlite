# 2026-07-14
#
# A database created by dolt_push contains only the pushed branch; the
# target's default branch (main) has no ref until a first write materializes
# it as an unborn branch with the all-zero head. Reading commit metadata for
# that branch returned "unknown operation" (resolving the zero hash), and
# checking out an existing branch and back stranded the unborn working set
# behind "target branch has no commits".
#
set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix doltlite_unborn_branch

db close
forcedelete ub_source.db ub_target.db
sqlite3 db ub_source.db

do_execsql_test 1.0 {
  CREATE TABLE example(id INTEGER PRIMARY KEY, value TEXT NOT NULL);
  INSERT INTO example VALUES (1, 'pushed from foo1');
} {}
do_test 1.1 {
  regexp {[0-9a-f]{40}} [db one {SELECT dolt_commit('-A','-m','feature commit')}]
} {1}
do_execsql_test 1.2 { SELECT dolt_branch('foo1') } {0}
do_test 1.3 {
  db eval {SELECT dolt_remote('add','origin','file://ub_target.db')}
  db eval {SELECT dolt_push('origin','foo1')}
} {0}

# Open the pushed database: only foo1 exists; the session branch is main.
do_test 2.0 {
  db close
  sqlite3 db ub_target.db
  execsql { SELECT name FROM dolt_branches ORDER BY name }
} {foo1}

# A first write materializes unborn main with the all-zero head.
do_execsql_test 2.1 {
  CREATE TABLE target_probe(id INTEGER PRIMARY KEY);
} {}
do_execsql_test 2.2 {
  SELECT name, hash = '0000000000000000000000000000000000000000'
    FROM dolt_branches ORDER BY name
} {foo1 0 main 1}

# Commit metadata for the unborn branch is NULL, not an error.
do_execsql_test 2.3 {
  SELECT name, latest_commit_date IS NULL, latest_committer IS NULL
    FROM dolt_branches ORDER BY name
} {foo1 0 0 main 1 1}
do_execsql_test 2.4 {
  SELECT name, dirty FROM dolt_branches ORDER BY name
} {foo1 0 main 1}

# Checkout away from and back to the unborn branch; its working set survives.
do_execsql_test 3.0 { SELECT dolt_checkout('foo1') } {0}
do_execsql_test 3.1 { SELECT count(*) FROM example } {1}
do_execsql_test 3.2 { SELECT dolt_checkout('main') } {0}
do_execsql_test 3.3 {
  SELECT table_name FROM dolt_status ORDER BY table_name
} {target_probe}
do_execsql_test 3.4 { SELECT count(*) FROM dolt_log } {0}

# The unborn branch's dirty flag holds when it is not the session branch.
do_execsql_test 3.5 { SELECT dolt_checkout('foo1') } {0}
do_execsql_test 3.6 {
  SELECT name, dirty FROM dolt_branches ORDER BY name
} {foo1 0 main 1}
do_execsql_test 3.7 { SELECT dolt_checkout('main') } {0}

# First commit on the unborn branch births it; metadata appears.
do_test 4.0 {
  regexp {[0-9a-f]{40}} [db one {SELECT dolt_commit('-A','-m','first on main')}]
} {1}
do_execsql_test 4.1 {
  SELECT name, latest_commit_date IS NULL FROM dolt_branches ORDER BY name
} {foo1 0 main 0}
do_execsql_test 4.2 { SELECT count(*) FROM dolt_log } {1}

db close
forcedelete ub_source.db ub_target.db
finish_test
