set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix doltlite-working-ref-txn-clean

# A transaction that undoes a branch's uncommitted changes leaves the live
# catalog equal to HEAD while the stored working set is still dirty.
# WORKING is the transaction's working set, not the stored one.
do_execsql_test 1.0 {
  CREATE TABLE t(id INT PRIMARY KEY, a VARCHAR(20));
  INSERT INTO t VALUES(1,'a1');
  SELECT length(dolt_commit('-Am','base'));
  INSERT INTO t VALUES(2,'uncommitted row');
  UPDATE t SET a='uncommitted edit' WHERE id=1;
  SELECT count(*) FROM dolt_diff_t('HEAD','WORKING');
} {40 2}

do_test 1.1 {
  db close
  sqlite3 db test.db
  db eval {
    BEGIN;
    DELETE FROM t WHERE id=2;
    UPDATE t SET a='a1' WHERE id=1;
    SELECT count(*) FROM dolt_diff_summary('HEAD','WORKING');
    SELECT count(*) FROM dolt_diff_t('HEAD','WORKING');
    SELECT count(*) FROM dolt_diff_t('WORKING','HEAD');
    SELECT dolt_hashof_db('WORKING')=dolt_hashof_db('HEAD');
  }
} {0 0 0 1}

do_execsql_test 1.2 {
  INSERT INTO t VALUES(3,'new');
  SELECT to_id FROM dolt_diff_t('HEAD','WORKING');
  ROLLBACK;
  SELECT count(*) FROM dolt_diff_t('HEAD','WORKING');
} {3 2}

do_execsql_test 1.3 {
  BEGIN;
  DELETE FROM t WHERE id=2;
  UPDATE t SET a='a1' WHERE id=1;
  COMMIT;
  SELECT count(*) FROM dolt_diff_t('HEAD','WORKING');
  SELECT count(*) FROM dolt_status;
} {0 0}

finish_test
