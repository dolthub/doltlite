set testdir [file dirname $argv0]
source $testdir/tester.tcl

foreach variant {plain indexed modified indexed-modified empty order-shift staged staged-indexed} {
  foreach stage {dot all commit force} {
    reset_db
    execsql {
      CREATE TABLE t(id INT PRIMARY KEY, v INT);
      CREATE TABLE tmp_old(id INT PRIMARY KEY, w INT);
    }
    if {$variant ne "empty"} {
      execsql {INSERT INTO t VALUES(1,10); INSERT INTO tmp_old VALUES(5,50)}
    }
    if {$variant in {indexed indexed-modified order-shift staged-indexed}} {
      execsql {CREATE INDEX t_v ON t(v); CREATE INDEX old_v ON tmp_old(w)}
    }
    if {$variant eq "order-shift"} {
      execsql {CREATE TABLE a(id INT PRIMARY KEY); INSERT INTO a VALUES(9)}
    }
    execsql {SELECT dolt_commit('-Am','base')}
    if {$variant in {staged staged-indexed}} {
      execsql {UPDATE t SET v=11; SELECT dolt_add('t'); UPDATE t SET v=12}
    }
    execsql {
      INSERT INTO dolt_ignore VALUES('tmp_*',1);
      ALTER TABLE t RENAME TO tmp_t;
      ALTER TABLE tmp_old RENAME TO kept;
    }
    if {$variant in {modified indexed-modified}} {
      execsql {INSERT INTO tmp_t VALUES(2,20); INSERT INTO kept VALUES(6,60)}
    }
    switch $stage {
      dot {execsql {SELECT dolt_add('.')}}
      all {execsql {SELECT dolt_add('-A')}}
      commit {execsql {SELECT dolt_commit('-Am','renames')}}
      force {execsql {SELECT dolt_add('-A','-f')}}
    }
    set old t
    if {$stage eq "force"} {set old tmp_t}
    set ref STAGED
    if {$stage eq "commit"} {set ref HEAD}
    set retained {1 10}
    set moved {5 50}
    if {$variant eq "empty"} {set retained {}; set moved {}}
    if {$variant in {modified indexed-modified}} {
      set moved {5 50 6 60}
      if {$stage eq "force"} {set retained {1 10 2 20}}
    }
    if {$variant in {staged staged-indexed}} {
      set retained {1 11}
      if {$stage eq "force"} {set retained {1 12}}
    }
    foreach phase {first repeated reopen} {
      if {$phase eq "repeated" && $stage ne "commit"} {
        if {$stage eq "force"} {
          execsql {SELECT dolt_add('-A','-f')}
        } else {
          execsql {SELECT dolt_add('-A')}
        }
      }
      if {$phase eq "reopen"} {db close; sqlite3 db test.db}
      do_execsql_test add-ignore-rename-$variant-$stage-$phase-retained \
        "SELECT * FROM dolt_at_${old}('$ref') ORDER BY id" $retained
      do_execsql_test add-ignore-rename-$variant-$stage-$phase-moved \
        "SELECT * FROM dolt_at_kept('$ref') ORDER BY id" $moved
      do_catchsql_test add-ignore-rename-$variant-$stage-$phase-no-duplicate \
        "SELECT * FROM dolt_at_tmp_old('$ref')" \
        [list 1 "table not found: tmp_old at $ref"]
    }
    if {$stage ne "commit"} {execsql {SELECT dolt_commit('-m','renames')}}
    execsql {SELECT dolt_branch('verify'); SELECT dolt_checkout('verify')}
    do_execsql_test add-ignore-rename-$variant-$stage-integrity {
      PRAGMA integrity_check;
    } {ok}
    if {$variant in {indexed indexed-modified order-shift staged-indexed}} {
      do_execsql_test add-ignore-rename-$variant-$stage-indexes "
        SELECT * FROM $old INDEXED BY t_v ORDER BY v;
        SELECT * FROM kept INDEXED BY old_v ORDER BY w;
      " [concat $retained $moved]
    }
  }
}

foreach stage {dot all commit} {
  reset_db
  execsql {
    CREATE TABLE t(id INT PRIMARY KEY, v INT);
    CREATE INDEX t_v ON t(v);
    INSERT INTO t VALUES(1,10);
    INSERT INTO dolt_ignore VALUES('tmp_*',1);
    SELECT dolt_commit('-Am','base');
    ALTER TABLE t RENAME TO tmp_t;
    INSERT INTO tmp_t VALUES(2,20);
  }
  foreach phase {first repeated reopen} {
    if {$phase eq "reopen"} {db close; sqlite3 db test.db}
    switch $stage {
      dot {execsql {SELECT dolt_add('.')}}
      all {execsql {SELECT dolt_add('-A')}}
      commit {
        do_catchsql_test add-ignore-only-$stage-$phase-commit {
          SELECT dolt_commit('-Am','ignored');
        } {1 {nothing to commit, working tree clean (use dolt_add to stage changes)}}
      }
    }
    do_execsql_test add-ignore-only-$stage-$phase {
      SELECT count(*) FROM dolt_status WHERE staged=1;
      SELECT * FROM dolt_at_t('STAGED');
      SELECT * FROM dolt_at_t('HEAD');
    } {0 1 10 1 10}
  }
}

foreach stage {dot all commit force} {
  reset_db
  execsql {
    CREATE TABLE ab(id INT PRIMARY KEY);
    INSERT INTO ab VALUES(1);
    SELECT dolt_commit('-Am','base');
    INSERT INTO dolt_ignore VALUES('a*',1),('*b',0);
    ALTER TABLE ab RENAME TO kept;
  }
  switch $stage {
    dot {set sql {SELECT dolt_add('.')}}
    all {set sql {SELECT dolt_add('-A')}}
    commit {set sql {SELECT dolt_commit('-Am','rename')}}
    force {set sql {SELECT dolt_add('-A','-f')}}
  }
  if {$stage eq "force"} {
    do_execsql_test add-ignore-rename-source-conflict-force $sql {0}
    do_execsql_test add-ignore-rename-source-conflict-force-staged {
      SELECT * FROM dolt_at_kept('STAGED');
    } {1}
  } else {
    do_test add-ignore-rename-source-conflict-$stage {
      set rc [catch {execsql $sql} msg]
      list $rc [string match {*conflicting patterns*dolt_ignore*} $msg]
    } {1 1}
    do_execsql_test add-ignore-rename-source-conflict-$stage-unchanged {
      SELECT * FROM dolt_at_ab('STAGED');
    } {1}
  }
}

foreach key {INTEGER INT} {
  foreach name {kept w} {
    foreach begin {{} BEGIN {BEGIN IMMEDIATE}} {
      foreach prior {0 1} {
        reset_db
        execsql "CREATE TABLE ${name}(id $key PRIMARY KEY, v INT)"
        execsql "INSERT INTO $name VALUES(1,10); SELECT dolt_commit('-Am','base')"
        if {$prior} {
          execsql "UPDATE $name SET v=11; SELECT dolt_add('$name'); UPDATE $name SET v=12"
        }
        if {$begin ne ""} {execsql $begin}
        execsql {
          INSERT INTO dolt_ignore VALUES('tmp_*',1);
          CREATE TABLE tmp_hidden(id INT PRIMARY KEY);
          INSERT INTO tmp_hidden VALUES(1);
          SELECT dolt_hashof_db('WORKING');
        }
        set staged [db onecolumn {SELECT dolt_hashof_db('STAGED')}]
        execsql {SELECT dolt_add('tmp_hidden')}
        set prefix "add-ignore-named-noop-$key-$name-[string map { { } -} $begin]-$prior"
        do_execsql_test $prefix-staged-hash {SELECT dolt_hashof_db('STAGED')} $staged
        do_execsql_test $prefix-staged-schema {
          SELECT count(*) FROM dolt_schema_diff('HEAD','STAGED')
          WHERE to_table_name='tmp_hidden';
        } {0}
        execsql {SELECT dolt_commit('--allow-empty','-m','kept staging')}
        if {$begin ne ""} {execsql COMMIT}
        db close
        sqlite3 db test.db
        do_catchsql_test $prefix-head {
          SELECT * FROM dolt_at_tmp_hidden('HEAD');
        } {1 {table not found: tmp_hidden at HEAD}}
        do_execsql_test $prefix-working {SELECT * FROM tmp_hidden; PRAGMA integrity_check} {1 ok}
        do_execsql_test $prefix-prior "SELECT v FROM dolt_at_${name}('HEAD')" [expr {$prior ? 11 : 10}]
      }
    }
  }
}

foreach key {INTEGER INT} {
  foreach rows {0 1} {
    foreach change {rename drop-create} {
      foreach stage {named dot all commit-all commit-modified} {
        foreach reopen {0 1} {
          reset_db
          execsql "CREATE TABLE keep(id $key PRIMARY KEY,v TEXT)"
          set expected {}
          if {$rows} {
            execsql {INSERT INTO keep VALUES(1,'preserved')}
            set expected {1 preserved}
          }
          execsql {
            INSERT INTO dolt_ignore VALUES('scratch_%',1);
            SELECT dolt_commit('-Am','base');
          }
          set head [db one {SELECT dolt_hashof('HEAD')}]
          if {$change eq "rename"} {
            execsql {ALTER TABLE keep RENAME TO scratch_x}
          } else {
            execsql "CREATE TABLE scratch_x(id $key PRIMARY KEY,v TEXT)"
            execsql {INSERT INTO scratch_x SELECT * FROM keep; DROP TABLE keep}
          }
          if {$reopen} {db close; sqlite3 db test.db}
          set prefix "ignored-rename-conservative-$key-$rows-$change-$stage-$reopen"
          switch $stage {
            named {execsql {SELECT dolt_add('keep')}}
            dot {execsql {SELECT dolt_add('.')}}
            all {execsql {SELECT dolt_add('-A')}}
            commit-all {
              do_catchsql_test $prefix-commit {
                SELECT dolt_commit('-Am','ignored rename');
              } {1 {nothing to commit, working tree clean (use dolt_add to stage changes)}}
            }
            commit-modified {
              do_catchsql_test $prefix-commit {
                SELECT dolt_commit('-am','ignored rename');
              } {1 {nothing to commit, working tree clean (use dolt_add to stage changes)}}
            }
          }
          foreach phase {first reopen} {
            if {$phase eq "reopen"} {db close; sqlite3 db test.db}
            do_execsql_test $prefix-$phase-staged {
              SELECT count(*) FROM dolt_status WHERE staged=1;
            } 0
            do_execsql_test $prefix-$phase-head {
              SELECT dolt_hashof('HEAD');
            } $head
            do_execsql_test $prefix-$phase-preserved {
              SELECT * FROM dolt_at_keep('HEAD') ORDER BY id;
              SELECT * FROM scratch_x ORDER BY id;
              PRAGMA integrity_check;
            } [concat $expected $expected ok]
          }
        }
      }
    }
  }
}

finish_test
