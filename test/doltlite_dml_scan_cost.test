set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix doltlite-dml-scan-cost

proc dml_scan_plan {conn sql} {
  set plan {}
  $conn eval "EXPLAIN QUERY PLAN $sql" row {lappend plan $row(detail)}
  return $plan
}

foreach {name type pk keyexpr suffix} {
  text TEXT id {printf('%016x',i)} {}
  blob BLOB id {CAST(printf('%016x',i) AS BLOB)} {}
  composite TEXT {id,seq} {printf('%016x',i%16)} {WITHOUT ROWID}
  integer INTEGER id i {WITHOUT ROWID}
} {
  reset_db
  forcedelete dml-scan-oracle.db
  sqlite3 oracle {file:dml-scan-oracle.db?doltlite_engine=sqlite} -uri 1
  foreach conn {db oracle} {
    $conn eval "
      CREATE TABLE t(id $type,seq INTEGER NOT NULL,grp INTEGER NOT NULL,
                     v INTEGER NOT NULL,tag TEXT,payload BLOB,PRIMARY KEY($pk)) $suffix;
      WITH RECURSIVE c(i) AS (VALUES(1) UNION ALL SELECT i+1 FROM c WHERE i<1024)
      INSERT INTO t SELECT $keyexpr,i,i%16,(i*7919)%1000000,
                           printf('tag-%08x',i),CAST(printf('%032d',i) AS BLOB) FROM c;
      CREATE INDEX t_g ON t(grp);
      CREATE INDEX t_gv ON t(grp,v);
      ANALYZE;
      BEGIN;
      DELETE FROM t WHERE seq%32=0;
    "
  }
  set update {UPDATE t SET tag=printf('updated-%08x',seq) WHERE 1}
  do_test $name-update-plan {dml_scan_plan db $update} {{SCAN t}}
  do_test $name-delete-plan {dml_scan_plan db {DELETE FROM t WHERE tag IS NOT NULL}} {{SCAN t}}
  do_test $name-selective-plan {
    dml_scan_plan db {UPDATE t SET tag='selective' WHERE grp=14}
  } {{SEARCH t USING INDEX t_g (grp=?)}}
  do_test $name-hint-plan {
    dml_scan_plan db {UPDATE t INDEXED BY t_gv SET tag='hinted' WHERE 1}
  } {{SCAN t USING INDEX t_gv}}
  do_test $name-covering-read-plan {
    dml_scan_plan db {SELECT grp,v FROM t}
  } {{SCAN t USING COVERING INDEX t_gv}}
  do_test $name-not-indexed-plan {
    dml_scan_plan db {SELECT v FROM t NOT INDEXED WHERE grp=1 OR seq%2=0}
  } {{SCAN t}}
  # seq is not in t_g or t_gv unless it is part of the primary key.
  # A secondary scan would seek the table once per row.
  if {$name ne "composite"} {
    do_test $name-or-group-plan {
      set plan [dml_scan_plan db {
        SELECT count(*) FROM (
          SELECT sum(v) AS x FROM t WHERE (grp=1 OR seq%2=0) GROUP BY grp
        )
      }]
      expr {[lsearch -glob $plan {*INDEX t_g*}] < 0
            && [lsearch -glob $plan {*INDEX t_gv*}] < 0
            && [lsearch -glob $plan {SCAN t*}] >= 0}
    } {1}
  }
  if {$suffix ne {}} {
    do_test $name-stock-plan {dml_scan_plan oracle $update} {{SCAN t USING INDEX t_g}}
  }
  foreach {step sql} [list \
      update $update \
      savepoint {SAVEPOINT edits} \
      selective {UPDATE t SET tag='selective' WHERE grp=14} \
      hinted {UPDATE t INDEXED BY t_gv SET tag='hinted' WHERE grp=3} \
      delete {DELETE FROM t WHERE tag IS NOT NULL} \
      rollback-savepoint {ROLLBACK TO edits; RELEASE edits} \
      rollback {ROLLBACK}] {
    foreach conn {db oracle} {$conn eval $sql}
    do_test $name-$step {
      db eval {SELECT hex(id),seq,grp,v,tag,hex(payload) FROM t ORDER BY id,seq}
    } [oracle eval {SELECT hex(id),seq,grp,v,tag,hex(payload) FROM t ORDER BY id,seq}]
  }
  oracle close
}

reset_db
do_test ipk-not-indexed-plan {
  db eval {
    CREATE TABLE t(id INTEGER PRIMARY KEY, val INT);
    CREATE INDEX idx ON t(val);
    INSERT INTO t VALUES(1,10),(2,20),(3,30);
  }
  dml_scan_plan db {SELECT id FROM t NOT INDEXED WHERE val > 15 ORDER BY id}
} {{SCAN t}}
do_test ipk-not-indexed-rows {
  db eval {SELECT id FROM t NOT INDEXED WHERE val > 15 ORDER BY id}
} {2 3}

reset_db
do_execsql_test lookup-cost-setup {
  CREATE TABLE r(id INTEGER PRIMARY KEY, seq INTEGER NOT NULL,
                 grp INTEGER NOT NULL, v INTEGER NOT NULL, payload BLOB);
  CREATE TABLE k(id TEXT PRIMARY KEY, seq INTEGER NOT NULL,
                 grp INTEGER NOT NULL, v INTEGER NOT NULL, payload BLOB);
  WITH RECURSIVE c(i) AS (VALUES(1) UNION ALL SELECT i+1 FROM c WHERE i<8192)
  INSERT INTO r SELECT i,i,i%256,(i*7919)%1000000,
                       CAST(printf('%0256d',i) AS BLOB) FROM c;
  INSERT INTO k SELECT printf('%016x',id),seq,grp,v,payload FROM r;
  CREATE INDEX r_g ON r(grp);
  CREATE INDEX k_s ON k(seq);
  ANALYZE;
} {}
# Every row fetched through a secondary index seeks the table's tree, so
# grouping by an index order that fetches each row loses to a sort.
do_test lookup-cost-rowid-group-plan {
  dml_scan_plan db {SELECT grp,sum(v) FROM r GROUP BY grp}
} {{SCAN r} {USE TEMP B-TREE FOR GROUP BY}}
do_execsql_test lookup-cost-rowid-group-rows {
  SELECT count(*),sum(s) FROM (SELECT grp,sum(v) AS s FROM r GROUP BY grp)
} [db eval {SELECT 256,sum(v) FROM r}]
# A fixed LIMIT stops an ordered index scan after a few fetches.
do_test lookup-cost-limit-plan {
  dml_scan_plan db {SELECT v FROM k ORDER BY seq LIMIT 10}
} {{SCAN k USING INDEX k_s}}
do_test lookup-cost-rowid-limit-plan {
  dml_scan_plan db {SELECT v FROM r ORDER BY grp LIMIT 10}
} {{SCAN r USING INDEX r_g}}
do_test lookup-cost-selective-plans {
  list [dml_scan_plan db {SELECT v FROM k WHERE seq=77}] \
       [dml_scan_plan db {SELECT sum(v) FROM k WHERE seq BETWEEN 100 AND 140}]
} {{{SEARCH k USING INDEX k_s (seq=?)}} {{SEARCH k USING INDEX k_s (seq>? AND seq<?)}}}

reset_db
do_execsql_test size-cost-setup {
  CREATE TABLE k(id TEXT PRIMARY KEY, seq INTEGER NOT NULL, grp INTEGER NOT NULL,
                 v INTEGER NOT NULL, payload BLOB);
  CREATE TABLE u(id INTEGER PRIMARY KEY, grp INTEGER, v INTEGER);
  WITH RECURSIVE c(i) AS (VALUES(1) UNION ALL SELECT i+1 FROM c WHERE i<8192)
  INSERT INTO k SELECT printf('%016x',i),i,i%256,(i*7919)%1000000,
                       CAST(printf('%0256d',i) AS BLOB) FROM c;
  INSERT INTO u SELECT seq,grp,v FROM k WHERE seq%2=0;
  CREATE INDEX k_s ON k(seq);
  CREATE INDEX u_g ON u(grp);
  ANALYZE;
} {}
set sizeJoin {
  SELECT count(*),sum(k.v) FROM k JOIN u ON u.id=k.seq
   WHERE k.grp=15 OR k.seq%2=0
}
# Once k outgrows the node cache, probing it through k_s reads a chunk per
# match, so the join scans k and probes the small table by rowid instead.
do_test size-cost-outgrown-plan {
  db eval {PRAGMA cache_size=-256}
  db cache flush
  dml_scan_plan db $sizeJoin
} {{SCAN k} {SEARCH u USING INTEGER PRIMARY KEY (rowid=?)}}
do_test size-cost-cached-plan {
  db eval {PRAGMA cache_size=-65536}
  db cache flush
  dml_scan_plan db $sizeJoin
} {{SCAN u USING COVERING INDEX u_g} {SEARCH k USING INDEX k_s (seq=?)}}
do_test size-cost-rows {
  db eval {PRAGMA cache_size=-256}
  db cache flush
  set a [db eval $sizeJoin]
  db eval {PRAGMA cache_size=-65536}
  db cache flush
  list [expr {$a eq [db eval $sizeJoin]}] $a
} [list 1 [db eval {SELECT count(*),sum(v) FROM k WHERE seq%2=0}]]
do_test size-cost-point-plan {
  db eval {PRAGMA cache_size=-256}
  db cache flush
  dml_scan_plan db {SELECT v FROM k WHERE seq=77}
} {{SEARCH k USING INDEX k_s (seq=?)}}

finish_test
