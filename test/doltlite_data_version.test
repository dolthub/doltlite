set testdir [file dirname $argv0]
source $testdir/tester.tcl

do_execsql_test doltlite_data_version-1.1 {
  PRAGMA data_version;
} {1}

do_execsql_test doltlite_data_version-1.2 {
  PRAGMA data_version;
  BEGIN IMMEDIATE;
  PRAGMA data_version;
  CREATE TABLE t1(a);
  INSERT INTO t1 VALUES(100),(200),(300);
  PRAGMA data_version;
  COMMIT;
  SELECT * FROM t1;
  PRAGMA data_version;
} {1 1 1 100 200 300 1}

sqlite3 db2 test.db

do_test doltlite_data_version-1.3 {
  db2 eval {
    SELECT * FROM t1;
    PRAGMA data_version;
  }
} {100 200 300 1}

do_execsql_test doltlite_data_version-1.4 {
  PRAGMA data_version;
  BEGIN IMMEDIATE;
  INSERT INTO t1 VALUES(400),(500);
  PRAGMA data_version;
  COMMIT;
  SELECT * FROM t1;
  PRAGMA data_version;
} {1 1 100 200 300 400 500 1}

do_test doltlite_data_version-1.5 {
  db2 eval {
    SELECT * FROM t1;
    PRAGMA data_version;
    BEGIN IMMEDIATE;
    UPDATE t1 SET a=a+1;
    PRAGMA data_version;
    COMMIT;
    SELECT * FROM t1;
    PRAGMA data_version;
  }
} {100 200 300 400 500 2 2 101 201 301 401 501 2}

do_execsql_test doltlite_data_version-1.6 {
  SELECT * FROM t1;
  PRAGMA data_version;
} {101 201 301 401 501 2}

do_test doltlite_data_version-1.7 {
  db eval {
    BEGIN;
    PRAGMA data_version;
    UPDATE t1 SET a=555 WHERE a=501;
    PRAGMA data_version;
    SELECT * FROM t1 ORDER BY a;
    PRAGMA data_version;
  }
} {2 2 101 201 301 401 555 2}

do_test doltlite_data_version-1.8 {
  db2 eval {
    PRAGMA data_version;
  }
} {2}

do_execsql_test doltlite_data_version-1.9 {
  COMMIT;
  PRAGMA data_version;
} {2}

do_test doltlite_data_version-1.10 {
  db2 eval {
    PRAGMA data_version;
  }
} {3}

# A write transaction is what first notices the peer commit. A read would
# bump the version; BEGIN IMMEDIATE has to as well, or the new rows are
# visible under the old cookie.
do_test doltlite_data_version-1.11 {
  db eval {
    INSERT INTO t1 VALUES(600);
  }
  db2 eval {
    BEGIN IMMEDIATE;
    SELECT count(*) FROM t1;
    PRAGMA data_version;
    INSERT INTO t1 VALUES(601);
    PRAGMA data_version;
    COMMIT;
    PRAGMA data_version;
  }
} {6 4 4 4}

# Each do_test reports only its last command. The FTS writes below are the
# sequence that corrupts the inverted index when the adopter keeps the old
# data_version: peer match, peer insert, local match, optimize, then a
# third connection's integrity check.
do_test doltlite_data_version-1.12.1 {
  db eval {
    CREATE VIRTUAL TABLE f USING fts5(x);
    INSERT INTO f VALUES('one');
    PRAGMA data_version;
  }
} {3}

do_test doltlite_data_version-1.12.2 {
  db2 eval {
    SELECT rowid FROM f('one');
    PRAGMA data_version;
  }
} {1 5}

do_test doltlite_data_version-1.12.3 {
  db2 eval { INSERT INTO f VALUES('two'); }
  db eval {
    SELECT rowid FROM f('one OR two') ORDER BY rowid;
    PRAGMA data_version;
  }
} {1 2 4}

do_test doltlite_data_version-1.12.4 {
  db2 eval {
    INSERT INTO f VALUES('three');
    INSERT INTO f(f) VALUES('optimize');
  }
  db eval {
    INSERT INTO f VALUES('four');
    SELECT rowid FROM f('one OR two OR three OR four') ORDER BY rowid;
    PRAGMA integrity_check;
    PRAGMA data_version;
  }
} {1 2 3 4 ok 5}

do_test doltlite_data_version-1.12.5 {
  sqlite3 db3 test.db
  db3 eval {
    SELECT rowid FROM f('one OR two OR three OR four') ORDER BY rowid;
    PRAGMA integrity_check;
  }
} {1 2 3 4 ok}

# A later write transaction on the connection that just committed stays on
# the same data version. Adopting a peer commit is what changes it.
do_test doltlite_data_version-1.13 {
  set before [db one {PRAGMA data_version}]
  db eval {
    BEGIN IMMEDIATE;
    INSERT INTO t1 VALUES(700);
    COMMIT;
  }
  set mid [db one {PRAGMA data_version}]
  db eval {
    BEGIN IMMEDIATE;
    INSERT INTO t1 VALUES(701);
    COMMIT;
  }
  set after [db one {PRAGMA data_version}]
  expr {$before==$mid && $mid==$after}
} {1}

# A peer's ref-only change (branch, tag, delete, a new branch it switches
# to) leaves this branch's rows alone but changes dolt_branches and
# dolt_tags, so a reader must see a new data version.
db eval {SELECT dolt_commit('-Am','dv')}
set i 0
foreach op {
  {SELECT dolt_branch('dv_b')}
  {SELECT dolt_tag('dv_t')}
  {SELECT dolt_branch('-d','dv_b')}
  {SELECT dolt_checkout('-b','dv_c')}
} {
  incr i
  do_test doltlite_data_version-2.$i {
    set before [db2 one {PRAGMA data_version}]
    set mine [db one {PRAGMA data_version}]
    db eval $op
    list [expr {[db2 one {PRAGMA data_version}]!=$before}] \
         [expr {[db one {PRAGMA data_version}]==$mine}]
  } {1 1}
}
db eval {SELECT dolt_checkout('main')}

db3 close
db2 close
finish_test
