set testdir [file dirname $argv0]
source $testdir/tester.tcl

proc nl_reset {} {
  catch {db close}
  forcedelete test.db
  sqlite3 db test.db
  db eval {
    CREATE TABLE users(id INTEGER PRIMARY KEY, name TEXT);
    CREATE TABLE cfg(k TEXT PRIMARY KEY, v TEXT);
    INSERT INTO users VALUES(1,'base');
    INSERT INTO cfg VALUES('mode','v1');
    SELECT dolt_commit('-Am','base');
    SELECT dolt_tag('v1');
    SELECT dolt_checkout('-b','other');
    CREATE TABLE notes(id INTEGER PRIMARY KEY, body TEXT);
    SELECT dolt_commit('-Am','notes');
  }
}

proc nl_disk {branch sql} {
  sqlite3 observer [file normalize test.db]/$branch -readonly 1
  set r [observer eval $sql]
  observer close
  return $r
}

nl_reset
do_execsql_test nonlocal-lazy-empty {
  SELECT count(*) FROM dolt_nonlocal_tables;
} 0
do_execsql_test nonlocal-redirect-write {
  INSERT INTO dolt_nonlocal_tables VALUES('users','main',NULL,'immediate');
  INSERT INTO users VALUES(2,'from-other');
  SELECT id FROM users ORDER BY id;
} {1 2}
do_test nonlocal-redirect-lands-on-target {
  nl_disk main {SELECT id FROM users ORDER BY id}
} {1 2}
do_test nonlocal-redirect-not-local {
  nl_disk main {SELECT id FROM dolt_at_users('other') ORDER BY id}
} {1}
do_execsql_test nonlocal-rules-versioned {
  SELECT table_name, staged, status FROM dolt_status;
} {dolt_nonlocal_tables 0 {new table}}

# The hidden schema is reachable only through a rule.
do_catchsql_test nonlocal-no-leak {
  INSERT INTO dolt_nonlocal_tables VALUES('settings','main','cfg','immediate');
  SELECT k, v FROM settings;
  SELECT count(*) FROM main.cfg;
} {0 {mode v1 1}}
do_execsql_test nonlocal-unrelated-name-stays-local {
  UPDATE cfg SET v='local';
  SELECT v FROM cfg;
  SELECT v FROM settings;
} {local v1}

do_catchsql_test nonlocal-create-refused {
  CREATE TABLE users(id INTEGER PRIMARY KEY);
} {1 {Cannot create table name users because it matches a name present in dolt_nonlocal_tables.}}
do_catchsql_test nonlocal-create-if-not-exists {
  CREATE TABLE IF NOT EXISTS users(id INTEGER PRIMARY KEY);
} {0 {}}

do_execsql_test nonlocal-wildcard {
  INSERT INTO dolt_nonlocal_tables VALUES('glob_*','main','','immediate');
  SELECT count(*) FROM dolt_nonlocal_tables;
} 3
do_catchsql_test nonlocal-wildcard-create-refused {
  CREATE TABLE glob_x(id INTEGER PRIMARY KEY);
} {1 {Cannot create table name glob_x because it matches a name present in dolt_nonlocal_tables.}}

do_execsql_test nonlocal-tag-read {
  INSERT INTO dolt_nonlocal_tables VALUES('frozen','v1','cfg','immediate');
  SELECT k, v FROM frozen;
} {mode v1}
do_catchsql_test nonlocal-tag-read-only {
  UPDATE frozen SET v='x';
} {1 {attempt to write a readonly database}}

do_execsql_test nonlocal-alias-same-branch {
  INSERT INTO dolt_nonlocal_tables VALUES('my_notes','','notes','immediate');
  INSERT INTO my_notes VALUES(1,'via-alias');
  SELECT body FROM notes;
} {via-alias}

do_catchsql_test nonlocal-bad-options {
  INSERT INTO dolt_nonlocal_tables VALUES('manual_t','main','','manual');
  SELECT * FROM manual_t;
} {1 {Invalid nonlocal table options manual: only valid value is 'immediate'.}}
do_execsql_test nonlocal-bad-options-cleared {
  DELETE FROM dolt_nonlocal_tables WHERE table_name='manual_t';
} {}

# Nonlocal and local writes commit, or roll back, together.
do_execsql_test nonlocal-txn-commit {
  BEGIN;
  INSERT INTO users VALUES(3,'txn');
  INSERT INTO notes VALUES(2,'txn');
  COMMIT;
} {}
do_test nonlocal-txn-commit-target {
  nl_disk main {SELECT id FROM users ORDER BY id}
} {1 2 3}
do_test nonlocal-txn-commit-local {
  nl_disk other {SELECT id FROM notes ORDER BY id}
} {1 2}
do_execsql_test nonlocal-txn-rollback {
  BEGIN;
  INSERT INTO users VALUES(4,'rb');
  INSERT INTO notes VALUES(3,'rb');
  ROLLBACK;
  SELECT max(id) FROM users;
  SELECT max(id) FROM notes;
} {3 2}
do_test nonlocal-txn-commit-refused {
  db eval {BEGIN; INSERT INTO users VALUES(5,'x'); INSERT INTO notes VALUES(5,'x')}
  set r [catchsql {SELECT dolt_commit('-am','both')}]
  db eval ROLLBACK
  set r
} {1 {Cannot commit changes on more than one branch / database}}
do_test nonlocal-txn-add {
  db eval {BEGIN; INSERT INTO users VALUES(5,'x'); INSERT INTO notes VALUES(5,'x')}
  set r [db eval {SELECT dolt_add('notes')}]
  db eval COMMIT
  lappend r [nl_disk main {SELECT max(id) FROM users}]
  lappend r [db eval {SELECT staged FROM dolt_status WHERE table_name='notes'}]
  db eval {DELETE FROM users WHERE id=5; DELETE FROM notes WHERE id=5}
  set r
} {0 5 1}

# A rule that targets this branch may have its backing table created here;
# dolt_clean keeps it untracked.
do_execsql_test nonlocal-clean-keeps-matches {
  INSERT INTO dolt_nonlocal_tables VALUES('keep_me','','','immediate');
  SELECT dolt_commit('-Am','rules') IS NOT NULL;
  CREATE TABLE keep_me(id INTEGER PRIMARY KEY);
  CREATE TABLE scratch(id INTEGER PRIMARY KEY);
  SELECT dolt_clean();
  SELECT name FROM sqlite_master WHERE type='table' ORDER BY name;
} {1 0 cfg dolt_nonlocal_tables keep_me notes users}

do_test nonlocal-reopen {
  db close
  sqlite3 db [file normalize test.db]/other
  db eval {SELECT id FROM users ORDER BY id}
} {1 2 3}

do_test nonlocal-checkout-target-detaches {
  db eval {SELECT dolt_checkout('main')}
  db eval {SELECT count(*) FROM users}
  db eval {SELECT name FROM pragma_database_list ORDER BY seq}
} {main}
do_execsql_test nonlocal-checkout-back {
  SELECT dolt_checkout('other');
  SELECT count(*) FROM users;
} {0 3}

do_catchsql_test nonlocal-shape-guard {
  SELECT dolt_checkout('-b','fresh','main');
  CREATE TABLE dolt_nonlocal_tables(table_name TEXT PRIMARY KEY, target_ref TEXT);
} {1 {dolt_nonlocal_tables must have exactly four columns; expected: CREATE TABLE dolt_nonlocal_tables(table_name TEXT NOT NULL, target_ref TEXT, ref_table TEXT, options TEXT, PRIMARY KEY(table_name))}}

# Foreign keys that reference a claimed name check the nonlocal table.
nl_reset
do_execsql_test nonlocal-fk-setup {
  PRAGMA foreign_keys=ON;
  INSERT INTO dolt_nonlocal_tables VALUES('shared_cfg','main','cfg','immediate');
  CREATE TABLE uses_cfg(k TEXT PRIMARY KEY REFERENCES shared_cfg(k));
  INSERT INTO shared_cfg VALUES('remote','x');
  INSERT INTO uses_cfg VALUES('remote');
  SELECT k FROM uses_cfg;
} {remote}
do_catchsql_test nonlocal-fk-child-refused {
  INSERT INTO uses_cfg VALUES('absent');
} {1 {FOREIGN KEY constraint failed}}
do_execsql_test nonlocal-fk-check-clean {
  SELECT count(*) FROM pragma_foreign_key_check;
} 0
do_execsql_test nonlocal-fk-parent-removed {
  PRAGMA foreign_keys=OFF;
  DELETE FROM shared_cfg WHERE k='remote';
  SELECT "table", parent FROM pragma_foreign_key_check;
} {uses_cfg shared_cfg}
do_execsql_test nonlocal-fk-verify {
  SELECT dolt_verify_constraints('--all');
  SELECT "table", num_violations FROM dolt_constraint_violations;
} {1 uses_cfg 1}

# PRAGMA table_list lists the names rules resolve, as Dolt's SHOW TABLES:
# a plain name whose target exists, and target tables a wildcard claims.
nl_reset
do_test nonlocal-table-list {
  sqlite3 peer [file normalize test.db]/main
  peer eval {CREATE TABLE glob_a(id INTEGER PRIMARY KEY, v TEXT)}
  peer close
  db eval {
    INSERT INTO dolt_nonlocal_tables VALUES
      ('settings','main','cfg','immediate'),
      ('glob_*','main','','immediate'),
      ('ghost','main','','immediate');
  }
  db eval {
    SELECT name, type, ncol FROM pragma_table_list
    WHERE schema='main' AND name NOT LIKE 'sqlite%' ORDER BY name
  }
} {cfg table 2 dolt_nonlocal_tables table 4 glob_a table 2 notes table 2 settings table 2 users table 2}
do_execsql_test nonlocal-table-list-named {
  SELECT name FROM pragma_table_list('settings') WHERE schema='main';
  SELECT count(*) FROM pragma_table_list('ghost');
} {settings 0}

# A target branch can be deleted or renamed while its attachment is idle;
# names it served then fail as in Dolt, and come back with the branch.
nl_reset
do_execsql_test nonlocal-target-setup {
  SELECT dolt_branch('shared', 'main');
  SELECT dolt_branch('shared2', 'main');
  INSERT INTO dolt_nonlocal_tables VALUES
    ('team','shared','users','immediate'),
    ('team2','shared2','users','immediate');
  SELECT count(*) FROM team;
  SELECT count(*) FROM team2;
} {0 0 1 1}
do_catchsql_test nonlocal-target-delete-in-txn {
  BEGIN;
  INSERT INTO team VALUES(7,'txn');
  SELECT dolt_branch('-D','shared');
} {1 {branch 'shared' is attached in this connection}}
do_execsql_test nonlocal-target-delete-in-txn-rollback {
  ROLLBACK;
} {}
do_catchsql_test nonlocal-target-delete {
  SELECT dolt_branch('-D','shared');
  SELECT count(*) FROM team;
} {1 {branch not found: shared}}
do_catchsql_test nonlocal-target-delete-write {
  INSERT INTO team VALUES(8,'gone');
} {1 {branch not found: shared}}
do_catchsql_test nonlocal-target-rename {
  SELECT dolt_branch('-m','shared2','renamed');
  SELECT count(*) FROM team2;
} {1 {branch not found: shared2}}
do_test nonlocal-target-fresh-connection {
  sqlite3 db2 [file normalize test.db]/other
  set r [catchsql {SELECT count(*) FROM team2} db2]
  db2 close
  set r
} {1 {branch not found: shared2}}
do_execsql_test nonlocal-target-recreated {
  SELECT dolt_branch('shared', 'main');
  SELECT count(*) FROM team;
} {0 1}
do_test nonlocal-target-detached {
  list [catchsql {SELECT count(*)>0 FROM "dolt_nonlocal:shared".sqlite_schema}] \
       [catchsql {SELECT 1 FROM "dolt_nonlocal:shared2".sqlite_schema}]
} {{0 1} {1 {no such table: dolt_nonlocal:shared2.sqlite_schema}}}
# dolt_commit_all commits the target branch and this one together.
nl_reset
do_execsql_test nonlocal-commit-all {
  INSERT INTO dolt_nonlocal_tables VALUES('users','main',NULL,'immediate');
  SELECT dolt_commit('-Am','rules') IS NOT NULL;
  BEGIN;
  INSERT INTO users VALUES(2,'shared');
  INSERT INTO notes VALUES(1,'local');
  SELECT key FROM json_each(dolt_commit_all('-am','both'));
  SELECT message FROM dolt_log LIMIT 1;
} {1 main other both}
do_test nonlocal-commit-all-target {
  nl_disk main {SELECT message FROM dolt_log LIMIT 1; SELECT count(*) FROM dolt_status}
} {both 0}

# A foreign key to a name a stored rule claims commits; one to a table
# that exists nowhere is still refused.
nl_reset
do_execsql_test nonlocal-fk-commit {
  INSERT INTO dolt_nonlocal_tables VALUES('shared_cfg','main','cfg','immediate');
  CREATE TABLE uses_cfg(k TEXT PRIMARY KEY REFERENCES shared_cfg(k));
  SELECT dolt_commit('-Am','child') IS NOT NULL;
  SELECT message FROM dolt_log LIMIT 1;
} {1 child}
do_catchsql_test nonlocal-fk-commit-missing {
  CREATE TABLE uses_missing(k TEXT PRIMARY KEY REFERENCES nowhere(k));
  SELECT dolt_commit('-Am','missing');
} {1 {foreign key on table `uses_missing` requires the referenced table `nowhere`}}

# DROP and RENAME TO edit the local table. Column changes, constraints, and
# CREATE INDEX follow the rule onto the target, as Dolt does.
nl_reset
do_execsql_test nonlocal-drop-local {
  INSERT INTO dolt_nonlocal_tables VALUES('users','main','','immediate');
  DROP TABLE users;
  SELECT count(*) FROM sqlite_master WHERE name='users';
  SELECT count(*) FROM users;
} {0 1}
do_test nonlocal-drop-target-kept {
  nl_disk main {SELECT count(*) FROM sqlite_master WHERE name='users'}
} {1}
nl_reset
do_execsql_test nonlocal-alter-add {
  INSERT INTO dolt_nonlocal_tables VALUES('users','main',NULL,'immediate');
  ALTER TABLE users ADD COLUMN c INT;
  INSERT INTO users VALUES(2,'exp',7);
  SELECT id, name, c FROM users ORDER BY id;
  SELECT sql FROM sqlite_master WHERE type='table' AND name='users';
} {1 base {} 2 exp 7 {CREATE TABLE users(id INTEGER PRIMARY KEY, name TEXT)}}
do_test nonlocal-alter-add-target {
  nl_disk main {
    SELECT id, name, c FROM users ORDER BY id;
    SELECT group_concat(name, '.') FROM pragma_table_info('users');
  }
} {1 base {} 2 exp 7 id.name.c}
do_execsql_test nonlocal-alter-rename-column {
  ALTER TABLE users RENAME COLUMN name TO nm;
  SELECT group_concat(name, '.') FROM pragma_table_info('users');
  SELECT sql FROM sqlite_master WHERE type='table' AND name='users';
} {id.nm.c {CREATE TABLE users(id INTEGER PRIMARY KEY, name TEXT)}}
do_test nonlocal-alter-rename-column-target {
  nl_disk main {SELECT group_concat(name, '.') FROM pragma_table_info('users')}
} {id.nm.c}
do_execsql_test nonlocal-alter-drop-column {
  ALTER TABLE users DROP COLUMN c;
  SELECT group_concat(name, '.') FROM pragma_table_info('users');
  SELECT sql FROM sqlite_master WHERE type='table' AND name='users';
} {id.nm {CREATE TABLE users(id INTEGER PRIMARY KEY, name TEXT)}}
do_test nonlocal-alter-drop-column-target {
  nl_disk main {SELECT group_concat(name, '.') FROM pragma_table_info('users')}
} {id.nm}
do_execsql_test nonlocal-alter-index {
  CREATE INDEX users_nm ON users(nm);
  SELECT name FROM sqlite_master WHERE type='index' AND tbl_name='users';
} {}
do_test nonlocal-alter-index-target {
  nl_disk main {
    SELECT name FROM sqlite_master WHERE type='index' AND tbl_name='users';
  }
} {users_nm}
do_execsql_test nonlocal-alter-check {
  ALTER TABLE users ADD CONSTRAINT chk CHECK (id > 0);
  SELECT sql FROM sqlite_master WHERE type='table' AND name='users';
} {{CREATE TABLE users(id INTEGER PRIMARY KEY, name TEXT)}}
do_test nonlocal-alter-check-target {
  expr {[string first "CHECK" [nl_disk main {
    SELECT sql FROM sqlite_master WHERE type='table' AND name='users'
  }]]>=0}
} {1}
do_execsql_test nonlocal-rename-stays-local {
  ALTER TABLE users RENAME TO people;
  SELECT id FROM users ORDER BY id;
  SELECT id FROM people ORDER BY id;
  SELECT name FROM sqlite_master WHERE type='table' AND name IN ('users','people');
} {1 2 1 people}
do_test nonlocal-rename-target-kept {
  nl_disk main {SELECT name FROM sqlite_master WHERE type='table' AND name='users'}
} {users}
nl_reset
db eval {INSERT INTO dolt_nonlocal_tables VALUES('nl','main','users','immediate')}
do_execsql_test nonlocal-alias-add {
  ALTER TABLE nl ADD COLUMN x INT;
  SELECT group_concat(name, '.') FROM pragma_table_info('nl');
} {id.name.x}
do_test nonlocal-alias-add-target {
  nl_disk main {SELECT group_concat(name, '.') FROM pragma_table_info('users')}
} {id.name.x}
do_execsql_test nonlocal-alias-index {
  CREATE INDEX nl_i ON nl(name);
  SELECT count(*) FROM sqlite_master WHERE type='index' AND name='nl_i';
} {0}
do_test nonlocal-alias-index-target {
  nl_disk main {SELECT name, sql FROM sqlite_master WHERE name='nl_i'}
} {nl_i {CREATE INDEX nl_i ON "users"(name)}}
do_execsql_test nonlocal-alias-same-branch-index {
  INSERT INTO dolt_nonlocal_tables VALUES('my_notes','','notes','immediate');
  CREATE INDEX notes_i ON my_notes(body);
  SELECT sql FROM sqlite_master WHERE name='notes_i';
} {{CREATE INDEX notes_i ON "notes"(body)}}
foreach {name sql err} {
  rename {ALTER TABLE nl RENAME TO renamed} {no such table: nl}
  drop {DROP TABLE nl} {no such table: nl}
} {
  do_catchsql_test nonlocal-ddl-$name $sql [list 1 $err]
}
do_execsql_test nonlocal-ddl-trigger {
  CREATE TRIGGER nl_tr AFTER INSERT ON nl BEGIN
    INSERT INTO notes VALUES(new.id, 'saw '||new.name);
  END;
  INSERT INTO nl(id, name) VALUES(40, 'alias');
  SELECT tbl_name FROM sqlite_master WHERE name='nl_tr';
  SELECT body FROM notes WHERE id=40;
} {nl {saw alias}}

# A TEMP table answers an unqualified name before any rule, as SQLite
# resolves temp first; dropping it uncovers the rule again.
nl_reset
do_execsql_test nonlocal-temp-shadows {
  INSERT INTO dolt_nonlocal_tables VALUES('nl','main','users','immediate');
  CREATE TEMP TABLE nl(id INTEGER PRIMARY KEY);
  INSERT INTO nl VALUES(42);
  SELECT group_concat(id) FROM nl;
  DROP TABLE nl;
  SELECT group_concat(id) FROM nl;
} {42 1}
do_test nonlocal-temp-target-untouched {
  nl_disk main {SELECT group_concat(id) FROM users}
} {1}

# HEAD names this session's commit, not the default branch: read-only, and
# it follows the session's HEAD as it moves.
nl_reset
db eval {INSERT INTO cfg VALUES('k','other-commit'); SELECT dolt_commit('-am','oc')}
do_execsql_test nonlocal-head-read {
  INSERT INTO dolt_nonlocal_tables VALUES('hd','HEAD','cfg','immediate');
  INSERT INTO dolt_nonlocal_tables VALUES('hp','HEAD~1','cfg','immediate');
  SELECT dolt_commit('-Am','rules') IS NOT NULL;
  SELECT group_concat(k) FROM hd;
  SELECT group_concat(k) FROM hp;
} {1 k,mode k,mode}
do_catchsql_test nonlocal-head-read-only {
  INSERT INTO hd VALUES('x','y');
} {1 {attempt to write a readonly database}}
do_execsql_test nonlocal-head-follows {
  INSERT INTO cfg VALUES('n','new');
  SELECT dolt_commit('-am','next') IS NOT NULL;
  SELECT group_concat(k) FROM hd;
  SELECT group_concat(k) FROM hp;
} {1 k,mode,n k,mode}
do_test nonlocal-head-not-default-branch {
  nl_disk main {SELECT group_concat(k) FROM cfg; SELECT count(*) FROM dolt_status}
} {mode 0}

# A qualified ref names the commit it resolves to, read-only, rather than
# missing the target and falling through to the source branch's table.
nl_reset
db eval {UPDATE cfg SET v='other-local'}
do_execsql_test nonlocal-qualified-ref-read {
  INSERT INTO dolt_nonlocal_tables VALUES('cfg','heads/main','','immediate');
  INSERT INTO dolt_nonlocal_tables VALUES('tg','refs/tags/v1','cfg','immediate');
  SELECT v FROM cfg;
  SELECT v FROM tg;
} {v1 v1}
do_catchsql_test nonlocal-qualified-ref-read-only {
  UPDATE cfg SET v='written';
} {1 {attempt to write a readonly database}}
do_test nonlocal-qualified-ref-local-kept {
  nl_disk main {SELECT v FROM cfg}
} {v1}

# A rule whose target cannot be opened fails the statement; it never
# falls back to the source branch's table of the same name.
do_test nonlocal-unopenable-target {
  catch {db close}
  sqlite3 db :memory:
  db eval {
    CREATE TABLE users(id INTEGER PRIMARY KEY);
    SELECT dolt_commit('-Am','base');
    SELECT dolt_checkout('-b','other');
    INSERT INTO dolt_nonlocal_tables VALUES('users','main','','immediate');
  }
  set r [catchsql {INSERT INTO users VALUES(1)}]
  lappend r [db eval {SELECT count(*) FROM dolt_status WHERE table_name='users'}]
} {1 {cannot open nonlocal table users on main} 0}

# Another connection's rule change applies to this connection's very next
# statement, both when it creates the rules table and when it removes a rule.
do_test nonlocal-peer-rule-change {
  catch {db close}
  forcedelete test.db
  sqlite3 db test.db
  db eval {
    CREATE TABLE users(id INTEGER PRIMARY KEY);
    SELECT dolt_commit('-Am','base');
    SELECT dolt_branch('other');
  }
  db close
  sqlite3 db [file normalize test.db]/other
  sqlite3 peer [file normalize test.db]/other
  db eval {SELECT count(*) FROM users}
  peer eval {INSERT INTO dolt_nonlocal_tables VALUES('users','main','','immediate')}
  db eval {INSERT INTO users VALUES(1)}
  peer eval {DELETE FROM dolt_nonlocal_tables}
  db eval {INSERT INTO users VALUES(2)}
  peer close
  list [nl_disk main {SELECT group_concat(id) FROM users}] \
       [nl_disk other {SELECT group_concat(id) FROM users}]
} {1 2}

# A statement held across a rule change (here, the Tcl statement cache
# reusing the same SQL text) recompiles with the new redirects.
nl_reset
do_test nonlocal-held-statement {
  db eval {INSERT INTO dolt_nonlocal_tables VALUES('users','main','','immediate')}
  foreach id {2 3} {
    if {$id==3} { db eval {DELETE FROM dolt_nonlocal_tables} }
    db eval {INSERT INTO users VALUES($id, 'held')}
  }
  list [nl_disk main {SELECT group_concat(id) FROM users}] \
       [nl_disk other {SELECT group_concat(id) FROM users}]
} {1,2 1,3}

# Referential actions are coded in the parent's schema, another branch for
# a nonlocal parent, so they could never fire: refused, as in Dolt.
nl_reset
db eval {INSERT INTO dolt_nonlocal_tables VALUES('np','main','cfg','immediate')}
foreach {name sql} {
  cascade {CREATE TABLE c1(k TEXT REFERENCES np(k) ON DELETE CASCADE)}
  set-null {CREATE TABLE c2(k TEXT REFERENCES np(k) ON UPDATE SET NULL)}
  restrict {CREATE TABLE c3(k TEXT REFERENCES np(k) ON DELETE RESTRICT)}
  add-column {ALTER TABLE notes ADD COLUMN k TEXT REFERENCES np(k) ON DELETE CASCADE}
} {
  do_catchsql_test nonlocal-fk-action-$name $sql \
    {1 {foreign keys referencing nonlocal tables do not support referential actions}}
}
do_execsql_test nonlocal-fk-no-action {
  CREATE TABLE c4(k TEXT REFERENCES np(k) ON DELETE NO ACTION);
  CREATE TABLE c5(k TEXT REFERENCES np(k));
  SELECT count(*) FROM sqlite_master WHERE name IN ('c1','c2','c3','c4','c5');
} {2}

# The hidden schemas holding nonlocal targets are an implementation detail:
# introspection lists the nonlocal name under main, not the schema behind it.
nl_reset
do_execsql_test nonlocal-hidden-schemas {
  INSERT INTO dolt_nonlocal_tables VALUES('np','main','cfg','immediate');
  SELECT count(*) FROM np;
  SELECT group_concat(name) FROM pragma_database_list;
  SELECT count(*) FROM pragma_table_list WHERE schema NOT IN ('main','temp');
  SELECT schema FROM pragma_table_list WHERE name='np';
} {1 main 0 main}

set executable [file normalize [info nameofexecutable]]
while {[file type $executable] eq "link"} {
  set executable [file normalize [file join [file dirname $executable] [file readlink $executable]]]
}
set engine [file join [file dirname $executable] doltlite]
if {$tcl_platform(platform) eq "windows"} {append engine .exe}

foreach key {INTEGER INT} {
  foreach gc {0 1} {
    foreach command {
      {SELECT dolt_checkout('missing')}
      {SELECT dolt_merge('missing')}
      {SELECT dolt_commit('-m','nothing staged')}
    } kind {checkout merge commit} {
      foreach access {read write} {
        reset_db
        execsql "CREATE TABLE w(id $key PRIMARY KEY)"
        execsql {
          SELECT dolt_commit('-Am','base');
          SELECT dolt_checkout('-b','nl0');
          CREATE TABLE shared(id INT PRIMARY KEY);
          SELECT dolt_commit('-Am','shared');
          SELECT dolt_checkout('main');
          INSERT INTO dolt_nonlocal_tables VALUES('link','nl0','shared','immediate');
          SELECT dolt_commit('-Am','rule');
          SELECT dolt_checkout('-b','b1');
          BEGIN IMMEDIATE;
          INSERT INTO link VALUES(0);
          INSERT INTO w VALUES(0);
          COMMIT;
        }
        exec $engine -bail [file normalize test.db] {
          BEGIN IMMEDIATE;
          INSERT INTO link VALUES(1);
          INSERT INTO w VALUES(1);
          COMMIT;
        }
        if {$gc} {exec $engine -bail [file normalize test.db] {SELECT dolt_gc()}}
        set prefix nonlocal-peer-refused-$key.$gc.$kind.$access
        do_test $prefix.refused {lindex [catchsql $command] 0} 1
        if {$access eq "read"} {
          do_execsql_test $prefix.read {SELECT id FROM link ORDER BY id} {0 1}
        }
        do_execsql_test $prefix.write {
          BEGIN IMMEDIATE;
          INSERT INTO link VALUES(2);
          INSERT INTO w VALUES(2);
          COMMIT;
        } {}
        do_test $prefix.durable {
          nl_disk nl0 {SELECT id FROM shared ORDER BY id; PRAGMA integrity_check}
        } {0 1 2 ok}
      }
    }
  }
}

# A rule that fell back to the local table follows the target as soon as a
# peer creates the table there.
catch {db close}
forcedelete test.db
sqlite3 db test.db
db eval {
  CREATE TABLE t0(x);
  SELECT dolt_commit('-Am','init');
  SELECT dolt_branch('exp');
}
db close
sqlite3 db [file normalize test.db]/exp
do_execsql_test nonlocal-peer-create.fallback {
  CREATE TABLE settings(k TEXT PRIMARY KEY, v TEXT);
  INSERT INTO dolt_nonlocal_tables VALUES('settings','main',NULL,'immediate');
  SELECT count(*) FROM settings;
} {0}
