  set r [peer eval {
    INSERT INTO users VALUES(7,'g');
    SELECT msg FROM log;
  }]
  peer close
  set r
} {{main-ins 7}}

nl_trigger_reset
do_test nonlocal-trigger-bare-target.fires {
  sqlite3 peer [file normalize test.db]/main
  peer eval {DROP TRIGGER tr_i; DROP TRIGGER tr_u; DROP TRIGGER tr_d}
  peer close
  db eval {
    CREATE TRIGGER x_i AFTER INSERT ON users BEGIN
      INSERT INTO log VALUES('exp-ins '||new.id);
    END;
    INSERT INTO dolt_nonlocal_tables VALUES('users','main',NULL,'immediate');
    INSERT INTO users VALUES(1,'a');
