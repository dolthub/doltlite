  INSERT INTO users VALUES(1,'a');
  UPDATE users SET name='b';
  DELETE FROM users;
  SELECT count(*) FROM log;
} {0}
do_test nonlocal-trigger-none.target-log-untouched {
  nl_disk main {SELECT count(*) FROM log}
} {0}
