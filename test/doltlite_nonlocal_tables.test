    INSERT INTO log2 VALUES(new.nope);
  END;
  INSERT INTO users VALUES(5,'e');
} {1 {no such column: new.nope}}

nl_orphan_reset
do_test nonlocal-trigger-create.merge-binds-local-table {
  db eval {
    CREATE TRIGGER tr AFTER INSERT ON users BEGIN
      INSERT INTO log VALUES('trig '||new.name);
    END;
    DELETE FROM dolt_nonlocal_tables;
    SELECT dolt_commit('-Am','trigger');
    SELECT dolt_checkout('main');
    SELECT dolt_merge('exp');
    INSERT INTO users VALUES(7,'m');
  }
  db eval {SELECT msg FROM log}
} {{trig m}}

finish_test
