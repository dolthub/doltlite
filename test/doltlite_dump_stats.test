set testdir [file dirname $argv0]
source $testdir/tester.tcl

proc dump_stats_open {ref format} {
  set path dump-stats.$format
  forcedelete $path
  db eval {SELECT dolt_dump('--file-name',$path,'-r',$format,'--ref',$ref)}
  if {$format eq "sql"} {
    sqlite3 out file::memory:?doltlite_engine=sqlite -uri 1
    set fd [open $path rb]; set text [read $fd]; close $fd
    out eval $text
  } else {
    sqlite3 out file:dump-stats.sqlite?doltlite_engine=sqlite -uri 1
  }
}

db eval {
  CREATE TABLE t(a,b);
  CREATE INDEX ti ON t(a);
  INSERT INTO t VALUES(1,'one'),(2,'two'),(3,'three');
  CREATE TABLE u(a);
  INSERT INTO u VALUES(1),(2),(3);
  SELECT dolt_commit('-Am','unanalyzed'); SELECT dolt_tag('no-stats');
  ANALYZE;
  UPDATE sqlite_stat1 SET stat='1000000 1' WHERE idx='ti';
  SELECT dolt_commit('-Am','analyzed');
  SELECT dolt_tag('analyzed'); SELECT dolt_branch('stats-branch');
  UPDATE sqlite_stat1 SET stat='1000000 1000000' WHERE idx='ti';
  SELECT dolt_add('sqlite_stat1');
  UPDATE sqlite_stat1 SET stat='1000000 2' WHERE idx='ti';
}
set hash [db one {SELECT dolt_hashof('HEAD')}]
set before [db eval {SELECT dolt_hashof('HEAD'),active_branch(); SELECT * FROM dolt_status}]
ifcapable stat4 {
  set samples [db eval {SELECT * FROM sqlite_stat4 ORDER BY rowid}]
}
foreach ref [list WORKING STAGED HEAD analyzed stats-branch $hash] \
    stat {{1000000 2} {1000000 1000000} {1000000 1} {1000000 1} {1000000 1} {1000000 1}} {
  foreach format {sql sqlite} {
    do_test dump-stats-$ref-$format.rows {
      dump_stats_open $ref $format
      out eval {SELECT tbl,idx,stat FROM sqlite_stat1 ORDER BY tbl,idx}
    } [list t ti $stat u {} 3]
    do_test dump-stats-$ref-$format.plan {
      optimization_control out Stat4 0
      lindex [out eval {EXPLAIN QUERY PLAN SELECT * FROM t WHERE a=1}] 3
    } [expr {$ref eq "STAGED" ? "SCAN t" : "SEARCH t USING INDEX ti (a=?)"}]
    ifcapable stat4 {
      do_test dump-stats-$ref-$format.samples {
        out eval {SELECT * FROM sqlite_stat4 ORDER BY rowid}
      } $samples
    }
    do_test dump-stats-$ref-$format.integrity {out eval {PRAGMA integrity_check}} ok
    catch {out close}
    do_test dump-stats-$ref-$format.source {
      db eval {SELECT dolt_hashof('HEAD'),active_branch(); SELECT * FROM dolt_status}
    } $before
  }
}

db eval {DROP TABLE sqlite_stat1}
ifcapable stat4 {db eval {DROP TABLE sqlite_stat4}}
do_execsql_test dump-stats-historical.no-live {
  SELECT tbl,idx,stat FROM dolt_at_sqlite_stat1('analyzed') ORDER BY tbl,idx;
} {t ti {1000000 1} u {} 3}
foreach format {sql sqlite} {
  do_test dump-stats-historical-$format.rows {
    dump_stats_open analyzed $format
    out eval {SELECT tbl,idx,stat FROM sqlite_stat1 ORDER BY tbl,idx}
  } {t ti {1000000 1} u {} 3}
  catch {out close}
  foreach ref {WORKING no-stats} {
    do_test dump-stats-absent-$ref-$format {
      dump_stats_open $ref $format
      out eval {SELECT count(*) FROM sqlite_schema WHERE name GLOB 'sqlite_stat*'}
    } 0
    catch {out close}
  }
}

db eval {ANALYZE; DELETE FROM sqlite_stat1}
ifcapable stat4 {db eval {DELETE FROM sqlite_stat4}}
db eval {SELECT dolt_commit('-Am','empty statistics')}
foreach ref {WORKING HEAD} {
  foreach format {sql sqlite} {
    do_test dump-stats-empty-$ref-$format {
      dump_stats_open $ref $format
      out eval {
        SELECT count(*) FROM sqlite_schema WHERE name='sqlite_stat1';
        SELECT count(*) FROM sqlite_stat1;
      }
    } {1 0}
    catch {out close}
  }
}
do_test dump-stats.no-temp {glob -nocomplain *-dump-*} {}
finish_test
