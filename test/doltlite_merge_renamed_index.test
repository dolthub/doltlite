set testdir [file dirname $argv0]
source $testdir/tester.tcl

foreach renameTable {0 1 2 3 4} {
  foreach direction {forward reverse} {
    foreach txn {autocommit explicit} {
      reset_db
      execsql {
        CREATE TABLE t(id INTEGER PRIMARY KEY, a INT);
        CREATE UNIQUE INDEX old_idx ON t(a);
        INSERT INTO t VALUES(1,10);
        SELECT dolt_commit('-Am','base');
        SELECT dolt_branch('side');
        DROP INDEX old_idx;
        CREATE UNIQUE INDEX new_idx ON t(a);
        INSERT INTO t VALUES(2,20);
      }
      set table [lindex {t renamed {select data} {odd"name} select} $renameTable]
      set quoted [string map {{"} {""}} $table]
      if {$renameTable} {
        execsql "ALTER TABLE t RENAME TO \"$quoted\""
      }
      execsql {
        SELECT dolt_commit('-Am','replace index');
        SELECT dolt_checkout('side');
        ALTER TABLE t RENAME COLUMN a TO b;
        INSERT INTO t VALUES(3,30);
        SELECT dolt_commit('-Am','rename column');
      }
      if {$direction eq "forward"} {
        execsql {SELECT dolt_checkout('main')}
        set target side
        set branch main
      } else {
        set target main
        set branch side
      }
      if {$txn eq "explicit"} {execsql {BEGIN}}
      set name merge-renamed-index-$renameTable-$direction-$txn
      do_test $name-merge {
        string length [execsql "SELECT dolt_merge('$target')"]
      } 40
      do_execsql_test $name-schema {
        SELECT name FROM sqlite_master WHERE type='index' ORDER BY name;
        SELECT count(*) FROM dolt_status;
        SELECT count(*) FROM dolt_conflicts;
        PRAGMA integrity_check;
      } {new_idx 0 0 ok}
      do_execsql_test $name-rows "
        SELECT id,b FROM \"$quoted\" INDEXED BY new_idx WHERE b>=10 ORDER BY b;
      " {1 10 2 20 3 30}
      do_test $name-unique {
        catchsql "INSERT INTO \"$quoted\" VALUES(4,20)"
      } [list 1 "UNIQUE constraint failed: $table.b"]
      db close
      sqlite3 db [file normalize test.db]/$branch
      do_execsql_test $name-reopen "
        SELECT id,b FROM \"$quoted\" INDEXED BY new_idx WHERE b>=10 ORDER BY b;
        SELECT name FROM sqlite_master WHERE type='index' ORDER BY name;
        PRAGMA integrity_check;
      " {1 10 2 20 3 30 new_idx ok}
    }
  }
}

finish_test
