set testdir [file dirname $argv0]
source $testdir/tester.tcl
source $testdir/malloc_common.tcl

proc merge_schema_snapshot {} {
  set state [execsql {
    SELECT dolt_hashof('HEAD');
    SELECT sql FROM sqlite_master ORDER BY name;
  }]
  foreach table [execsql {
    SELECT name FROM sqlite_master WHERE type='table' ORDER BY name
  }] {
    lappend state [execsql "SELECT dolt_hashof_table('$table')"]
  }
  return $state
}

foreach kind {generated foreign-key} {
  foreach direction {forward reverse} {
    foreach txn {autocommit explicit} {
      reset_db
      execsql {
        CREATE TABLE t(id INTEGER PRIMARY KEY, a TEXT, b INT);
        INSERT INTO t VALUES(1,'x',10),(2,'y',20);
        SELECT dolt_commit('-Am','base');
        SELECT dolt_branch('side');
      }
      if {$kind eq "generated"} {
        execsql {ALTER TABLE t DROP COLUMN b}
      } else {
        execsql {DROP TABLE t}
      }
      execsql {
        SELECT dolt_commit('-Am','drop');
        SELECT dolt_checkout('side');
      }
      if {$kind eq "generated"} {
        execsql {ALTER TABLE t ADD COLUMN d INT AS (b*2) VIRTUAL}
        set pattern {*cannot merge: schema change could not be applied:*no such column*b*}
      } else {
        execsql {
          CREATE TABLE child(id INTEGER PRIMARY KEY, parent INT REFERENCES t(id));
          INSERT INTO child VALUES(1,1);
        }
        set pattern {*no such table: main.t*}
      }
      execsql {SELECT dolt_commit('-Am','dependency')}
      if {$direction eq "forward"} {
        execsql {SELECT dolt_checkout('main')}
        set target side
      } else {
        set target main
      }
      set before [merge_schema_snapshot]
      if {$txn eq "explicit"} {execsql {BEGIN; SAVEPOINT before_merge}}
      set name merge-schema-errors-$kind-$direction-$txn
      do_test $name-message {
        set result [catchsql "SELECT dolt_merge('$target')"]
        if {![string match $pattern [lindex $result 1]]} {
          set result
        } else {
          list [lindex $result 0] detail
        }
      } {1 detail}
      do_test $name-restored {
        list [expr {$before eq [merge_schema_snapshot]}] [execsql {
          SELECT is_merging FROM dolt_merge_status;
          SELECT count(*) FROM dolt_conflicts;
        }]
      } {1 {0 0}}
      do_test $name-retry {
        catchsql "SELECT dolt_merge('$target')"
      } $result
      if {$txn eq "explicit"} {
        do_execsql_test $name-rollback {ROLLBACK TO before_merge; COMMIT} {}
      }
      db close
      if {$direction eq "reverse"} {
        sqlite3 db test.db/side
      } else {
        sqlite3 db test.db
      }
      do_test $name-reopen {
        list [expr {$before eq [merge_schema_snapshot]}] \
             [execsql {PRAGMA integrity_check}]
      } {1 ok}
    }
  }
}

# One side rebuilt the table with two same-typed columns in the other
# order; the other renamed a third column and edited a row.
foreach direction {forward reverse} {
  foreach op {merge cherry_pick} {
    reset_db
    execsql {
      CREATE TABLE t(id INTEGER PRIMARY KEY, a INT, b TEXT, d INT);
      INSERT INTO t VALUES(1,10,'b1',100),(2,20,'b2',200),(3,30,'b3',300);
      SELECT dolt_commit('-Am','base');
      SELECT dolt_branch('side');
      CREATE TABLE n(id INTEGER PRIMARY KEY, d INT, b TEXT, a INT);
      INSERT INTO n(id,d,b,a) SELECT id,d,b,a FROM t;
      DROP TABLE t;
      ALTER TABLE n RENAME TO t;
      SELECT dolt_commit('-Am','reorder');
      SELECT dolt_checkout('side');
      ALTER TABLE t RENAME COLUMN b TO b2;
      UPDATE t SET b2='T' WHERE id=2;
      SELECT dolt_commit('-Am','rename');
    }
    set target main
    if {$direction eq "forward"} {
      execsql {SELECT dolt_checkout('main')}
      set target side
    }
    set name merge-schema-errors-reorder-rename-$direction-$op
    set before [execsql {SELECT * FROM t ORDER BY id}]
    do_test $name-refused {
      lindex [catchsql "SELECT dolt_${op}('$target')"] 0
    } 1
    if {$op eq "merge"} {
      do_test $name-detail {
        execsql BEGIN
        catchsql "SELECT dolt_merge('$target')"
        set detail [execsql {SELECT description FROM dolt_schema_conflicts}]
        execsql ROLLBACK
        string match {*renamed on one branch and columns reordered*} $detail
      } 1
    }
    do_test $name-unchanged {
      list [expr {$before eq [execsql {SELECT * FROM t ORDER BY id}]}] \
           [execsql {SELECT a,d FROM t WHERE id=1; PRAGMA integrity_check}]
    } {1 {10 100 ok}}
  }
}

reset_db
do_execsql_test merge-schema-errors-oom-setup {
  CREATE TABLE c(
    id INTEGER PRIMARY KEY,
    v INT CHECK(v > 0),
    w INT DEFAULT 1
  );
  INSERT INTO c VALUES(1, 10, 2);
  SELECT length(dolt_commit('-Am', 'ancestor'));
  SELECT dolt_branch('side');
  SELECT dolt_checkout('side');
  DROP TABLE c;
  CREATE TABLE c(
    id INTEGER PRIMARY KEY,
    v INT CHECK(v > 5),
    w INT NOT NULL DEFAULT 7
  );
  INSERT INTO c VALUES(1, 10, 2);
  SELECT length(dolt_commit('-Am', 'side constraints'));
  SELECT dolt_checkout('main');
  ALTER TABLE c ADD COLUMN extra INT DEFAULT 3;
  SELECT length(dolt_commit('-Am', 'main add col'));
} {40 0 0 40 0 40}

faultsim_save_and_close

do_faultsim_test merge-schema-errors-oom-adopt -faults oom-transient -prep {
  faultsim_restore_and_reopen
} -body {
  db one {SELECT length(dolt_merge('side'))}
} -test {
  if {$testnfail==0 && ($testrc!=0 || $testresult ne "40")} {
    error "nfail=0 rc=$testrc result=$testresult"
  }
  if {$testrc==0 && $testresult ne "40"} {
    error "rc=0 result=$testresult"
  }
  if {$testrc!=0 && [string match {*conflict*} $testresult]} {
    error "OOM misreported as conflict: $testresult"
  }
}

reset_db
do_execsql_test merge-schema-errors-oom-dual-col-setup {
  CREATE TABLE t(id INTEGER PRIMARY KEY, a INT, b TEXT);
  INSERT INTO t VALUES(1, 10, 'x');
  CREATE INDEX idx_a ON t(a);
  SELECT length(dolt_commit('-Am', 'base'));
  SELECT dolt_branch('side');
  SELECT dolt_checkout('side');
  ALTER TABLE t ADD COLUMN c INT DEFAULT 1;
  DROP INDEX idx_a;
  CREATE INDEX idx_a ON t(a, b);
  INSERT INTO t VALUES(2, 20, 'y', 2);
  SELECT length(dolt_commit('-Am', 'side'));
  SELECT dolt_checkout('main');
  ALTER TABLE t ADD COLUMN d TEXT DEFAULT 'z';
  INSERT INTO t VALUES(3, 30, 'w', 'q');
  SELECT length(dolt_commit('-Am', 'main'));
} {40 0 0 40 0 40}

faultsim_save_and_close

do_faultsim_test merge-schema-errors-oom-dual-col -faults oom-transient -prep {
  faultsim_restore_and_reopen
} -body {
  db one {SELECT length(dolt_merge('side'))}
} -test {
  if {$testnfail==0 && ($testrc!=0 || $testresult ne "40")} {
    error "nfail=0 rc=$testrc result=$testresult"
  }
  if {$testrc==0 && $testresult ne "40"} {
    error "rc=0 result=$testresult"
  }
  if {$testrc!=0 && [string match {*conflict*} $testresult]} {
    error "OOM misreported as conflict: $testresult"
  }
}

do_faultsim_test merge-schema-errors-oom-dual-col-txn -faults oom-transient -prep {
  faultsim_restore_and_reopen
  db eval BEGIN
} -body {
  db one {SELECT length(dolt_merge('side'))}
} -test {
  if {$testnfail==0 && ($testrc!=0 || $testresult ne "40")} {
    error "nfail=0 rc=$testrc result=$testresult"
  }
  if {$testrc==0 && $testresult ne "40"} {
    error "rc=0 result=$testresult"
  }
  if {$testrc!=0 && [string match {*conflict*} $testresult]} {
    error "OOM misreported as conflict: $testresult"
  }
  set nsc [db one {SELECT count(*) FROM dolt_schema_conflicts}]
  if {$nsc != 0} {
    error "OOM recorded $nsc bogus schema conflicts (rc=$testrc result=$testresult)"
  }
}

reset_db
do_execsql_test merge-schema-errors-oom-rename-setup {
  CREATE TABLE t(id INTEGER PRIMARY KEY, a INT, b TEXT, c INT);
  INSERT INTO t VALUES(1, 10, 'hello', 30);
  CREATE TABLE u(id INTEGER PRIMARY KEY, x INT);
  INSERT INTO u VALUES(1, 100);
  SELECT length(dolt_commit('-Am', 'base'));
  SELECT dolt_branch('side');
  SELECT dolt_checkout('side');
  ALTER TABLE t RENAME COLUMN a TO tmp_a;
  ALTER TABLE t RENAME COLUMN b TO a;
  ALTER TABLE t RENAME COLUMN tmp_a TO b;
  ALTER TABLE u RENAME TO u_renamed;
  SELECT length(dolt_commit('-Am', 'side renames'));
  SELECT dolt_checkout('main');
  UPDATE u SET x = 200 WHERE id = 1;
  SELECT length(dolt_commit('-am', 'main edit'));
} {40 0 0 40 0 40}

faultsim_save_and_close

do_faultsim_test merge-schema-errors-oom-rename -faults oom-transient -prep {
  faultsim_restore_and_reopen
} -body {
  db one {SELECT length(dolt_merge('side'))}
} -test {
  if {$testnfail==0 && ($testrc!=0 || $testresult ne "40")} {
    error "nfail=0 rc=$testrc result=$testresult"
  }
  if {$testrc==0 && $testresult ne "40"} {
    error "rc=0 result=$testresult"
  }
}

reset_db
