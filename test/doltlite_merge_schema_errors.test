reset_db
do_execsql_test merge-schema-errors-oom-fk-setup {
  CREATE TABLE p(id INTEGER PRIMARY KEY, v INT);
  CREATE TABLE c(id INTEGER PRIMARY KEY, pid INT REFERENCES p(id), note TEXT);
  INSERT INTO p VALUES(1, 10);
  INSERT INTO c VALUES(1, 1, 'base');
  SELECT length(dolt_commit('-Am', 'base'));
  SELECT dolt_branch('side');
  SELECT dolt_checkout('side');
  INSERT INTO p VALUES(3, 30);
  INSERT INTO c VALUES(3, 3, 'side');
  SELECT length(dolt_commit('-am', 'side fk rows'));
  SELECT dolt_checkout('main');
  INSERT INTO p VALUES(2, 20);
  INSERT INTO c VALUES(2, 2, 'main');
  SELECT length(dolt_commit('-am', 'main fk rows'));
} {40 0 0 40 0 40}

faultsim_save_and_close

