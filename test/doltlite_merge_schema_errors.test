  SELECT length(dolt_commit('-Am', 'side new table'));
  SELECT dolt_checkout('main');
  INSERT INTO t VALUES(2, 20);
  SELECT length(dolt_commit('-am', 'main row'));
} {40 0 0 40 0 40}

