set testdir [file dirname $argv0]
source $testdir/tester.tcl
source $testdir/malloc_common.tcl
set testprefix doltlite-checkout-dot-view-trigger

# Restoring views and triggers drops each one, then recreates them.
# Dropping a view takes its INSTEAD OF triggers with it, and a trigger can
# sort before the view it belongs to.
do_execsql_test 1.0 {
  CREATE TABLE t(id INTEGER PRIMARY KEY, a TEXT);
  CREATE VIEW v AS SELECT id FROM t;
  CREATE TRIGGER vt INSTEAD OF INSERT ON v BEGIN
    INSERT INTO t VALUES(new.id,'via view');
  END;
  CREATE TRIGGER a_first INSTEAD OF DELETE ON v BEGIN
    DELETE FROM t WHERE id=old.id;
  END;
  CREATE TRIGGER tt AFTER INSERT ON t BEGIN SELECT 1; END;
  SELECT length(dolt_commit('-Am','view with instead-of triggers'));
} {40}

do_execsql_test 1.1 {
  INSERT INTO t VALUES(1,'uncommitted');
  SELECT dolt_checkout('.');
  SELECT count(*) FROM t;
  SELECT count(*) FROM dolt_status;
  SELECT name FROM sqlite_master WHERE type IN ('view','trigger') ORDER BY name;
} {0 0 0 a_first tt v vt}

do_execsql_test 1.2 {
  INSERT INTO v VALUES(7);
  SELECT * FROM t;
  DELETE FROM v WHERE id=7;
  SELECT count(*) FROM t;
} {7 {via view} 0}

do_execsql_test 1.3 {
  DROP TRIGGER vt;
  CREATE TRIGGER extra INSTEAD OF UPDATE ON v BEGIN SELECT 1; END;
  SELECT dolt_checkout('dolt_schemas');
  SELECT name FROM sqlite_master WHERE type IN ('view','trigger') ORDER BY name;
  SELECT count(*) FROM dolt_status;
} {0 a_first tt v vt 0}

do_execsql_test 1.4 {
  DROP VIEW v;
  SELECT dolt_checkout('.');
  SELECT name FROM sqlite_master WHERE type IN ('view','trigger') ORDER BY name;
  SELECT count(*) FROM dolt_status;
} {0 a_first tt v vt 0}

# Shadowing TEMP table must not be dropped when dolt_checkout rebuilds main.t.
do_test 2.1-temp-table-shadow {
  reset_db
  db eval {
    CREATE TABLE t(id INTEGER PRIMARY KEY, a TEXT);
    INSERT INTO t VALUES(1,'orig');
    SELECT dolt_commit('-Am','base');
    ALTER TABLE t ADD COLUMN b INT;
    INSERT INTO t VALUES(2,'mod',9);
    CREATE TEMP TABLE t(x TEXT);
    INSERT INTO temp.t VALUES('temp_keep');
  }
  list \
    [db eval {SELECT dolt_checkout('t')}] \
    [db eval {SELECT id, a FROM main.t ORDER BY id}] \
    [db eval {SELECT x FROM temp.t}] \
    [db eval {SELECT count(*) FROM dolt_status}] \
    [db eval {PRAGMA integrity_check}]
} {0 {1 orig} temp_keep 0 ok}

# Shadowing TEMP view must not be dropped when dolt_checkout replaces a main
# view holding a table's name or reverts dolt_schemas.
do_test 2.2-temp-view-shadow-table-rebuild {
  reset_db
  db eval {
    CREATE TABLE t(id INTEGER PRIMARY KEY, a TEXT);
    INSERT INTO t VALUES(1,'orig');
    SELECT dolt_commit('-Am','base');
    DROP TABLE t;
    CREATE VIEW t AS SELECT 99 AS a;
    CREATE TEMP VIEW t AS SELECT 'temp_view' AS x;
  }
  list \
    [db eval {SELECT dolt_checkout('t')}] \
    [db eval {SELECT id, a FROM main.t ORDER BY id}] \
    [db eval {SELECT x FROM temp.t}] \
    [db eval {SELECT count(*) FROM dolt_status}] \
    [db eval {PRAGMA integrity_check}]
} {0 {1 orig} temp_view 0 ok}

do_test 2.3-temp-view-trigger-shadow-schemas {
  reset_db
  db eval {
    CREATE TABLE t(id INTEGER PRIMARY KEY, a TEXT);
    CREATE VIEW v AS SELECT id FROM t;
    CREATE TRIGGER tr AFTER INSERT ON t BEGIN SELECT 1; END;
    SELECT dolt_commit('-Am','base');
    DROP VIEW v;
    CREATE VIEW v AS SELECT a FROM t;
    CREATE TEMP TABLE tt(k INT);
    CREATE TEMP VIEW v AS SELECT 'temp_v' AS s;
    CREATE TEMP TRIGGER tr AFTER INSERT ON tt BEGIN SELECT 2; END;
  }
  list \
    [db eval {SELECT dolt_checkout('dolt_schemas')}] \
    [db eval {SELECT sql FROM main.sqlite_master WHERE name='v'}] \
    [db eval {SELECT s FROM temp.v}] \
    [db eval {SELECT count(*) FROM sqlite_temp_master WHERE type='trigger' AND name='tr'}] \
    [db eval {SELECT count(*) FROM dolt_status}] \
    [db eval {PRAGMA integrity_check}]
} {0 {{CREATE VIEW v AS SELECT id FROM t}} temp_v 1 0 ok}

# Shadowing TEMP index must not be dropped when dolt_checkout drops a
# working-only main index on a table.
do_test 2.4-temp-index-shadow {
  reset_db
  db eval {
    CREATE TABLE t(id INTEGER PRIMARY KEY, a TEXT);
    INSERT INTO t VALUES(1,'orig');
    SELECT dolt_commit('-Am','base');
    CREATE INDEX ix ON t(a);
    CREATE TEMP TABLE tmp(z TEXT);
    CREATE INDEX temp.ix ON tmp(z);
    INSERT INTO temp.tmp VALUES('keep');
  }
  list \
    [db eval {SELECT dolt_checkout('t')}] \
    [db eval {SELECT count(*) FROM main.sqlite_master WHERE type='index' AND name='ix'}] \
    [db eval {SELECT count(*) FROM sqlite_temp_master WHERE type='index' AND name='ix'}] \
    [db eval {SELECT z FROM temp.tmp}] \
    [db eval {SELECT count(*) FROM dolt_status}] \
    [db eval {PRAGMA integrity_check}]
} {0 0 1 keep 0 ok}

# Shadowing TEMP table/view must not be dropped when dolt_checkout drops a
# main table/view holding a committed index's name.
do_test 2.5-temp-shadow-index-name-holder {
  reset_db
  db eval {
    CREATE TABLE t(id INTEGER PRIMARY KEY, a TEXT);
    CREATE INDEX ix ON t(a);
    INSERT INTO t VALUES(1,'a1');
    SELECT dolt_commit('-Am','base');
    DROP INDEX ix;
    CREATE TABLE ix(q);
    CREATE TEMP TABLE ix(z TEXT);
    INSERT INTO temp.ix VALUES('temp_ix');
  }
  list \
    [db eval {SELECT dolt_checkout('t')}] \
    [db eval {SELECT type, name FROM main.sqlite_master WHERE name='ix'}] \
    [db eval {SELECT z FROM temp.ix}] \
    [db eval {SELECT count(*) FROM dolt_status}] \
    [db eval {PRAGMA integrity_check}]
} {0 {index ix} temp_ix 0 ok}

# Non-constant argument expression for dolt_checkout('.') and missing table errors.
do_test 3.1-nonconst-dot-and-missing {
  reset_db
  db eval {
    CREATE TABLE t(id INTEGER PRIMARY KEY, a TEXT);
    CREATE TABLE u(id INTEGER PRIMARY KEY, b TEXT);
    INSERT INTO t VALUES(1,'orig');
    INSERT INTO u VALUES(1,'keep');
    SELECT dolt_commit('-Am','base');
    DROP TABLE u;
    SELECT dolt_add('u');
    UPDATE t SET a='dirty' WHERE id=1;
  }
  list \
    [catchsql {SELECT dolt_checkout(col) FROM (SELECT 'no_such_table' AS col)}] \
    [catchsql {SELECT dolt_checkout('t', col) FROM (SELECT 'no_such_table' AS col)}] \
    [catchsql {SELECT dolt_checkout('main', col) FROM (SELECT 'no_such_table' AS col)}] \
    [db eval {SELECT dolt_checkout(col) FROM (SELECT '.' AS col)}] \
    [db eval {SELECT id, a FROM t ORDER BY id}] \
    [db eval {SELECT id, b FROM u ORDER BY id}] \
    [db eval {PRAGMA integrity_check}]
} [list \
    {1 {no such branch or table: no_such_table}} \
    {1 {no such branch or table: no_such_table}} \
    {1 {no such branch or table: no_such_table}} \
    0 {1 orig} {1 keep} ok]

# OOM fault injection on dolt_checkout('.') (constant and non-constant arg)
# and missing-table checkout paths.
reset_db
db eval {
  CREATE TABLE t(id INTEGER PRIMARY KEY, a TEXT);
  CREATE TABLE u(id INTEGER PRIMARY KEY, b TEXT);
  INSERT INTO t VALUES(1,'orig');
  INSERT INTO u VALUES(1,'keep');
  SELECT dolt_commit('-Am','base');
  DROP TABLE u;
  SELECT dolt_add('u');
  UPDATE t SET a='dirty' WHERE id=1;
}
faultsim_save_and_close

do_faultsim_test 3.2-oom-checkout-dot -faults oom-transient -prep {
  faultsim_restore_and_reopen
} -body {
  execsql {SELECT dolt_checkout('.')}
} -test {
  faultsim_test_result {0 0} {1 {out of memory}} {1 {disk I/O error}} \
      {1 {failed to snapshot current branch state}} {1 {checkout failed}}
  faultsim_integrity_check
}

do_faultsim_test 3.3-oom-checkout-dot-nonconst -faults oom-transient -prep {
  faultsim_restore_and_reopen
} -body {
  execsql {SELECT dolt_checkout(col) FROM (SELECT '.' AS col)}
} -test {
  faultsim_test_result {0 0} {1 {out of memory}} {1 {disk I/O error}} \
      {1 {failed to snapshot current branch state}} {1 {checkout failed}}
  faultsim_integrity_check
}

do_faultsim_test 3.4-oom-checkout-missing -faults oom-transient -prep {
  faultsim_restore_and_reopen
} -body {
  execsql {SELECT dolt_checkout('t', 'no_such_table')}
} -test {
  faultsim_test_result {1 {no such branch or table: no_such_table}} \
      {1 {no such branch or table}} {1 {out of memory}} {1 {disk I/O error}}
  faultsim_integrity_check
}

do_faultsim_test 3.5-oom-checkout-ref-missing -faults oom-transient -prep {
  faultsim_restore_and_reopen
} -body {
  execsql {SELECT dolt_checkout('main', 'no_such_table')}
} -test {
  faultsim_test_result {1 {no such branch or table: no_such_table}} \
      {1 {no such branch or table: main}} {1 {no such branch or table}} \
      {1 {out of memory}} {1 {disk I/O error}}
  faultsim_integrity_check
}

do_faultsim_test 3.6-oom-checkout-nonconst-missing -faults oom-transient -prep {
  faultsim_restore_and_reopen
} -body {
  execsql {SELECT dolt_checkout(col) FROM (SELECT 'no_such_table' AS col)}
} -test {
  faultsim_test_result {1 {no such branch or table: no_such_table}} \
      {1 {no such branch or table}} {1 {out of memory}} {1 {disk I/O error}} \
      {1 {failed to snapshot current branch state}} {1 {checkout failed}}
  faultsim_integrity_check
}

finish_test
