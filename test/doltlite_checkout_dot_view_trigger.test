set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix doltlite-checkout-dot-view-trigger

# Restoring views and triggers drops each one, then recreates them.
# Dropping a view takes its INSTEAD OF triggers with it, and a trigger can
# sort before the view it belongs to.
do_execsql_test 1.0 {
  CREATE TABLE t(id INTEGER PRIMARY KEY, a TEXT);
  CREATE VIEW v AS SELECT id FROM t;
  CREATE TRIGGER vt INSTEAD OF INSERT ON v BEGIN
    INSERT INTO t VALUES(new.id,'via view');
  END;
  CREATE TRIGGER a_first INSTEAD OF DELETE ON v BEGIN
    DELETE FROM t WHERE id=old.id;
  END;
  CREATE TRIGGER tt AFTER INSERT ON t BEGIN SELECT 1; END;
  SELECT length(dolt_commit('-Am','view with instead-of triggers'));
} {40}

do_execsql_test 1.1 {
  INSERT INTO t VALUES(1,'uncommitted');
  SELECT dolt_checkout('.');
  SELECT count(*) FROM t;
  SELECT count(*) FROM dolt_status;
  SELECT name FROM sqlite_master WHERE type IN ('view','trigger') ORDER BY name;
} {0 0 0 a_first tt v vt}

do_execsql_test 1.2 {
  INSERT INTO v VALUES(7);
  SELECT * FROM t;
  DELETE FROM v WHERE id=7;
  SELECT count(*) FROM t;
} {7 {via view} 0}

do_execsql_test 1.3 {
  DROP TRIGGER vt;
  CREATE TRIGGER extra INSTEAD OF UPDATE ON v BEGIN SELECT 1; END;
  SELECT dolt_checkout('dolt_schemas');
  SELECT name FROM sqlite_master WHERE type IN ('view','trigger') ORDER BY name;
  SELECT count(*) FROM dolt_status;
} {0 a_first tt v vt 0}

do_execsql_test 1.4 {
  DROP VIEW v;
  SELECT dolt_checkout('.');
  SELECT name FROM sqlite_master WHERE type IN ('view','trigger') ORDER BY name;
  SELECT count(*) FROM dolt_status;
} {0 a_first tt v vt 0}

finish_test
