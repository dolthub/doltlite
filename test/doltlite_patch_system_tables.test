set testdir [file dirname $argv0]
source $testdir/tester.tcl

proc patch_sys_state {} {
  execsql {
    SELECT 'seq', name, seq FROM sqlite_sequence ORDER BY name;
    SELECT 'stat', count(*) FROM sqlite_schema WHERE name='sqlite_stat1';
    SELECT 'ver', user_version, application_id
      FROM pragma_user_version, pragma_application_id;
  }
}

proc patch_sys_replay {from to} {
  execsql "SELECT dolt_reset('--hard','$from')"
  foreach statement [execsql "
    SELECT statement FROM dolt_patch('$from','$to') ORDER BY statement_order
  "] {execsql $statement}
  set state [patch_sys_state]
  lappend state [execsql "
    SELECT count(*) FROM dolt_diff_summary('$to','WORKING')
  "]
  execsql "SELECT dolt_reset('--hard','$to')"
  set state
}

do_test patch-system.setup {
  execsql {
  CREATE TABLE s(id INTEGER PRIMARY KEY AUTOINCREMENT, v INT);
  CREATE TABLE t(id INT PRIMARY KEY, a INT);
  CREATE INDEX ta ON t(a);
  INSERT INTO s(v) VALUES(1);
  INSERT INTO t VALUES(1,1),(2,2);
  SELECT dolt_commit('-Am','a');
  SELECT dolt_tag('a');
  INSERT INTO s(v) VALUES(2);
  DELETE FROM s WHERE v=2;
  ANALYZE;
  PRAGMA user_version=42;
  PRAGMA application_id=7;
  SELECT dolt_commit('-Am','b');
  SELECT dolt_tag('b');
  }
  execsql {SELECT count(*) FROM dolt_diff_summary('a','b')}
} {2}

do_execsql_test patch-system.statements {
  SELECT table_name, diff_type, statement FROM dolt_patch('a','b')
   WHERE statement NOT LIKE 'INSERT INTO "sqlite_stat1"%'
   ORDER BY statement_order;
} [list \
  sqlite_sequence data {DELETE FROM "sqlite_sequence";} \
  sqlite_sequence data \
    {INSERT INTO "sqlite_sequence"("rowid","name","seq") VALUES (1,'s',2);} \
  sqlite_stat1 schema {ANALYZE sqlite_schema;} \
  sqlite_stat1 data {DELETE FROM "sqlite_stat1";} \
  sqlite_stat1 schema {ANALYZE sqlite_schema;} \
  {} schema {PRAGMA user_version=42;} \
  {} schema {PRAGMA application_id=7;} \
]

do_execsql_test patch-system.filter {
  SELECT count(*) FROM dolt_patch('a','b','sqlite_sequence');
  SELECT count(*) FROM dolt_patch('a','b','t');
  SELECT DISTINCT table_name FROM dolt_patch('a','b','sqlite_stat1');
} {2 0 sqlite_stat1}

do_test patch-system.replay-forward {
  patch_sys_replay a b
} {seq s 2 stat 1 ver 42 7 0}

do_test patch-system.replay-reverse {
  patch_sys_replay b a
} {seq s 1 stat 0 ver 0 0 0}

do_execsql_test patch-system.unchanged {
  SELECT count(*) FROM dolt_patch('b','b');
} {0}

finish_test
