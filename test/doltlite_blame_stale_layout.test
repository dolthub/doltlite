set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix doltlite_blame_stale_layout

# dolt_blame_<table> keeps the key columns it read when first used. A
# merge, a reset or another connection's commit can put a table with a
# different primary key under the same name; blame has to notice.
proc blame_setup {} {
  reset_db
  execsql {
    CREATE TABLE t(id INTEGER PRIMARY KEY, a INT);
    INSERT INTO t VALUES(1,10),(2,20);
    SELECT dolt_commit('-Am','c1');
    SELECT dolt_checkout('-b','other');
    DROP TABLE t;
    CREATE TABLE t(k TEXT, j INT, v, PRIMARY KEY(k,j)) WITHOUT ROWID;
    INSERT INTO t VALUES('a',1,'x'),('b',2,'y');
    SELECT dolt_commit('-Am','c2');
    SELECT dolt_checkout('main');
  }
}
set old {1 c1 2 c1}
set new {a 1 c2 b 2 c2}

foreach {name sql} {
  merge       {SELECT dolt_merge('other')}
  reset-hard  {SELECT dolt_reset('--hard','other')}
} {
  blame_setup
  do_execsql_test $name.before {SELECT id, message FROM dolt_blame_t ORDER BY 1} $old
  execsql $sql
  do_execsql_test $name.after {SELECT k, j, message FROM dolt_blame_t ORDER BY 1} $new
  do_execsql_test $name.again {SELECT k, j, message FROM dolt_blame_t ORDER BY 1} $new
  do_execsql_test $name.integrity {PRAGMA integrity_check} ok
}

blame_setup
do_execsql_test peer.before {SELECT id, message FROM dolt_blame_t ORDER BY 1} $old
do_test peer.commit {
  sqlite3 peer test.db
  peer eval {SELECT dolt_merge('other')}
  peer close
  execsql {SELECT k, j, v FROM t ORDER BY 1}
} {a 1 x b 2 y}
do_execsql_test peer.after {SELECT k, j, message FROM dolt_blame_t ORDER BY 1} $new

# The same key shape keeps working across a change that does not touch it.
blame_setup
do_execsql_test same.before {SELECT id, message FROM dolt_blame_t ORDER BY 1} $old
execsql {
  ALTER TABLE t ADD COLUMN b INT;
  INSERT INTO t VALUES(3,30,3);
  SELECT dolt_commit('-Am','c3');
}
do_execsql_test same.rows {SELECT id, message FROM dolt_blame_t ORDER BY 1} {1 c1 2 c1 3 c3}

# A prepared blame statement is re-planned against the new table.
blame_setup
do_test prepared.reuse {
  set r [execsql {SELECT count(*) FROM dolt_blame_t}]
  execsql {SELECT dolt_merge('other')}
  lappend r [execsql {SELECT count(*) FROM dolt_blame_t}]
  lappend r [execsql {SELECT group_concat(k) FROM dolt_blame_t}]
} {2 2 a,b}

# Once the table is gone, blame says so instead of reporting corruption.
foreach {name sql msg} {
  drop        {DROP TABLE t} {no such table: dolt_blame_t}
  reset-gone  {SELECT dolt_reset('--hard','HEAD~1')} {no such table: dolt_blame_t}
  view        {DROP TABLE t; CREATE VIEW t AS SELECT 1 AS id}
              {dolt_blame_t: table has no primary key}
} {
  reset_db
  execsql {
    CREATE TABLE u(x INTEGER PRIMARY KEY);
    SELECT dolt_commit('-Am','c0');
    CREATE TABLE t(id INTEGER PRIMARY KEY, a INT);
    INSERT INTO t VALUES(1,10),(2,20);
    SELECT dolt_commit('-Am','c1');
    SELECT count(*) FROM dolt_blame_t;
  }
  execsql $sql
  do_test gone.$name {
    catchsql {SELECT count(*) FROM dolt_blame_t}
  } [list 1 $msg]
  do_execsql_test gone.$name.integrity {PRAGMA integrity_check} ok
}

foreach {layout pk} {rowid INTEGER clustered INT} {
  foreach shape {equal-root mixed} {
    reset_db
    execsql "CREATE TABLE t(id $pk PRIMARY KEY, a INT, b INT)"
    execsql {INSERT INTO t VALUES(1,5,NULL)}
    if {$shape eq "mixed"} {execsql {INSERT INTO t VALUES(2,6,7),(3,NULL,NULL)}}
    execsql {
      SELECT dolt_commit('-Am','before');
      ALTER TABLE t DROP COLUMN a;
      UPDATE t SET b=5 WHERE id=1;
      SELECT dolt_commit('-Am','after');
    }
    set diffRows {1 NULL 5 modified}
    set blameRows {1 after}
    set modified 1
    set unmodified 0
    if {$shape eq "mixed"} {
      lappend diffRows 2 7 7 modified
      lappend blameRows 2 after 3 before
      incr modified
      incr unmodified
    }
    set name dropped-slot-$layout-$shape
    do_execsql_test $name.diff {
      SELECT from_id, quote(from_b), quote(to_b), diff_type
      FROM dolt_diff_t('HEAD~1','HEAD') ORDER BY from_id;
    } $diffRows
    do_execsql_test $name.reverse {
      SELECT to_id, quote(to_b), quote(from_b), diff_type
      FROM dolt_diff_t('HEAD','HEAD~1') ORDER BY to_id;
    } $diffRows
    do_execsql_test $name.history {
      SELECT from_id, quote(from_b), quote(to_b), diff_type
      FROM dolt_diff_t WHERE to_commit=dolt_hashof('HEAD') ORDER BY from_id;
    } $diffRows
    do_execsql_test $name.history-key {
      SELECT from_id, quote(from_b), quote(to_b), diff_type
      FROM dolt_diff_t WHERE to_commit=dolt_hashof('HEAD') AND to_id=1;
    } {1 NULL 5 modified}
    do_execsql_test $name.stat {
      SELECT rows_unmodified, rows_modified, cells_modified
      FROM dolt_diff_stat('HEAD~1','HEAD','t');
    } [list $unmodified $modified 1]
    do_execsql_test $name.summary {
      SELECT data_change, schema_change FROM dolt_diff_summary('HEAD~1','HEAD','t');
    } {1 1}
    do_execsql_test $name.blame {
      SELECT id, message FROM dolt_blame_t ORDER BY id;
    } $blameRows
  }
}

# Shape change across >BLAME_DIFF_BUDGET rows (rowid <-> WITHOUT ROWID)
# must blame all rows at the recreating commit and never match across key types.
reset_db
execsql {
  CREATE TABLE t(a INT, id INTEGER PRIMARY KEY, v TEXT);
  INSERT INTO t VALUES(5, 0, NULL);
  WITH RECURSIVE c(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM c WHERE x<=200)
    INSERT INTO t SELECT x+1000, x, 'old' FROM c;
  SELECT dolt_commit('-Am', 'c1');
  DROP TABLE t;
  CREATE TABLE t(id INT PRIMARY KEY, v TEXT) WITHOUT ROWID;
  INSERT INTO t VALUES(5, NULL);
  WITH RECURSIVE c(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM c WHERE x<=200)
    INSERT INTO t SELECT x+1000, 'new' FROM c;
}
do_execsql_test shape-change-rowid-to-wor.working {
  SELECT count(*) FROM dolt_blame_t;
  SELECT count(*) FROM dolt_blame_t WHERE id=5;
} {0 0}
execsql {SELECT dolt_commit('-Am', 'c2')}
do_execsql_test shape-change-rowid-to-wor.committed {
  SELECT id, message FROM dolt_blame_t WHERE id=5;
  SELECT message, count(*) FROM dolt_blame_t GROUP BY message;
} {5 c2 c2 202}

reset_db
execsql {
  CREATE TABLE t(id INTEGER PRIMARY KEY, v TEXT) WITHOUT ROWID;
  INSERT INTO t VALUES(0, 'old');
  WITH RECURSIVE c(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM c WHERE x<=200)
    INSERT INTO t SELECT x, 'old' FROM c;
  SELECT dolt_commit('-Am', 'c1');
  DROP TABLE t;
  CREATE TABLE t(id INTEGER PRIMARY KEY, v TEXT);
  INSERT INTO t VALUES(0, 'old');
  WITH RECURSIVE c(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM c WHERE x<=200)
    INSERT INTO t SELECT x, 'new' FROM c;
}
do_execsql_test shape-change-wor-to-rowid.working {
  SELECT count(*) FROM dolt_blame_t;
  SELECT count(*) FROM dolt_blame_t WHERE id=0;
} {0 0}
execsql {SELECT dolt_commit('-Am', 'c2')}
do_execsql_test shape-change-wor-to-rowid.committed {
  SELECT id, message FROM dolt_blame_t WHERE id=0;
  SELECT message, count(*) FROM dolt_blame_t GROUP BY message;
} {0 c2 c2 202}

# Dropping a column before the PK shifts the PK column ordinal.
reset_db
execsql {
  CREATE TABLE t(x TEXT, id TEXT PRIMARY KEY);
  INSERT INTO t VALUES('a', 'k1'), (NULL, 'k2');
  SELECT dolt_commit('-Am', 'c1');
}
do_execsql_test drop-col-pk-ordinal.before {
  SELECT id, message FROM dolt_blame_t ORDER BY id;
} {k1 c1 k2 c1}
execsql {ALTER TABLE t DROP COLUMN x}
do_execsql_test drop-col-pk-ordinal.after-drop-working {
  SELECT id, message FROM dolt_blame_t ORDER BY id;
} {k2 c1}
execsql {SELECT dolt_commit('-Am', 'c2')}
do_execsql_test drop-col-pk-ordinal.after-drop-committed {
  SELECT id, message FROM dolt_blame_t ORDER BY id;
} {k1 c2 k2 c1}

# Dropping a column before an INTEGER PRIMARY KEY shifts intPkCid.
reset_db
execsql {
  CREATE TABLE t(x TEXT, id INTEGER PRIMARY KEY);
  INSERT INTO t VALUES('a', 1), ('b', 2);
  SELECT dolt_commit('-Am', 'c1');
}
do_execsql_test drop-col-ipk-ordinal.before {
  SELECT id, message FROM dolt_blame_t ORDER BY id;
} {1 c1 2 c1}
execsql {
  ALTER TABLE t DROP COLUMN x;
  SELECT dolt_commit('-Am', 'c2');
}
do_execsql_test drop-col-ipk-ordinal.after {
  SELECT id, message FROM dolt_blame_t ORDER BY id;
} {1 c2 2 c2}

# Branch switch where the PK has the same name at a different column ordinal.
reset_db
execsql {
  CREATE TABLE t(x TEXT, id TEXT PRIMARY KEY);
  INSERT INTO t VALUES('a', 'k1');
  SELECT dolt_commit('-Am', 'c1');
  SELECT dolt_checkout('-b', 'reordered');
  DROP TABLE t;
  CREATE TABLE t(id TEXT PRIMARY KEY, y INT);
  INSERT INTO t VALUES('k2', 42);
  SELECT dolt_commit('-Am', 'c2');
  SELECT dolt_checkout('main');
}
do_execsql_test branch-pk-ordinal.main {
  SELECT id, message FROM dolt_blame_t;
} {k1 c1}
execsql {SELECT dolt_checkout('reordered')}
do_execsql_test branch-pk-ordinal.reordered {
  SELECT id, message FROM dolt_blame_t;
} {k2 c2}

# Branch switch changing PK collation must reconnect blame vtab.
reset_db
execsql {
  CREATE TABLE t(id TEXT PRIMARY KEY, v INT);
  INSERT INTO t VALUES('abc', 1);
  SELECT dolt_commit('-Am', 'c1');
  SELECT dolt_checkout('-b', 'nocase');
  DROP TABLE t;
  CREATE TABLE t(id TEXT COLLATE NOCASE PRIMARY KEY, v INT);
  INSERT INTO t VALUES('abc', 1);
  SELECT dolt_commit('-Am', 'c2');
  SELECT dolt_checkout('main');
}
do_execsql_test branch-pk-collation.binary {
  SELECT id, message FROM dolt_blame_t WHERE id='ABC';
} {}
execsql {SELECT dolt_checkout('nocase')}
do_execsql_test branch-pk-collation.nocase {
  SELECT id, message FROM dolt_blame_t WHERE id='ABC';
} {abc c1}

# Branch switch changing PK affinity must reconnect blame vtab.
reset_db
execsql {
  CREATE TABLE t(id TEXT PRIMARY KEY, v INT);
  INSERT INTO t VALUES('1', 10);
  SELECT dolt_commit('-Am', 'c1');
  SELECT dolt_checkout('-b', 'realpk');
  DROP TABLE t;
  CREATE TABLE t(id REAL PRIMARY KEY, v INT);
  INSERT INTO t VALUES(1, 20);
  SELECT dolt_commit('-Am', 'c2');
  SELECT dolt_checkout('main');
}
do_execsql_test branch-pk-affinity.text {
  SELECT typeof(id), id, message FROM dolt_blame_t;
} {text 1 c1}
execsql {SELECT dolt_checkout('realpk')}
do_execsql_test branch-pk-affinity.real {
  SELECT typeof(id), id, message FROM dolt_blame_t WHERE id='1';
} {real 1.0 c2}

finish_test
