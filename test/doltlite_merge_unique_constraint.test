set testdir [file dirname $argv0]
source $testdir/tester.tcl

# One side rebuilds a table to add or remove a UNIQUE constraint; the other
# makes an unrelated change. The constraint's autoindex has its own catalog
# entry, and the merged schema must hold exactly the autoindexes the merged
# table declares.
proc uq_rebuild {cols} {
  execsql "CREATE TABLE x(id INTEGER PRIMARY KEY, a INT, $cols)"
  execsql {
    INSERT INTO x SELECT * FROM t;
    DROP TABLE t;
    ALTER TABLE x RENAME TO t;
  }
}
foreach {name from to bUnique cUnique} {
  drop-only      {b TEXT UNIQUE, c TEXT}        {b TEXT, c TEXT}               0 0
  add-only       {b TEXT, c TEXT}               {b TEXT UNIQUE, c TEXT}        1 0
  drop-first     {b TEXT UNIQUE, c TEXT UNIQUE} {b TEXT, c TEXT UNIQUE}        0 1
  drop-second    {b TEXT UNIQUE, c TEXT UNIQUE} {b TEXT UNIQUE, c TEXT}        1 0
  drop-both      {b TEXT UNIQUE, c TEXT UNIQUE} {b TEXT, c TEXT}               0 0
  add-second     {b TEXT UNIQUE, c TEXT}        {b TEXT UNIQUE, c TEXT UNIQUE} 1 1
} {
  foreach direction {forward reverse} {
    foreach other {table rows} {
      foreach op {merge cherry_pick} {
        reset_db
        execsql "CREATE TABLE t(id INTEGER PRIMARY KEY, a INT, $from)"
        execsql {
          INSERT INTO t VALUES(1,10,'x','p'),(2,20,'y','q');
          CREATE TABLE u(id INTEGER PRIMARY KEY, v);
          SELECT dolt_commit('-Am','base');
          SELECT dolt_branch('br');
        }
        if {$other eq "table"} {
          execsql {CREATE TABLE zz(q)}
        } else {
          execsql {INSERT INTO u VALUES(1,'other')}
        }
        execsql {
          SELECT dolt_commit('-Am','other');
          SELECT dolt_checkout('br');
        }
        uq_rebuild $to
        execsql {SELECT dolt_commit('-Am','constraint')}
        if {$direction eq "forward"} {
          execsql {SELECT dolt_checkout('main')}
          set target br
          set reopen [file normalize test.db]
        } else {
          set target main
          set reopen "[file normalize test.db]/br"
        }
        set prefix unique-constraint-$name-$direction-$other-$op
        do_test $prefix.run {
          lindex [catchsql "SELECT dolt_${op}('$target')"] 0
        } 0
        foreach stage {merged reopened} {
          if {$stage eq "reopened"} {
            db close
            sqlite3 db $reopen
          }
          do_execsql_test $prefix.$stage.schema {
            SELECT count(*) FROM sqlite_schema
            WHERE tbl_name='t' AND name LIKE 'sqlite_autoindex_%';
            SELECT group_concat(id) FROM (SELECT id FROM t ORDER BY id);
            PRAGMA integrity_check;
          } [list [expr {$bUnique+$cUnique}] 1,2 ok]
        }
        do_test $prefix.enforced {
          set r [list [lindex [catchsql {INSERT INTO t VALUES(8,80,'x','new8')}] 0]]
          lappend r [lindex [catchsql {INSERT INTO t VALUES(9,90,'new9','p')}] 0]
          execsql {PRAGMA integrity_check}
          set r
        } [list $bUnique $cUnique]
      }
    }
  }
}

# Reverting the commit that added the constraint, after a later commit.
reset_db
do_test unique-constraint-revert {
  execsql {
    CREATE TABLE t(id INTEGER PRIMARY KEY, a INT, b TEXT, c TEXT);
    INSERT INTO t VALUES(1,10,'x','p'),(2,20,'y','q');
    SELECT dolt_commit('-Am','base');
  }
  uq_rebuild {b TEXT UNIQUE, c TEXT}
  execsql {
    SELECT dolt_commit('-Am','add unique');
    CREATE TABLE zz(q);
    SELECT dolt_commit('-Am','later');
  }
  set r [list [lindex [catchsql {SELECT dolt_revert('HEAD~1')}] 0]]
  lappend r [execsql {
    SELECT count(*) FROM sqlite_schema WHERE name LIKE 'sqlite_autoindex_%';
    PRAGMA integrity_check;
  }]
  lappend r [lindex [catchsql {INSERT INTO t VALUES(8,80,'x','z')}] 0]
} {0 {0 ok} 0}

# Theirs adds a UNIQUE constraint by rebuild while ours renames a column,
# renames the table, or retypes a column. The first two merge, as they do
# with the sides swapped; the third is a conflict that leaves ours intact.
proc uq_theirs_rebuild {} {
  execsql {
    CREATE TABLE new_t(id INTEGER PRIMARY KEY, a INT, c TEXT, UNIQUE(c));
    INSERT INTO new_t SELECT id,a,c FROM t;
    DROP TABLE t;
    ALTER TABLE new_t RENAME TO t;
    CREATE INDEX ia ON t(a);
  }
}
foreach {name ours tbl col merges} {
  rename-column {ALTER TABLE t RENAME COLUMN a TO a2} t a2 1
  rename-table  {ALTER TABLE t RENAME TO t2} t2 a 1
  retype-column {
    CREATE TABLE new_t(id INTEGER PRIMARY KEY, a TEXT, c TEXT);
    INSERT INTO new_t SELECT id,a,c FROM t;
    DROP TABLE t;
    ALTER TABLE new_t RENAME TO t;
    CREATE INDEX ia ON t(a);
  } t a 0
} {
  foreach side {ours-first theirs-first} {
    reset_db
    execsql {
      CREATE TABLE t(id INTEGER PRIMARY KEY, a INT, c TEXT);
      CREATE INDEX ia ON t(a);
      INSERT INTO t VALUES(1,10,'c1'),(2,20,'c2'),(3,30,'c3');
      SELECT dolt_commit('-Am','base');
      SELECT dolt_branch('br');
    }
    if {$side eq "ours-first"} {
      execsql $ours
      execsql {SELECT dolt_commit('-Am','ours'); SELECT dolt_checkout('br')}
      uq_theirs_rebuild
    } else {
      uq_theirs_rebuild
      execsql {SELECT dolt_commit('-Am','ours'); SELECT dolt_checkout('br')}
      execsql $ours
    }
    execsql {SELECT dolt_commit('-Am','theirs'); SELECT dolt_checkout('main')}
    set prefix unique-vs-$name-$side
    if {$merges} {
      do_test $prefix.merge {
        lindex [catchsql {SELECT dolt_merge('br')}] 0
      } 0
      do_test $prefix.state {
        set r [execsql "
          SELECT group_concat(id||':'||$col||':'||c, ' ')
            FROM (SELECT * FROM $tbl ORDER BY id);
          SELECT count(*) FROM $tbl INDEXED BY ia WHERE $col=20;
          SELECT count(*) FROM sqlite_schema
           WHERE name LIKE 'sqlite_autoindex_%';
          PRAGMA integrity_check;
        "]
        lappend r [lindex [catchsql "INSERT INTO $tbl VALUES(9,90,'c1')"] 0]
      } {{1:10:c1 2:20:c2 3:30:c3} 1 1 ok 1}
    } elseif {$side eq "ours-first"} {
      do_test $prefix.conflict {
        set r [catchsql {SELECT dolt_merge('br')}]
        list [lindex $r 0] [string match {*conflicts detected*} [lindex $r 1]]
      } {1 1}
      do_execsql_test $prefix.intact {
        SELECT typeof(a) FROM t WHERE id=1;
        SELECT count(*) FROM sqlite_schema WHERE name LIKE 'sqlite_autoindex_%';
        PRAGMA integrity_check;
      } {text 0 ok}
    }
  }
}

foreach {layout key suffix} {
  rowid {id INTEGER PRIMARY KEY} {}
  without_rowid {id INT PRIMARY KEY} {WITHOUT ROWID}
} {
  reset_db
  execsql "CREATE TABLE t($key, a TEXT, b INT) $suffix"
  execsql "CREATE UNIQUE INDEX /* on ( */ u_part ON /* tbl */ t(a /* don't ) where */) WHERE b > 0 -- trailing where comment"
  execsql {
    SELECT dolt_commit('-Am','base');
    SELECT dolt_branch('side');
    INSERT INTO t VALUES(1,'dup',1);
    SELECT dolt_commit('-Am','main row');
    SELECT dolt_checkout('side');
    INSERT INTO t VALUES(2,'dup',1);
    SELECT dolt_commit('-Am','side row');
    SELECT dolt_checkout('main');
    BEGIN;
  }
  do_catchsql_test unique-comment-partial-$layout-collide {
    SELECT dolt_merge('side');
  } {1 {Merge resulted in constraint violations. Resolve the rows in dolt_constraint_violations and then commit with dolt_commit.}}
  do_execsql_test unique-comment-partial-$layout-violations {
    SELECT violation_type, id, a, b FROM dolt_constraint_violations_t ORDER BY id;
  } {{unique index} 1 dup 1 {unique index} 2 dup 1}
  execsql ROLLBACK

  reset_db
  execsql "CREATE TABLE t($key, a TEXT, b INT) $suffix"
  execsql "CREATE UNIQUE INDEX /* on ( */ u_part ON /* tbl */ t(a /* don't ) where */) WHERE b > 0 -- trailing where comment"
  execsql {
    SELECT dolt_commit('-Am','base');
    SELECT dolt_branch('side');
    INSERT INTO t VALUES(1,'dup',1);
    SELECT dolt_commit('-Am','main row');
    SELECT dolt_checkout('side');
    INSERT INTO t VALUES(2,'dup',0);
    SELECT dolt_commit('-Am','side filtered row');
    SELECT dolt_checkout('main');
  }
  do_test unique-comment-partial-$layout-filtered {
    lindex [catchsql {SELECT dolt_merge('side')}] 0
  } 0
  do_execsql_test unique-comment-partial-$layout-filtered-ok {
    SELECT count(*) FROM dolt_constraint_violations;
    SELECT id, a, b FROM t ORDER BY id;
    PRAGMA integrity_check;
  } {0 1 dup 1 2 dup 0 ok}

  reset_db
  execsql "CREATE TABLE t($key, a TEXT, b INT) $suffix"
  execsql "CREATE UNIQUE INDEX /* on ( */ u_expr ON /* tbl */ t(lower(a -- inner comment\n) /* don't ) , */ DESC -- trailing expr\n) WHERE b > 0 -- trailing where"
  execsql {
    SELECT dolt_commit('-Am','base');
    SELECT dolt_branch('side');
    INSERT INTO t VALUES(1,'Abc',1);
    SELECT dolt_commit('-Am','main expr row');
    SELECT dolt_checkout('side');
    INSERT INTO t VALUES(2,'aBC',1);
    SELECT dolt_commit('-Am','side expr row');
    SELECT dolt_checkout('main');
    BEGIN;
  }
  do_catchsql_test unique-comment-expr-$layout-collide {
    SELECT dolt_merge('side');
  } {1 {Merge resulted in constraint violations. Resolve the rows in dolt_constraint_violations and then commit with dolt_commit.}}
  do_execsql_test unique-comment-expr-$layout-violations {
    SELECT violation_type, id, a, b FROM dolt_constraint_violations_t ORDER BY id;
  } {{unique index} 1 Abc 1 {unique index} 2 aBC 1}
  execsql ROLLBACK

  reset_db
  execsql "CREATE TABLE t($key, a TEXT, b INT) $suffix"
  execsql "CREATE UNIQUE INDEX /* on ( */ u_expr ON /* tbl */ t(lower(a -- inner comment\n) /* don't ) , */ DESC -- trailing expr\n) WHERE b > 0 -- trailing where"
  execsql {
    SELECT dolt_commit('-Am','base');
    SELECT dolt_branch('side');
    INSERT INTO t VALUES(1,'Abc',1);
    SELECT dolt_commit('-Am','main expr row');
    SELECT dolt_checkout('side');
    INSERT INTO t VALUES(2,'aBC',0);
    SELECT dolt_commit('-Am','side expr filtered');
    SELECT dolt_checkout('main');
  }
  do_test unique-comment-expr-$layout-filtered {
    lindex [catchsql {SELECT dolt_merge('side')}] 0
  } 0
  do_execsql_test unique-comment-expr-$layout-filtered-ok {
    SELECT count(*) FROM dolt_constraint_violations;
    SELECT id, a, b FROM t ORDER BY id;
    PRAGMA integrity_check;
  } {0 1 Abc 1 2 aBC 0 ok}
}

finish_test
