set testdir [file dirname $argv0]
source $testdir/tester.tcl
source $testdir/malloc_common.tcl

set case 0
foreach {schema suffix} {
  {a INT PRIMARY KEY,v} {}
  {a TEXT PRIMARY KEY COLLATE NOCASE,v} {}
  {a INT,v,PRIMARY KEY(a,v)} {}
  {a INT PRIMARY KEY,v,UNIQUE(v)} {}
  {a INTEGER PRIMARY KEY,v} {}
  {a INT PRIMARY KEY,v} {WITHOUT ROWID}
  {a INT PRIMARY KEY DESC,v} {}
  {a,v} {}
} {
  foreach name {empty renamed} {
    foreach reopen {0 1} {
      set prefix empty-update-[incr case].$name.$reopen
      reset_db
      if {$name eq "empty"} {set table {""}} else {set table t}
      db eval "CREATE TABLE ${table}($schema) $suffix;"
      db eval "INSERT INTO $table VALUES(1,'one'),(2,'two')"
      if {$name eq "renamed"} {db eval {ALTER TABLE t RENAME TO ""}}
      if {$reopen} {db close; sqlite3 db test.db}
      db progress 10000 {expr 1}
      do_test $prefix.update {
        set result [catchsql {UPDATE "" SET v='updated' WHERE a=1}]
        set result
      } {0 {}}
      do_execsql_test $prefix.rows {SELECT * FROM "" ORDER BY a} {1 updated 2 two}
      do_execsql_test $prefix.scan {
        SAVEPOINT scan; UPDATE "" SET v=v||'-scan';
        SELECT * FROM "" ORDER BY a; ROLLBACK TO scan; RELEASE scan;
      } {1 updated-scan 2 two-scan}
      do_execsql_test $prefix.key {UPDATE "" SET a=3 WHERE a=2; SELECT * FROM "" ORDER BY a} {1 updated 3 two}
      do_execsql_test $prefix.rollback {
        SAVEPOINT s; UPDATE "" SET v='rollback' WHERE a=1; ROLLBACK TO s; RELEASE s;
        SELECT * FROM "" ORDER BY a;
      } {1 updated 3 two}
      db close
      sqlite3 db test.db
      do_execsql_test $prefix.reopen {SELECT * FROM "" ORDER BY a} {1 updated 3 two}
      do_execsql_test $prefix.integrity {PRAGMA integrity_check} ok
    }
  }
}
foreach branch {integer indexed text desc composite without} {
  foreach op {update scan key replace delete rollback rename delete-txn} {
    db close
    forcecopy [file join $::testdir empty_name_v12_fixture.db] test.db
    sqlite3 db test.db
    db eval "SELECT dolt_checkout('$branch')"
    db progress 10000 {expr 1}
    set prefix empty-legacy-$branch.$op
    do_execsql_test $prefix.lookup {SELECT * FROM "" WHERE a=2} {2 two}
    if {$branch eq "indexed"} {
      do_execsql_test $prefix.index {SELECT * FROM "" INDEXED BY payload WHERE v='old'} {1 old}
    }
    set constraint {UNIQUE constraint failed: .a}
    if {$branch eq "composite"} {set constraint {UNIQUE constraint failed: .a, .v}}
    do_catchsql_test $prefix.duplicate {INSERT INTO "" VALUES(1,'old')} [list 1 $constraint]
    do_execsql_test $prefix.before {SELECT * FROM "" ORDER BY a} {1 old 2 two}
    switch $op {
      delete-txn {set sql {BEGIN; DELETE FROM "" WHERE a=2}; set expected {1 old}}
      rename {set sql {ALTER TABLE "" RENAME TO renamed; UPDATE renamed SET a=3 WHERE a=2; ALTER TABLE renamed RENAME TO ""}; set expected {1 old 3 two}}
      update {set sql {UPDATE "" SET v='new' WHERE a=1}; set expected {1 new 2 two}}
      scan {set sql {UPDATE "" SET v=v||'new'}; set expected {1 oldnew 2 twonew}}
      key {set sql {UPDATE "" SET a=3 WHERE a=2}; set expected {1 old 3 two}}
      replace {set sql {REPLACE INTO "" VALUES(1,'new')}; set expected {1 new 2 two}}
      delete {set sql {DELETE FROM "" WHERE a=2}; set expected {1 old}}
      rollback {set sql {SAVEPOINT s; UPDATE "" SET v='new'; ROLLBACK TO s; RELEASE s}; set expected {1 old 2 two}}
    }
    if {$branch eq "composite" && $op eq "replace"} {set expected {1 new 1 old 2 two}}
    do_execsql_test $prefix.mutate $sql
    do_execsql_test $prefix.after {SELECT * FROM "" ORDER BY a,v} $expected
    if {$op eq "delete-txn"} {
      do_execsql_test $prefix.deleted-lookup {SELECT * FROM "" WHERE a=2} {}
      do_execsql_test $prefix.commit {COMMIT}
    }
    do_execsql_test $prefix.integrity {PRAGMA integrity_check} ok
    db close
    sqlite3 db test.db/$branch
    do_execsql_test $prefix.reopen {SELECT * FROM "" ORDER BY a,v} $expected
  }
}
foreach op {update replace} {
  set ::empty_op $op
  do_faultsim_test empty-legacy-fault-$op -faults {oom-* ioerr-*} -prep {
    catch {db close}
    forcecopy [file join $::testdir empty_name_v12_fixture.db] test.db
    sqlite3 db test.db/integer
  } -body {
    if {$::empty_op eq "update"} {db eval {UPDATE "" SET v='new' WHERE a=1}} \
    else {db eval {REPLACE INTO "" VALUES(1,'new')}}
  } -test {
    faultsim_test_result {0 {}}
    set rows [db eval {SELECT * FROM "" ORDER BY a}]
    if {$rows ni {{1 old 2 two} {1 new 2 two}}} {error "non-atomic mutation: $rows"}
    db eval {UPDATE "" SET v='retry' WHERE a=1}
    if {[db eval {SELECT * FROM "" ORDER BY a}] ne {1 retry 2 two}} {error "bad retry"}
    if {[db one {PRAGMA integrity_check}] ne "ok"} {error "bad integrity"}
  }
}
finish_test
