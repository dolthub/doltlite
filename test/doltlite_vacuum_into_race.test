set testdir [file dirname $argv0]
source $testdir/tester.tcl

# VACUUM INTO checked the destination for emptiness and then streamed output
# through the same handle. A peer could commit a whole database at that path
# in between, and the output overwrote it while VACUUM INTO reported success.
# The destination is now reserved for the duration, so one side is refused
# and neither loses committed data.

proc vacuum_race_setup {} {
  forcedelete vir_source.db vir_target.db
  forcedelete .vir_source.db-lock .vir_target.db-lock
  sqlite3 src vir_source.db
  src eval {
    CREATE TABLE source_rows(id INT PRIMARY KEY);
    INSERT INTO source_rows VALUES(1);
    SELECT dolt_commit('-Am','source');
  }
  src close
}

# The peer runs on its own connection from inside the first write to the
# destination, which is the exact window the old code left open.
proc vacuum_race_peer {method path id offset amount} {
  if {!$::vir_fired && [file tail $path] eq "vir_target.db" && $offset==0} {
    set ::vir_fired 1
    set ::vir_peer_rc [catch {
      sqlite3 peer vir_target.db
      peer eval {
        CREATE TABLE peer_rows(id INT PRIMARY KEY, value TEXT);
        INSERT INTO peer_rows VALUES(42,'preserve me');
        SELECT dolt_commit('-Am','peer');
      }
    } ::vir_peer_msg]
    catch {peer close}
  }
  return SQLITE_OK
}

vacuum_race_setup
set ::vir_fired 0
set ::vir_peer_rc 0
set ::vir_peer_msg ""

testvfs racevfs
racevfs filter {xWrite}
racevfs script vacuum_race_peer
sqlite3 db vir_source.db -vfs racevfs
set ::vir_vac_rc [catch {db eval {VACUUM INTO 'vir_target.db'}} ::vir_vac_msg]
db close
racevfs delete

do_test doltlite_vacuum_into_race-1.0 {
  set ::vir_fired
} {1}

# Exactly one side may win. The peer is refused while the destination is
# reserved; if it ever did commit, its rows must still be there.
do_test doltlite_vacuum_into_race-1.1 {
  expr {$::vir_vac_rc==0 || $::vir_peer_rc==0}
} {1}

sqlite3 chk vir_target.db
# Whichever side won, the destination holds that side's committed data whole.
do_test doltlite_vacuum_into_race-1.2 {
  if {$::vir_peer_rc==0} {
    # The peer committed: its row must have survived the vacuum output.
    list peer [chk eval {SELECT value FROM peer_rows WHERE id=42}]
  } else {
    # The peer was refused: the vacuum must have succeeded and landed.
    list vacuum $::vir_vac_rc [chk eval {SELECT count(*) FROM source_rows}]
  }
} [expr {$::vir_peer_rc==0 ? {peer {preserve me}} : {vacuum 0 1}}]

do_test doltlite_vacuum_into_race-1.3 {
  chk eval {PRAGMA integrity_check}
} {ok}
chk close

if {$tcl_platform(platform) eq "unix"} {
  vacuum_race_setup
  set ::vir_fired 0
  set ::vir_peer_rc 0
  proc vacuum_race_unlinked_peer {method path id offset amount} {
    if {!$::vir_fired && [file tail $path] eq "vir_target.db" && $offset==0} {
      forcedelete .vir_target.db-lock
    }
    return [vacuum_race_peer $method $path $id $offset $amount]
  }
  testvfs racevfs
  racevfs filter {xWrite}
  racevfs script vacuum_race_unlinked_peer
  sqlite3 db vir_source.db -vfs racevfs
  do_test doltlite_vacuum_into_race-3.0 {
    list [catch {db eval {VACUUM INTO 'vir_target.db'}}] $::vir_fired $::vir_peer_rc
  } {0 1 1}
  db close
  racevfs delete
  sqlite3 chk vir_target.db
  do_test doltlite_vacuum_into_race-3.1 {
    list [chk eval {SELECT count(*) FROM source_rows}] [chk eval {PRAGMA integrity_check}]
  } {1 ok}
  chk close
}

# The source is never touched by any of this.
sqlite3 s2 vir_source.db
do_test doltlite_vacuum_into_race-1.4 {
  s2 eval {SELECT count(*) FROM source_rows}
} {1}
s2 close

# Controls: an uncontended empty destination still works, and a destination
# that already holds a database is still refused with its bytes intact.
forcedelete vir_plain.db .vir_plain.db-lock
sqlite3 db vir_source.db
do_test doltlite_vacuum_into_race-2.0 {
  db eval {VACUUM INTO 'vir_plain.db'}
  set {} {}
} {}
db close
sqlite3 p1 vir_plain.db
do_test doltlite_vacuum_into_race-2.1 {
  p1 eval {SELECT count(*) FROM source_rows}
} {1}
p1 close

forcedelete vir_busy.db .vir_busy.db-lock
sqlite3 ex vir_busy.db
ex eval {
  CREATE TABLE keep(a INT);
  INSERT INTO keep VALUES(7);
  SELECT dolt_commit('-Am','keep');
}
ex close
sqlite3 db vir_source.db
do_test doltlite_vacuum_into_race-2.2 {
  list [catch {db eval {VACUUM INTO 'vir_busy.db'}} msg] $msg
} {1 {output file already exists}}
db close
sqlite3 ex2 vir_busy.db
do_test doltlite_vacuum_into_race-2.3 {
  ex2 eval {SELECT a FROM keep}
} {7}
ex2 close

# VACUUM INTO targeting the same database file (relative or absolute path)
# must fail immediately with "output file already exists" instead of
# self-deadlocking on the lock sidecar for the duration of busy_timeout.
sqlite3 db vir_source.db
db eval {PRAGMA busy_timeout = 5000}
do_test doltlite_vacuum_into_race-2.4 {
  set us [lindex [time {
    set rc [catch {db eval {VACUUM INTO 'vir_source.db'}} msg]
  }] 0]
  list $rc [db errorcode] $msg [expr {$us < 2000000}]
} {1 1 {output file already exists} 1}

do_test doltlite_vacuum_into_race-2.5 {
  set absPath [file normalize vir_source.db]
  set us [lindex [time {
    set rc [catch {db eval {VACUUM INTO $absPath}} msg]
  }] 0]
  list $rc [db errorcode] $msg [expr {$us < 2000000}]
} {1 1 {output file already exists} 1}

do_test doltlite_vacuum_into_race-2.6 {
  list [db eval {SELECT count(*) FROM source_rows}] [db eval {PRAGMA integrity_check}]
} {1 ok}
db close

# Reset-database VACUUM must roll back its write transaction and release the
# exclusive graph lock when commit fails with SQLITE_BUSY.
forcedelete vir_reset.db .vir_reset.db-lock
testvfs resetbusyvfs
resetbusyvfs filter xLock
set ::vir_reset_busy 0
proc vir_reset_busy_lock {method file level} {
  if {$::vir_reset_busy && [string match *vir_reset.db $file] && $level==4} {
    return SQLITE_BUSY
  }
  return SQLITE_OK
}
resetbusyvfs script vir_reset_busy_lock
sqlite3 db vir_reset.db -vfs resetbusyvfs
db eval {
  CREATE TABLE t1(id INT PRIMARY KEY, v TEXT);
  INSERT INTO t1 VALUES(1, 'keep');
  SELECT dolt_commit('-Am', 'init');
}
sqlite3 peer vir_reset.db

set ::vir_reset_busy 1
do_test doltlite_vacuum_into_race-4.0 {
  sqlite3_db_config db RESET_DB 1
  set rc [catch {db eval {VACUUM}} msg]
  sqlite3_db_config db RESET_DB 0
  list $rc [db errorcode] $msg
} {1 5 {database is locked}}
set ::vir_reset_busy 0

do_test doltlite_vacuum_into_race-4.1 {
  list [db eval {SELECT id, v FROM t1}] [peer eval {SELECT id, v FROM t1}]
} {{1 keep} {1 keep}}

do_test doltlite_vacuum_into_race-4.2 {
  peer eval {INSERT INTO t1 VALUES(2, 'from_peer')}
  peer eval {SELECT id, v FROM t1 ORDER BY id}
} {1 keep 2 from_peer}

do_test doltlite_vacuum_into_race-4.3 {
  db eval {INSERT INTO t1 VALUES(3, 'from_db')}
  db eval {SELECT id, v FROM t1 ORDER BY id}
} {1 keep 2 from_peer 3 from_db}

do_test doltlite_vacuum_into_race-4.4 {
  sqlite3_db_config db RESET_DB 1
  db eval {VACUUM}
  sqlite3_db_config db RESET_DB 0
  list [db eval {SELECT count(*) FROM sqlite_master}] \
       [peer eval {SELECT count(*) FROM sqlite_master}]
} {0 0}

peer close
db close
resetbusyvfs delete
forcedelete vir_reset.db .vir_reset.db-lock

forcedelete vir_source.db vir_target.db vir_plain.db vir_busy.db
forcedelete .vir_source.db-lock .vir_target.db-lock
forcedelete .vir_plain.db-lock .vir_busy.db-lock

finish_test
