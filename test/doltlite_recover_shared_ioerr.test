set testdir [file dirname $argv0]
source $testdir/tester.tcl
source $testdir/malloc_common.tcl

set testprefix doltlite_recover_shared_ioerr

ifcapable !shared_cache||!subquery {
  finish_test
  return
}


set ::drs_shared_cache [sqlite3_enable_shared_cache 1]

proc drs_setup {} {
  catch {db close}
  catch {db2 close}
  forcedelete test.db test.db-journal test.db-wal test.db-shm
  sqlite3 db test.db
  sqlite3 db2 test.db
  execsql {
    PRAGMA read_uncommitted = 1;
    BEGIN;
    CREATE TABLE t1(a, b);
    INSERT INTO t1(oid) VALUES(NULL);
    INSERT INTO t1(oid) SELECT NULL FROM t1;
    INSERT INTO t1(oid) SELECT NULL FROM t1;
    INSERT INTO t1(oid) SELECT NULL FROM t1;
    INSERT INTO t1(oid) SELECT NULL FROM t1;
    INSERT INTO t1(oid) SELECT NULL FROM t1;
    INSERT INTO t1(oid) SELECT NULL FROM t1;
    INSERT INTO t1(oid) SELECT NULL FROM t1;
    INSERT INTO t1(oid) SELECT NULL FROM t1;
    INSERT INTO t1(oid) SELECT NULL FROM t1;
    INSERT INTO t1(oid) SELECT NULL FROM t1;
    UPDATE t1 SET a = oid, b = 'abcdefghijklmnopqrstuvwxyz0123456789';
    CREATE INDEX i1 ON t1(a);
    COMMIT;
    BEGIN;
    SELECT * FROM sqlite_master;
  } db2
}

proc drs_body {} {
  set ::drs_residx 0
  execsql {DELETE FROM t1 WHERE 0 = (a % 2);}
  incr ::drs_residx

  execsql {BEGIN;}
  execsql {INSERT INTO t1 SELECT a+1, b FROM t1;}
  execsql {INSERT INTO t1 SELECT 'string' || a, b FROM t1 WHERE 0 = (a%7);}
  execsql {COMMIT;}
  incr ::drs_residx
}

proc drs_run {iFail} {
  drs_setup
  set ::sqlite_io_error_persist 1
  set ::sqlite_io_error_pending $iFail
  set rc [catch {drs_body} msg]
  set hit $::sqlite_io_error_hit
  set ::sqlite_io_error_persist 0
  set ::sqlite_io_error_pending 0
  set ::sqlite_io_error_hit 0
  set ::sqlite_io_error_hardhit 0

  catchsql ROLLBACK
  set peer [catchsql {
    SELECT max(a), min(a), count(*) FROM (SELECT a FROM t1 ORDER BY a);
  } db2]
  set writer [catchsql {
    SELECT max(a), min(a), count(*) FROM (SELECT a FROM t1 ORDER BY a);
  } db]
  set ic [catchsql {PRAGMA integrity_check} db]
  db2 close
  db close
  list $rc $msg $::drs_residx [expr {$hit>0}] $peer $writer $ic
}

# Sweep every IO-op offset until the body runs fault-free, instead of
# pinning two offsets: the count of IO ops per statement shifts whenever
# the refresh or commit path changes shape, and a stale offset silently
# stops hitting. Every hit must leave the writer at a statement boundary,
# the read-uncommitted peer undisturbed, and the store intact.
set iFail 1
set nHit 0
set nPhase2 0
while {$iFail < 2000} {
  set res [drs_run $iFail]
  foreach {rc msg residx hit peer writer ic} $res break
  if {!$hit} break
  incr nHit
  if {$residx==1} { incr nPhase2 }
  do_test 1.sweep.$iFail {
    set r {}
    if {$peer ne {0 {1024 1 1024}}} { lappend r "peer view disturbed: $peer" }
    if {$ic ne {0 ok}} { lappend r "integrity: $ic" }
    if {$rc} {
      if {$msg ne "disk I/O error"} { lappend r "unexpected error: $msg" }
      # An error during COMMIT after the durable point reports failure
      # while the change persists, so the boundary ahead is also legal.
      if {$residx==0 && $writer ne {0 {1024 1 1024}}
          && $writer ne {0 {1023 1 512}}} {
        lappend r "delete left mid-statement state: $writer"
      }
      if {$residx==1 && $writer ne {0 {1023 1 512}}
          && $writer ne {0 {string994 1 1170}}} {
        lappend r "txn left mid-statement state: $writer"
      }
    } else {
      if {$residx!=2 || $writer ne {0 {string994 1 1170}}} {
        lappend r "hit without failure left: $residx $writer"
      }
    }
    set r
  } {}
  incr iFail
}
do_test 1.sweep.coverage {
  list [expr {$nHit>=20}] [expr {$nPhase2>=1}]
} {1 1}

sqlite3_enable_shared_cache $::drs_shared_cache
unset -nocomplain ::drs_shared_cache ::drs_residx
finish_test
