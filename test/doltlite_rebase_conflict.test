set testdir [file dirname $argv0]
source $testdir/tester.tcl

set child [open rebase-conflict-check.tcl w]
puts $child {
  sqlite3 db test.db
  puts [db eval {
    PRAGMA integrity_check;
    SELECT * FROM t;
    SELECT count(*) FROM dolt_conflicts;
    SELECT count(*) FROM dolt_status;
  }]
  db close
}
close $child

foreach operation {merge cherry_pick revert} {
  foreach {mode rebase} {
    linear {SELECT dolt_rebase('f')}
    interactive {SELECT dolt_rebase('-i','f')}
  } {
    foreach finish {rollback resolve} {
      reset_db
      execsql {
        CREATE TABLE t(id INT PRIMARY KEY,v INT);
        INSERT INTO t VALUES(1,1);
        SELECT dolt_commit('-Am','base');
        SELECT dolt_branch('f');
        SELECT dolt_checkout('-b','g');
        UPDATE t SET v=7;
        SELECT dolt_commit('-am','other');
        SELECT dolt_checkout('main');
        UPDATE t SET v=5;
        SELECT dolt_commit('-am','main');
        BEGIN;
      }
      set prefix rebase-conflict-$operation-$mode-$finish
      do_test $prefix-conflict {
        set result [catchsql "SELECT dolt_${operation}('g')"]
        list [lindex $result 0] [db one {SELECT count(*) FROM dolt_conflicts}]
      } {1 1}
      set head [execsql {SELECT dolt_hashof('HEAD')}]
      set staged [execsql {SELECT dolt_hashof_db('STAGED')}]
      set conflicts [execsql {SELECT * FROM dolt_conflicts_t}]
      set branches [execsql {SELECT name,hash FROM dolt_branches ORDER BY name}]
      do_test $prefix-refused {
        set result [catchsql $rebase]
        list [lindex $result 0] \
             [string match {*unable to start rebase while a merge is in progress*} \
                           [lindex $result 1]] \
             [string match {*rebase working branch already exists*} \
                           [lindex $result 1]]
      } {1 1 0}
      do_test $prefix-preserved {
        list [sqlite3_get_autocommit db] \
             [db one {SELECT active_branch()}] \
             [expr {$head eq [execsql {SELECT dolt_hashof('HEAD')}]}] \
             [expr {$staged eq [execsql {SELECT dolt_hashof_db('STAGED')}]}] \
             [expr {$conflicts eq [execsql {SELECT * FROM dolt_conflicts_t}]}] \
             [expr {$branches eq [execsql {
               SELECT name,hash FROM dolt_branches ORDER BY name
             }]}]
      } {0 main 1 1 1 1}
      if {$finish eq "resolve"} {
        execsql {SELECT dolt_conflicts_resolve('--ours','t'); COMMIT}
      } else {
        execsql {ROLLBACK}
      }
      do_execsql_test $prefix-intact {
        PRAGMA integrity_check;
        SELECT * FROM t;
        SELECT count(*) FROM dolt_conflicts;
        SELECT count(*) FROM dolt_status;
      } {ok 1 5 0 0}
      db close
      do_test $prefix-process {
        exec [info nameofexecutable] rebase-conflict-check.tcl
      } {ok 1 5 0 0}
      sqlite3 db test.db
      do_execsql_test $prefix-reopen {
        PRAGMA integrity_check;
        SELECT * FROM t;
        SELECT count(*) FROM dolt_conflicts;
        SELECT count(*) FROM dolt_status;
      } {ok 1 5 0 0}
      do_test $prefix-later-write {
        execsql {
          INSERT INTO t VALUES(2,2);
          SELECT dolt_commit('-am','after rebase refusal');
          SELECT dolt_gc();
        }
        execsql {PRAGMA integrity_check; SELECT * FROM t ORDER BY id}
      } {ok 1 5 2 2}
    }
  }
}

forcedelete rebase-conflict-check.tcl

# Verify conflict-paused rebase of a non-default branch onto main does not
# leave mirrored rebase flags on main after --continue or --abort.
foreach end_mode {continue abort_immediate abort_after_step} {
  reset_db
  execsql {
    CREATE TABLE t(id INT PRIMARY KEY, v INT);
    INSERT INTO t VALUES(1, 1), (2, 10);
    SELECT dolt_commit('-Am', 'base');
    SELECT dolt_branch('extra');
    SELECT dolt_checkout('extra');
    INSERT INTO t VALUES(3, 30);
    SELECT dolt_commit('-am', 'extra commit');
    SELECT dolt_checkout('main');
    SELECT dolt_checkout('-b', 'feat');
    UPDATE t SET v = 2 WHERE id = 1;
    SELECT dolt_commit('-am', 'feat 1');
    UPDATE t SET v = 20 WHERE id = 2;
    SELECT dolt_commit('-am', 'feat 2');
    SELECT dolt_checkout('main');
    UPDATE t SET v = 9 WHERE id = 1;
    UPDATE t SET v = 90 WHERE id = 2;
    SELECT dolt_commit('-am', 'main diverge');
    SELECT dolt_checkout('feat');
    BEGIN;
  }

  set prefix rebase-paused-return-$end_mode
  do_test $prefix-pause {
    set res [catchsql {SELECT dolt_rebase('main')}]
    list [lindex $res 0] [db one {SELECT count(*) FROM dolt_conflicts}]
  } {1 1}

  if {$end_mode eq "continue"} {
    do_test $prefix-resolve-1 {
      execsql {
        SELECT dolt_conflicts_resolve('--theirs', 't');
        SELECT dolt_add('.');
      }
      set res [catchsql {SELECT dolt_rebase('--continue')}]
      list [lindex $res 0] [db one {SELECT count(*) FROM dolt_conflicts}]
    } {1 1}
    do_test $prefix-resolve-2 {
      execsql {
        SELECT dolt_conflicts_resolve('--theirs', 't');
        SELECT dolt_add('.');
      }
      set res [catchsql {SELECT dolt_rebase('--continue')}]
      list [lindex $res 0] [string match {*Successfully rebased*} [lindex $res 1]]
    } {0 1}
    execsql {COMMIT}
  } elseif {$end_mode eq "abort_immediate"} {
    do_test $prefix-abort {
      set res [catchsql {SELECT dolt_rebase('--abort')}]
      list [lindex $res 0] [string match {*aborted*} [lindex $res 1]]
    } {0 1}
    execsql {COMMIT}
  } else {
    do_test $prefix-resolve-1 {
      execsql {
        SELECT dolt_conflicts_resolve('--theirs', 't');
        SELECT dolt_add('.');
      }
      set res [catchsql {SELECT dolt_rebase('--continue')}]
      list [lindex $res 0] [db one {SELECT count(*) FROM dolt_conflicts}]
    } {1 1}
    do_test $prefix-abort-after-step {
      set res [catchsql {SELECT dolt_rebase('--abort')}]
      list [lindex $res 0] [string match {*aborted*} [lindex $res 1]]
    } {0 1}
    execsql {COMMIT}
  }

  # Switch to main and verify no phantom rebase state remains.
  do_test $prefix-switch-main {
    execsql {SELECT dolt_checkout('main')}
    list [db one {SELECT active_branch()}] \
         [db one {SELECT count(*) FROM dolt_branches WHERE name = 'dolt_rebase_feat'}] \
         [lindex [catchsql {SELECT dolt_commit('--amend', '-m', 'main amend 1')}] 0]
  } {main 0 0}

  # Reopen DB (lands on default branch main) and verify all branch-mutating ops work.
  db close
  sqlite3 db test.db
  do_test $prefix-reopen-main-ops {
    set b [db one {SELECT active_branch()}]
    set amend_rc [lindex [catchsql {SELECT dolt_commit('--amend', '-m', 'main amend 2')}] 0]
    set cp_rc [lindex [catchsql {SELECT dolt_cherry_pick('extra')}] 0]
    set head_before_rev [db one {SELECT dolt_hashof('HEAD')}]
    set rev_rc [lindex [catchsql "SELECT dolt_revert('$head_before_rev')"] 0]
    set reb_rc [lindex [catchsql {SELECT dolt_rebase('extra')}] 0]
    list $b $amend_rc $cp_rc $rev_rc $reb_rc [db one {PRAGMA integrity_check}]
  } {main 0 0 0 0 ok}
}

# Verify dolt_rebase (linear and interactive) is rejected when a cherry-pick
# or revert has had its conflicts resolved via --ours but has not yet been
# continued or aborted, and that the pending replay can still finish cleanly.
foreach {operation expected_err} {
  cherry_pick {*unable to start rebase while a cherry-pick is in progress*}
  revert      {*unable to start rebase while a revert is in progress*}
} {
  foreach {mode rebase} {
    linear      {SELECT dolt_rebase('f')}
    interactive {SELECT dolt_rebase('-i','f')}
  } {
    foreach finish {continue abort} {
      reset_db
      execsql {
        CREATE TABLE t(id INT PRIMARY KEY, v INT);
        INSERT INTO t VALUES(1, 1), (2, 10);
        SELECT dolt_commit('-Am', 'base');
        SELECT dolt_branch('f');
        SELECT dolt_checkout('-b', 'g');
        UPDATE t SET v = 7 WHERE id = 1;
        UPDATE t SET v = 70 WHERE id = 2;
        SELECT dolt_commit('-am', 'other');
        SELECT dolt_checkout('main');
        UPDATE t SET v = 5 WHERE id = 1;
        SELECT dolt_commit('-am', 'main');
        BEGIN;
      }
      set prefix rebase-pending-replay-$operation-$mode-$finish
      do_test $prefix-conflict {
        set res [catchsql "SELECT dolt_${operation}('g')"]
        list [lindex $res 0] [db one {SELECT count(*) FROM dolt_conflicts}]
      } {1 1}
      do_test $prefix-resolve-ours {
        execsql {SELECT dolt_conflicts_resolve('--ours', 't')}
        db one {SELECT count(*) FROM dolt_conflicts}
      } {0}
      set head [execsql {SELECT dolt_hashof('HEAD')}]
      set staged [execsql {SELECT dolt_hashof_db('STAGED')}]
      set rows [execsql {SELECT * FROM t ORDER BY id}]
      set branches [execsql {SELECT name, hash FROM dolt_branches ORDER BY name}]
      do_test $prefix-refused {
        set res [catchsql $rebase]
        list [lindex $res 0] \
             [string match $expected_err [lindex $res 1]] \
             [db one {SELECT count(*) FROM dolt_branches WHERE name LIKE 'dolt_rebase_%'}]
      } {1 1 0}
      do_test $prefix-preserved {
        list [sqlite3_get_autocommit db] \
             [db one {SELECT active_branch()}] \
             [expr {$head eq [execsql {SELECT dolt_hashof('HEAD')}]}] \
             [expr {$staged eq [execsql {SELECT dolt_hashof_db('STAGED')}]}] \
             [expr {$rows eq [execsql {SELECT * FROM t ORDER BY id}]}] \
             [expr {$branches eq [execsql {
               SELECT name, hash FROM dolt_branches ORDER BY name
             }]}]
      } {0 main 1 1 1 1}
      do_test $prefix-finish {
        if {$finish eq "continue"} {
          execsql {SELECT dolt_add('.')}
        }
        set res [catchsql "SELECT dolt_${operation}('--${finish}')"]
        execsql {COMMIT}
        list [lindex $res 0] \
             [db one {PRAGMA integrity_check}] \
             [db one {SELECT count(*) FROM dolt_conflicts}] \
             [db one {SELECT count(*) FROM dolt_status}]
      } {0 ok 0 0}
    }
  }
}

# Verify continuing after a conflict on an 'edit' step still enters the edit
# pause (both when more steps follow and when it is the final step).
foreach has_tail {1 0} {
  foreach edit_mode {amend staged} {
    reset_db
    execsql {
      CREATE TABLE t(id INT PRIMARY KEY, v INT);
      INSERT INTO t VALUES(1, 1);
      SELECT dolt_commit('-Am', 'base');
      SELECT dolt_checkout('-b', 'feat');
      UPDATE t SET v = 2 WHERE id = 1;
      SELECT dolt_commit('-am', 'feat 1');
    }
    if {$has_tail} {
      execsql {
        INSERT INTO t VALUES(2, 20);
        SELECT dolt_commit('-am', 'feat 2');
      }
    }
    execsql {
      SELECT dolt_checkout('main');
      UPDATE t SET v = 9 WHERE id = 1;
      SELECT dolt_commit('-am', 'main diverge');
      SELECT dolt_checkout('feat');
      BEGIN;
      SELECT dolt_rebase('-i', 'main');
      UPDATE dolt_rebase SET action = 'edit' WHERE commit_message = 'feat 1';
    }
    set prefix rebase-edit-conflict-tail${has_tail}-${edit_mode}
    do_test $prefix-conflict {
      set res [catchsql {SELECT dolt_rebase('--continue')}]
      list [lindex $res 0] [db one {SELECT count(*) FROM dolt_conflicts}]
    } {1 1}
    do_test $prefix-resolve-enters-edit-pause {
      execsql {
        SELECT dolt_conflicts_resolve('--theirs', 't');
        SELECT dolt_add('.');
      }
      set res [catchsql {SELECT dolt_rebase('--continue')}]
      list [lindex $res 0] \
           [string match {*edit action paused*} [lindex $res 1]] \
           [db one {SELECT count(*) FROM dolt_rebase}] \
           [db one {SELECT active_branch()}]
    } [list 0 1 $has_tail dolt_rebase_feat]
    if {$edit_mode eq "amend"} {
      execsql {
        INSERT INTO t VALUES(3, 30);
        SELECT dolt_commit('--amend', '-am', 'feat 1 amended');
      }
    } else {
      execsql {
        INSERT INTO t VALUES(3, 30);
        SELECT dolt_add('.');
      }
    }
    do_test $prefix-finish {
      set res [catchsql {SELECT dolt_rebase('--continue')}]
      execsql {COMMIT}
      list [lindex $res 0] [string match {*Successfully rebased*} [lindex $res 1]]
    } {0 1}
    set expected_rows [expr {$has_tail ? {1 2 2 20 3 30} : {1 2 3 30}}]
    do_execsql_test $prefix-rows {
      SELECT id, v FROM t ORDER BY id;
    } $expected_rows
    if {$edit_mode eq "amend"} {
      set expected_log [expr {$has_tail
        ? {{feat 2} {feat 1 amended} {main diverge}}
        : {{feat 1 amended} {main diverge}}}]
    } else {
      set expected_log [expr {$has_tail
        ? {{feat 2} {feat 1} {feat 1} {main diverge}}
        : {{feat 1} {feat 1} {main diverge}}}]
    }
    set log_limit [llength $expected_log]
    do_execsql_test $prefix-log "
      SELECT message FROM dolt_log LIMIT $log_limit;
    " $expected_log
    do_execsql_test $prefix-clean {
      SELECT active_branch();
      SELECT count(*) FROM dolt_status;
      SELECT count(*) FROM dolt_branches WHERE name = 'dolt_rebase_feat';
      PRAGMA integrity_check;
    } {feat 0 0 ok}
  }
}

finish_test
