set testdir [file dirname $argv0]
source $testdir/tester.tcl

# Ours re-creates an index under its old name and changes no rows; theirs
# changes rows. The index kept from ours was built over ours' rows and no
# index patch reaches it, so the merge has to rebuild it.
foreach {layout key} {rowid {INTEGER PRIMARY KEY} clustered {INT PRIMARY KEY}} {
  foreach {oname ours} {
    plain  {DROP INDEX ia; CREATE INDEX ia ON t(d)}
    unique {DROP INDEX ia; CREATE UNIQUE INDEX ia ON t(d)}
  } {
    foreach {tname theirs indexes} {
      same  {} ia
      drop  {DROP INDEX ia} ia
      other {DROP INDEX ia; CREATE INDEX ib ON t(d)} {ia ib}
    } {
      foreach op {merge cherry_pick} {
        if {$tname eq "same"} {set theirs $ours}
        reset_db
        execsql "CREATE TABLE t(id $key, a INT, d INT)"
        execsql {
          CREATE INDEX ia ON t(a);
          INSERT INTO t VALUES(1,10,100),(2,20,200),(3,30,300);
          SELECT dolt_commit('-Am','base');
          SELECT dolt_branch('br');
        }
        execsql $ours
        execsql {
          SELECT dolt_commit('-Am','ours');
          SELECT dolt_checkout('br');
        }
        execsql $theirs
        execsql {
          INSERT INTO t VALUES(7,70,700);
          DELETE FROM t WHERE id=2;
          UPDATE t SET a=a+5, d=d+5 WHERE id=3;
          SELECT dolt_commit('-Am','theirs');
          SELECT dolt_checkout('main');
        }
        set prefix recreated-index-$layout-$oname-$tname-$op
        do_test $prefix.run {
          lindex [catchsql "SELECT dolt_${op}('br')"] 0
        } 0
        set query {
          SELECT group_concat(id) FROM (SELECT id FROM t NOT INDEXED ORDER BY d);
          SELECT group_concat(id) FROM (SELECT id FROM t INDEXED BY ia
                                        WHERE d>0 ORDER BY d);
          SELECT count(*) FROM t INDEXED BY ia WHERE d=700;
          SELECT group_concat(name, ' ') FROM (SELECT name FROM sqlite_schema
            WHERE type='index' AND name NOT LIKE 'sqlite_%' ORDER BY name);
          PRAGMA integrity_check;
        }
        set expected [list 1,3,7 1,3,7 1 $indexes ok]
        do_execsql_test $prefix.index $query $expected
        db close
        sqlite3 db test.db
        do_execsql_test $prefix.reopen $query $expected
      }
    }
  }
}

# Two same-typed columns trade places in the table text. A rebuild moved the
# values with the names; a pair of renames left them where they were. Only
# the rows tell the two apart when the other side left the table alone.
foreach {how ours indexsql} {
  rebuild {
    CREATE TABLE n(id INTEGER PRIMARY KEY, d INT, a INT);
    INSERT INTO n(id,d,a) SELECT id,d,a FROM t;
    DROP TABLE t;
    ALTER TABLE n RENAME TO t;
    CREATE INDEX ia ON t(a);
  } {CREATE INDEX ia ON t(a)}
  rename {
    ALTER TABLE t RENAME COLUMN a TO x;
    ALTER TABLE t RENAME COLUMN d TO a;
    ALTER TABLE t RENAME COLUMN x TO d;
  } {CREATE INDEX ia ON t(d)}
} {
  foreach op {merge cherry_pick} {
    reset_db
    execsql {
      CREATE TABLE t(id INTEGER PRIMARY KEY, a INT, d INT);
      CREATE INDEX ia ON t(a);
      INSERT INTO t VALUES(1,10,100),(2,20,200),(3,30,300);
      SELECT dolt_commit('-Am','base');
      SELECT dolt_branch('br');
    }
    execsql $ours
    set rows [execsql {SELECT id,a,d FROM t ORDER BY id}]
    execsql {
      SELECT dolt_commit('-Am','ours');
      SELECT dolt_checkout('br');
      CREATE TABLE other(x);
      SELECT dolt_commit('-Am','theirs');
      SELECT dolt_checkout('main');
    }
    set prefix traded-columns-$how-$op
    do_test $prefix.run {
      lindex [catchsql "SELECT dolt_${op}('br')"] 0
    } 0
    do_test $prefix.index {
      execsql {
        SELECT sql FROM sqlite_schema WHERE name='ia';
        SELECT id,a,d FROM t ORDER BY id;
        PRAGMA integrity_check;
      }
    } [list $indexsql {*}$rows ok]
    do_execsql_test $prefix.lookup {
      SELECT (SELECT count(*) FROM t WHERE a=100)
          == (SELECT count(*) FROM t NOT INDEXED WHERE a=100),
             (SELECT count(*) FROM t WHERE d=100)
          == (SELECT count(*) FROM t NOT INDEXED WHERE d=100);
    } {1 1}
  }
}

finish_test
