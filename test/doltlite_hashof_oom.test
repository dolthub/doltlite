set testdir [file dirname $argv0]
source $testdir/tester.tcl
source $testdir/malloc_common.tcl

set testprefix doltlite_hashof_oom

do_execsql_test 1.0 {
  CREATE TABLE t1(id INTEGER PRIMARY KEY, a INT, b TEXT, c INT);
  CREATE INDEX idx_a ON t1(a);
  CREATE INDEX idx_b ON t1(b);
  CREATE UNIQUE INDEX idx_bc ON t1(b, c) WHERE c IS NOT NULL;
  INSERT INTO t1 VALUES(1, 10, 'alpha', 100);
  INSERT INTO t1 VALUES(2, 20, 'beta', 200);
  INSERT INTO t1 VALUES(3, 30, 'gamma', NULL);
  SELECT length(dolt_commit('-Am', 'seed'));
} {40}

set expected_table_hash [db one {SELECT dolt_hashof_table('t1')}]
set expected_table_head [db one {SELECT dolt_hashof_table('t1', 'HEAD')}]
set expected_index_hash [db one {SELECT dolt_hashof_index('idx_bc')}]
set expected_ref_hash   [db one {SELECT dolt_hashof('HEAD')}]
set expected_db_hash    [db one {SELECT dolt_hashof_db()}]
set expected_db_head    [db one {SELECT dolt_hashof_db('HEAD')}]

faultsim_save_and_close

do_faultsim_test 1.1 -faults oom-transient -prep {
  faultsim_restore_and_reopen
} -body {
  db one {SELECT dolt_hashof_table('t1')}
} -test {
  faultsim_test_result [list 0 $::expected_table_hash] \
      {1 {out of memory}} {1 {disk I/O error}}
}

do_faultsim_test 1.2 -faults oom-transient -prep {
  faultsim_restore_and_reopen
} -body {
  db one {SELECT dolt_hashof_table('t1', 'HEAD')}
} -test {
  faultsim_test_result [list 0 $::expected_table_head] \
      {1 {out of memory}} {1 {disk I/O error}} \
      {1 {dolt_hashof_table: commit load failed}}
}

do_faultsim_test 1.3 -faults oom-transient -prep {
  faultsim_restore_and_reopen
} -body {
  db one {SELECT dolt_hashof_index('idx_bc')}
} -test {
  faultsim_test_result [list 0 $::expected_index_hash] \
      {1 {out of memory}} {1 {disk I/O error}}
}

do_faultsim_test 1.4 -faults oom-transient -prep {
  faultsim_restore_and_reopen
} -body {
  db one {SELECT dolt_hashof('HEAD')}
} -test {
  faultsim_test_result [list 0 $::expected_ref_hash] \
      {1 {out of memory}} {1 {disk I/O error}}
}

do_faultsim_test 1.5 -faults oom-transient -prep {
  faultsim_restore_and_reopen
} -body {
  db one {SELECT dolt_hashof_db()}
} -test {
  faultsim_test_result [list 0 $::expected_db_hash] \
      {1 {out of memory}} {1 {disk I/O error}} \
      {1 {dolt_hashof_db: catalog flush failed}} \
      {1 {dolt_hashof_db: catalog hash failed}}
}

do_faultsim_test 1.6 -faults oom-transient -prep {
  faultsim_restore_and_reopen
} -body {
  db one {SELECT dolt_hashof_db('HEAD')}
} -test {
  faultsim_test_result [list 0 $::expected_db_head] \
      {1 {out of memory}} {1 {disk I/O error}} \
      {1 {dolt_hashof_db: catalog hash failed}} \
      {1 {dolt_hashof_db: commit load failed}}
}

catch {db close}
forcedelete test_hashof_peer.db
sqlite3 db1 test_hashof_peer.db
sqlite3 db2 test_hashof_peer.db

db1 eval {
  CREATE TABLE t(id INTEGER PRIMARY KEY, v INT);
  CREATE INDEX idx ON t(v);
  INSERT INTO t VALUES(1, 10);
  SELECT dolt_commit('-Am', 'seed');
}

set peer_step 1
foreach {label implicit explicit} {
  db      {dolt_hashof_db()}           {dolt_hashof_db('WORKING')}
  catalog {dolt_hashof_catalog()}      {dolt_hashof_catalog('WORKING')}
  table   {dolt_hashof_table('t')}     {dolt_hashof_table('t', 'WORKING')}
  index   {dolt_hashof_index('idx')}   {dolt_hashof_index('idx', 'WORKING')}
} {
  incr peer_step
  set before [db1 one "SELECT $implicit"]
  db2 eval "
    INSERT INTO t VALUES($peer_step, [expr {$peer_step * 10}]);
    SELECT dolt_commit('-Am', 'peer $label');
  "
  set after [db1 one "SELECT $implicit"]
  set after_working [db1 one "SELECT $explicit"]
  set peer_hash [db2 one "SELECT $implicit"]
  do_test 2.$label-changed [list expr {$after ne $before}] 1
  do_test 2.$label-matches-working [list expr {$after eq $after_working}] 1
  do_test 2.$label-matches-peer [list expr {$after eq $peer_hash}] 1
}

db1 close
db2 close
forcedelete test_hashof_peer.db

finish_test
