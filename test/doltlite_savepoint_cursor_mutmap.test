} {2:d:insD 2:c:origC 2:b:updB 4:d:insD 4:c:origC 4:b:updB}

do_execsql_test doltlite_savepoint_cursor_mutmap-1.5 {
  PRAGMA integrity_check;
} {ok}

finish_test
