  execsql {
    BEGIN;
    INSERT INTO t_wr VALUES('d', 'insD');
    UPDATE t_wr SET v = 'updB' WHERE id = 'b';
    DELETE FROM t_wr WHERE id = 'a';
  }

  set wr_desc {}
  db eval {
    SELECT driver.k, t_wr.id, t_wr.v
      FROM driver LEFT JOIN t_wr ON driver.k IN (2, 4)
     ORDER BY driver.k, t_wr.id DESC
  } {
    if {$k == 2 || $k == 4} {
