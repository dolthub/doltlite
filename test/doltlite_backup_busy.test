set testdir [file dirname $argv0]
source $testdir/tester.tcl

foreach location {source destination own} {
  foreach dest {file memory attached} {
    if {$location eq "destination" && $dest eq "memory"} continue
    foreach action {finish retry} {
      set prefix backup-busy-$location.$dest.$action
      reset_db
      forcedelete backup-source.db backup-dest.db
      sqlite3 src backup-source.db
      src eval {
        CREATE TABLE t(id INTEGER PRIMARY KEY,v BLOB);
        CREATE INDEX tv ON t(v);
        INSERT INTO t VALUES(1,'a'),(2,'b'),(3,'c');
        SELECT dolt_commit('-Am','base');
      }
      set schema main
      if {$dest eq "memory"} {
        db close
        sqlite3 db :memory:
      } elseif {$dest eq "attached"} {
        db eval {
          CREATE TABLE sentinel(id INTEGER PRIMARY KEY);
          INSERT INTO sentinel VALUES(77);
          ATTACH 'backup-dest.db' AS aux;
        }
        set schema aux
      }
      db eval "CREATE TABLE $schema.t(id INTEGER PRIMARY KEY,v BLOB)"
      db eval "INSERT INTO $schema.t VALUES(9,'dest')"
      set writer src
      if {$location ne "own"} {
        set writer peer
        if {$location eq "source"} {
          sqlite3 peer backup-source.db
        } elseif {$dest eq "attached"} {
          sqlite3 peer backup-dest.db
        } else {
          sqlite3 peer test.db
        }
      }
      $writer eval {BEGIN IMMEDIATE; INSERT INTO t VALUES(10,zeroblob(2000000))}
      sqlite3_backup B db $schema src main
      if {$location eq "source"} {
        do_test $prefix.step {B step -1} SQLITE_DONE
        do_test $prefix.finish {list [B finish] [sqlite3_errcode db]} \
          {SQLITE_OK SQLITE_OK}
        do_test $prefix.committed-only {
          db eval "SELECT id,v FROM $schema.t INDEXED BY tv ORDER BY id"
        } {1 a 2 b 3 c}
        do_test $prefix.writer-kept {
          $writer one {SELECT length(v) FROM t WHERE id=10}
        } 2000000
      } else {
        do_test $prefix.busy {B step -1} SQLITE_BUSY
        do_test $prefix.busy-again {B step -1} SQLITE_BUSY
        if {$action eq "finish"} {
          do_test $prefix.finish {
            list [B finish] [sqlite3_errcode db]
          } {SQLITE_BUSY SQLITE_BUSY}
        }
        do_test $prefix.destination-kept {
          db eval "SELECT id,v FROM $schema.t ORDER BY id"
        } {9 dest}
      }
      $writer eval {ROLLBACK}
      if {$writer eq "peer"} {peer close}
      if {$location ne "source" && $action eq "retry"} {
        do_test $prefix.retry {B step -1} SQLITE_DONE
        do_test $prefix.retry-finish {
          list [B finish] [sqlite3_errcode db]
        } {SQLITE_OK SQLITE_OK}
        do_test $prefix.retry-rows {
          db eval "SELECT id,v FROM $schema.t INDEXED BY tv ORDER BY id"
        } {1 a 2 b 3 c}
      }
      do_test $prefix.source-writable {
        src eval {INSERT INTO t VALUES(20,'after'); SELECT id FROM t ORDER BY id}
      } {1 2 3 20}
      do_test $prefix.integrity {db one "PRAGMA $schema.integrity_check"} ok
      if {$dest eq "attached"} {
        do_test $prefix.main-kept {db one {SELECT id FROM sentinel}} 77
      }
      src close
      do_test $prefix.no-temp {glob -nocomplain *-backup-*} {}
    }
  }
}

foreach dest {file memory} {
  set prefix backup-busy-snapshot-$dest
  reset_db
  forcedelete backup-source.db
  sqlite3 src backup-source.db
  src eval {
    CREATE TABLE t(id INTEGER PRIMARY KEY);
    INSERT INTO t VALUES(1);
    SELECT dolt_commit('-Am','base');
    BEGIN;
    SELECT * FROM t;
  }
  sqlite3 peer backup-source.db
  peer eval {INSERT INTO t VALUES(2); SELECT dolt_commit('-am','peer')}
  if {$dest eq "memory"} {
    db close
    sqlite3 db :memory:
  }
  sqlite3_backup B db main src main
  do_test $prefix.step {B step -1} SQLITE_DONE
  do_test $prefix.finish {B finish} SQLITE_OK
  do_test $prefix.snapshot {
    db eval {SELECT id FROM t; SELECT message FROM dolt_log LIMIT 1}
  } {1 base}
  do_test $prefix.transaction-kept {
    src eval {SELECT id FROM t; COMMIT; SELECT id FROM t ORDER BY id}
  } {1 1 2}
  do_test $prefix.writer-kept {peer eval {SELECT id FROM t ORDER BY id}} {1 2}
  do_test $prefix.integrity {db one {PRAGMA integrity_check}} ok
  peer close
  src close
}

testvfs backupvfs
backupvfs filter xWrite
proc backup_snapshot_write {method file args} {
  if {$::backupArmed && [string match *-backup-* $file]} {
    set ::backupArmed 0
    set ::backupRace [catch {peer eval $::backupPeerSql} ::backupMessage]
  }
  return SQLITE_OK
}
backupvfs script backup_snapshot_write
set ::backupArmed 0
foreach maintenance {commit gc vacuum} {
  set prefix backup-busy-race-$maintenance
  reset_db
  forcedelete backup-source.db
  sqlite3 src backup-source.db
  src eval {
    CREATE TABLE t(id INTEGER PRIMARY KEY,v BLOB);
    INSERT INTO t VALUES(1,zeroblob(100000));
    SELECT dolt_commit('-Am','base');
    BEGIN;
    SELECT * FROM t;
  }
  sqlite3 peer backup-source.db
  set ::backupPeerSql {INSERT INTO t VALUES(2,'peer');
                       SELECT dolt_commit('-am','peer');}
  if {$maintenance eq "gc"} {append ::backupPeerSql {SELECT dolt_gc();}}
  if {$maintenance eq "vacuum"} {append ::backupPeerSql {VACUUM;}}
  db close
  sqlite3 db test.db -vfs backupvfs
  set ::backupRace -1
  set ::backupArmed 1
  sqlite3_backup B db main src main
  do_test $prefix.step {B step -1} SQLITE_DONE
  set ::backupArmed 0
  do_test $prefix.raced {set ::backupRace} 0
  do_test $prefix.finish {B finish} SQLITE_OK
  do_test $prefix.snapshot {
    db eval {SELECT id,length(v) FROM t; SELECT message FROM dolt_log LIMIT 1}
  } {1 100000 base}
  do_test $prefix.writer-kept {
    peer eval {SELECT id FROM t ORDER BY id; PRAGMA integrity_check}
  } {1 2 ok}
  do_test $prefix.transaction-kept {
    src eval {SELECT id FROM t; COMMIT; SELECT id FROM t ORDER BY id}
  } {1 1 2}
  peer close
  src close
  do_test $prefix.reopen {
    db close
    sqlite3 db test.db
    db eval {SELECT id,length(v) FROM t; PRAGMA integrity_check}
  } {1 100000 ok}
}
backupvfs delete

# A backup reading an attached ordinary SQLite file keeps that schema in use.
foreach op {detach deserialize} {
  set prefix backup-busy-stock-source.$op
  catch {db close}
  forcedelete stock-aux.db stock-dest.db
  sqlite3 seed file:stock-aux.db?doltlite_engine=sqlite -uri 1
  seed eval {
    CREATE TABLE t(a);
    WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM n WHERE i<200)
    INSERT INTO t SELECT randomblob(900) FROM n;
  }
  seed close
  sqlite3 db :memory:
  db eval {ATTACH 'stock-aux.db' AS aux}
  sqlite3 dest file:stock-dest.db?doltlite_engine=sqlite -uri 1
  set image [db serialize aux]
  sqlite3_backup B dest main db aux
  do_test $prefix.step {B step 1} SQLITE_OK
  if {$op eq "detach"} {
    do_test $prefix.refused {catchsql {DETACH aux}} {1 {database aux is locked}}
  } else {
    do_test $prefix.refused {
      list [catch {db deserialize aux $image} msg] $msg
    } {1 {unable to set MEMDB content}}
  }
  do_test $prefix.source-kept {db eval {SELECT count(*) FROM aux.t}} {200}
  do_test $prefix.done {B step -1} SQLITE_DONE
  do_test $prefix.finish {B finish} SQLITE_OK
  do_test $prefix.copied {
    dest eval {SELECT count(*), sum(length(a)) FROM t; PRAGMA integrity_check}
  } {200 180000 ok}
  dest close
  db close
}

# Backup to :memory: or named memory must preserve the destination store's
# write gate (e.g. PRAGMA query_only) and stats pointer.
foreach dest_uri {:memory: {file:backup_qo_mem?mode=memory&cache=shared}} {
  set tag [expr {$dest_uri eq ":memory:" ? "memory" : "sharedmem"}]
  set prefix backup-preserve-gates-$tag
  forcedelete backup-source.db
  sqlite3 src backup-source.db
  src eval {
    CREATE TABLE t(id INTEGER PRIMARY KEY, v TEXT);
    INSERT INTO t VALUES(1, 'a');
    SELECT dolt_commit('-Am', 'base');
  }
  sqlite3 db $dest_uri -uri 1
  sqlite3_backup B db main src main
  do_test $prefix.step {B step -1} SQLITE_DONE
  do_test $prefix.finish {B finish} SQLITE_OK
  do_test $prefix.query-only-branch-refused {
    db eval {PRAGMA query_only = ON;}
    catchsql {SELECT dolt_branch('b2')}
  } {1 {attempt to write a readonly database}}
  do_test $prefix.branches-unchanged {
    db eval {SELECT name FROM dolt_branches ORDER BY name}
  } {main}
  do_test $prefix.query-only-off-writable {
    db eval {PRAGMA query_only = OFF;}
    sqlite3_db_status db CACHE_WRITE 1
    set rc [catchsql {SELECT dolt_branch('b2')}]
    set cw [lindex [sqlite3_db_status db CACHE_WRITE 0] 1]
    list $rc [db eval {SELECT name FROM dolt_branches ORDER BY name}] [expr {$cw > 0}]
  } {{0 0} {b2 main} 1}
  src close
  db close
}

# Backup into memdb destinations (deserialized buffer and file:/name?vfs=memdb).
forcedelete backup-source.db
sqlite3 src backup-source.db
src eval {
  CREATE TABLE t(id INTEGER PRIMARY KEY, v TEXT);
  CREATE INDEX tv ON t(v);
  INSERT INTO t VALUES(1, 'a'), (2, 'b'), (3, 'c');
  SELECT dolt_commit('-Am', 'from-src');
}
set src_img [src serialize main]

sqlite3 seed :memory:
seed eval {
  CREATE TABLE oldt(x INTEGER PRIMARY KEY);
  INSERT INTO oldt VALUES(99);
  SELECT dolt_commit('-Am', 'old-dest');
}
set old_img [seed serialize main]
seed close

foreach mode {nonempty empty} {
  set prefix backup-memdb-deserialize-$mode
  sqlite3 db :memory:
  if {$mode eq "nonempty"} {
    db deserialize main $old_img
  } else {
    db deserialize main ""
  }
  sqlite3_backup B db main src main
  do_test $prefix.step {B step -1} SQLITE_DONE
  do_test $prefix.finish {list [B finish] [sqlite3_errcode db]} {SQLITE_OK SQLITE_OK}
  do_test $prefix.rows {
    db eval {SELECT id, v FROM t INDEXED BY tv ORDER BY id}
  } {1 a 2 b 3 c}
  do_test $prefix.log {
    db one {SELECT message FROM dolt_log LIMIT 1}
  } {from-src}
  do_test $prefix.integrity {db one {PRAGMA integrity_check}} ok
  do_test $prefix.serialize-roundtrip {
    set out_img [db serialize main]
    sqlite3 chk :memory:
    chk deserialize main $out_img
    set res [list [chk eval {SELECT id, v FROM t ORDER BY id}] [chk one {PRAGMA integrity_check}]]
    chk close
    set res
  } {{1 a 2 b 3 c} ok}
  do_test $prefix.query-only-gate {
    db eval {PRAGMA query_only = ON;}
    set r1 [catchsql {SELECT dolt_branch('b2')}]
    db eval {PRAGMA query_only = OFF;}
    sqlite3_db_status db CACHE_WRITE 1
    set r2 [catchsql {SELECT dolt_branch('b2')}]
    set cw [lindex [sqlite3_db_status db CACHE_WRITE 0] 1]
    list $r1 $r2 [expr {$cw > 0}]
  } {{1 {attempt to write a readonly database}} {0 0} 1}
  db close
}

# Backup from one deserialized buffer into another deserialized buffer.
do_test backup-memdb-buffer-to-buffer {
  sqlite3 sbuf :memory:
  sbuf deserialize main $src_img
  sqlite3 dbuf :memory:
  dbuf deserialize main $old_img
  sqlite3_backup B dbuf main sbuf main
  set st [B step -1]
  set fn [B finish]
  set rows [dbuf eval {SELECT id, v FROM t INDEXED BY tv ORDER BY id}]
  set ic [dbuf one {PRAGMA integrity_check}]
  set out_img [dbuf serialize main]
  sqlite3 chk :memory:
  chk deserialize main $out_img
  set chk_rows [chk eval {SELECT id, v FROM t ORDER BY id}]
  chk close
  dbuf close
  sbuf close
  list $st $fn $rows $ic $chk_rows
} {SQLITE_DONE SQLITE_OK {1 a 2 b 3 c} ok {1 a 2 b 3 c}}

# Backup into a read-only deserialized buffer must fail with SQLITE_READONLY.
do_test backup-memdb-deserialize-readonly {
  sqlite3 db :memory:
  db deserialize -readonly 1 main $old_img
  set rc [catch {sqlite3_backup B db main src main} msg]
  set err [sqlite3_errcode db]
  set kept [db eval {SELECT x FROM oldt}]
  db close
  list $rc $err $kept
} {1 SQLITE_READONLY 99}

# Backup into file:/name?vfs=memdb (empty and non-empty).
foreach mode {empty nonempty} {
  set prefix backup-memdb-vfs-$mode
  sqlite3 db "file:/backup_memdb_${mode}?vfs=memdb" -uri 1
  if {$mode eq "nonempty"} {
    db eval {
      CREATE TABLE oldt(x INTEGER PRIMARY KEY);
      INSERT INTO oldt VALUES(42);
    }
  }
  sqlite3_backup B db main src main
  do_test $prefix.step {B step -1} SQLITE_DONE
  do_test $prefix.finish {list [B finish] [sqlite3_errcode db]} {SQLITE_OK SQLITE_OK}
  do_test $prefix.rows {
    db eval {SELECT id, v FROM t INDEXED BY tv ORDER BY id}
  } {1 a 2 b 3 c}
  do_test $prefix.integrity {db one {PRAGMA integrity_check}} ok
  do_test $prefix.serialize-roundtrip {
    set out_img [db serialize main]
    sqlite3 chk :memory:
    chk deserialize main $out_img
    set res [list [chk eval {SELECT id, v FROM t ORDER BY id}] [chk one {PRAGMA integrity_check}]]
    chk close
    set res
  } {{1 a 2 b 3 c} ok}
  db close
}
src close

sqlite3 db test.db

finish_test
