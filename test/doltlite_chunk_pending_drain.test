set testdir [file dirname $argv0]
source $testdir/tester.tcl

set testprefix doltlite-chunk-pending-drain

set saved_pending_drain_limit [expr {[info exists env(DOLTLITE_CHUNK_PENDING_DRAIN_LIMIT)] ? $env(DOLTLITE_CHUNK_PENDING_DRAIN_LIMIT) : ""}]
set had_pending_drain_limit [info exists env(DOLTLITE_CHUNK_PENDING_DRAIN_LIMIT)]
set env(DOLTLITE_CHUNK_PENDING_DRAIN_LIMIT) 32768

do_execsql_test 1.0 {
  PRAGMA page_size = 1024;
  CREATE TABLE t1(a, b);
  BEGIN;
  WITH data(x,y) AS (
    SELECT 1, zeroblob(10000)
    UNION ALL
    SELECT x+1, y FROM data WHERE x < 300
  )
  INSERT INTO t1 SELECT * FROM data;
  COMMIT;
  SELECT count(*), length(max(b)) FROM t1;
} {300 10000}

db close
sqlite3 db test.db

do_execsql_test 1.1 {
  SELECT count(*), length(max(b)) FROM t1;
} {300 10000}

foreach {key decl keyexpr} {
  integer INTEGER i
  text TEXT {printf('%016x',i)}
} {
  do_execsql_test rollback-$key-setup "
    CREATE TABLE spill(id $decl PRIMARY KEY, v INTEGER, payload BLOB);
    BEGIN;
    WITH RECURSIVE c(i) AS (
      VALUES(1) UNION ALL SELECT i+1 FROM c WHERE i<65536
    )
    INSERT INTO spill SELECT $keyexpr,i,zeroblob(32) FROM c;
    COMMIT;
  " {}
  db close
  sqlite3 db test.db

  foreach iteration {1 2} {
    do_catchsql_test rollback-$key-$iteration {
      BEGIN;
      SELECT sum(v) FROM spill;
      INSERT INTO spill SELECT * FROM spill WHERE 1
        ON CONFLICT(id) DO UPDATE SET v=excluded.v+1;
      SELECT changes(),sum(v) FROM spill;
      ROLLBACK;
      SELECT sum(v) FROM spill;
    } {0 {2147516416 65536 2147581952 2147516416}}
    catchsql {ROLLBACK}
  }

  do_execsql_test rollback-$key-commit {
    BEGIN;
    SELECT sum(v) FROM spill;
    INSERT INTO spill SELECT * FROM spill WHERE 1
      ON CONFLICT(id) DO UPDATE SET v=excluded.v+1;
    COMMIT;
  } {2147516416}
  catchsql {ROLLBACK}
  db close
  sqlite3 db test.db
  do_execsql_test rollback-$key-durable {
    SELECT count(*),sum(v),sum(length(payload)) FROM spill;
    PRAGMA integrity_check;
  } {65536 2147581952 2097152 ok}

  sqlite3 db2 test.db
  db eval {BEGIN; SELECT sum(v) FROM spill}
  db2 eval {UPDATE spill SET v=v+1 WHERE v=2}
  do_catchsql_test peer-upgrade-$key {
    UPDATE spill SET v=v+1 WHERE v=3;
  } {1 {database is locked}}
  do_test $testprefix-peer-snapshot-$key {
    sqlite3_extended_errcode db
  } {SQLITE_BUSY_SNAPSHOT}
  db eval {ROLLBACK}
  db2 close
  do_execsql_test peer-kept-$key {
    SELECT sum(v) FROM spill;
    DROP TABLE spill;
  } {2147581953}
}

# I/O write error during pending drain on a brand-new DB after writing the
# offset-0 manifest must truncate the file back to 0 bytes so reopen succeeds.
proc drain_tvfs_cb {method file args} {
  if {![string match *drain_ioerr.db $file]} { return SQLITE_OK }
  if {$::drain_fail_after_hdr && $method eq "xWrite"} {
    set off [lindex $args 1]
    set len [lindex $args 2]
    if {$off > 0} {
      if {$len >= 32768} {
        set ::drain_fault_fired 1
      }
      return SQLITE_IOERR
    }
  }
  return SQLITE_OK
}

testvfs drain_tvfs
drain_tvfs filter {xWrite}
drain_tvfs script drain_tvfs_cb

do_test drain-newdb-ioerr-trunc {
  catch {db close}
  forcedelete drain_ioerr.db
  set ::drain_fail_after_hdr 1
  set ::drain_fault_fired 0
  sqlite3 db drain_ioerr.db -vfs drain_tvfs
  set r [catchsql {
    BEGIN;
    CREATE TABLE t_drain(id INTEGER PRIMARY KEY, b BLOB);
    WITH RECURSIVE c(i) AS (
      VALUES(1) UNION ALL SELECT i+1 FROM c WHERE i<200
    )
    INSERT INTO t_drain SELECT i, randomblob(1000) FROM c;
    COMMIT;
  }]
  set ::drain_fail_after_hdr 0
  catch {db eval {ROLLBACK}}
  db close
  list $::drain_fault_fired [lindex $r 0] [file size drain_ioerr.db]
} {1 1 0}

do_test drain-newdb-ioerr-reopen {
  sqlite3 db drain_ioerr.db
  set ic1 [db eval {PRAGMA integrity_check}]
  db eval {
    CREATE TABLE t_ok(k INTEGER PRIMARY KEY, v TEXT);
    INSERT INTO t_ok VALUES(1, 'clean');
  }
  db close
  sqlite3 db drain_ioerr.db
  set res [db eval {SELECT k, v FROM t_ok; PRAGMA integrity_check}]
  db close
  forcedelete drain_ioerr.db
  list $ic1 $res
} {ok {1 clean ok}}

drain_tvfs delete
sqlite3 db test.db

if {$had_pending_drain_limit} {
  set env(DOLTLITE_CHUNK_PENDING_DRAIN_LIMIT) $saved_pending_drain_limit
} else {
  unset env(DOLTLITE_CHUNK_PENDING_DRAIN_LIMIT)
}

finish_test
