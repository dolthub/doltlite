set testdir [file dirname $argv0]
source $testdir/tester.tcl

foreach keymode {integer text without-rowid} {
  set key {id INTEGER PRIMARY KEY}
  set suffix {}
  if {$keymode ne "integer"} {set key {id TEXT PRIMARY KEY}}
  if {$keymode eq "without-rowid"} {set suffix {WITHOUT ROWID}}

  foreach kind {drop-add rename-add same-drop different-drop} {
    foreach direction {forward reverse} {
      reset_db
      execsql "CREATE TABLE t($key, a INT, b INT, c INT) $suffix"
      execsql {
        INSERT INTO t VALUES(1,10,100,1000),(2,20,200,2000),(3,30,300,3000);
        SELECT dolt_commit('-Am','base');
        SELECT dolt_branch('side');
      }
      switch $kind {
        drop-add {
          set ours {ALTER TABLE t ADD COLUMN d INT DEFAULT 9; DELETE FROM t WHERE id=2;}
          set theirs {ALTER TABLE t DROP COLUMN a;}
          set columns {id b c d}
          set rows {1 100 1000 9 3 300 3000 9}
        }
        rename-add {
          set ours {ALTER TABLE t RENAME COLUMN a TO renamed; DELETE FROM t WHERE id=2;}
          set theirs {ALTER TABLE t ADD COLUMN d INT DEFAULT 9;}
          set columns {id renamed b c d}
          set rows {1 10 100 1000 9 3 30 300 3000 9}
        }
        same-drop {
          set ours {ALTER TABLE t DROP COLUMN a; UPDATE t SET b=111 WHERE id=1;}
          set theirs {ALTER TABLE t DROP COLUMN a; INSERT INTO t VALUES(4,400,4000);}
          set columns {id b c}
          set rows {1 111 1000 2 200 2000 3 300 3000 4 400 4000}
        }
        different-drop {
          set ours {ALTER TABLE t DROP COLUMN a; DELETE FROM t WHERE id=2;}
          set theirs {ALTER TABLE t DROP COLUMN b;}
          set columns {id c}
          set rows {1 1000 3 3000}
        }
      }
      execsql $ours
      execsql {
        SELECT dolt_commit('-am','ours');
        SELECT dolt_checkout('side');
      }
      execsql $theirs
      execsql {SELECT dolt_commit('-am','theirs')}
      if {$direction eq "forward"} {
        execsql {SELECT dolt_checkout('main')}
        set target side
        set reopen [file normalize test.db]
      } else {
        set target main
        set reopen "[file normalize test.db]/side"
      }
      set name schema-relayout-$keymode-$kind-$direction
      do_test $name-merge {
        execsql {BEGIN}
        execsql "SELECT dolt_merge('$target')"
        execsql {SELECT count(*) FROM dolt_conflicts}
      } {0}
      do_execsql_test $name-columns {
        SELECT name FROM pragma_table_info('t') ORDER BY cid;
      } $columns
      do_execsql_test $name-rows {SELECT * FROM t ORDER BY id} $rows
      db close
      sqlite3 db $reopen
      do_execsql_test $name-reopen-columns {
        SELECT name FROM pragma_table_info('t') ORDER BY cid;
      } $columns
      do_execsql_test $name-reopen-rows {SELECT * FROM t ORDER BY id} $rows
    }
  }

  foreach operation {merge cherry_pick} {
    foreach resolution {ours theirs} {
      reset_db
      execsql "CREATE TABLE t($key, a INT, b INT, c INT) $suffix"
      execsql {
        INSERT INTO t VALUES(1,10,100,1000),(2,20,200,2000);
        SELECT dolt_commit('-Am','base');
        SELECT dolt_branch('side');
        ALTER TABLE t ADD COLUMN d INT DEFAULT 9;
        UPDATE t SET b=111 WHERE id=1;
        SELECT dolt_commit('-am','ours');
        SELECT dolt_checkout('side');
        ALTER TABLE t DROP COLUMN a;
        UPDATE t SET b=222 WHERE id=1;
        SELECT dolt_commit('-am','theirs');
        SELECT dolt_checkout('main');
        BEGIN;
      }
      do_test schema-relayout-$keymode-$operation-conflict-$resolution {
        catchsql "SELECT dolt_${operation}('side')"
        execsql {
          SELECT count(*) FROM dolt_conflicts;
          SELECT name FROM pragma_table_info('t') ORDER BY cid;
        }
      } {1 id b c d}
      do_execsql_test schema-relayout-$keymode-$operation-conflict-values-$resolution {
        SELECT base_b, our_b, their_b FROM dolt_conflicts_t;
      } {100 111 222}
      do_test schema-relayout-$keymode-$operation-resolve-$resolution {
        execsql "SELECT dolt_conflicts_resolve('--$resolution','t')"
        execsql {SELECT dolt_commit('-am','resolved')}
        db close
        sqlite3 db [file normalize test.db]
        execsql {
          SELECT name FROM pragma_table_info('t') ORDER BY cid;
          SELECT id,b,c,d FROM t ORDER BY id;
        }
      } [list id b c d 1 [expr {$resolution eq "ours" ? 111 : 222}] 1000 9 2 200 2000 9]
    }
  }

  foreach changed {a b} {
    reset_db
    execsql "CREATE TABLE t($key, a INT, b INT) $suffix"
    execsql {
      INSERT INTO t VALUES(1,10,100),(2,20,200);
      SELECT dolt_commit('-Am','base');
      SELECT dolt_branch('side');
      ALTER TABLE t ADD COLUMN d INT DEFAULT 9;
    }
    execsql "UPDATE t SET $changed=999 WHERE id=1"
    execsql {
      SELECT dolt_commit('-am','edit');
      SELECT dolt_checkout('side');
      ALTER TABLE t DROP COLUMN a;
      DELETE FROM t WHERE id=1;
      SELECT dolt_commit('-am','delete');
      SELECT dolt_checkout('main');
      BEGIN;
    }
    do_test schema-relayout-$keymode-delete-modify-$changed {
      catchsql {SELECT dolt_merge('side')}
      execsql {
        SELECT count(*) FROM dolt_conflicts;
        SELECT name FROM pragma_table_info('t') ORDER BY cid;
      }
    } {1 id b d}
    do_execsql_test schema-relayout-$keymode-rollback-$changed {
      ROLLBACK;
      SELECT count(*) FROM dolt_conflicts;
      SELECT name FROM pragma_table_info('t') ORDER BY cid;
      SELECT count(*) FROM t;
    } {0 id a b d 2}
    do_test schema-relayout-$keymode-autocommit-$changed {
      catchsql {SELECT dolt_merge('side')}
      db close
      sqlite3 db [file normalize test.db]
      execsql {
        SELECT count(*) FROM dolt_conflicts;
        SELECT is_merging FROM dolt_merge_status;
        SELECT name FROM pragma_table_info('t') ORDER BY cid;
        SELECT count(*) FROM t;
      }
    } {0 0 id a b d 2}
  }
}

foreach keymode {integer text without-rowid} {
  set key {id INTEGER PRIMARY KEY}
  set suffix {}
  if {$keymode ne "integer"} {set key {id TEXT PRIMARY KEY}}
  if {$keymode eq "without-rowid"} {set suffix {WITHOUT ROWID}}
  foreach indexmode {none regular unique expression} {
    foreach change {insert update null} {
      foreach fixture {populated empty} {
        if {$fixture eq "empty" && $change ne "insert"} {continue}
        foreach operation {merge cherry_pick} {
          foreach direction {forward reverse} {
            reset_db
            set default {DEFAULT 18}
            if {$fixture eq "empty"} {set default {}}
            execsql "CREATE TABLE t($key, a INT, b INT, c INT $default) $suffix"
            switch $indexmode {
              regular {execsql {CREATE INDEX u ON t(c)}}
              unique {execsql {CREATE UNIQUE INDEX u ON t(c)}}
              expression {execsql {CREATE INDEX u ON t(c+0)}}
            }
            if {$fixture eq "populated"} {
              execsql {INSERT INTO t VALUES(1,NULL,10,100),(2,NULL,20,200)}
            }
            execsql {
              SELECT dolt_commit('-Am','base');
              SELECT dolt_branch('side');
              ALTER TABLE t DROP COLUMN a;
              ALTER TABLE t RENAME COLUMN c TO cc;
              SELECT dolt_commit('-am','ddl');
              SELECT dolt_checkout('side');
            }
            switch $change {
              insert {
                execsql {INSERT INTO t VALUES(3,NULL,30,777)}
                set rows {1 10 100 2 20 200 3 30 777}
                set count 3
              }
              update {
                execsql {UPDATE t SET c=777 WHERE id=1}
                set rows {1 10 777 2 20 200}
                set count 2
              }
              null {
                execsql {INSERT INTO t VALUES(3,NULL,30,NULL)}
                set rows {1 10 100 2 20 200 3 30 NULL}
                set count 3
              }
            }
            if {$fixture eq "empty"} {set rows {3 30 777}; set count 1}
            execsql {SELECT dolt_commit('-am','dml')}
            if {$direction eq "forward"} {
              execsql {SELECT dolt_checkout('main')}
              set target side
              set reopen [file normalize test.db]
            } else {
              set target main
              set reopen "[file normalize test.db]/side"
            }
            set name drop-rename-$keymode-$indexmode-$change-$fixture-$operation-$direction
            do_test $name-apply {
              execsql "SELECT dolt_${operation}('$target')"
              execsql {SELECT count(*) FROM dolt_conflicts}
            } {0}
            do_execsql_test $name-columns {
              SELECT name FROM pragma_table_info('t') ORDER BY cid;
            } {id b cc}
            do_execsql_test $name-rows {
              SELECT id,b,quote(cc) FROM t NOT INDEXED ORDER BY id;
            } $rows
            do_execsql_test $name-count {SELECT count(*) FROM t} $count
            if {$indexmode ne "none"} {
              do_execsql_test $name-index-count {
                SELECT count(*) FROM t INDEXED BY u;
              } $count
            }
            do_execsql_test $name-integrity {PRAGMA integrity_check} {ok}
            db close
            sqlite3 db $reopen
            do_execsql_test $name-reopen {
              SELECT id,b,quote(cc) FROM t NOT INDEXED ORDER BY id;
              PRAGMA integrity_check;
            } [concat $rows ok]
          }
        }
      }
    }
  }
}

foreach keymode {integer text without-rowid} {
  set key {id INTEGER PRIMARY KEY}
  set suffix {}
  if {$keymode ne "integer"} {set key {id TEXT PRIMARY KEY}}
  if {$keymode eq "without-rowid"} {set suffix {WITHOUT ROWID}}
  foreach operation {merge cherry_pick} {
    foreach direction {forward reverse} {
      reset_db
      execsql "CREATE TABLE t($key, v TEXT) $suffix"
      execsql {
        CREATE INDEX u ON t(v);
        INSERT INTO t VALUES(1,'base');
        SELECT dolt_commit('-Am','base');
        SELECT dolt_branch('side');
        ALTER TABLE t RENAME COLUMN v TO val;
        ALTER TABLE t ADD COLUMN note TEXT DEFAULT 'remote-default';
        UPDATE t SET note='remote-note' WHERE id=1;
        INSERT INTO t VALUES(200,'from-remote','remote-row');
        SELECT dolt_commit('-am','ddl');
        SELECT dolt_checkout('side');
        INSERT INTO t VALUES(100,'from-local');
        SELECT dolt_commit('-am','dml');
      }
      if {$direction eq "forward"} {
        execsql {SELECT dolt_checkout('main')}
        set target side
        set reopen [file normalize test.db]
      } else {
        set target main
        set reopen "[file normalize test.db]/side"
      }
      set name rename-add-$keymode-$operation-$direction
      do_test $name-apply {
        execsql "SELECT dolt_${operation}('$target')"
        execsql {SELECT count(*) FROM dolt_conflicts}
      } {0}
      set rows {1 base remote-note 100 from-local remote-default 200 from-remote remote-row}
      do_execsql_test $name-rows {SELECT * FROM t NOT INDEXED ORDER BY id} $rows
      do_execsql_test $name-integrity {PRAGMA integrity_check} {ok}
      db close
      sqlite3 db $reopen
      do_execsql_test $name-reopen {
        SELECT * FROM t NOT INDEXED ORDER BY id;
        PRAGMA integrity_check;
      } [concat $rows ok]
    }
  }
}

finish_test
