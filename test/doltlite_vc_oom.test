set testdir [file dirname $argv0]
source $testdir/tester.tcl
source $testdir/malloc_common.tcl

set testprefix doltlite_vc_oom

do_test 1.0 {
  execsql {
    CREATE TABLE t(id INTEGER PRIMARY KEY, v TEXT);
    INSERT INTO t VALUES(1, 'v1');
    SELECT dolt_commit('-A', '-m', 'c1');
    UPDATE t SET v = 'v2' WHERE id = 1;
    CREATE TABLE untracked(id INTEGER PRIMARY KEY, a INT, b TEXT);
    CREATE INDEX idx_u_a ON untracked(a);
    CREATE INDEX idx_u_b ON untracked(b);
    INSERT INTO untracked VALUES(1, 10, 'keep');
  }
  set {} {}
} {}
faultsim_save_and_close

do_faultsim_test 1.1 -faults oom-transient -prep {
  faultsim_restore_and_reopen
} -body {
  db eval { SELECT dolt_reset('--hard') }
  set v [db one { SELECT v FROM t WHERE id = 1 }]
  set u [db one { SELECT b FROM untracked WHERE id = 1 }]
  set nidx [db one {
    SELECT count(*) FROM sqlite_master
    WHERE type='index' AND tbl_name='untracked'
  }]
  list $v $u $nidx
} -test {
  faultsim_test_result {0 {v1 keep 2}} \
      {1 {out of memory}} {1 {disk I/O error}} {1 {failed to read HEAD}}
  catchsql ROLLBACK
  faultsim_integrity_check
}

faultsim_restore_and_reopen
do_test 2.0 {
  reset_db
  execsql {
    CREATE TABLE t(id INTEGER PRIMARY KEY, v TEXT);
    INSERT INTO t VALUES(1, 'orig');
    SELECT dolt_commit('-A', '-m', 'c1');
    UPDATE t SET v = 'dirty' WHERE id = 1;
  }
  set {} {}
} {}
faultsim_save_and_close

do_faultsim_test 2.1 -faults oom-transient -prep {
  faultsim_restore_and_reopen
} -body {
  db eval { SELECT dolt_checkout('t') }
  db one { SELECT v FROM t WHERE id = 1 }
} -test {
  faultsim_test_result {0 orig} \
      {1 {out of memory}} {1 {disk I/O error}} \
      {1 {failed to snapshot current branch state}} {1 {checkout failed}}
  catchsql ROLLBACK
  faultsim_integrity_check
}

ifcapable fts5 {
  faultsim_restore_and_reopen
  do_test 3.0 {
    reset_db
    execsql {
      CREATE TABLE t(id INTEGER PRIMARY KEY, v TEXT);
      INSERT INTO t VALUES(1, 'orig');
      CREATE VIRTUAL TABLE docs USING fts5(body);
      INSERT INTO docs VALUES('hello world');
      SELECT dolt_commit('-A', '-m', 'c1');
      UPDATE t SET v = 'dirty' WHERE id = 1;
    }
    set {} {}
  } {}
  faultsim_save_and_close

  do_faultsim_test 3.1 -faults oom-transient -prep {
    faultsim_restore_and_reopen
    db eval {
      BEGIN;
      INSERT INTO docs VALUES('pending vtab write');
    }
  } -body {
    db eval { SELECT dolt_checkout('t') }
    db one { SELECT v FROM t WHERE id = 1 }
  } -test {
    faultsim_test_result {0 orig} \
        {1 {out of memory}} {1 {disk I/O error}} \
        {1 {failed to snapshot current branch state}} {1 {checkout failed}}
    catchsql ROLLBACK
    faultsim_integrity_check
  }
}

faultsim_restore_and_reopen
do_test 4.0 {
  reset_db
  execsql {
    CREATE TABLE t(id INTEGER PRIMARY KEY, a INT, b TEXT);
    CREATE INDEX idx_t_a ON t(a);
    INSERT INTO t VALUES(1, 10, 'base');
    CREATE TABLE r(id INTEGER PRIMARY KEY, v INT);
    INSERT INTO r VALUES(1, 100);
    SELECT dolt_commit('-Am', 'base');
    SELECT dolt_branch('side');
    ALTER TABLE t RENAME COLUMN a TO a_renamed;
    INSERT INTO r VALUES(2, 200);
    SELECT dolt_commit('-Am', 'main rename col and edit r');
    SELECT dolt_checkout('side');
    INSERT INTO t VALUES(2, 20, 'side');
    ALTER TABLE r RENAME TO r_renamed;
    SELECT dolt_commit('-Am', 'side edit t and rename table');
    SELECT dolt_checkout('main');
  }
  set {} {}
} {}
faultsim_save_and_close

set merge_rename_oom_results [list \
  {0 {40 2 2}} \
  {1 {out of memory}} \
  {1 {disk I/O error}} \
  {1 {merge source not found}} \
  {1 {no common ancestor found}} \
  {1 {failed to load commit}} \
  {1 {failed to load our commit}} \
  {1 {failed to load their commit}} \
  {1 {failed to load ancestor}} \
  {1 {merge failed}} \
  {1 {failed to create merge commit}} \
  {1 {cannot merge: schema change could not be applied: out of memory}} \
  {1 {cannot merge: schema change could not be applied: unable to open a temporary database file for storing temporary tables}} \
]

do_faultsim_test 4.1 -faults oom-transient -prep {
  faultsim_restore_and_reopen
} -body {
  set h [db one {SELECT length(dolt_merge('side'))}]
  set nt [db one {SELECT count(*) FROM t}]
  set nr [db one {SELECT count(*) FROM r_renamed}]
  list $h $nt $nr
} -test {
  faultsim_test_result {*}$::merge_rename_oom_results
  catchsql ROLLBACK
  faultsim_integrity_check
}

faultsim_restore_and_reopen
do_test 5.0 {
  reset_db
  execsql {
    CREATE TABLE t(id INTEGER PRIMARY KEY, a INT);
    INSERT INTO t VALUES(1, 10);
    SELECT dolt_commit('-Am', 'c1');
    ALTER TABLE t ADD COLUMN b TEXT;
    ALTER TABLE t ADD COLUMN c REAL;
    INSERT INTO t VALUES(2, 20, 'two', 2.5);
    SELECT dolt_commit('-Am', 'c2');
  }
  set {} {}
} {}
faultsim_save_and_close

do_faultsim_test 5.1 -faults oom-transient -prep {
  faultsim_restore_and_reopen
} -body {
  db eval {
    SELECT id, a, b, c FROM dolt_at_t('HEAD~1') ORDER BY id
  }
} -test {
  faultsim_test_result {0 {1 10 {} {}}} \
      {1 {out of memory}} {1 {disk I/O error}} \
      {1 {vtab constructor failed: dolt_at_t}} \
      {1 {no such table: dolt_at_t}}
  catchsql ROLLBACK
  faultsim_integrity_check
}

finish_test
