source [file join [file dirname [info script]] vec1_common.tcl]
set testprefix vec1limit
vec1_load db


do_execsql_test 1.0 { 
  CREATE VIRTUAL TABLE v1 USING vec1(v, a, b);
  INSERT INTO v1 VALUES(random_vector(16), 555, 111);
  DELETE FROM v1;
}

do_catchsql_test 1.1 {
  SELECT * FROM v1(:q) 
} {1 {vec1: unexpected vector blob size 0 bytes, expected 64}}

set q [db one {SELECT random_vector(16)}]
foreach {tn sql} {
  1 { SELECT * FROM v1($q) }
  2 { SELECT * FROM v1($q) ORDER BY vec1_l2_distance(v, $q) LIMIT 10 }
  3 { SELECT * FROM v1($q) WHERE a!=b LIMIT 10 }
  4 { SELECT * FROM v1($q) LIMIT -1 }
  5 { SELECT * FROM v1($q) WHERE a LIKE 'p%' LIMIT 10 }
} {
  do_catchsql_test 1.2.$tn $sql [list \
    1 {vec1: no K value or visible LIMIT clause}
  ]
}

foreach {tn sql} {
  1 { SELECT * FROM v1($q) LIMIT 10 }
  2 { SELECT * FROM v1($q) WHERE a=555 LIMIT 10 }
} {
  do_execsql_test 1.3.$tn $sql {}
}

#-------------------------------------------------------------------------

reset_db
vec1_load db

do_execsql_test 2.0 {
  CREATE TABLE corpus(id INTEGER PRIMARY KEY, v BLOB, title TEXT, cat TEXT);
  INSERT INTO corpus(id,v,title,cat)
    SELECT i, vec1_from_json(
        '['|| (i%17) ||','|| (i%13) ||','|| (i%7) ||','|| (i%5)
            ||','|| (i%23) ||','|| (i%3) ||','|| (i%11) ||','|| (i%19) ||']'
      ), 'runbook '||i, 
      CASE WHEN i%3=0 THEN 'ops' WHEN i%3=1 THEN 'kb' ELSE 'security' END
    FROM (
     WITH RECURSIVE r(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM r WHERE i<2000) 
     SELECT i FROM r
    );
  CREATE VIRTUAL TABLE docs USING vec1(embedding, title, category);
  INSERT INTO docs(rowid, embedding, title, category) 
  SELECT id, v, title, cat FROM corpus;
  INSERT INTO docs(cmd,arg) VALUES('rebuild',(
    SELECT vec1_train(v,'{nbucket:8}') FROM corpus
  ));
}

foreach {tn K} {
  1 576460752303423616
  2 1152921504606852096
  3 1152921504606847232
  4 1152921504606848000
  5 1152921504606847232
} {
  set J "{K:$K, nprobe: 99}"
  set K [expr $K]

  do_catchsql_test 2.1.$tn.1 {
    SELECT count(*) FROM docs( vec1_from_json('[1,2,3,4,5,6,7,8]'), $J );
  } {1 {vec1: K must be an integer value between 0 and 33554432}}

  do_catchsql_test 2.1.$tn.2 {
    SELECT count(*) FROM docs( vec1_from_json('[1,2,3,4,5,6,7,8]'), $K );
  } {1 {vec1: K must be an integer value between 0 and 33554432}}
}

#-------------------------------------------------------------------------
# K = 0 / LIMIT 0 across trained, flat, and none modes (and streaming:1).
#
set q8 [db one {SELECT vec1_from_json('[1,2,3,4,5,6,7,8]')}]
set lim0 0

foreach {tn sql} {
  1 { SELECT rowid FROM docs($q8) LIMIT 0 }
  2 { SELECT rowid FROM docs($q8) LIMIT $lim0 }
  3 { SELECT rowid FROM docs($q8, 0) }
  4 { SELECT rowid FROM docs($q8, '{K:0}') }
  5 { SELECT rowid FROM docs($q8, '{K:0, streaming:1}') }
  6 { SELECT rowid FROM docs($q8, '{streaming:1}') LIMIT $lim0 }
} {
  do_execsql_test 3.1.$tn $sql {}
}

do_execsql_test 3.2.0 {
  CREATE VIRTUAL TABLE docs_flat USING vec1(embedding, title, category);
  INSERT INTO docs_flat(rowid, embedding, title, category)
  SELECT id, v, title, cat FROM corpus WHERE id <= 50;
  INSERT INTO docs_flat(cmd, arg) VALUES('rebuild', '{index:"flat"}');
}

foreach {tn sql} {
  1 { SELECT rowid FROM docs_flat($q8) LIMIT 0 }
  2 { SELECT rowid FROM docs_flat($q8) LIMIT $lim0 }
  3 { SELECT rowid FROM docs_flat($q8, 0) }
  4 { SELECT rowid FROM docs_flat($q8, '{K:0}') }
  5 { SELECT rowid FROM docs_flat($q8, '{K:0, streaming:1}') }
  6 { SELECT rowid FROM docs_flat($q8, '{streaming:1}') LIMIT $lim0 }
} {
  do_execsql_test 3.2.$tn $sql {}
}

do_execsql_test 3.3.0 {
  CREATE VIRTUAL TABLE docs_none USING vec1(embedding, title, category);
  INSERT INTO docs_none(rowid, embedding, title, category)
  SELECT id, v, title, cat FROM corpus WHERE id <= 50;
  INSERT INTO docs_none(cmd, arg) VALUES('rebuild', '{index:"none"}');
}

foreach {tn sql} {
  1 { SELECT rowid FROM docs_none($q8) LIMIT 0 }
  2 { SELECT rowid FROM docs_none($q8) LIMIT $lim0 }
  3 { SELECT rowid FROM docs_none($q8, 0) }
  4 { SELECT rowid FROM docs_none($q8, '{K:0}') }
} {
  do_execsql_test 3.3.$tn $sql {}
}

#-------------------------------------------------------------------------
# 64-bit LIMIT values exceeding 32-bit INT_MAX must not truncate to 32-bit.
#
foreach {tn lim} {
  1 4294967297
  2 4294967296
  3 2147483648
  4 9223372036854775807
} {
  do_catchsql_test 4.1.$tn "
    SELECT rowid FROM docs(\$q8) LIMIT $lim
  " {1 {vec1: K must be an integer value between 0 and 33554432}}
}

do_execsql_test 4.2.1 {
  SELECT count(*) FROM (SELECT rowid FROM docs($q8, 5) LIMIT 4294967297)
} {5}

do_execsql_test 4.2.2 {
  SELECT count(*) FROM (SELECT rowid FROM docs($q8, 5) LIMIT 4294967296)
} {5}

finish_test

