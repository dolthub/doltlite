  WHERE c2 = 'ONE' COLLATE nocase
  ORDER BY 1
} {3 4}

#-------------------------------------------------------------------------
reset_db
vec1_load db

do_execsql_test 8.0 {
  CREATE VIRTUAL TABLE docs USING vec1(embedding, title, size_kb, priority);
  INSERT INTO docs(rowid, embedding, title, size_kb, priority)
    SELECT i, 
           vec1_from_json('['||i||',0,0,0]'), 
           'runbook '||i, (i%5)*100, (i%3)+1
    FROM (
      WITH RECURSIVE r(i) AS (
        SELECT 1 UNION ALL SELECT i+1 FROM r WHERE i<60
      )
      SELECT i FROM r
    );
}

foreach {tn where res} {
  1 "priority IN (1,2) AND size_kb=100" 8
  2 "size_kb=100 AND priority IN (1,2)" 8
  4 "size_kb IN (100,200) AND priority = 1" 8
  5 "priority IN (1,2)" 20
  6 "size_kb = 100" 12
  3 "priority IN (1,2) AND size_kb > 50" 20
} {
breakpoint
  do_execsql_test 8.1.$tn "
    SELECT count(*) 
      FROM docs( vec1_from_json('\[1,0,0,0\]'), 20 )
      WHERE $where
  " [list $res]
}

#-------------------------------------------------------------------------
reset_db
vec1_load db

do_execsql_test 9.0 {
  CREATE VIRTUAL TABLE v_empty_in USING vec1(v, a, b);
  INSERT INTO v_empty_in(rowid, v, a, b) VALUES
    (1, vec1_from_json('[1,0,0,0]'), 2, NULL),
    (2, vec1_from_json('[1,0,0,0]'), 1, 2),
    (3, vec1_from_json('[1,0,0,0]'), 2, 2);
}

foreach {mode rebuild_sql} {
  none ""
  flat "INSERT INTO v_empty_in(cmd, arg) VALUES('rebuild', '{index:\"flat\"}')"
} {
  if {$rebuild_sql ne ""} {
    execsql $rebuild_sql
  }
  foreach {tn where res} {
    1 "a IN (SELECT 1 WHERE 0) AND b IS 2"                        {}
    2 "a IN (SELECT 1 WHERE 0)"                                   {}
    3 "a IN (SELECT 1 WHERE 0) AND b = 2"                         {}
    4 "b = 2 AND a IN (SELECT 1 WHERE 0)"                         {}
    5 "a IN (SELECT 1 WHERE 0) AND b IN (SELECT 1 WHERE 0) AND b IS 2" {}
    6 "a IN (SELECT 1 WHERE 0) AND b IN (2) AND a IS 2"           {}
    7 "a IN (SELECT 2) AND b IS NULL"                             {1}
    8 "a IN (SELECT 1 UNION ALL SELECT 2) AND b IS 2"             {2 3}
  } {
    do_execsql_test 9.$mode.$tn "
      SELECT rowid
        FROM v_empty_in(vec1_from_json('\[1,0,0,0\]'), 10)
        WHERE $where
        ORDER BY 1
    " $res
  }
}

#-------------------------------------------------------------------------
# Float RHS filters on 1-byte and 4-byte integer metadata columns.
reset_db
vec1_load db

do_execsql_test 10.0 {
  CREATE VIRTUAL TABLE v_i4 USING vec1(v, a);
  CREATE VIRTUAL TABLE v_i1 USING vec1(v, a);
  CREATE TABLE ref_i4(id INTEGER PRIMARY KEY, a);
  CREATE TABLE ref_i1(id INTEGER PRIMARY KEY, a);

  INSERT INTO ref_i4(id, a) VALUES
    (1, -2147483648),
    (2, -3),
    (3, -2),
    (4, -1),
    (5, 0),
    (6, 1),
    (7, 2),
    (8, 3),
    (9, 2147483646),
    (10, NULL),
    (11, -100),
    (12, 100);
  INSERT INTO v_i4(rowid, v, a)
    SELECT id, vec1_from_json('['||id||',0,0,0]'), a FROM ref_i4;
  INSERT INTO v_i4(cmd, arg) VALUES('rebuild', '{index:"flat"}');

  INSERT INTO ref_i1(id, a) VALUES
    (1, 0),
    (2, 1),
    (3, 2),
    (4, 3),
    (5, 254),
    (6, NULL);
  WITH RECURSIVE r(i) AS (SELECT 7 UNION ALL SELECT i+1 FROM r WHERE i<40)
  INSERT INTO ref_i1(id, a) SELECT i, i%5 FROM r;
  INSERT INTO v_i1(rowid, v, a)
    SELECT id, vec1_from_json('['||id||',0,0,0]'), a FROM ref_i1;
  INSERT INTO v_i1(cmd, arg) VALUES('rebuild', '{index:"flat"}');
}

set float_vals {
  -1.5 -0.5 0.5 1.5 -1.0 -0.0 0.0 1.0
  -1e30 1e30
  -9223372036854775808.0 9223372036854775808.0
  -2147483648.5 -2147483648.0 -2147483647.5
  2147483645.5 2147483646.0 2147483646.5 2147483647.0
  254.5 255.0
}

foreach {tab ref} {v_i4 ref_i4 v_i1 ref_i1} {
  set idx 0
  foreach op {< <= > >= = != IS {IS NOT}} {
    foreach fv $float_vals {
      incr idx
      set expected [execsql "SELECT id FROM $ref WHERE a $op $fv ORDER BY 1"]
      do_execsql_test 10.$tab.$idx "
        SELECT rowid
          FROM ${tab}(vec1_from_json('\[1,0,0,0\]'), 100)
          WHERE a $op $fv
          ORDER BY 1
      " $expected
    }
  }

  set in_list "-1.5, -1.0, -0.5, 0.5, 1.0, 1.5, -1e30, 1e30, -9223372036854775808.0, 9223372036854775808.0"
  set expected [execsql "SELECT id FROM $ref WHERE a IN ($in_list) ORDER BY 1"]
  do_execsql_test 10.$tab.in "
    SELECT rowid
      FROM ${tab}(vec1_from_json('\[1,0,0,0\]'), 100)
      WHERE a IN ($in_list)
      ORDER BY 1
  " $expected
}

finish_test

