source [file join [file dirname [info script]] vec1_common.tcl]
set testprefix vec1binary


foreach {tn nElem codesize} {
  1 16 2
  2 16 1
  3 48 6
  4 48 3
} {
  reset_db
  vec1_load db
  expr srand(0)
  do_execsql_test 1.$tn.0 {
    CREATE VIRTUAL TABLE v1 USING vec1(v);
  }

  set nRow [expr 40]
  set nLimit [expr 40]

  do_execsql_test 1.$tn.1 {
    WITH s(i) AS (
        SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<$nRow
    )
    INSERT INTO v1 SELECT random_vector($nElem) FROM s;
  }

  set jarg "{quantizer:\"bq\", nbucket: 8, codesize: $codesize}"
  do_execsql_test 1.$tn.2 {
    INSERT INTO v1(cmd, arg) VALUES('rebuild', (
          SELECT vec1_train(v, $jarg) FROM v1
    ));
  }

  set v [db one {SELECT random_vector($nElem)}]

  set res [db eval {
      SELECT rowid FROM v1 ORDER by vec1_l2_distance($v, v) LIMIT $nLimit
  }]

  do_execsql_test 1.$tn.2 {
    SELECT rowid FROM v1($v, '{K:50, nprobe:8}') 
      ORDER BY vec1_l2_distance(v, $v) 
      LIMIT $nLimit
  } $res

  do_execsql_test 1.$tn.3 {
    PRAGMA integrity_check
  } {ok}
}

#-------------------------------------------------------------------------
reset_db
vec1_load db

do_execsql_test 2.1 {
  CREATE VIRTUAL TABLE v1 USING vec1(v);
  INSERT INTO v1(cmd, arg) VALUES('rebuild', (
    WITH s(i) AS ( SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<$nRow )
    SELECT vec1_train(random_vector(8), '{quantizer:"bq", nbucket:8}') FROM s
  ));

  INSERT INTO v1 VALUES( random_vector(8) );
}

set v [db one {SELECT random_vector(8)}]

do_execsql_test 2.2 {
  SELECT rowid FROM v1($v, '{nprobe:8}') LIMIT $nLimit
} {1}

#-------------------------------------------------------------------------
reset_db
vec1_load db

do_execsql_test 2.1 {
  CREATE VIRTUAL TABLE v1 USING vec1(abc);
  INSERT INTO v1(cmd, arg) VALUES('rebuild', (
    WITH s(i) AS ( SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<$nRow )
    SELECT vec1_train(random_vector(64), '{quantizer:"bq", nbucket:2}') FROM s
  ));

  WITH s(i) AS (
    SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<1000
  )
  INSERT INTO v1 SELECT random_vector(64) FROM s;
}

do_execsql_test 2.2 {
  PRAGMA integrity_check
} {ok}

foreach id [db eval {SELECT rowid FROM v1}] {
  db eval { DELETE FROM v1 WHERE rowid = $id }
  if {($id % 1)==0} {
    do_execsql_test 2.3.$id {
      PRAGMA integrity_check
    } {ok}
  }
}

#-------------------------------------------------------------------------
# Now check the version number in model headers. This should be 7 when
# using a binary quantizer, or 4 otherwise.
#
reset_db
vec1_load db

foreach {tn jarg iVersion} {
  1 "{nbucket:2, codesize:8}" 4
  2 "{nbucket:2, codesize:8, quantizer:\"bq\"}" 7
  3 "{nbucket:2, codesize:8, quantizer:\"pq\"}" 4
} {
  do_test 2.$tn {
    set M [db one {
      WITH s(i) AS (
        SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<512
      )
      SELECT vec1_train(random_vector(16), $jarg) FROM s;
    }]

    binary scan $M I version
    set version
  } $iVersion
}

#-------------------------------------------------------------------------
reset_db
vec1_load db

do_execsql_test 3.1 {
  CREATE VIRTUAL TABLE v1 USING vec1(v);
  WITH s(i) AS ( SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<1000 )
  INSERT INTO v1 SELECT random_vector(100) FROM s;

  INSERT INTO v1(cmd, arg) VALUES('rebuild', (
    SELECT vec1_train(v, '{quantizer:"bq", nbucket:2, codesize:8}') FROM v1
  ));
}

set v [db one {SELECT random_vector(100)}]
do_execsql_test 3.2 {
  SELECT count(*) FROM (
    SELECT rowid FROM v1($v, '{nprobe:2}') LIMIT 5
  );
} {5}

#-------------------------------------------------------------------------
# Selecting distance stats on small binary-quantized vectors (2, 3, 4
# elements, where nCode=5 and formatted code can exceed nElem*8 bytes).
#
reset_db
vec1_load db

do_execsql_test 4.1 {
  CREATE VIRTUAL TABLE v2 USING vec1(v);
  INSERT INTO v2 VALUES (x'ffffff4f00000000');
  INSERT INTO v2 VALUES (x'ffffff4fffffff4f');
  INSERT INTO v2(cmd, arg) VALUES('rebuild', (
    SELECT vec1_train(v, '{quantizer:"bq", nbucket:0, wht:0}') FROM v2
  ));
  SELECT rowid, distance FROM v2 ORDER BY rowid;
} {
  1 {{bucket:0, coarse_error:0.000000, reconstruction_error:0.765367, code: [255,255,255,79,1]}}
  2 {{bucket:0, coarse_error:0.000000, reconstruction_error:0.000000, code: [242,4,53,80,3]}}
}

do_execsql_test 4.2 {
  CREATE VIRTUAL TABLE v3 USING vec1(v);
  INSERT INTO v3 VALUES (x'ffffff4f0000000000000000');
  INSERT INTO v3 VALUES (x'ffffff4fffffff4fffffff4f');
  INSERT INTO v3(cmd, arg) VALUES('rebuild', (
    SELECT vec1_train(v, '{quantizer:"bq", nbucket:0, wht:0}') FROM v3
  ));
  SELECT rowid, distance FROM v3 ORDER BY rowid;
} {
  1 {{bucket:0, coarse_error:0.000000, reconstruction_error:0.919402, code: [255,255,255,79,1]}}
  2 {{bucket:0, coarse_error:0.000000, reconstruction_error:0.000000, code: [215,179,93,80,7]}}
}

do_execsql_test 4.3 {
  CREATE VIRTUAL TABLE v4 USING vec1(v);
  INSERT INTO v4 VALUES (x'ffffff4f000000000000000000000000');
  INSERT INTO v4 VALUES (x'ffffff4fffffff4fffffff4fffffff4f');
  INSERT INTO v4(cmd, arg) VALUES('rebuild', (
    SELECT vec1_train(v, '{quantizer:"bq", nbucket:0, wht:0}') FROM v4
  ));
  SELECT rowid, distance FROM v4 ORDER BY rowid;
} {
  1 {{bucket:0, coarse_error:0.000000, reconstruction_error:1.000000, code: [255,255,255,79,1]}}
  2 {{bucket:0, coarse_error:0.000000, reconstruction_error:0.000000, code: [255,255,127,80,15]}}
}

finish_test
  
